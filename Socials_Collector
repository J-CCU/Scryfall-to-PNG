_v50_scheduler_cooldown_prev = UnifiedSchedulerV37._cooldown_until

def _v50_scheduler_cooldown_until(self, platform: UnifiedPlatform) -> float:
    if platform.key != "instagram":
        return _v50_scheduler_cooldown_prev(self, platform)
    state = self._db_runtime_state(platform.db_path)
    now = time.time()
    public_values = []
    for key in (
        "instagram_rate_limited_until", "instagram_RATE_LIMITED_UNTIL", "rate_limited_until",
        "instagram_access_backoff_until",
    ):
        try:
            value = float(state.get(key) or 0)
            if value > now:
                public_values.append(value)
        except Exception:
            pass
    public_until = max(public_values) if public_values else 0.0
    try:
        graph_until = float(state.get("instagram_graph_cooldown_until") or 0)
    except Exception:
        graph_until = 0.0
    graph_configured = bool(instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN and instagram_INSTAGRAM_GRAPH_IG_USER_ID)

    if graph_configured:
        public_blocked = public_until > now
        graph_blocked = graph_until > now
        if public_blocked and graph_blocked:
            return min(public_until, graph_until)
        return 0.0
    return public_until

