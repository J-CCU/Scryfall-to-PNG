def _v46_get_video_sync(self: youtube_Database, video_id: str) -> Optional[dict]:
    # V45 executed the same SELECT twice solely to recover column names.
    with self.lock:
        cur = self.conn.execute("SELECT * FROM video_ingestion WHERE video_id=?", (str(video_id),))
        row = cur.fetchone()
        if not row:
            return None
        if isinstance(row, sqlite3.Row):
            return dict(row)
        return dict(zip([d[0] for d in cur.description], row))


