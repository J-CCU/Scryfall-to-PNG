def youtube_find_deno_runtime() -> Optional[Path]:
    """Find Deno even when the GUI process has a reduced shell PATH."""
    candidates: List[Path] = []
    found = shutil.which("deno")
    if found:
        candidates.append(Path(found))
    candidates.extend([
        Path("/opt/homebrew/bin/deno"),
        Path("/usr/local/bin/deno"),
        Path.home() / ".deno" / "bin" / "deno",
    ])
    seen = set()
    for candidate in candidates:
        key = str(candidate)
        if key in seen:
            continue
        seen.add(key)
        try:
            if not candidate.is_file():
                continue
            result = subprocess.run(
                [str(candidate), "--version"],
                capture_output=True,
                text=True,
                timeout=4,
                check=False,
            )
            if result.returncode == 0:
                return candidate
        except Exception:
            continue
    return None


def youtube_detect_ytdlp_js_support() -> dict:
    """Detect Deno/EJS and configure a safe yt-dlp runtime path."""
    global youtube_YTDLP_DENO_PATH, youtube_YTDLP_EJS_AVAILABLE
    youtube_YTDLP_DENO_PATH = youtube_find_deno_runtime()
    youtube_YTDLP_EJS_AVAILABLE = importlib.util.find_spec("yt_dlp_ejs") is not None

    if youtube_YTDLP_DENO_PATH:
        try:
            version_output = subprocess.run(
                [str(youtube_YTDLP_DENO_PATH), "--version"],
                capture_output=True,
                text=True,
                timeout=4,
                check=False,
            ).stdout.strip()
            version = version_output.splitlines()[0] if version_output else "unknown"
        except Exception:
            version = "unknown"
        youtube_log(f"[js] Deno available | version={version} | path={youtube_YTDLP_DENO_PATH}")
    else:
        version = ""
        youtube_log("[js] Deno NOT FOUND | install Deno >= 2.3 for full YouTube yt-dlp support")

    if youtube_YTDLP_EJS_AVAILABLE:
        youtube_log("[js] yt-dlp-ejs package available")
    elif youtube_YTDLP_DENO_PATH:
        youtube_log("[js] yt-dlp-ejs package NOT FOUND | yt-dlp npm EJS fallback enabled")
    else:
        youtube_log("[js] yt-dlp-ejs package NOT FOUND | no EJS runtime available")

    return {
        "deno": bool(youtube_YTDLP_DENO_PATH),
        "deno_path": str(youtube_YTDLP_DENO_PATH) if youtube_YTDLP_DENO_PATH else "",
        "deno_version": version,
        "ejs": bool(youtube_YTDLP_EJS_AVAILABLE),
        "remote_ejs_fallback": bool(youtube_YTDLP_DENO_PATH and not youtube_YTDLP_EJS_AVAILABLE),
    }


