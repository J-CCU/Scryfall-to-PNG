def _v46_resolve_data_dir() -> Path:
    raw = os.getenv("SOCIAL_COLLECTOR_DATA_DIR", "").strip()
    if raw:
        p = Path(os.path.expandvars(os.path.expanduser(raw)))
        return p if p.is_absolute() else (BASE_DIR / p).resolve()
    try:
        if V46_DATA_POINTER_FILE.exists():
            raw = V46_DATA_POINTER_FILE.read_text(encoding="utf-8").strip()
            if raw:
                p = Path(os.path.expandvars(os.path.expanduser(raw)))
                return p if p.is_absolute() else (BASE_DIR / p).resolve()
    except Exception:
        pass
    # Preserve the existing production databases unless the operator explicitly
    # migrates them.  This avoids ever splitting one live database into two.
    return BASE_DIR


