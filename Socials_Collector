def youtube_choose_video_action_v38(
    db: youtube_Database, video: dict, mode: str, force_refresh: bool = False
) -> str:
    state = db.get_video_sync(str(video.get("video_id") or ""))
    if state is None:
        return "NEW"
    if force_refresh:
        return "FORCE"

    # Do not rerun expensive yt-dlp merely because comments are missing.
    if not _v35_youtube_payload_complete(db, state, mode):
        return "RESUME"
    if not _v38_comments_complete(db, state):
        return "COMMENT_REPAIR"

    # Payload + comments can be complete while an older checkpoint bit is stale.
    # Repair that locally instead of reopening network work or silently carrying
    # an IN_PROGRESS marker forever.
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE" or state.get("last_error"):
        _v38_finalize_video(db, str(video.get("video_id") or ""))
        state = db.get_video_sync(str(video.get("video_id") or "")) or state

    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = _v29_hours(last)
    if elapsed is None or elapsed >= youtube_video_refresh_interval_hours(video):
        return "PERFORMANCE_REFRESH"
    if _v38_comment_refresh_due(db, video, state):
        return "COMMENT_REFRESH"
    return "SKIP"


