# ---------------------------------------------------------------------------
# WAL maintenance and verified local backups.
# ---------------------------------------------------------------------------
def _v46_checkpoint_path(path: Path, *, truncate: bool = False) -> tuple:
    if not Path(path).exists():
        return (0, 0, 0)
    conn = sqlite3.connect(str(path), timeout=2.0)
    try:
        conn.execute("PRAGMA busy_timeout=2000")
        mode = "TRUNCATE" if truncate else "PASSIVE"
        row = conn.execute(f"PRAGMA wal_checkpoint({mode})").fetchone()
        return tuple(row or (0,0,0))
    finally:
        conn.close()


def _v46_db_maintenance_loop(path: Path, stop: threading.Event) -> None:
    last_optimize = time.monotonic()
    while not stop.wait(V46_WAL_MAINTENANCE_SECONDS):
        try:
            wal = Path(str(path) + "-wal")
            if wal.exists() and wal.stat().st_size >= V46_WAL_SIZE_TRIGGER_BYTES:
                _v46_checkpoint_path(path, truncate=False)
            if time.monotonic() - last_optimize >= 1800:
                conn = sqlite3.connect(str(path), timeout=2.0)
                try:
                    conn.execute("PRAGMA busy_timeout=2000")
                    conn.execute("PRAGMA optimize")
                finally:
                    conn.close()
                last_optimize = time.monotonic()
        except Exception:
            pass


def _v46_backup_one(src: Path, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(dest.suffix + ".tmp")
    try:
        if tmp.exists(): tmp.unlink()
    except Exception:
        pass
    source = sqlite3.connect(str(src), timeout=30.0)
    target = sqlite3.connect(str(tmp), timeout=30.0)
    try:
        source.execute("PRAGMA busy_timeout=30000")
        source.backup(target, pages=4096, sleep=0.01)
        target.commit()
        check = target.execute("PRAGMA quick_check").fetchone()
        if not check or str(check[0]).lower() != "ok":
            raise RuntimeError(f"quick_check failed for {src.name}: {check}")
    finally:
        target.close(); source.close()
    os.replace(str(tmp), str(dest))


def _v46_backup_all(reason: str = "manual", root: Optional[Path] = None) -> Optional[Path]:
    root = Path(root or V46_BACKUP_DIR)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    folder = root / stamp
    folder.mkdir(parents=True, exist_ok=False)
    copied = 0
    for path in (youtube_DB_PATH, instagram_DB_PATH, tiktok_DB_PATH):
        if Path(path).exists():
            _v46_checkpoint_path(Path(path), truncate=False)
            _v46_backup_one(Path(path), folder / Path(path).name)
            copied += 1
    (folder / "backup_info.json").write_text(json.dumps({"created_at": youtube_now_utc(), "reason": reason, "data_dir": str(V46_DATA_DIR), "databases": copied}, indent=2), encoding="utf-8")
    # Retain newest N complete backup sets.
    try:
        sets = sorted([p for p in root.iterdir() if p.is_dir()], key=lambda p: p.name, reverse=True)
        for old in sets[V46_BACKUP_RETENTION:]:
            shutil.rmtree(old, ignore_errors=True)
    except Exception:
        pass
    return folder


def _v46_auto_backup_loop(app) -> None:
    # Do not start a multi-GB copy at launch. First automatic backup is after the
    # configured interval; manual --backup-now remains available at any time.
    stop = getattr(app, "_v46_backup_stop", None)
    if stop is None:
        return
    while not stop.wait(V46_BACKUP_INTERVAL_HOURS * 3600.0):
        try:
            folder = _v46_backup_all("scheduled")
            app.enqueue_ui(("log", f"[backup/v46] local SQLite backup COMPLETE | {folder}\n"))
        except Exception as exc:
            app.enqueue_ui(("log", f"[backup/v46] backup ERROR | {type(exc).__name__}: {exc}\n"))


def _v46_migrate_local_data(target: Optional[str] = None) -> int:
    source_root = V46_DATA_DIR
    if target:
        dest_root = Path(os.path.expandvars(os.path.expanduser(target)))
    elif os.name == "nt":
        dest_root = Path(os.environ.get("SystemDrive", "C:")) / "SocialCollector" / "data"
    else:
        dest_root = Path.home() / "SocialCollector" / "data"
    dest_root = dest_root.resolve()
    if dest_root == source_root.resolve():
        print(f"[migrate/v46] already using local data root: {dest_root}", flush=True)
        return 0
    dest_root.mkdir(parents=True, exist_ok=True)
    mapping = (
        (source_root / "youtube_maximum.db", dest_root / "youtube_maximum.db", "video_ingestion"),
        (source_root / "instagram.db", dest_root / "instagram.db", "post_ingestion"),
        (source_root / "tiktok.db", dest_root / "tiktok.db", "video_ingestion"),
    )
    migrated = 0
    for src, dest, table in mapping:
        if not src.exists():
            continue
        if dest.exists() and dest.stat().st_size > 0:
            raise RuntimeError(f"destination already exists; refusing to overwrite: {dest}")
        print(f"[migrate/v46] {src.name} -> {dest}", flush=True)
        _v46_checkpoint_path(src, truncate=False)
        _v46_backup_one(src, dest)
        a = sqlite3.connect(str(src), timeout=30.0)
        b = sqlite3.connect(str(dest), timeout=30.0)
        try:
            src_n = int(a.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0] or 0)
            dst_n = int(b.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0] or 0)
            if src_n != dst_n:
                raise RuntimeError(f"verification failed for {src.name}: source={src_n}, destination={dst_n}")
        finally:
            a.close(); b.close()
        print(f"[migrate/v46] verified {src.name} | obligations={src_n:,}", flush=True)
        migrated += 1
    if migrated == 0:
        print(f"[migrate/v46] no databases found under {source_root}", flush=True)
        return 2
    # Pointer flips only after every copied database passed quick_check/count verification.
    V46_DATA_POINTER_FILE.write_text(str(dest_root), encoding="utf-8")
    print(f"[migrate/v46] COMPLETE | active data root on next launch: {dest_root}", flush=True)
    print("[migrate/v46] original databases were NOT deleted", flush=True)
    return 0


# ---------------------------------------------------------------------------
# Single-parent guard: one GUI owns the local DB set; its three child workers are
# intentionally exempt. This prevents two accidental GUI launches from writing
# the same WAL databases concurrently.
# ---------------------------------------------------------------------------
def _v46_acquire_parent_lock() -> None:
    global _V46_PARENT_LOCK_HANDLE
    lock_path = V46_DATA_DIR / ".social_collector.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fh = open(lock_path, "a+b")
    if fh.tell() == 0:
        fh.write(b"0"); fh.flush()
    fh.seek(0)
    try:
        if os.name == "nt":
            import msvcrt
            msvcrt.locking(fh.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        fh.close()
        raise RuntimeError(f"Another Social Collector is already using {V46_DATA_DIR}")
    _V46_PARENT_LOCK_HANDLE = fh


def _v46_release_parent_lock() -> None:
    global _V46_PARENT_LOCK_HANDLE
    fh = _V46_PARENT_LOCK_HANDLE
    _V46_PARENT_LOCK_HANDLE = None
    if fh is None:
        return
    try:
        fh.seek(0)
        if os.name == "nt":
            import msvcrt
            msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
        else:
            import fcntl
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except Exception:
        pass
    try: fh.close()
    except Exception: pass


