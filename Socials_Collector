        mode: str,
        force_refresh: bool,
        continuous: bool,
        high_throughput: bool,
        extended_surfaces: bool,
        collect_comments: bool = False,
    ) -> None:
        # Dedicated-server invariant: every enabled platform is a permanent
        # independent service slot. A successful pass means "poll again", not
        # "terminate this platform". The server stops only on an explicit End.
        self.ui_log("[server/v23] ALWAYS-ON mode enabled | completed platform passes automatically restart\n")
        return super().start(
            inputs, limit, mode, force_refresh, True,
