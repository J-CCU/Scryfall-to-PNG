tiktok_RESEARCH_BASE = "https://open.tiktokapis.com/v2/research"
tiktok_RESEARCH_OAUTH_URL = "https://open.tiktokapis.com/v2/oauth/token/"
tiktok_RESEARCH_VIDEO_FIELDS = (
    "id,video_description,create_time,region_code,share_count,view_count,"
    "like_count,comment_count,music_id,hashtag_names,effect_ids,playlist_id,"
    "voice_to_text,is_stem_verified,favorites_count,video_duration,"
    "hashtag_info_list,sticker_info_list,effect_info_list,video_mention_list,"
    "video_label,video_tag,username"
)


def tiktok_research_token_available() -> bool:
    return bool(tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN and tiktok_COLLECT_RESEARCH_API)


def tiktok_ensure_research_access_token(db: Optional[tiktok_Database] = None) -> str:
    """Use a supplied token, or obtain a client-credentials token from TikTok.

    The Research API's client access tokens expire, so the collector stores an
    expiry timestamp in runtime_state and refreshes before expiry when client
    credentials are configured. No credential rotation is used to bypass limits.
    """
    global tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN
    if not tiktok_COLLECT_RESEARCH_API:
        return ""
    now = time.time()
    if tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN:
        if db is not None:
            try:
                expires_at = float(db.get_runtime_state("tiktok_research_token_expires_at") or 0)
                if expires_at and now >= expires_at - tiktok_TIKTOK_RESEARCH_TOKEN_SAFETY_SECONDS and tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET:
                    tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN = ""
            except Exception:
                pass
        if tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN:
            return tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN
    if not (tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET):
        return ""
    try:
        r = requests.post(
            tiktok_RESEARCH_OAUTH_URL,
            data={
                "client_key": tiktok_TIKTOK_RESEARCH_CLIENT_KEY,
                "client_secret": tiktok_TIKTOK_RESEARCH_CLIENT_SECRET,
                "grant_type": "client_credentials",
            },
            headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": tiktok_UA},
            timeout=tiktok_REQUEST_TIMEOUT,
        )
        if r.status_code != 200:
            tiktok_log(f"[research/auth] HTTP {r.status_code}: {r.text[:500]}")
            return ""
        payload = r.json() if r.content else {}
        token = str(payload.get("access_token") or "").strip()
        expires_in = int(payload.get("expires_in") or 0)
        if not token:
            tiktok_log(f"[research/auth] no access_token in response")
            return ""
        tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN = token
        if db is not None:
            db.set_runtime_state("tiktok_research_token_expires_at", str(now + max(0, expires_in)))
        tiktok_log(f"[research/auth] client access token acquired | expires_in={expires_in}s")
        return token
    except Exception as exc:
        tiktok_log(f"[research/auth] {type(exc).__name__}: {exc}")
        return ""


def tiktok_research_headers(db: Optional[tiktok_Database] = None) -> dict:
    token = tiktok_ensure_research_access_token(db)
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "User-Agent": tiktok_UA,
    }


def tiktok_research_post(path: str, params: dict, body: dict, db: Optional[tiktok_Database] = None, _retry_auth: bool = True) -> Optional[dict]:
    if not tiktok_COLLECT_RESEARCH_API:
        return None
    token = tiktok_ensure_research_access_token(db)
    if not token:
        return None
    try:
        r = requests.post(tiktok_RESEARCH_BASE + path, params=params, headers=tiktok_research_headers(db), json=body, timeout=tiktok_REQUEST_TIMEOUT)
        if r.status_code == 401 and _retry_auth and tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET:
            global tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN
            tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN = ""
            return tiktok_research_post(path, params, body, db, _retry_auth=False)
        if r.status_code == 429:
            raise RuntimeError("TikTok Research API HTTP 429 rate limit")
        if r.status_code != 200:
            tiktok_log(f"[research] HTTP {r.status_code} {path}: {r.text[:500]}")
            return None
        data = r.json()
        err = data.get("error") if isinstance(data, dict) else None
        if isinstance(err, dict) and err.get("code") not in (None, "ok", 0):
            tiktok_log(f"[research] API error {path}: {err}")
        return data
    except Exception as exc:
        tiktok_log(f"[research] {path} {type(exc).__name__}: {exc}")
        return None


def tiktok_research_user_info(username: str, db: Optional[tiktok_Database] = None) -> Optional[dict]:
    fields = "display_name,bio_description,avatar_url,is_verified,follower_count,following_count,likes_count,video_count,bio_url"
    data = tiktok_research_post("/user/info/", {"fields": fields}, {"username": username}, db)
    return (data or {}).get("data") if data else None


def tiktok_research_video_query(username: str, start_date: str, end_date: str, db: Optional[tiktok_Database] = None, max_count: int = 100) -> List[dict]:
    """Page through archived Research API video results for one username/date range."""
    out: List[dict] = []
    cursor = 0
    search_id = None
    while not tiktok_stop_requested():
        body = {
            "query": {"and": [{"operation": "EQ", "field_name": "username", "field_values": [username]}]},
            "max_count": min(100, max(1, int(max_count))),
            "cursor": cursor,
            "start_date": start_date,
            "end_date": end_date,
            "is_random": False,
        }
        if search_id:
            body["search_id"] = search_id
        data = tiktok_research_post("/video/query/", {"fields": tiktok_RESEARCH_VIDEO_FIELDS}, body, db)
        if not data:
            break
        payload = data.get("data") or {}
        rows = payload.get("videos") or []
        if isinstance(rows, list):
            out.extend(rows)
        has_more = bool(payload.get("has_more"))
        new_cursor = payload.get("cursor")
        search_id = payload.get("search_id") or search_id
        if not has_more or new_cursor is None or new_cursor == cursor:
            break
        cursor = int(new_cursor)
        if tiktok_STOP_EVENT.wait(0.25):
            break
    return out


def tiktok_research_comments(video_id: str, db: Optional[tiktok_Database] = None) -> List[dict]:
    if not tiktok_ensure_research_access_token(db) or not tiktok_COLLECT_RESEARCH_COMMENTS:
        return []
    comments: List[dict] = []
    cursor = 0
    while not tiktok_stop_requested():
        data = tiktok_research_post(
            "/video/comment/list/",
            {"fields": "id,video_id,text,like_count,reply_count,parent_comment_id,create_time"},
            {"video_id": int(video_id), "max_count": tiktok_MAX_RESEARCH_COMMENTS_PER_PAGE, "cursor": cursor},
            db,
        )
        if not data:
            break
        payload = data.get("data") or {}
        rows = payload.get("comments") or []
        if not rows:
            break
        comments.extend(rows)
        has_more = bool(payload.get("has_more"))
        next_cursor = payload.get("cursor")
        tiktok_log(f"[research/comments] video={video_id} page_rows={len(rows)} total={len(comments)} has_more={has_more}")
        if not has_more or next_cursor is None or next_cursor == cursor:
            break
        cursor = int(next_cursor)
        if tiktok_STOP_EVENT.wait(0.5):
            break
    return comments


