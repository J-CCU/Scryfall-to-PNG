# ============================================================================
# V43 — VISIBLE STARTUP AUDIT / NON-BLOCKING GUI BOOT
# ============================================================================
# V42 correctly added strict tri-platform evidence audits, but the parent
# process executed the entire audit synchronously before Tk was constructed.
# On a production database with tens of thousands of obligations this made the
# application appear to do nothing. V43 creates the GUI immediately, disables
# Start while the deep local audit runs on a background thread, and enables
# collection only after the audit has completed. Platform worker subprocesses
# still run their own platform-specific guard before any network collection.
#
# No network is used by the parent startup audit. SQLite remains the durable
# source of truth, and the live evidence rows remain visible while auditing.

V43_BUILD = "ALL_FIXES_V43_VISIBLE_STARTUP_AUDIT"
V43_STARTUP_POLL_MS = 250


def _v43_parent_audit_worker(app) -> None:
    """Run the deep three-DB audit without touching Tk from this thread."""
    global instagram_COLLECT_COMMENTS, tiktok_COLLECT_RESEARCH_COMMENTS
    old_ig = instagram_COLLECT_COMMENTS
    old_tt = tiktok_COLLECT_RESEARCH_COMMENTS
    result = {}
    error = ""
    try:
        # Legacy V43 audit policy; superseded by the V44/V48 startup audit.
        instagram_COLLECT_COMMENTS = True
        tiktok_COLLECT_RESEARCH_COMMENTS = True
        app.enqueue_ui(("log", "[startup/v43] Deep database evidence audit START | GUI remains responsive | network=0\n"))
        for key, label in (("youtube", "YouTube"), ("instagram", "Instagram"), ("tiktok", "TikTok")):
            app.enqueue_ui(("log", f"[startup/v43] auditing {label} database...\n"))
            one = _v42_pre_main_database_guard(key)
            result.update(one or {})
            app.enqueue_ui(("log", f"[startup/v43] {label} database audit complete\n"))
    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"
        app.enqueue_ui(("log", f"[startup/v43] audit ERROR | {error}\n"))
        app.enqueue_ui(("log", traceback.format_exc()))
    finally:
        instagram_COLLECT_COMMENTS = old_ig
        tiktok_COLLECT_RESEARCH_COMMENTS = old_tt
        app._v43_audit_result = result
        app._v43_audit_error = error
        app._v43_audit_done.set()


def _v43_finish_startup_audit_ui(app) -> None:
    """Main-thread poller: never call Tk from the audit worker."""
    try:
        if not app._v43_audit_done.is_set():
            app.root.after(V43_STARTUP_POLL_MS, lambda: _v43_finish_startup_audit_ui(app))
            return
        # V42 already owns the single recurring two-second counter refresher.
        # Do not start a second timer here; it has been updating throughout the audit.
        if app._v43_audit_error:
            # Do not silently enable collection after a failed integrity audit.
            app.start_btn.config(state="disabled")
            for p in UNIFIED_PLATFORMS:
                app.platform_status_vars[p.key].set("AUDIT ERROR")
            app.enqueue_ui(("log", "[startup/v43] Start remains disabled because the database audit failed.\n"))
            return
        for p in UNIFIED_PLATFORMS:
            app.platform_status_vars[p.key].set("READY")
        app.start_btn.config(state="normal")
        app.enqueue_ui(("log", "[startup/v43] DATABASE AUDIT COMPLETE | collection enabled | unfinished evidence remains durable repair work\n"))
    except Exception as exc:
        try:
            app.start_btn.config(state="disabled")
            app.enqueue_ui(("log", f"[startup/v43] GUI audit finalizer ERROR | {type(exc).__name__}: {exc}\n"))
        except Exception:
            pass


_v43_app_init_prev = UnifiedApp.__init__


def _v43_app_init(self, root: tk.Tk) -> None:
    _v43_app_init_prev(self, root)
    try:
        self.root.title("Social Collector Server — V43 Visible Evidence Audit")
    except Exception:
        pass
    self._v43_audit_done = threading.Event()
    self._v43_audit_result = {}
    self._v43_audit_error = ""
    # The window is already constructed at this point. Prevent collection until
    # the local evidence audit has classified the durable backlog.
    try:
        self.start_btn.config(state="disabled")
    except Exception:
        pass
    for p in UNIFIED_PLATFORMS:
        try:
            self.platform_status_vars[p.key].set("AUDITING DB")
        except Exception:
            pass
    try:
        self.youtube_db_finished_var.set("Auditing YouTube database evidence...")
        self.instagram_db_finished_var.set("Waiting for Instagram database audit...")
        self.tiktok_db_finished_var.set("Waiting for TikTok database audit...")
    except Exception:
        pass
    t = threading.Thread(target=_v43_parent_audit_worker, args=(self,), name="v43-startup-db-audit", daemon=True)
    self._v43_audit_thread = t
    t.start()
    self.root.after(V43_STARTUP_POLL_MS, lambda: _v43_finish_startup_audit_ui(self))


UnifiedApp.__init__ = _v43_app_init


