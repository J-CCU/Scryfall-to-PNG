def youtube_scrape_channel_metadata_v49(
    run_id: int, db: youtube_Database, channel_id: str,
    emit_fn: Optional[Callable[[str], None]] = None,
) -> dict:
    emit = emit_fn or youtube_log
    existing = _v49_channel_row(db, channel_id)
    api_fresh = _v49_channel_api_fresh(existing)

    # Most five-minute rotations need no channel-level network work at all.
    if _v49_channel_metadata_fresh(existing) and api_fresh:
        emit(
            f"  [channel metadata/v49] CACHE HIT | channel={channel_id} | "
            f"About/InnerTube TTL={int(V49_YOUTUBE_CHANNEL_METADATA_TTL_SECONDS)}s | API metrics fresh"
        )
        return _v49_public_channel_dict(existing)

    channel = _v49_channel_metadata_network(run_id, db, channel_id, emit_fn=emit_fn)

    # The base scraper writes public abbreviated metrics. If an official API
    # sample is still fresh, restore it immediately so the canonical channel row
    # cannot regress from e.g. 62,500 to an HTML-derived approximation.
    if api_fresh and existing:
        for key in ("subscribers_text", "subscribers_exact", "total_views_text", "total_views_exact", "video_count_text"):
            if existing.get(key) not in (None, ""):
                channel[key] = existing.get(key)
        db.upsert_channel(channel)
        return channel

    if _v39_api_circuit_open(db) or not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_YOUTUBE_API_KEY:
        return channel

    try:
        data, status, body = youtube_youtube_api_get(
            "channels",
            {"part": "snippet,statistics,contentDetails", "id": channel_id},
            db=db, run_id=run_id, note="channel_metrics_v49_daily",
        )
        if not data:
            return channel
        items = data.get("items") or []
        if not items:
            return channel
        raw_id = db.raw(
            run_id, channel_id=channel_id, video_id=None, source="youtube_api",
            endpoint="channels", status=status, payload=data,
            content_type="application/json", note="channel_metadata_v49_daily",
        )
        api_channel = youtube_parse_channel_data(
            channel_id, None, None, page_html="", ytdlp_info=None, api_item=items[0]
        )
        for key, value in api_channel.items():
            if value not in (None, "", [], {}):
                channel[key] = value
        db.upsert_channel(channel)
        with db.lock:
            db.conn.execute(
                "UPDATE channels SET channel_api_refreshed_at=? WHERE channel_id=?",
                (youtube_now_utc(), channel_id),
            )
            db.conn.commit()
        emit(
            f"  [youtube-api/v49] channel metrics refreshed | channel={channel_id} | "
            f"raw_id={raw_id} | next_due~{V39_CHANNEL_API_REFRESH_HOURS:g}h"
        )
    except Exception as exc:
        emit(
            f"  [youtube-api/v49] channel metrics refresh deferred | channel={channel_id} | "
            f"{type(exc).__name__}: {exc}"
        )
    return channel


