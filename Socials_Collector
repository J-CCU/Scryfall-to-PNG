# ===========================================================================
# V45 — STAGE-AWARE COMPLETION / FINISH-FIRST SCHEDULER
# ===========================================================================
# V44 made work durable, but production telemetry exposed two important facts:
#   1) the old GUI "payload" counter was only a core-storage counter;
#   2) a comment-only RESUME could reopen a DONE heavy job, so the durable queue
#      could report every known video as payload work and waste time replaying
#      already-persisted payloads.
#
# V45 makes stage evidence authoritative. Persisted yt-dlp/InnerTube payload is
# not invalidated by an unrelated last_error or a stale player checkpoint. Work
# enqueue is idempotent: a complete stage stays DONE unless FORCE is explicit.
# Jobs that can finish an item are prioritized ahead of jobs where both stages
# are still missing.
# ===========================================================================
V45_BUILD = "ALL_FIXES_V45_STAGE_AWARE_FINISH_FIRST"
V45_FINISH_PRIORITY_BOOST = 10**12


def _v45_youtube_payload_expr(vi: str = "vi") -> str:
    """Strict persisted payload evidence, tolerant of stale checkpoint labels.

    The stored evidence is authoritative. A successful yt-dlp raw payload means
    an InnerTube player call is not independently required. Existing format or
    caption rows prove those stages even if an old status label was stale.
    """
    return f"""
        {vi}.last_enriched_at IS NOT NULL
        AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id={vi}.video_id)
        AND (
            EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id
                   AND r.source='yt-dlp' AND r.note='video_full_info')
            OR (
                COALESCE({vi}.player_status,'')='SUCCESS'
                AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id AND r.source='InnerTube')
            )
        )
        AND (
            EXISTS(SELECT 1 FROM formats f WHERE f.video_id={vi}.video_id)
            OR COALESCE({vi}.formats_status,'') IN
               ('SUCCESS_EMPTY','SUCCESS_FAST_PATH','SKIPPED_NO_API_KEY','SKIPPED_PERFORMANCE_REFRESH')
        )
        AND (
            EXISTS(SELECT 1 FROM caption_tracks c WHERE c.video_id={vi}.video_id)
            OR COALESCE({vi}.captions_status,'') IN
               ('SUCCESS_EMPTY','SKIPPED_NO_API_KEY','SKIPPED_PERFORMANCE_REFRESH')
        )
    """


# Every V44 bulk audit/bootstrap resolves this global at call time.
_v44_youtube_payload_expr = _v45_youtube_payload_expr


def _v45_normalize_youtube_persisted_stages(db: youtube_Database) -> None:
    """Repair stale stage labels from durable rows without any network calls."""
    now = youtube_now_utc()
    with db.lock:
        # A persisted full yt-dlp payload is stronger evidence than a stale
        # QUEUED/FAILED label from an interrupted earlier run.
        db.conn.execute("""
            UPDATE video_ingestion
            SET yt_dlp_status='SUCCESS'
            WHERE EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=video_ingestion.video_id
                         AND r.source='yt-dlp' AND r.note='video_full_info')
              AND COALESCE(yt_dlp_status,'')<>'SUCCESS'
        """)
        # If yt-dlp supplied the full player payload, the separate InnerTube
        # player stage is intentionally unnecessary.
        db.conn.execute("""
            UPDATE video_ingestion
            SET player_status='SKIPPED_FAST_PATH'
            WHERE EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=video_ingestion.video_id
                         AND r.source='yt-dlp' AND r.note='video_full_info')
              AND COALESCE(player_status,'') NOT IN
                  ('SUCCESS','SKIPPED_NO_API_KEY','SKIPPED_FAST_PATH','SKIPPED_PERFORMANCE_REFRESH')
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET formats_status='SUCCESS'
            WHERE EXISTS(SELECT 1 FROM formats f WHERE f.video_id=video_ingestion.video_id)
              AND COALESCE(formats_status,'')<>'SUCCESS'
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET captions_status='SUCCESS'
            WHERE EXISTS(SELECT 1 FROM caption_tracks c WHERE c.video_id=video_ingestion.video_id)
              AND COALESCE(captions_status,'')<>'SUCCESS'
        """)
        # Old snapshots/raw payloads can predate last_enriched_at. Recover a
        # timestamp from the durable snapshot instead of replaying network work.
        db.conn.execute("""
            UPDATE video_ingestion
            SET last_enriched_at=(SELECT MAX(s.captured_at) FROM video_snapshots s
                                  WHERE s.video_id=video_ingestion.video_id)
            WHERE last_enriched_at IS NULL
              AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id=video_ingestion.video_id)
              AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=video_ingestion.video_id
                         AND (r.source='yt-dlp' OR r.source='InnerTube'))
        """)
        db.conn.commit()


_v45_fast_audit_prev = _v44_fast_audit_youtube

def _v44_fast_audit_youtube(db: youtube_Database) -> dict:
    _v45_normalize_youtube_persisted_stages(db)
