def _v46_pipeline_init(self: V38YouTubePipeline, run_id: int, db: youtube_Database, mode: str, emit: Callable[[str], None]):
    _v46_pipeline_init_prev(self, run_id, db, mode, emit)
    self.v46_comment_fail_streak = 0
    try:
        self.v46_comment_cooldown_until = float(db.get_runtime_state("v46_ytdlp_comment_cooldown_until") or 0)
    except Exception:
        self.v46_comment_cooldown_until = 0.0


V38YouTubePipeline.__init__ = _v46_pipeline_init


def _v46_pipeline_comment_worker(self: V38YouTubePipeline) -> None:
    owner = f"{self.owner_prefix}-comments-{threading.current_thread().name}"
    while not self.closed:
        if self.run_id <= 0:
            self.wake_event.wait(0.25); self.wake_event.clear(); continue
        fallback_mode = not _v46_official_youtube_comments_available(self.db)
        now = time.time()
        if fallback_mode and float(getattr(self, "v46_comment_cooldown_until", 0) or 0) > now:
            self.wake_event.wait(min(5.0, max(0.25, self.v46_comment_cooldown_until - now)))
            self.wake_event.clear()
            continue
        job = _v44_claim_youtube_work(self.db, "comments", owner)
        if not job:
            self.wake_event.wait(0.5); self.wake_event.clear(); continue
        vid = job["video_id"]
        video = self.db.get_video_catalog(vid) or {"video_id": vid}
        try:
            status, count = _v38_collect_comments(self.run_id, self.db, video)
            state = self.db.get_video_sync(vid) or {}
            done = _v38_comments_complete(self.db, state)
            if fallback_mode:
                bad_zero = (not done and int(count or 0) == 0 and str(status or "") in {
                    "PARTIAL", "FAILED", "ERROR", "PENDING_UNVERIFIED_EMPTY", "RATE_LIMITED", "STOPPED"
                })
                if bad_zero:
                    self.v46_comment_fail_streak = int(getattr(self, "v46_comment_fail_streak", 0) or 0) + 1
                    if self.v46_comment_fail_streak >= V46_COMMENT_FALLBACK_FAIL_THRESHOLD:
                        self.v46_comment_fail_streak = 0
                        self.v46_comment_cooldown_until = time.time() + V46_COMMENT_FALLBACK_COOLDOWN_SECONDS
                        self.db.set_runtime_state("v46_ytdlp_comment_cooldown_until", f"{self.v46_comment_cooldown_until:.3f}")
                        self.emit(
                            f"[comments/v46] yt-dlp fallback circuit PAUSED {V46_COMMENT_FALLBACK_COOLDOWN_SECONDS//60}m "
                            "after repeated zero-row partial failures; payload workers keep full request budget"
                        )
                elif done or int(count or 0) > 0:
                    self.v46_comment_fail_streak = 0
            retry = V44_YT_EMPTY_COMMENT_RETRY_SECONDS if status in {
                "PENDING_UNVERIFIED_EMPTY", "DEFERRED_QUOTA", "RATE_LIMITED", "PARTIAL", "STOPPED"
            } else V44_YT_RETRY_BASE_SECONDS
            if fallback_mode and float(getattr(self, "v46_comment_cooldown_until", 0) or 0) > time.time():
                retry = max(retry, self.v46_comment_cooldown_until - time.time())
            _v44_finish_youtube_work(self.db, vid, "comments", done=done, error="" if done else status, retry_after=retry)
            _v38_finalize_video(self.db, vid)
            _v41_refresh_one_completeness(self.db, vid)
            with self.lock:
                self.comment_completed += 1
                if not done and status in {"PENDING_UNVERIFIED_EMPTY", "DEFERRED_QUOTA", "RATE_LIMITED", "PARTIAL", "STOPPED"}:
                    self.comment_deferred += 1
                elif not done:
                    self.comment_failed += 1
        except Exception as exc:
            _v44_finish_youtube_work(
                self.db, vid, "comments", done=False,
                error=f"{type(exc).__name__}: {exc}",
                retry_after=min(3600, V44_YT_RETRY_BASE_SECONDS * max(1, job.get("attempts", 1))),
            )
            with self.lock:
                self.comment_completed += 1
                self.comment_failed += 1
            youtube_log(f"[youtube/v46 comments] ERROR | video={vid} | {type(exc).__name__}: {exc}")


