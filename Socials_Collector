# V16 COMMENT-AWARE COMPLETENESS / DATA EVIDENCE AUDIT
# ============================================================================
# A database row or SUCCESS status is not sufficient evidence that the payload
# actually exists. V16 verifies backing records in snapshots/raw/formats/
# captions/comments before allowing an existing item to be skipped.
# The comments toggle is a collection requirement: turning it ON automatically
# reopens prior records that were collected with comments disabled/skipped or
# whose recorded comment payload is missing.

V16_BUILD = "ALL_FIXES_V17_COMMENTS_TOGGLE_STARTUP_FIX"
