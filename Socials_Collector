def instagram_export_query(db: instagram_Database, query: str, path: Path) -> None:
    with db.lock:
        cur = db.conn.execute(query)
        cols = [d[0] for d in cur.description]
        rows = cur.fetchall()
    with path.open("w", newline="", encoding="utf-8-sig") as f:
        w = csv.writer(f)
        w.writerow(cols)
        for row in rows:
            w.writerow([row[c] for c in cols])


def instagram_export_run_csvs(db: instagram_Database, run_id: int, folder: Path) -> Dict[str, Path]:
    folder.mkdir(parents=True, exist_ok=True)
    outputs = {}
    queries = {
        "accounts.csv": "SELECT * FROM accounts ORDER BY username",
        "account_snapshots.csv": f"SELECT * FROM account_snapshots WHERE scrape_run_id={int(run_id)} ORDER BY id",
        "posts.csv": "SELECT * FROM posts ORDER BY published_epoch DESC",
        "post_snapshots.csv": f"SELECT * FROM post_snapshots WHERE scrape_run_id={int(run_id)} ORDER BY id",
        "post_ingestion.csv": "SELECT * FROM post_ingestion ORDER BY last_discovered_at DESC",
        "sidecar_items.csv": "SELECT * FROM sidecar_items ORDER BY post_id,item_index",
        "comments.csv": "SELECT * FROM comments ORDER BY created_epoch DESC",
        "formats.csv": "SELECT * FROM formats ORDER BY post_id,id",
        "captions.csv": "SELECT * FROM captions ORDER BY post_id,id",
        "account_inputs.csv": f"SELECT * FROM account_inputs WHERE scrape_run_id={int(run_id)} ORDER BY id",
        "errors.csv": f"SELECT * FROM errors WHERE scrape_run_id={int(run_id)} ORDER BY id",
        "raw_data_manifest.csv": f"SELECT id,scrape_run_id,account_id,post_id,source,data_type,sha256,captured_at,length(content_gzip) AS gzip_bytes FROM raw_data WHERE scrape_run_id={int(run_id)} ORDER BY id",
        "surface_items.csv": "SELECT * FROM surface_items ORDER BY last_seen_at DESC",
        "surface_snapshots.csv": f"SELECT * FROM surface_snapshots WHERE scrape_run_id={int(run_id)} ORDER BY id",
    }
    for name, q in queries.items():
        path = folder / name
        instagram_export_query(db, q, path)
        outputs[name] = path
    return outputs


