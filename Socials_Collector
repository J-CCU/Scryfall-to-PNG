def _v53_tiktok_reason_counts(path: Path = tiktok_DB_PATH) -> dict:
    out = {
        "limited_reason_counts": {},
        "catalog_limited_reason_counts": {},
        "limited_retry_due": 0,
        "catalog_retry_due": 0,
        "impersonation_available": _v53_tiktok_impersonation_available(),
    }
    conn = _v46_open_readonly(Path(path))
    if conn is None:
        return out
    try:
        vcols = {r[1] for r in conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        acols = {r[1] for r in conn.execute("PRAGMA table_info(accounts)").fetchall()}
        now = time.time()
        if {"access_state", "access_reason"}.issubset(vcols):
            rows = conn.execute(
                """SELECT COALESCE(NULLIF(access_reason,''),'UNKNOWN') AS reason, COUNT(*)
                   FROM video_ingestion
                   WHERE access_state='COMPLETE_LIMITED'
                   GROUP BY COALESCE(NULLIF(access_reason,''),'UNKNOWN')
                   ORDER BY COUNT(*) DESC, reason"""
            ).fetchall()
            out["limited_reason_counts"] = {str(r[0]): int(r[1] or 0) for r in rows}
        if "access_retry_after" in vcols:
            out["limited_retry_due"] = int(_v46_scalar(
                conn,
                "SELECT COUNT(*) FROM video_ingestion WHERE access_state='COMPLETE_LIMITED' AND COALESCE(access_retry_after,0)<=?",
                (now,),
            ) or 0)
        if {"catalog_access_status", "catalog_access_reason"}.issubset(acols):
            rows = conn.execute(
                """SELECT COALESCE(NULLIF(catalog_access_reason,''),'UNKNOWN') AS reason, COUNT(*)
                   FROM accounts
                   WHERE catalog_access_status='LIMITED'
                   GROUP BY COALESCE(NULLIF(catalog_access_reason,''),'UNKNOWN')
                   ORDER BY COUNT(*) DESC, reason"""
            ).fetchall()
            out["catalog_limited_reason_counts"] = {str(r[0]): int(r[1] or 0) for r in rows}
        if "catalog_retry_after" in acols:
            out["catalog_retry_due"] = int(_v46_scalar(
                conn,
                "SELECT COUNT(*) FROM accounts WHERE catalog_access_status='LIMITED' AND COALESCE(catalog_retry_after,0)<=?",
                (now,),
            ) or 0)
        return out
    finally:
        conn.close()


