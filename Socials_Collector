# ===========================================================================
# V35 — Lean YouTube DB-first completion + comment isolation
# ===========================================================================
# Production behavior after V34 showed that YouTube was healthy but doing too
# much work: the unified comments toggle could silently turn YouTube comments
# back ON, and comment/audit-era checkpoints kept feeding a 50-video historical
# backlog. V35 makes the intended server policy explicit:
#   * YouTube comments are OFF regardless of the Instagram/TikTok comment toggle;
#   * stale/comment-only YouTube checkpoint failures are repaired from persisted
#     payload evidence without network calls;
#   * a yt-dlp FAILED_EMPTY item is terminal when InnerTube successfully supplied
#     the player payload and the normalized Maximum-mode evidence is complete;
#   * only 5 genuinely incomplete historical videos are repaired per channel/pass;
#   * recent discovery remains 25, so the worker keeps moving across channels.
V35_BUILD = "ALL_FIXES_V35_YOUTUBE_LEAN_DB_FIRST"

# Bounded repair work. New/recent records are still discovered normally.
youtube_BACKLOG_ENRICHMENT_BATCH = 5


def _v35_youtube_payload_complete(db: "youtube_Database", state: Optional[dict], mode: str = "Maximum") -> bool:
    """Prove the useful YouTube payload is complete without making comments mandatory.

    Standard path: successful yt-dlp payload + snapshot.
    Fallback path: yt-dlp returned no usable info, but InnerTube player succeeded
    and its raw payload + snapshot were persisted. RATE_LIMITED/STOPPED/NOT_FETCHED
    never qualify, so retryable failures remain retryable.
    """
    if not state or not state.get("last_enriched_at"):
        return False
    d = dict(state)
    vid = str(d.get("video_id") or "")
    if not vid:
        return False

    yt_status = str(d.get("yt_dlp_status") or "")
    player_status = str(d.get("player_status") or "")
    player_terminal = {
        "SUCCESS", "SKIPPED_NO_API_KEY", "SKIPPED_FAST_PATH", "SKIPPED_PERFORMANCE_REFRESH"
    }
    if player_status not in player_terminal:
        return False

    with db.lock:
        if v16__count(db.conn, "SELECT COUNT(*) FROM video_snapshots WHERE video_id=?", (vid,)) < 1:
            return False

        if yt_status == "SUCCESS":
            if v16__count(
                db.conn,
                "SELECT COUNT(*) FROM raw_data WHERE video_id=? AND source='yt-dlp' AND note='video_full_info'",
                (vid,),
            ) < 1:
                return False
        elif yt_status == "FAILED_EMPTY" and player_status == "SUCCESS":
            # A known unavailable/empty yt-dlp extraction should not loop forever
            # when InnerTube already gave us a successful player payload.
            if v16__count(
                db.conn,
                "SELECT COUNT(*) FROM raw_data WHERE video_id=? AND source='InnerTube'",
                (vid,),
            ) < 1:
                return False
        else:
            # RATE_LIMITED, STOPPED, FAILED, NOT_FETCHED, etc. remain repairable.
            return False

        if mode == "Maximum":
            fs = str(d.get("formats_status") or "")
            if fs not in {
                "SUCCESS", "SUCCESS_EMPTY", "SUCCESS_FAST_PATH",
                "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"
            }:
                return False
            if fs == "SUCCESS" and v16__count(
                db.conn, "SELECT COUNT(*) FROM formats WHERE video_id=?", (vid,)
            ) < 1:
                return False

            cs = str(d.get("captions_status") or "")
            if cs not in {
                "SUCCESS", "SUCCESS_EMPTY", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"
            }:
                return False
            if cs == "SUCCESS" and v16__count(
                db.conn, "SELECT COUNT(*) FROM caption_tracks WHERE video_id=?", (vid,)
            ) < 1:
                return False

    return True


def _v35_youtube_complete(db: "youtube_Database", state: Optional[dict], mode: str = "Maximum") -> bool:
    if not _v35_youtube_payload_complete(db, state, mode):
        return False
    return str((state or {}).get("enrichment_state") or "").upper() == "COMPLETE"


# V32's finalizer and the active V31 action selector resolve this name at runtime.
# Point it at the V35 proof so successful fallback videos become COMPLETE in the
# same pass instead of waiting for a future repair run.
