                f"catalogs={c.get('catalogs_verified',0)}/{c.get('catalogs_total',0)} | reclassified={c.get('reclassified',0)}",
                flush=True,
            )
        finally:
            db.close()
    if key in {"", "tiktok"}:
        db = tiktok_Database(tiktok_DB_PATH)
        try:
            out["tiktok"] = _v42_audit_tiktok(db)
            c = out["tiktok"]
            print(
                f"[pre-main/v42] TikTok | finished={c.get('complete',0)}/{c.get('items',0)} | "
                f"payload={c.get('payload',0)} | comments collected={c.get('comments_collected',0)} "
