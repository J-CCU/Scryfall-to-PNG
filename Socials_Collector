def v39__youtube_run(self, *args, **kwargs):
    mode = str(kwargs.get("mode") or (args[2] if len(args) > 2 else "Maximum"))
    before = _v39_database_completeness_audit(self.db, mode)
    self.emit(
        f"[youtube/v39] PRE-RUN DB AUDIT | videos={before['videos']} complete={before['complete']} "
        f"pending={before['pending']} catalog_unverified={before['catalog_unverified']} "
        f"quota_deferred={before['deferred_quota']} api_circuit={'OPEN' if before['api_circuit_open'] else 'CLOSED'}"
    )
    run_id = int(_v39_youtube_run_prev(self, *args, **kwargs) or 0)
    after = _v39_database_completeness_audit(self.db, mode)
    self.emit(
        f"[youtube/v39] POST-RUN DB AUDIT | videos={after['videos']} complete={after['complete']} "
        f"pending={after['pending']} | missing_payload={after['missing_payload']} "
        f"missing_comments={after['missing_comments']} missing_both={after['missing_payload_comments']} | "
        f"catalog_unverified={after['catalog_unverified']} quota_deferred={after['deferred_quota']}"
    )
    if run_id and not youtube_stop_requested():
        with self.db.lock:
            row = self.db.conn.execute(
                "SELECT COALESCE(notes,'') FROM scrape_runs WHERE id=?", (run_id,)
            ).fetchone()
        notes = str(row[0] or "") if row else ""
        if after["api_circuit_open"] and after["deferred_quota"]:
            status = "PENDING_QUOTA_REPAIR"
        elif after["catalog_unverified"]:
            status = "PENDING_CATALOG_VERIFY"
        elif after["pending"]:
            status = "PENDING_REPAIR"
        else:
            status = "COMPLETED"
        v39_note = (
            f"v39_db_complete={after['complete']}/{after['videos']} "
            f"v39_pending={after['pending']} v39_catalog_unverified={after['catalog_unverified']} "
            f"v39_quota_deferred={after['deferred_quota']}"
        )
        self.db.finish_run(run_id, status, (notes + " | " + v39_note).strip(" |"))
        self.emit(f"[youtube/v39] durable run status={status} | {v39_note}")
    return run_id


