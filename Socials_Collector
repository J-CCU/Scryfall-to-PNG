def _v51_migrate_tiktok(db: tiktok_Database) -> None:
    _v42_migrate_tiktok(db)
    with db.lock:
        vcols = {r[1] for r in db.conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        for name, definition in {
            "access_state": "TEXT",
            "access_reason": "TEXT",
            "access_retry_after": "REAL",
            "limited_completed_at": "TEXT",
        }.items():
            if name not in vcols:
                db.conn.execute(f"ALTER TABLE video_ingestion ADD COLUMN {name} {definition}")
        acols = {r[1] for r in db.conn.execute("PRAGMA table_info(accounts)").fetchall()}
        for name, definition in {
            "catalog_access_status": "TEXT",
            "catalog_access_reason": "TEXT",
            "catalog_retry_after": "REAL",
            "catalog_limited_at": "TEXT",
        }.items():
            if name not in acols:
                db.conn.execute(f"ALTER TABLE accounts ADD COLUMN {name} {definition}")
        db.conn.execute("CREATE INDEX IF NOT EXISTS idx_v51_tt_access_retry ON video_ingestion(access_state,access_retry_after,account_id)")
        db.conn.execute("CREATE INDEX IF NOT EXISTS idx_v51_tt_catalog_retry ON accounts(catalog_access_status,catalog_retry_after)")
        db.conn.commit()


def _v51_tt_error_category(text: Any) -> str:
    s = str(text or "").lower()
    if not s:
        return ""
    if "no video formats found" in s or "no formats found" in s:
        return "NO_FORMATS"
    if "ip address is blocked" in s or "blocked from accessing this post" in s:
        return "IP_BLOCKED"
    if any(x in s for x in (
        "video is unavailable", "this video is unavailable", "post is unavailable",
        "private video", "video is private", "has been removed", "video has been removed",
        "deleted", "does not exist", "not available in your region",
    )):
        return "UNAVAILABLE"
    return ""


def _v51_tt_listing_row(db: tiktok_Database, video_id: str) -> dict:
    with db.lock:
