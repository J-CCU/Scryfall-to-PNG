    def upsert_video_listing(self, v: dict) -> None:
        """Persist discovery/catalog metadata without erasing richer existing data."""
        vid = v.get("video_id")
        if not vid:
            return
        fields = [
            "channel_id", "title", "description", "published_text", "upload_date",
            "timestamp", "duration_seconds", "view_count", "like_count", "comment_count",
            "channel_name", "uploader_id", "category", "language", "availability",
            "age_limit", "live_status", "is_live", "is_short", "is_premiere",
            "is_family_safe", "is_monetized", "has_paid_promotion", "is_premium_content",
            "thumbnail_url", "webpage_url",
        ]
        values = [v.get(k) for k in fields]
        # Text fields: replace only when the discovered value is non-empty.
        text_fields = {
            "channel_id", "title", "description", "published_text", "upload_date",
            "channel_name", "uploader_id", "category", "language", "availability",
            "live_status", "thumbnail_url", "webpage_url",
        }
        assignments = []
        for k in fields:
            if k in text_fields:
                assignments.append(f"{k}=CASE WHEN excluded.{k} IS NOT NULL AND excluded.{k} <> '' THEN excluded.{k} ELSE videos.{k} END")
            else:
                assignments.append(f"{k}=COALESCE(excluded.{k}, videos.{k})")
        assignments.append("updated_at=excluded.updated_at")
        with self.lock:
            self.conn.execute(
                f"""
                INSERT INTO videos (video_id, {', '.join(fields)}, updated_at)
                VALUES (?, {', '.join(['?'] * len(fields))}, ?)
                ON CONFLICT(video_id) DO UPDATE SET
                    {', '.join(assignments)}
                """,
                [vid, *values, youtube_now_utc()],
            )
            self.conn.commit()

    def list_video_backlog(self, channel_id: str, mode: str, limit: int) -> list:
        """Return older cataloged videos that are not complete for the requested mode."""
        if limit <= 0:
            return []
        with self.lock:
            cur = self.conn.execute(
                """
                SELECT v.*
                FROM videos v
                JOIN video_ingestion vi ON vi.video_id=v.video_id
                WHERE v.channel_id=?
                ORDER BY COALESCE(v.timestamp, 0) ASC, v.video_id
                """,
                (channel_id,),
            )
            cols = [d[0] for d in cur.description]
            candidates = [dict(zip(cols, r)) for r in cur.fetchall()]
        backlog = []
        for v in candidates:
            state = self.get_video_sync(v["video_id"])
            if not youtube_state_is_complete(state, mode):
                backlog.append(v)
                if len(backlog) >= limit:
                    break
        return backlog

    def register_video_discovery(self, run_id: int, video: dict) -> str:
        video_id = video.get("video_id")
        if not video_id:
            return "NO_ID"
        now = youtube_now_utc()
        channel_id = video.get("channel_id", "")
        with self.lock:
            existed = self.conn.execute(
                "SELECT 1 FROM video_ingestion WHERE video_id=?", (video_id,)
            ).fetchone() is not None
            self.conn.execute(
                """
                INSERT INTO video_ingestion
                (video_id, channel_id, first_seen_at, last_discovered_at,
                 discovery_count, last_run_id)
                VALUES (?, ?, ?, ?, 1, ?)
                ON CONFLICT(video_id) DO UPDATE SET
                    channel_id=COALESCE(NULLIF(excluded.channel_id, ''), video_ingestion.channel_id),
                    last_discovered_at=excluded.last_discovered_at,
                    discovery_count=COALESCE(video_ingestion.discovery_count, 0) + 1,
                    last_run_id=excluded.last_run_id
                """,
                (video_id, channel_id, now, now, run_id),
            )
            self.conn.commit()
        # Persist the catalog row immediately so stopped/rate-limited runs retain
        # the complete discovered catalog and can resume enrichment later.
        self.upsert_video_listing(video)
        return "UPDATE" if existed else "INSERT"

    def mark_video_enrichment(
        self,
        run_id: int,
        video: dict,
        *,
        full: bool,
        heavy: bool = False,
        error: str = "",
    ) -> None:
        video_id = video.get("video_id")
        if not video_id:
            return
        now = youtube_now_utc()
        with self.lock:
            # Ensure the row exists even if this is the first time a video was
            # seen through an older database or a partially completed run.
            self.conn.execute(
                """
                INSERT OR IGNORE INTO video_ingestion
                (video_id, channel_id, first_seen_at, last_discovered_at, discovery_count)
                VALUES (?, ?, ?, ?, 0)
                """,
                (video_id, video.get("channel_id", ""), now, now),
            )
            self.conn.execute(
                """
                UPDATE video_ingestion
                SET channel_id=?,
                    last_enriched_at=CASE WHEN ? THEN ? ELSE last_enriched_at END,
                    last_performance_refresh_at=?,
                    last_heavy_refresh_at=CASE WHEN ? THEN ? ELSE last_heavy_refresh_at END,
                    yt_dlp_status=?,
                    player_status=?,
                    comments_status=CASE WHEN ? THEN COALESCE(comments_status, 'UNKNOWN') ELSE comments_status END,
                    captions_status=CASE WHEN ? THEN COALESCE(captions_status, 'UNKNOWN') ELSE captions_status END,
                    formats_status=CASE WHEN ? THEN COALESCE(formats_status, 'UNKNOWN') ELSE formats_status END,
                    enrichment_attempts=COALESCE(enrichment_attempts,0)+1,
                    last_run_id=?,
                    last_error=?
                WHERE video_id=?
                """,
                (
                    video.get("channel_id", ""),
                    1 if full else 0, now, now,
                    1 if heavy else 0, now,
                    video.get("yt_dlp_status", ""), video.get("player_status", ""),
                    1 if full and heavy else 0,
                    1 if full and heavy else 0,
                    1 if full and heavy else 0,
                    run_id, error, video_id,
                ),
            )
            self.conn.commit()

