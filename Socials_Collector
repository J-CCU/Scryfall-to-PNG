def _v51_tt_discover(self: tiktok_Collector, run_id: int, account: dict, limit: int, mode: str, force_refresh: bool = False):
    aid = str(account.get("account_id") or "")
    requested = int(limit or 0)
    if requested > 0:
        return _v42_tt_discover_source(self, run_id, account, limit, mode, force_refresh)

    state = _v51_tt_catalog_state(self.db, aid)
    verified = bool(
        str(state.get("index_complete") or "").upper() == "YES"
        and str(state.get("catalog_verification_version") or "") == V42_CATALOG_PROOF_VERSION
        and (_v29_hours(state.get("catalog_verified_at")) is not None)
        and (_v29_hours(state.get("catalog_verified_at")) < V42_CATALOG_REVERIFY_HOURS)
    )
    limited = str(state.get("catalog_access_status") or "").upper() == "LIMITED"
    try:
        catalog_retry = float(state.get("catalog_retry_after") or 0)
    except Exception:
        catalog_retry = 0.0

    if not force_refresh and (verified or (limited and catalog_retry > time.time())):
        if not _v51_tt_recent_discovery_due(self.db, aid):
            label = "verified" if verified else "limited"
            self.emit(
                f"  [catalog/v51] TikTok recent discovery CACHE HIT | state={label} | "
                f"TTL={int(V51_TIKTOK_RECENT_DISCOVERY_TTL_SECONDS)}s"
            )
            return [], bool(verified)
        rows, _ = _v42_tt_discover_source(self, run_id, account, tiktok_INCREMENTAL_DISCOVERY_WINDOW, mode, False)
        _v51_tt_note_recent_discovery(self.db, aid)
        if verified:
            self.emit(f"  [catalog/v51] TikTok historical proof current | recent_window={tiktok_INCREMENTAL_DISCOVERY_WINDOW}")
            return rows, True
        self.emit(
            f"  [catalog/v51] TikTok catalog LIMITED; recent discovery kept active | "
            f"recent_window={tiktok_INCREMENTAL_DISCOVERY_WINDOW} | full retry deferred"
        )
        return rows, False

    self.emit("  [catalog/v51] TikTok full accessible catalog verification START")
    rows, complete = _v42_tt_discover_source(self, run_id, account, 0, mode, force_refresh)
    _v51_tt_note_recent_discovery(self.db, aid)
    if complete:
        _v51_tt_clear_catalog_limited(self.db, aid)
        with _V44_TT_FULL_PROOFS_LOCK:
            _V44_TT_FULL_PROOFS.add(aid)
        self.emit(f"  [catalog/v51] TikTok FULL proof captured | videos={len(rows)}")
        return rows, True
    if rows:
        _v51_tt_mark_catalog_limited(self.db, aid, "FULL_TRAVERSAL_UNAVAILABLE_PUBLIC_FALLBACK")
        self.emit(
            f"  [catalog/v51] TikTok catalog LIMITED | public recent evidence={len(rows)} | "
            f"full-history retry in {int(V51_TIKTOK_CATALOG_LIMITED_RETRY_SECONDS//86400)}d"
        )
    return rows, False


