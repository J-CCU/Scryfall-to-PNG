def v52_instagram_get_backlog(self: instagram_Database, account_id: str, limit: int) -> List[dict]:
    _v52_migrate_instagram(self)
    now = time.time()
    effective_limit = int(limit)
    if _v52_public_backoff_until(self) > now:
        effective_limit = min(effective_limit, V52_IG_OFFLINE_BACKLOG_BATCH)
    with self.lock:
        rows = self.conn.execute(
            """SELECT p.*,i.* FROM posts p JOIN post_ingestion i ON i.post_id=p.post_id
               WHERE p.account_id=? AND (
                   COALESCE(i.completeness_audit_status,'')<>'COMPLETE' OR
                   COALESCE(i.enrichment_state,'')<>'COMPLETE' OR COALESCE(i.last_error,'')<>''
               )
               AND NOT (
                   COALESCE(i.completeness_audit_status,'')='MISSING_COMMENTS'
                   AND COALESCE(i.comments_status,'')='DEFERRED_PUBLIC_ACCESS'
                   AND COALESCE(i.comments_retry_after,0)>?
               )
               AND NOT (
                   COALESCE(i.completeness_audit_status,'') IN ('MISSING_PAYLOAD','MISSING_PAYLOAD_COMMENTS')
                   AND COALESCE(i.payload_retry_after,0)>?
               )
               ORDER BY
                 CASE COALESCE(i.completeness_audit_status,'')
                   WHEN 'MISSING_PAYLOAD' THEN 0
                   WHEN 'MISSING_PAYLOAD_COMMENTS' THEN 0
                   WHEN 'MISSING_COMMENTS' THEN 1
                   ELSE 2
                 END,
                 COALESCE(p.published_epoch,0) DESC
               LIMIT ?""",
            (str(account_id), now, now, max(0, effective_limit)),
        ).fetchall()
    return [dict(r) for r in rows]

