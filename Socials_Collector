        with self.lock:
            self.conn.commit()
            self.conn.close()

    def begin_run(self, mode: str, limit: int, inputs: list) -> int:
        with self.lock:
            cur = self.conn.execute(
                "INSERT INTO scrape_runs(started_at,status,mode,video_limit,input_json) VALUES(?,?,?,?,?)",
                (tiktok_now_utc(), "RUNNING", mode, limit, json.dumps(inputs, ensure_ascii=False)),
            )
            self.conn.commit()
            return int(cur.lastrowid)

