def tiktok_worker_main(job_file: str) -> int:
    print(f"[worker] process started | pid={os.getpid()} | python={sys.executable}", flush=True)
    job_path = Path(job_file)
    print(f"[worker] job={job_path}", flush=True)
    try:
        job = json.loads(job_path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"[worker] could not read job file: {type(exc).__name__}: {exc}", flush=True)
        return 2

    print("[worker] opening database...", flush=True)
    db = tiktok_Database(tiktok_DB_PATH)
    try:
        print("[worker] database opened", flush=True)
        tiktok_load_cookies()
        print(f"[worker] yt-dlp={'available' if tiktok_yt_dlp else 'MISSING'}", flush=True)
        if tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN or (tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET):
            print("[worker] TikTok Research API credentials configured (approved access required)", flush=True)
        else:
            print("[worker] TikTok Research API credentials not configured; public yt-dlp/page collection only", flush=True)
        collector = tiktok_Collector(
            db,
            progress_callback=lambda current, total, phase: print(f"[PROGRESS]|{current}|{total}|{phase}", flush=True),
        )
        print("[worker] starting Collector.run()...", flush=True)
        run_id = collector.run(
            job.get("inputs") or [],
            int(job.get("limit", tiktok_DEFAULT_LIMIT)),
            str(job.get("mode", "Maximum")),
            bool(job.get("force_refresh", False)),
        )
        print(f"[worker] finished run_id={run_id}", flush=True)
        return 0
    except Exception as exc:
        print(f"[worker] FATAL: {type(exc).__name__}: {exc}", flush=True)
        print(traceback.format_exc(), flush=True)
        return 1
    finally:
        try:
            db.close()
        except Exception:
            pass



