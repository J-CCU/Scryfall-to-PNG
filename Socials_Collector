def tiktok_resolve_account_v55(username: str, db: tiktok_Database, *, mode: str, force_refresh: bool = False) -> Optional[dict]:
    uname = tiktok_normalized_username(username)
    result = _v55_resolve_prev(uname, db, mode=mode, force_refresh=force_refresh)
    key = _v55_profile_limited_key(uname)
    if result:
        db.set_runtime_state(key, "")
        return result
    if not uname or tiktok_tiktok_rate_limited():
        return result
    # The current failure is recorded in account_inputs immediately after this
    # function returns, so one historical failure means this is at least the
    # second independent public resolution failure.
    prior = _v55_historical_unresolved_count(db, uname)
    if prior >= 1:
        reason = "PROFILE_PUBLIC_RESOLUTION_UNAVAILABLE"
        db.set_runtime_state(key, reason)
        db.set_runtime_state(
            f"v51_tiktok_resolve_retry_after:{uname.lower()}",
            str(time.time() + V55_TIKTOK_PROFILE_LIMITED_RETRY_SECONDS),
        )
        tiktok_log(
            f"[resolve/v55] @{uname} PROFILE_ACCESS_LIMITED | repeated public resolution failure | "
            f"terminal for this pass; retry in {int(V55_TIKTOK_PROFILE_LIMITED_RETRY_SECONDS//86400)}d"
        )
    return result


