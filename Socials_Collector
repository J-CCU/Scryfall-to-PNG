def _v47_tt_enrich(self: tiktok_Collector, run_id: int, video: dict, mode: str, action: str) -> None:
    if action != "BUSINESS_COMMENT_REPAIR":
        return _v47_tt_enrich_prev(self, run_id, video, mode, action)
    vid = str(video.get("video_id") or "")
    try:
        inserted, _ = _v47_collect_business_comments(self.db, run_id, video)
        complete = _v47_refresh_tt_audit(self.db, vid)
        self.emit(f"      [comments/v47] TikTok Business owned comments COMPLETE | video={vid} | rows={inserted} | complete={'yes' if complete else 'no'}")
    except PermissionError as exc:
        self.db.mark_stage(vid, "comments", "DEFERRED_BUSINESS_API_AUTH")
        _v42_set_comment_evidence(self.db, "video_ingestion", "video_id", vid, "BUSINESS_API_AUTH_REQUIRED", "TikTok Business Accounts API")
        _v47_refresh_tt_audit(self.db, vid)
        self.emit(f"      [comments/v47] TikTok Business auth deferred | video={vid} | {exc}")
    except Exception as exc:
        status = "DEFERRED_BUSINESS_API_RATE_LIMIT" if "rate limit" in str(exc).lower() else "FAILED_BUSINESS_API"
        self.db.mark_stage(vid, "comments", status, str(exc))
        _v42_set_comment_evidence(self.db, "video_ingestion", "video_id", vid, status, "TikTok Business Accounts API")
        self.db.record_error(run_id, account_id=str(video.get("account_id") or ""), video_id=vid, stage="business_comments_v47", exc=exc)
        _v47_refresh_tt_audit(self.db, vid)
        self.emit(f"      [comments/v47] TikTok Business comments ERROR | video={vid} | {type(exc).__name__}: {exc}")


tiktok_Collector.enrich_video = _v47_tt_enrich


def _v47_tt_backlog(self: tiktok_Database, account_id: str, limit: int = V42_REPAIR_ALL_LIMIT) -> List[dict]:
    _v42_migrate_tiktok(self)
    with self.lock:
        rows = self.conn.execute(
            """SELECT v.*,i.* FROM videos v JOIN video_ingestion i ON i.video_id=v.video_id
               WHERE v.account_id=? AND (
                   COALESCE(i.completeness_audit_status,'')<>'COMPLETE'
                   OR COALESCE(i.enrichment_state,'')<>'COMPLETE'
                   OR COALESCE(i.last_error,'')<>''
               ) ORDER BY COALESCE(v.timestamp,0) DESC LIMIT ?""",
            (account_id, max(0, int(limit))),
        ).fetchall()
    return [dict(r) for r in rows]


