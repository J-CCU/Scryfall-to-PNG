# RATE LIMIT / RETRY
# ============================================================================


def tiktok_is_tiktok_rate_limit_text(text: str) -> bool:
    """Return True only for explicit TikTok throttle/rate-limit evidence.

    IMPORTANT: never treat a bare substring such as ``429`` as a throttle signal.
    TikTok video IDs are long numeric values and can legitimately contain 429.
    """
    lowered = str(text or "").lower()
    if not lowered:
        return False
    explicit_429 = bool(re.search(r"\b(?:http(?:\s+error)?\s*)?429\s+(?:too\s+many\s+requests|requests?)\b", lowered))
    explicit_429_status = bool(re.search(r"\b(?:http\s+)?status(?:[_ ]code)?\s*[:=]?\s*429\b", lowered))
    if explicit_429 or explicit_429_status:
        return True
    return any(
        phrase in lowered
        for phrase in (
            "too many requests",
            "rate limit",
            "rate-limited",
            "request frequency",
            "requests are too frequent",
            "temporarily blocked",
            "please wait",
            "try again later",
            "unusual activity",
        )
    )


def tiktok_is_tiktok_page_throttle(page: str, status: int = 200) -> bool:
    """Detect an actual TikTok throttle/challenge in rendered page text.

    TikTok profile HTML contains JavaScript bundles and serialized application
    state that can legitimately contain phrases such as ``rate limit`` or
    ``temporarily blocked``. Scanning the entire HTML source therefore produces
    false positives on ordinary HTTP 200 profile pages.

    This helper strips script/style blocks and tags first, then checks only the
    user-facing text plus explicit HTTP 429.
    """
    if int(status or 0) == 429:
        return True
    raw = str(page or "")
    if not raw:
        return False
    visible = re.sub(r"<script\b[^>]*>.*?</script>", " ", raw, flags=re.I | re.S)
    visible = re.sub(r"<style\b[^>]*>.*?</style>", " ", visible, flags=re.I | re.S)
    visible = re.sub(r"<noscript\b[^>]*>.*?</noscript>", " ", visible, flags=re.I | re.S)
    visible = re.sub(r"<[^>]+>", " ", visible)
    visible = html.unescape(visible)
    visible = re.sub(r"\s+", " ", visible).strip()
    return tiktok_is_tiktok_rate_limit_text(visible) or tiktok_is_challenge_text(visible)


def tiktok_is_challenge_text(text: str) -> bool:
    lowered = str(text or "").lower()
    return any(
        token in lowered
        for token in ("captcha", "verify you are human", "challenge", "verification required", "robot")
    )


def tiktok_set_tiktok_rate_limit(db: Optional["Database"] = None, *, reason: str = "", pending_video_id: str = "", pending_account_id: str = "") -> None:
    global tiktok_TIKTOK_RATE_LIMITED_UNTIL, tiktok_TIKTOK_RATE_LIMIT_COOLDOWN, tiktok_RATE_LIMIT_EVENTS, tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER, tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF
    now = time.time()
    with tiktok_RATE_LIMIT_LOCK:
        active = tiktok_TIKTOK_RATE_LIMITED_UNTIL > now
        if not active:
            tiktok_RATE_LIMIT_EVENTS += 1
            tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER = min(4.0, max(1.5, tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER * 1.5))
            tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF = 0
            cooldown = tiktok_TIKTOK_RATE_LIMIT_COOLDOWN
            tiktok_TIKTOK_RATE_LIMITED_UNTIL = now + cooldown
            tiktok_TIKTOK_RATE_LIMIT_COOLDOWN = min(tiktok_TIKTOK_RATE_LIMIT_COOLDOWN * 2, tiktok_TIKTOK_RATE_LIMIT_MAX_COOLDOWN)
        remaining = max(0, int(tiktok_TIKTOK_RATE_LIMITED_UNTIL - now))

    if db is not None:
        try:
            db.set_runtime_state("tiktok_rate_limited_until", str(tiktok_TIKTOK_RATE_LIMITED_UNTIL))
            db.set_runtime_state("tiktok_rate_limit_reason", reason or "rate limit")
            if pending_video_id:
                db.set_runtime_state("tiktok_rate_limit_pending_video_id", pending_video_id)
            if pending_account_id:
                db.set_runtime_state("tiktok_rate_limit_pending_account_id", pending_account_id)
        except Exception:
            pass

    tiktok_log(
        f"[throttle] TikTok rate limit detected | cooldown={remaining//60}m {remaining%60}s | "
        f"pending_video={pending_video_id or 'none'} | reason={reason or 'rate limit'}"
    )


def tiktok_load_tiktok_rate_limit(db: Optional["Database"] = None) -> None:
    global tiktok_TIKTOK_RATE_LIMITED_UNTIL
    if db is None:
        return
    try:
        value = db.get_runtime_state("tiktok_rate_limited_until")
        until = float(value) if value else 0.0
        reason = str(db.get_runtime_state("tiktok_rate_limit_reason") or "")
        # v11 had a false-positive path where the bare substring ``429`` inside
        # a numeric TikTok video id could mark a successful extraction as throttled.
        # Discard only that known malformed persisted state; genuine throttle
        # reasons remain intact.
        if re.match(r"^\s*\[TikTok\]\s*Extracting URL\s*:", reason, re.I):
            db.set_runtime_state("tiktok_rate_limited_until", "")
            db.set_runtime_state("tiktok_rate_limit_reason", "")
            db.set_runtime_state("tiktok_rate_limit_pending_video_id", "")
            db.set_runtime_state("tiktok_rate_limit_pending_account_id", "")
            until = 0.0
            tiktok_log("[throttle] cleared stale v11 TikTok false-positive cooldown state")
        with tiktok_RATE_LIMIT_LOCK:
            tiktok_TIKTOK_RATE_LIMITED_UNTIL = max(tiktok_TIKTOK_RATE_LIMITED_UNTIL, until)
    except Exception:
        pass


def tiktok_tiktok_rate_limited() -> bool:
    with tiktok_RATE_LIMIT_LOCK:
        return time.time() < tiktok_TIKTOK_RATE_LIMITED_UNTIL


def tiktok_rate_limit_remaining() -> int:
    with tiktok_RATE_LIMIT_LOCK:
        return max(0, int(tiktok_TIKTOK_RATE_LIMITED_UNTIL - time.time()))


def tiktok_clear_tiktok_rate_limit(db: Optional["Database"] = None) -> None:
    global tiktok_TIKTOK_RATE_LIMITED_UNTIL
    with tiktok_RATE_LIMIT_LOCK:
        tiktok_TIKTOK_RATE_LIMITED_UNTIL = 0.0
    if db is not None:
        for key in (
            "tiktok_rate_limited_until",
            "tiktok_rate_limit_reason",
            "tiktok_rate_limit_pending_video_id",
            "tiktok_rate_limit_pending_account_id",
        ):
            try:
                db.set_runtime_state(key, "")
            except Exception:
                pass


def tiktok_wait_for_tiktok_cooldown(db: Optional["Database"] = None, pending_video_id: str = "") -> bool:
    if tiktok_ORCHESTRATED_RUN and tiktok_tiktok_rate_limited():
        tiktok_log(
            f"[orchestrator] TikTok throttle detected; returning control to multi-platform scheduler "
            f"| retry_video={pending_video_id or 'none'}"
        )
        return False
    while tiktok_tiktok_rate_limited():
        if tiktok_stop_requested():
            return False
        remaining = tiktok_rate_limit_remaining()
        mins, secs = divmod(remaining, 60)
        tiktok_log(
            f"[throttle] cooldown active | remaining={mins}m {secs}s | "
            f"retry_video={pending_video_id or 'none'} | committed DB data preserved"
        )
        if tiktok_STOP_EVENT.wait(min(float(remaining), tiktok_TIKTOK_RATE_LIMIT_LOG_INTERVAL)):
            return False
    tiktok_clear_tiktok_rate_limit(db)
    tiktok_log("[throttle] TikTok cooldown expired | requests can resume")
    return True


def tiktok_min_interval_for_mode(mode: str) -> float:
    return float(tiktok_TIKTOK_MIN_INTERVAL_BY_MODE.get(mode, tiktok_TIKTOK_MIN_INTERVAL_BY_MODE["Full"]))


def tiktok_policy_text(mode: str) -> str:
    return f"collector_policy_min_interval={tiktok_min_interval_for_mode(mode):.1f}s | request_sleep={tiktok_TIKTOK_REQUEST_SLEEP_BY_MODE.get(mode, 1.0):.1f}s"


def tiktok_wait_for_request_slot(mode: str, label: str) -> bool:
    global tiktok_LAST_TOP_LEVEL_REQUEST_START, tiktok_REQUEST_COUNTER
    if tiktok_stop_requested() or tiktok_tiktok_rate_limited():
        return False
    min_interval = tiktok_min_interval_for_mode(mode)
    with tiktok_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = None if not tiktok_LAST_TOP_LEVEL_REQUEST_START else now - tiktok_LAST_TOP_LEVEL_REQUEST_START
        wait_for = 0.0 if elapsed is None else max(0.0, min_interval - elapsed)
        if elapsed is not None:
            wait_for += random.uniform(0.0, min(1.5, max(0.25, min_interval * 0.12)))
        if wait_for > 0:
            tiktok_log(f"      [throttle] waiting {wait_for:.1f}s before TikTok {label} | {tiktok_policy_text(mode)}")
            if tiktok_STOP_EVENT.wait(wait_for):
                return False
            if tiktok_tiktok_rate_limited() or tiktok_stop_requested():
                return False
        tiktok_LAST_TOP_LEVEL_REQUEST_START = time.monotonic()
        tiktok_REQUEST_COUNTER += 1
        request_no = tiktok_REQUEST_COUNTER
    tiktok_log(f"      [throttle] TikTok {label} request START | #{request_no} | min_interval={min_interval:.1f}s")
    return True


