# ---------------------------------------------------------------------------
# SQLite hot-path tuning. WAL + NORMAL already preserves the intended
# checkpoint behavior; these settings reduce fsync/page-cache overhead.
# ---------------------------------------------------------------------------
def v14__sqlite_tune(db) -> None:
    try:
        with db.lock:
            db.conn.execute("PRAGMA journal_mode=WAL")
            db.conn.execute("PRAGMA synchronous=NORMAL")
            db.conn.execute("PRAGMA temp_store=MEMORY")
            db.conn.execute("PRAGMA cache_size=-65536")
            db.conn.execute("PRAGMA mmap_size=268435456")
            db.conn.execute("PRAGMA wal_autocheckpoint=1000")
            db.conn.execute("PRAGMA busy_timeout=5000")
            db.conn.commit()
    except Exception:
        pass

