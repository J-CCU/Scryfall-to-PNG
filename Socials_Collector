# ============================================================================
# V20: CONCURRENT PLATFORM STRATEGIES + INDEPENDENT PAUSE/RESUME
# ============================================================================
# V20 changes the orchestration model from one active subprocess at a time to
# one bounded subprocess per platform.  Each platform owns its own:
#   * source strategy / capability preflight
#   * subprocess
#   * cooldown state and pending retry pointer
#   * retry backoff when a transient worker failure occurs
#   * stdout monitor
#
# No proxy, IP rotation, account rotation, CAPTCHA bypass, or platform-control
# evasion is introduced. A real access block, throttle, or verification event
# causes that platform to pause and the persisted cooldown is honored exactly.
# Other platforms keep running.

V20_BUILD = "ALL_FIXES_V20_CONCURRENT_STRATEGIES"
V20_RETRY_FAILURE_INITIAL = 60.0
V20_RETRY_FAILURE_MAX = 900.0
V20_ACCESS_PROBE_LOG_ONLY = True


def v20_strategy_description(platform_key: str) -> str:
    if platform_key == "youtube":
        return (
            "yt-dlp/InnerTube primary; YouTube Data API/cached metadata where configured; "
            "bounded worker concurrency; persisted yt-dlp cooldown + exact pending retry"
        )
    if platform_key == "instagram":
        graph = "Meta Graph API supplement when configured; " if instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN else ""
        auth = "authenticated Instaloader when configured; " if instagram_INSTAGRAM_LOGIN_USERNAME else "anonymous mobile-feed first; "
        return (
            graph + auth +
            "direct mobile-feed public route; cached-ID retry; post-level yt-dlp enrichment; "
            "401/Please-wait access-block backoff"
        )
    if platform_key == "tiktok":
        research = "TikTok Research API primary when approved; " if (tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN or tiktok_TIKTOK_RESEARCH_CLIENT_KEY) else ""
        return (
            research +
            "embedded profile/page JSON; yt-dlp public profile; tiktokuser:<channel_id> fallback "
            "when a channel ID is obtainable; persisted throttle/challenge retry"
        )
    return "platform-specific strategy"


def v20_preflight(platform: UnifiedPlatform, inputs: List[str]) -> Tuple[str, str]:
    """Lightweight capability preflight; intentionally does not hammer endpoints.

    Returns (state, reason).  READY means the dependency/source path is present.
    UNKNOWN means the dependency is present but live reachability is left to the
    real worker. BLOCKED is reserved for persisted platform state already present.
    """
    if platform.key == "youtube":
        if youtube_yt_dlp is None:
            return "FAILED", "yt-dlp is not installed"
        return "READY", v20_strategy_description("youtube")

    if platform.key == "instagram":
        if instagram_instaloader is None and not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN:
            return "FAILED", "Neither Instaloader nor Meta Graph API is available"
        access_until = 0.0
        try:
            db = instagram_Database(instagram_DB_PATH)
            try:
                access_until = v19__ig_access_backoff_until(db)
            finally:
                db.close()
        except Exception:
            access_until = 0.0
        if access_until > time.time():
            return "ACCESS_BLOCKED", f"persisted Instagram access backoff until {datetime.fromtimestamp(access_until, timezone.utc).isoformat()}"
        return "READY", v20_strategy_description("instagram")

    if platform.key == "tiktok":
        if tiktok_yt_dlp is None:
            return "FAILED", "yt-dlp is not installed"
        try:
            db = tiktok_Database(tiktok_DB_PATH)
            try:
                tiktok_load_tiktok_rate_limit(db)
                remaining = tiktok_rate_limit_remaining()
            finally:
                db.close()
        except Exception:
            remaining = 0
        if remaining > 0:
            return "COOLDOWN", f"persisted TikTok cooldown remaining={remaining}s"
        return "READY", v20_strategy_description("tiktok")

    return "UNKNOWN", "No preflight implementation"



# ---------------------------------------------------------------------------
# Instagram V20 source strategy: Graph API primary when an eligible/mapped
# professional account is configured; otherwise retain the hardened v19 public
# mobile-feed/authenticated fallback.  This prevents a broken anonymous route
# from being hit before a supported Graph route for an account that has one.
# ---------------------------------------------------------------------------
v20__instagram_old_resolve_profile = instagram_resolve_profile
