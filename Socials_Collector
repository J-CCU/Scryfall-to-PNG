# ---------------------------------------------------------------------------
# Adaptive YouTube comment fallback circuit.  When yt-dlp comments are returning
# repeated zero-row PARTIAL/403-like failures, stop burning the same global
# request budget that the payload workers need.  Durable comment jobs stay in
# SQLite and resume after the short cooldown or when the official API is usable.
# ---------------------------------------------------------------------------
def _v46_official_youtube_comments_available(db: youtube_Database) -> bool:
    if not youtube_YOUTUBE_API_KEY:
        return False
    try:
        if _v39_api_circuit_open(db) or _v41_transient_api_cooldown_open(db):
            return False
    except Exception:
        return False
    return True


