def _v42_ig_update_post_stage(self: instagram_Database, post_id: str, stage: str, status: str, error: str = "") -> None:
    requested = str(status or "")
    final = requested
    evidence = ""
    source = ""
    if str(stage) == "comments" and requested in {"SUCCESS", "SUCCESS_EMPTY"}:
        with _V42_IG_COMMENT_FETCH_LOCK:
            fetch = _V42_IG_COMMENT_FETCH.pop(str(post_id), None)
        with self.lock:
            actual = int(_v42_scalar(self.conn, "SELECT COUNT(*) FROM comments WHERE post_id=?", (post_id,)) or 0)
            expected = _v42_scalar(self.conn, "SELECT comments_count FROM posts WHERE post_id=?", (post_id,))
        if fetch and fetch.get("status") != "COMPLETE":
            final = "PARTIAL"
            evidence = str(fetch.get("status") or "PARTIAL")
            source = str(fetch.get("source") or "")
        elif fetch:
            source = str(fetch.get("source") or "")
            evidence = "GRAPH_PAGINATION_COMPLETE" if "Graph" in source else "INSTALOADER_TRAVERSAL_COMPLETE"
            final = "SUCCESS" if actual > 0 else "SUCCESS_EMPTY"
        elif actual > 0:
            final = "SUCCESS"
            evidence = "PERSISTED_ROWS"
        elif expected is not None and int(expected or 0) == 0:
            final = "SUCCESS_EMPTY"
            evidence = "METADATA_ZERO"
        else:
            final = "PENDING_UNVERIFIED_EMPTY"
            evidence = "EMPTY_WITHOUT_TRAVERSAL_PROOF"
    _v42_ig_update_stage_prev(self, post_id, stage, final, error)
    if str(stage) == "comments":
        _v42_set_comment_evidence(self, "post_ingestion", "post_id", post_id, evidence or final, source)

