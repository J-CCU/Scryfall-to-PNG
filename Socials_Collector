# Catalog proof: recent-window mode is forbidden until a successful full scan
# has been registered in the DB. The proof is captured during discovery but is
# committed only after register_video_discovery has persisted every discovered
# ID and update_channel_index is called.
# ---------------------------------------------------------------------------
_v39_discover_with_retry_orig = youtube_ytdlp_discover_with_rate_limit_retry


def youtube_ytdlp_discover_with_rate_limit_retry_v39(
    run_id: int, db: youtube_Database, channel_id: str, limit: int
):
    rows, raw_id, complete = _v39_discover_with_retry_orig(run_id, db, channel_id, limit)
    if int(limit or 0) <= 0:
        with _V39_FULL_SCAN_PROOFS_LOCK:
            if complete and rows:
                ids = [str((v or {}).get("video_id") or "") for v in rows]
                ids = [v for v in ids if v]
                timestamps = [int((v or {}).get("timestamp") or 0) for v in rows if int((v or {}).get("timestamp") or 0) > 0]
                _V39_FULL_SCAN_PROOFS[str(channel_id)] = {
                    "ids": ids,
                    "count": len(set(ids)),
                    "hash": _v39_catalog_hash(ids),
                    "oldest": min(timestamps) if timestamps else None,
                    "newest": max(timestamps) if timestamps else None,
                    "run_id": int(run_id or 0),
                }
                youtube_log(
                    f"[coverage/v39] FULL catalog scan proof captured | channel={channel_id} | "
                    f"accessible_ids={len(set(ids))} | awaiting DB registration commit"
                )
            else:
                _V39_FULL_SCAN_PROOFS.pop(str(channel_id), None)
                youtube_log(
                    f"[coverage/v39] FULL catalog scan NOT proven | channel={channel_id} | "
                    f"rows={len(rows)} complete={'yes' if complete else 'no'} | recent-window remains disabled"
                )
    return rows, raw_id, complete


youtube_ytdlp_discover_with_rate_limit_retry = youtube_ytdlp_discover_with_rate_limit_retry_v39


_v39_channel_index_orig = youtube_Database.update_channel_index


def v39__update_channel_index(self: youtube_Database, channel_id: str, *, complete: bool, discovered_count: int) -> None:
    cid = str(channel_id or "")
    with _V39_FULL_SCAN_PROOFS_LOCK:
        proof = _V39_FULL_SCAN_PROOFS.pop(cid, None)

    proof_committed = False
    if proof:
        ids = list(dict.fromkeys(proof.get("ids") or []))
        with self.lock:
            # All IDs from the remote full scan must exist in BOTH canonical and
            # ingestion tables before historical coverage can be declared proven.
            missing = 0
            for start in range(0, len(ids), 400):
                chunk = ids[start:start + 400]
                placeholders = ",".join("?" for _ in chunk)
                present_v = int(self.conn.execute(
                    f"SELECT COUNT(*) FROM videos WHERE video_id IN ({placeholders})", chunk
                ).fetchone()[0] or 0)
                present_i = int(self.conn.execute(
                    f"SELECT COUNT(*) FROM video_ingestion WHERE video_id IN ({placeholders})", chunk
                ).fetchone()[0] or 0)
                missing += (len(chunk) - present_v) + (len(chunk) - present_i)
            if missing == 0 and ids:
                self.conn.execute(
                    """
                    UPDATE channels
                    SET catalog_verification_version=?, catalog_verified_at=?, catalog_verified_count=?,
                        catalog_verified_hash=?, catalog_oldest_timestamp=?, catalog_newest_timestamp=?
                    WHERE channel_id=?
                    """,
                    (
                        V39_CATALOG_PROOF_VERSION, youtube_now_utc(), int(proof.get("count") or len(ids)),
                        str(proof.get("hash") or ""), proof.get("oldest"), proof.get("newest"), cid,
                    ),
                )
                self.conn.commit()
                proof_committed = True
            else:
                self.conn.execute(
                    "UPDATE channels SET index_complete='0' WHERE channel_id=?", (cid,)
                )
                self.conn.commit()

    # Never let the old "already indexed => complete" shortcut manufacture a
    # V39 proof. Existing proof may be preserved; new proof must come from the
    # full-scan path above.
    verified_now = proof_committed or _v39_catalog_proof_is_current(self, cid)
    _v39_channel_index_orig(
        self, cid, complete=bool(verified_now), discovered_count=int(discovered_count or 0)
    )
    if proof:
        youtube_log(
            f"[coverage/v39] catalog proof {'COMMITTED' if proof_committed else 'REJECTED'} | "
            f"channel={cid} | remote_ids={proof.get('count',0)} | recent-window={'ENABLED' if verified_now else 'DISABLED'}"
        )


