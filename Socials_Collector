def _v49_human_count(value: Any) -> Optional[int]:
    """Parse public compact counts such as 62.5K, 1.2M, 184,000."""
    if value is None:
        return None
    text = str(value).strip().replace("\u00a0", " ")
    if not text:
        return None
    m = re.search(r"([-+]?\d[\d,]*(?:\.\d+)?)\s*([KMBT]?)", text, re.I)
    if not m:
        return None
    raw = m.group(1).replace(",", "")
    try:
        number = float(raw)
    except Exception:
        return None
    multiplier = {
        "": 1,
        "K": 1_000,
        "M": 1_000_000,
        "B": 1_000_000_000,
        "T": 1_000_000_000_000,
    }.get((m.group(2) or "").upper(), 1)
    return int(round(number * multiplier))


def youtube_digits_only(value: Any) -> str:
    """Compatibility name retained; now understands YouTube K/M/B/T counts."""
    parsed = _v49_human_count(value)
    return "" if parsed is None else str(parsed)


