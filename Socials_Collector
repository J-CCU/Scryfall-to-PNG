# ===========================================================================
# V39 — DATABASE COMPLETENESS GUARD + CATALOG PROOF + API QUOTA CIRCUIT
# ===========================================================================
# V39 makes "DB-first" mean evidence-first rather than row-exists-first:
#   1) before the normal program entrypoint, audit/repair local YouTube DB shape;
#   2) legacy index_complete flags are not trusted until a V39 full-catalog pass
#      has proved that every currently accessible upload ID was registered;
#   3) a bounded recent scan is allowed only after that proof exists;
#   4) the proof is periodically revalidated so long downtime / >25 new uploads
#      cannot leave a permanent hole behind the recent-window optimization;
#   5) every known video is audited for payload + mandatory comment evidence;
#   6) one confirmed official-API quotaExceeded opens a persisted daily circuit
#      breaker, stopping all further Data API work for that quota day while
#      yt-dlp/InnerTube/database work continues;
#   7) DEFERRED_QUOTA is retryable and automatically re-enters the repair queue
#      after the next quota day; it is never treated as SUCCESS_EMPTY;
#   8) performance-refresh timestamps are updated only when API data was actually
#      obtained, so quota failures cannot make stale metrics look fresh.

V39_BUILD = "ALL_FIXES_V39_DATABASE_COMPLETENESS_GUARD"
V40_BUILD = "ALL_FIXES_V40_WINDOWS_SAFE_COMPLETENESS_GUARD"
V39_CATALOG_PROOF_VERSION = "V39_FULL_CATALOG_PROOF_1"
V39_CATALOG_REVERIFY_HOURS = max(24.0, float(os.getenv("SOCIAL_YOUTUBE_CATALOG_REVERIFY_HOURS", "168")))
V39_CHANNEL_API_REFRESH_HOURS = max(6.0, float(os.getenv("SOCIAL_YOUTUBE_CHANNEL_API_REFRESH_HOURS", "24")))
V39_HEAVY_REPAIR_PER_CHANNEL = max(5, int(os.getenv("SOCIAL_YOUTUBE_HEAVY_REPAIR", "50")))
V39_COMMENT_BACKLOG_PER_CHANNEL = max(100, int(os.getenv("SOCIAL_YOUTUBE_COMMENT_BACKLOG", "1000")))
V39_PREMAIN_AUDIT_INTERVAL_SECONDS = max(60.0, float(os.getenv("SOCIAL_YOUTUBE_PREMAIN_AUDIT_INTERVAL_SECONDS", "300")))
V39_QUOTA_REASONS = {"quotaExceeded", "dailyLimitExceeded", "dailyLimitExceededUnreg"}
V39_SUPPRESS_REDUNDANT_CHANNEL_API = True

# V38 backlog selection reads these globals at runtime. Raise the repair caps so
# an incomplete historical database converges instead of advancing only five
# heavy rows per channel forever.
V38_HEAVY_REPAIR_PER_CHANNEL = V39_HEAVY_REPAIR_PER_CHANNEL
V38_COMMENT_BACKLOG_PER_CHANNEL = V39_COMMENT_BACKLOG_PER_CHANNEL

