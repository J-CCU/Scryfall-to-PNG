def v13__set_checkpoint(conn, table: str, key_col: str, key: str, *, state: Optional[str] = None, stage: Optional[str] = None, error_marker: Optional[str] = None) -> None:
    sets = ["checkpoint_at=?"]
    vals = [youtube_now_utc()]
    if state is not None:
        sets.append("enrichment_state=?")
        vals.append(state)
    if stage is not None:
        sets.append("current_stage=?")
        vals.append(stage)
    if error_marker is not None:
        sets.append("last_error=?")
        vals.append(error_marker)
    vals.append(key)
    conn.execute(f"UPDATE {table} SET {', '.join(sets)} WHERE {key_col}=?", vals)


