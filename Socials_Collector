        except Exception:
            configured = []
        out["universe_source"] = "social_universe.csv" if configured else "latest run inputs"
        if conn is None:
            out["universe_unresolved"] = len(expected)
            out["unresolved_locators"] = [f"@{x}" for x in expected]
            return out
        resolved = {
            str(r[0] or "").strip().lower()
            for r in conn.execute(
                "SELECT username FROM accounts WHERE COALESCE(account_id,'')<>'' AND UPPER(COALESCE(resolution_verified,''))='YES'"
            ).fetchall()
            if str(r[0] or "").strip()
