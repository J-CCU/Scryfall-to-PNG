# minute. Push their durable heavy retry toward the scheduled start (or one hour
# when no start time is known).
_v49_finish_youtube_work_prev = _v44_finish_youtube_work

def _v49_upcoming_retry_seconds(db: youtube_Database, video_id: str) -> float:
    try:
        with db.lock:
            row = db.conn.execute(
                "SELECT live_status,availability,timestamp FROM videos WHERE video_id=?",
                (str(video_id),),
            ).fetchone()
        if not row or (str(row[0] or "") != "is_upcoming" and str(row[1] or "") != "upcoming"):
            return 0.0
        ts = int(row[2] or 0)
        if ts > 0:
            delta = ts - time.time()
            if delta > 7200:
                return min(21600.0, max(3600.0, delta - 3600.0))
            if delta > 900:
                return max(600.0, delta - 300.0)
            return 600.0
        return 3600.0
    except Exception:
        return 0.0

def _v44_finish_youtube_work(db: youtube_Database, video_id: str, stage: str, *, done: bool, error: str = "", retry_after: float = 0.0) -> None:
    if not done and str(stage) == "heavy":
        retry_after = max(float(retry_after or 0.0), _v49_upcoming_retry_seconds(db, video_id))
        if retry_after >= 600:
            error = error or "scheduled livestream deferred"
    return _v49_finish_youtube_work_prev(
        db, video_id, stage, done=done, error=error, retry_after=retry_after
    )


