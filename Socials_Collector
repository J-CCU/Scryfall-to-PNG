def v27_validate_youtube_api_key_v39() -> tuple[bool, str]:
    if not _V39_CONFIGURED_YOUTUBE_API_KEY:
        return False, "not configured"
    db = youtube_Database(youtube_DB_PATH)
    try:
        _v39_migrate_youtube_schema(db)
        if _v39_load_api_circuit(db):
            return False, f"quota circuit open for {youtube_youtube_api_today_key()}"
        today = youtube_youtube_api_today_key()
        cached_day = db.get_runtime_state("youtube_api_validation_day") or ""
        cached_status = db.get_runtime_state("youtube_api_validation_status") or ""
        if cached_day == today and cached_status == "READY":
            return True, "validated today (cached; network=0)"
        try:
            r = youtube_SESSION.get(
                "https://www.googleapis.com/youtube/v3/videos",
                params={"part": "id", "id": "dQw4w9WgXcQ", "key": _V39_CONFIGURED_YOUTUBE_API_KEY},
                timeout=youtube_REQUEST_TIMEOUT,
                headers={"User-Agent": youtube_UA},
            )
            youtube_youtube_api_note_request(db)
            body = r.text[:4000]
            if r.status_code == 200:
                db.set_runtime_state("youtube_api_validation_day", today)
                db.set_runtime_state("youtube_api_validation_status", "READY")
                return True, "validated"
            reason = _v39_api_reason_from_body(body)
            if r.status_code == 403 and reason in V39_QUOTA_REASONS:
                _v39_trip_api_circuit(db, reason, body)
                db.set_runtime_state("youtube_api_validation_day", today)
                db.set_runtime_state("youtube_api_validation_status", "QUOTA_DEFERRED")
                return False, f"HTTP 403: {reason}; quota circuit opened"
            try:
                payload = r.json()
                msg = str((payload.get("error") or {}).get("message") or "")[:300]
            except Exception:
                msg = body[:300]
            return False, f"HTTP {r.status_code}: {msg}"
        except Exception as exc:
            return False, f"{type(exc).__name__}: {exc}"
    finally:
        db.close()


