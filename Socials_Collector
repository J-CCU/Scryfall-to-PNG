        # If evidence says a formerly DONE job is incomplete, reopen it.
        db.conn.execute(f"""
            UPDATE youtube_work_queue SET state='PENDING',next_attempt_at=0,lease_owner=NULL,lease_expires_at=0,updated_at=?
            WHERE stage='heavy' AND state='DONE' AND EXISTS(
                SELECT 1 FROM video_ingestion vi WHERE vi.video_id=youtube_work_queue.video_id AND NOT ({payload})
            )
        """, (now_iso,))
        db.conn.execute(f"""
            UPDATE youtube_work_queue SET state='PENDING',next_attempt_at=0,lease_owner=NULL,lease_expires_at=0,updated_at=?
            WHERE stage='comments' AND state='DONE' AND EXISTS(
                SELECT 1 FROM video_ingestion vi JOIN videos v ON v.video_id=vi.video_id
                WHERE vi.video_id=youtube_work_queue.video_id AND NOT ({comments})
            )
        """, (now_iso,))
        db.conn.execute(f"""
            INSERT OR IGNORE INTO youtube_work_queue(video_id,stage,action,state,priority,run_id,attempts,next_attempt_at,created_at,updated_at)
            SELECT vi.video_id,'heavy','RESUME','PENDING',COALESCE(v.timestamp,0),?,0,0,?,?
            FROM video_ingestion vi LEFT JOIN videos v ON v.video_id=vi.video_id
            WHERE NOT ({payload})
        """, (int(run_id or 0), now_iso, now_iso))
        db.conn.execute(f"""
            INSERT OR IGNORE INTO youtube_work_queue(video_id,stage,action,state,priority,run_id,attempts,next_attempt_at,created_at,updated_at)
            SELECT vi.video_id,'comments','COMMENT_REPAIR','PENDING',COALESCE(v.timestamp,0),?,0,0,?,?
            FROM video_ingestion vi JOIN videos v ON v.video_id=vi.video_id
            WHERE NOT ({comments})
        """, (int(run_id or 0), now_iso, now_iso))
        # Completed evidence closes stale work rows.
        db.conn.execute(f"""UPDATE youtube_work_queue SET state='DONE',lease_owner=NULL,lease_expires_at=0,updated_at=?
            WHERE stage='heavy' AND EXISTS(SELECT 1 FROM video_ingestion vi WHERE vi.video_id=youtube_work_queue.video_id AND ({payload}))""", (now_iso,))
        db.conn.execute(f"""UPDATE youtube_work_queue SET state='DONE',lease_owner=NULL,lease_expires_at=0,updated_at=?
            WHERE stage='comments' AND EXISTS(SELECT 1 FROM video_ingestion vi JOIN videos v ON v.video_id=vi.video_id WHERE vi.video_id=youtube_work_queue.video_id AND ({comments}))""", (now_iso,))
        db.conn.commit()
        rows = db.conn.execute("SELECT stage,state,COUNT(*) FROM youtube_work_queue GROUP BY stage,state").fetchall()
    out = {}
    for stage, state, n in rows:
        out[f"{stage}_{state}"] = int(n or 0)
    return out


def _v44_claim_youtube_work(db: youtube_Database, stage: str, owner: str) -> Optional[dict]:
    now = time.time()
    now_iso = youtube_now_utc()
    with db.lock:
        db.conn.execute("UPDATE youtube_work_queue SET state='PENDING',lease_owner=NULL,lease_expires_at=0,updated_at=? WHERE state='RUNNING' AND lease_expires_at<=?", (now_iso, now))
        row = db.conn.execute(
            """SELECT video_id,action,priority,attempts,run_id FROM youtube_work_queue
               WHERE stage=? AND state IN ('PENDING','RETRY') AND next_attempt_at<=?
               ORDER BY priority DESC, attempts ASC, created_at ASC LIMIT 1""",
            (stage, now),
        ).fetchone()
        if not row:
            db.conn.commit()
            return None
        vid = str(row[0] or "")
        updated = db.conn.execute(
            """UPDATE youtube_work_queue SET state='RUNNING',lease_owner=?,lease_expires_at=?,attempts=attempts+1,updated_at=?
               WHERE video_id=? AND stage=? AND state IN ('PENDING','RETRY')""",
            (owner, now + V44_YT_LEASE_SECONDS, now_iso, vid, stage),
        ).rowcount
        db.conn.commit()
        if not updated:
            return None
        return {"video_id": vid, "action": str(row[1] or "RESUME"), "priority": int(row[2] or 0), "attempts": int(row[3] or 0) + 1, "run_id": int(row[4] or 0)}


def _v44_finish_youtube_work(db: youtube_Database, video_id: str, stage: str, *, done: bool, error: str = "", retry_after: float = 0.0) -> None:
    state = "DONE" if done else "RETRY"
    now = time.time()
    with db.lock:
        db.conn.execute(
            """UPDATE youtube_work_queue SET state=?,next_attempt_at=?,lease_owner=NULL,lease_expires_at=0,last_error=?,updated_at=?
               WHERE video_id=? AND stage=?""",
            (state, 0.0 if done else now + max(1.0, float(retry_after or V44_YT_RETRY_BASE_SECONDS)), str(error or "")[:1000], youtube_now_utc(), str(video_id), str(stage)),
        )
        db.conn.commit()


def _v44_youtube_work_counts(db: youtube_Database) -> dict:
    _v44_migrate_youtube(db)
    with db.lock:
        rows = db.conn.execute("SELECT stage,state,COUNT(*) FROM youtube_work_queue GROUP BY stage,state").fetchall()
    out = {"heavy_pending":0,"heavy_running":0,"comments_pending":0,"comments_running":0,"heavy_done":0,"comments_done":0}
    for stage, state, n in rows:
        stage = str(stage or "")
        state = str(state or "")
        n = int(n or 0)
        if stage == "heavy":
            if state in {"PENDING","RETRY"}: out["heavy_pending"] += n
            elif state == "RUNNING": out["heavy_running"] += n
            elif state == "DONE": out["heavy_done"] += n
        elif stage == "comments":
            if state in {"PENDING","RETRY"}: out["comments_pending"] += n
            elif state == "RUNNING": out["comments_running"] += n
            elif state == "DONE": out["comments_done"] += n
    return out


def _v44_pipeline_init(self: V38YouTubePipeline, run_id: int, db: youtube_Database, mode: str, emit: Callable[[str], None]):
    self.run_id = int(run_id or 0)
    self.db = db
    self.mode = str(mode)
    self.emit = emit
    self.lock = threading.RLock()
    self.closed = False
    self.discovery_done = False
    self.wake_event = threading.Event()
    self.owner_prefix = f"{os.getpid()}-{id(self)}"
    self.heavy_submitted = self.heavy_completed = self.heavy_failed = 0
    self.comment_submitted = self.comment_completed = self.comment_failed = self.comment_deferred = 0
    _v44_bootstrap_youtube_work(db, self.run_id)
    self.heavy_threads = [threading.Thread(target=self._heavy_worker, name=f"v38-ytdlp-{i+1}", daemon=True) for i in range(V38_YTDLP_WORKERS)]
    self.comment_threads = [threading.Thread(target=self._comment_worker, name=f"v38-comments-{i+1}", daemon=True) for i in range(V38_COMMENT_WORKERS)]
    for t in self.heavy_threads + self.comment_threads:
        t.start()


def _v44_pipeline_submit_heavy(self: V38YouTubePipeline, video: dict, action: str) -> bool:
    vid = str((video or {}).get("video_id") or "")
    if not vid:
        return False
    added = _v44_youtube_enqueue(self.db, vid, "heavy", str(action or "RESUME"), self.run_id, _v44_work_priority(video), force=(str(action) == "FORCE"))
    if added:
        with self.lock: self.heavy_submitted += 1
        self.wake_event.set()
    return added


def _v44_pipeline_submit_comments(self: V38YouTubePipeline, video: dict, *, force: bool = False) -> bool:
    if not youtube_COLLECT_COMMENTS:
        return False
    vid = str((video or {}).get("video_id") or "")
    if not vid:
        return False
    state = self.db.get_video_sync(vid) or {}
    if not force and not _v38_comment_refresh_due(self.db, video, state):
        return False
    added = _v44_youtube_enqueue(self.db, vid, "comments", "COMMENT_REPAIR", self.run_id, _v44_work_priority(video), force=force)
    if added:
        with self.lock: self.comment_submitted += 1
        self.wake_event.set()
    return added


def _v44_pipeline_heavy_worker(self: V38YouTubePipeline) -> None:
    owner = f"{self.owner_prefix}-heavy-{threading.current_thread().name}"
    while not self.closed:
        if self.run_id <= 0:
            self.wake_event.wait(0.25); self.wake_event.clear(); continue
        job = _v44_claim_youtube_work(self.db, "heavy", owner)
        if not job:
            self.wake_event.wait(0.5); self.wake_event.clear(); continue
        vid = job["video_id"]
        video = self.db.get_video_catalog(vid) or {"video_id": vid}
        action = job.get("action") or "RESUME"
        try:
            _v38_heavy_enrich_orig(self.run_id, self.db, video, self.mode, action)
            state = self.db.get_video_sync(vid) or {}
            done = _v35_youtube_payload_complete(self.db, state, self.mode)
            _v44_finish_youtube_work(self.db, vid, "heavy", done=done, error="" if done else "payload evidence incomplete", retry_after=V44_YT_RETRY_BASE_SECONDS)
            with self.lock:
                if done: self.heavy_completed += 1
                else: self.heavy_failed += 1
        except Exception as exc:
            _v44_finish_youtube_work(self.db, vid, "heavy", done=False, error=f"{type(exc).__name__}: {exc}", retry_after=min(3600, V44_YT_RETRY_BASE_SECONDS * max(1, job.get("attempts",1))))
            with self.lock: self.heavy_failed += 1
            youtube_log(f"[youtube/v44 heavy] ERROR | video={vid} | {type(exc).__name__}: {exc}")


def _v44_pipeline_comment_worker(self: V38YouTubePipeline) -> None:
    owner = f"{self.owner_prefix}-comments-{threading.current_thread().name}"
    while not self.closed:
        if self.run_id <= 0:
            self.wake_event.wait(0.25); self.wake_event.clear(); continue
        job = _v44_claim_youtube_work(self.db, "comments", owner)
        if not job:
            self.wake_event.wait(0.5); self.wake_event.clear(); continue
        vid = job["video_id"]
        video = self.db.get_video_catalog(vid) or {"video_id": vid}
        try:
            status, _count = _v38_collect_comments(self.run_id, self.db, video)
            state = self.db.get_video_sync(vid) or {}
            done = _v38_comments_complete(self.db, state)
            retry = V44_YT_EMPTY_COMMENT_RETRY_SECONDS if status in {"PENDING_UNVERIFIED_EMPTY","DEFERRED_QUOTA","RATE_LIMITED","PARTIAL","STOPPED"} else V44_YT_RETRY_BASE_SECONDS
            _v44_finish_youtube_work(self.db, vid, "comments", done=done, error="" if done else status, retry_after=retry)
            _v38_finalize_video(self.db, vid)
            _v41_refresh_one_completeness(self.db, vid)
            with self.lock:
                self.comment_completed += 1
                if not done and status in {"PENDING_UNVERIFIED_EMPTY","DEFERRED_QUOTA","RATE_LIMITED","PARTIAL","STOPPED"}: self.comment_deferred += 1
                elif not done: self.comment_failed += 1
        except Exception as exc:
            _v44_finish_youtube_work(self.db, vid, "comments", done=False, error=f"{type(exc).__name__}: {exc}", retry_after=min(3600, V44_YT_RETRY_BASE_SECONDS * max(1, job.get("attempts",1))))
            with self.lock:
                self.comment_completed += 1; self.comment_failed += 1
            youtube_log(f"[youtube/v44 comments] ERROR | video={vid} | {type(exc).__name__}: {exc}")


def _v44_pipeline_snapshot(self: V38YouTubePipeline) -> dict:
    q = _v44_youtube_work_counts(self.db)
    with self.lock:
        return {
            "heavy_submitted": self.heavy_submitted + q["heavy_done"] + q["heavy_pending"] + q["heavy_running"],
            "heavy_completed": q["heavy_done"],
            "heavy_failed": self.heavy_failed,
            "heavy_pending": q["heavy_pending"] + q["heavy_running"],
            "comment_submitted": self.comment_submitted + q["comments_done"] + q["comments_pending"] + q["comments_running"],
            "comment_completed": q["comments_done"],
            "comment_failed": self.comment_failed,
            "comment_deferred": self.comment_deferred,
            "comment_pending": q["comments_pending"] + q["comments_running"],
        }


def _v44_pipeline_drain(self: V38YouTubePipeline) -> dict:
    self.discovery_done = True
    self.wake_event.set()
    self.emit(f"[youtube/v44] catalog/discovery phase complete | draining durable SQLite work | yt-dlp_workers={V38_YTDLP_WORKERS} comment_workers={V38_COMMENT_WORKERS}")
    last_log = 0.0
    while not youtube_stop_requested():
        q = _v44_youtube_work_counts(self.db)
        eligible_heavy = q["heavy_pending"] + q["heavy_running"]
        eligible_comments = q["comments_pending"] + q["comments_running"]
        # RETRY rows with a future next_attempt_at are included above. If nothing
        # is currently claimable/running, leave them durable for the next pass.
        with self.db.lock:
            now = time.time()
            ready = int(self.db.conn.execute("SELECT COUNT(*) FROM youtube_work_queue WHERE state='RUNNING' OR (state IN ('PENDING','RETRY') AND next_attempt_at<=?)", (now,)).fetchone()[0] or 0)
        if ready == 0:
            break
        now_m = time.monotonic()
        if now_m - last_log >= V38_DRAIN_LOG_SECONDS:
            self.emit(f"[youtube/v44 drain] durable work | heavy pending/running={eligible_heavy} | comments pending/running={eligible_comments} | finished work persists across restart")
            last_log = now_m
        self.wake_event.set()
        time.sleep(0.5)
    return self.snapshot()


def _v44_pipeline_close(self: V38YouTubePipeline) -> None:
    if self.closed:
        return
    self.closed = True
    self.wake_event.set()
    for t in self.heavy_threads + self.comment_threads:
        t.join(timeout=5.0)
    # Release this process's leases immediately; no 30-minute crash wait.
    with self.db.lock:
        self.db.conn.execute("""UPDATE youtube_work_queue SET state='PENDING',lease_owner=NULL,lease_expires_at=0,updated_at=?
                              WHERE state='RUNNING' AND lease_owner LIKE ?""", (youtube_now_utc(), self.owner_prefix + "%"))
        self.db.conn.commit()


