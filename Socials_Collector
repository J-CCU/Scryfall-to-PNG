class youtube_App:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("YouTube Maximum Data Scraper")
        self.root.geometry("1100x820")

        self.db = youtube_Database(youtube_DB_PATH)
        self.scraper: Optional[youtube_Scraper] = None
        self.process: Optional[subprocess.Popen] = None
        self.worker: Optional[threading.Thread] = None
        self.job_path: Optional[Path] = None
        self.stop_clicked = False
        self.last_run_id: Optional[int] = None
        # Tkinter must only be touched from the main thread. Worker-thread
        # logging/progress is routed through this queue and pumped by Tk.
        self.ui_queue = queue.Queue()

        self.build()
        self.root.after(50, self.pump_ui_queue)
        youtube_load_cookies()

        if youtube_yt_dlp is None:
            self.log_ui("WARNING: yt-dlp is not installed. Maximum extraction requires it.\n")
            self.log_ui("Install with: python3 -m pip install -U yt-dlp\n")
        else:
            self.log_ui(f"yt-dlp: {getattr(youtube_yt_dlp, '__version__', 'installed')}\n")

        self.log_ui(f"Database: {youtube_DB_PATH}\n")

    def build(self) -> None:
        frame = ttk.Frame(self.root, padding=8)
        frame.pack(fill="both", expand=True)

        ttk.Label(frame, text="YouTube channel URLs, @handles, or UC channel IDs:").pack(anchor="w")
        self.input_box = tk.Text(frame, height=9, width=130)
        self.input_box.pack(fill="x", pady=(4, 8))

        options = ttk.Frame(frame)
        options.pack(fill="x")

        ttk.Label(options, text="Video limit:").pack(side="left")
        self.limit_var = tk.StringVar(value="Latest 100")
        ttk.Combobox(
            options,
            textvariable=self.limit_var,
            values=["Latest 30", "Latest 100", "Latest 300", "Latest 1000", "All available"],
            state="readonly",
            width=18,
        ).pack(side="left", padx=(6, 20))

        ttk.Label(options, text="Mode:").pack(side="left")
        self.mode_var = tk.StringVar(value="Maximum")
        ttk.Combobox(
            options,
            textvariable=self.mode_var,
            values=["Fast", "Full", "Maximum"],
            state="readonly",
            width=12,
        ).pack(side="left", padx=6)

        ttk.Label(
            options,
            text="",
        ).pack(side="left", padx=15)

        self.force_refresh_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(
            options,
            text="Force full refresh of existing videos",
            variable=self.force_refresh_var,
        ).pack(side="left", padx=15)

        buttons = ttk.Frame(frame)
        buttons.pack(fill="x", pady=8)

        self.start_btn = ttk.Button(buttons, text="Start Scrape", command=self.start)
        self.start_btn.pack(side="left", padx=4)

        self.stop_btn = ttk.Button(buttons, text="End (finish current item)", command=self.stop, state="disabled")
        self.stop_btn.pack(side="left", padx=4)

        ttk.Button(buttons, text="Export Last Run", command=self.export_last).pack(side="left", padx=4)
        ttk.Button(buttons, text="Open DB Folder", command=self.open_db_folder).pack(side="left", padx=4)

        self.progress = ttk.Progressbar(frame, orient="horizontal", mode="determinate")
        self.progress.pack(fill="x")

        self.status_var = tk.StringVar(value="Ready")
        ttk.Label(frame, textvariable=self.status_var).pack(anchor="w", pady=(4, 1))
        self.db_status_var = tk.StringVar(value="DB: waiting for scrape")
        ttk.Label(frame, textvariable=self.db_status_var).pack(anchor="w", pady=(0, 4))

        log_controls = ttk.Frame(frame)
        log_controls.pack(fill="x", pady=(0, 3))
        self.auto_follow_var = tk.BooleanVar(value=True)
        ttk.Checkbutton(
            log_controls,
            text="Auto-follow log",
            variable=self.auto_follow_var,
        ).pack(side="left")
        self.log_position_var = tk.StringVar(value="Log: ready")
        ttk.Label(log_controls, textvariable=self.log_position_var).pack(side="right")

        output_frame = ttk.Frame(frame)
        output_frame.pack(fill="both", expand=True)
        self.output_scrollbar = ttk.Scrollbar(output_frame, orient="vertical")
        self.output_scrollbar.pack(side="right", fill="y")
        self.output = tk.Text(
            output_frame, height=30, width=130, wrap="word",
            yscrollcommand=self._on_log_scroll,
        )
        self.output.pack(side="left", fill="both", expand=True)
        self.output_scrollbar.config(command=self.output.yview)

    def _on_log_scroll(self, *args) -> None:
        self.output_scrollbar.set(*args)
        try:
            top_line = self.output.index("@0,0").split(".")[0]
            bottom_line = self.output.index(f"@0,{max(self.output.winfo_height() - 4, 1)}").split(".")[0]
            self.log_position_var.set(f"Log: lines {top_line}–{bottom_line}")
        except Exception:
            pass

    def log_ui(self, message: str) -> None:
        # Main-thread messages are written immediately so button clicks are
        # visibly acknowledged. Worker-thread messages are queued safely.
        try:
            if threading.current_thread() is threading.main_thread():
                self.output.insert(tk.END, message)
                if self.auto_follow_var.get():
                    self.output.see(tk.END)
            else:
                self.ui_queue.put(("log", message))
        except Exception as exc:
            print(f"[ui] log error: {type(exc).__name__}: {exc}", flush=True)

    def progress_ui(self, current: int, total: int, phase: str) -> None:
        try:
            self.ui_queue.put(("progress", current, total, phase))
        except Exception:
            pass

    def pump_ui_queue(self) -> None:
        try:
            while True:
                item = self.ui_queue.get_nowait()
                kind = item[0]
                if kind == "log":
                    message = item[1]
                    self.output.insert(tk.END, message)
                    if self.auto_follow_var.get():
                        self.output.see(tk.END)
                    stripped = message.strip()
                    if "[db]" in stripped and "run=" in stripped:
                        self.db_status_var.set("DB: " + stripped.replace("  ", " "))
                    elif stripped.startswith("[control]") or stripped.startswith("[run]"):
                        self.status_var.set(stripped)
                elif kind == "progress":
                    _, current, total, phase = item
                    self.progress["maximum"] = max(total, 1)
                    self.progress["value"] = min(current, total)
                    self.status_var.set(f"{phase.title()}: {current}/{total}")
                    self.status_var.set(f"{phase}: {current}/{total}")
                elif kind == "status":
                    self.status_var.set(item[1])
                elif kind == "run_id":
                    self.last_run_id = item[1]
                elif kind == "process_done":
                    self._process_finished(item[1])
        except queue.Empty:
            pass
        except Exception as exc:
            # Keep the GUI alive even if displaying a log message fails.
            print(f"[ui] pump error: {type(exc).__name__}: {exc}", flush=True)
        finally:
            try:
                self.root.after(50, self.pump_ui_queue)
            except Exception:
                pass

    def selected_limit(self) -> int:
        return {
            "Latest 30": 30,
            "Latest 100": 100,
            "Latest 300": 300,
            "Latest 1000": 1000,
            "All available": 0,
        }.get(self.limit_var.get(), youtube_DEFAULT_LIMIT)

    def start(self) -> None:
        if self.process and self.process.poll() is None:
            self.log_ui("[control] scrape is already running\n")
            return

        try:
            inputs = [x.strip() for x in self.input_box.get("1.0", tk.END).splitlines() if x.strip()]
            if not inputs:
                messagebox.showwarning("Input", "Paste at least one channel URL or @handle.")
                return

            if youtube_yt_dlp is None:
                python_cmd = sys.executable
                message = (
                    "yt-dlp is not installed in the Python environment this GUI is using.\n\n"
                    f"Python: {python_cmd}\n\n"
                    "Install it with:\n"
                    f"{python_cmd} -m pip install -U yt-dlp requests\n\n"
                    "Then restart this program."
                )
                self.status_var.set("Missing yt-dlp")
                self.log_ui("[control] START BLOCKED: yt-dlp is missing.\n")
                self.log_ui(f"[control] Python interpreter: {python_cmd}\n")
                self.log_ui(f"[control] Install: {python_cmd} -m pip install -U yt-dlp requests\n")
                messagebox.showerror("Missing yt-dlp", message)
                return

            youtube_clear_stop_request()
            self.stop_clicked = False
            self.output.delete("1.0", tk.END)
            self.progress["value"] = 0
            self.status_var.set("Starting...")
            self.start_btn.config(state="disabled")
            self.stop_btn.config(state="normal")

            limit = self.selected_limit()
            mode = self.mode_var.get()
            force_refresh = self.force_refresh_var.get()

            self.log_ui(
                f"[control] Start Scrape clicked | inputs={len(inputs)} | "
                f"mode={mode} | limit={'ALL' if limit <= 0 else limit} | "
                f"force_refresh={'yes' if force_refresh else 'no'}\n"
            )
            self.log_ui("[control] launching isolated scraper process...\n")
            self.status_var.set("Launching scraper process...")

            # Close the GUI's SQLite connection before the child starts. The
            # child opens its own connection, preventing cross-process SQLite
            # contention while a scrape is running.
            try:
                self.db.close()
            except Exception:
                pass

            self.job_path = youtube_BASE_DIR / f".scrape_job_{os.getpid()}_{int(time.time() * 1000)}.json"
            self.job_path.write_text(
                json.dumps({
                    "inputs": inputs,
                    "limit": limit,
                    "mode": mode,
                    "force_refresh": force_refresh,
                }),
                encoding="utf-8",
            )

            cmd = [
                sys.executable, "-u", str(Path(__file__).resolve()),
                "--worker", str(self.job_path),
            ]
            child_env = os.environ.copy()
            child_env["PYTHONUNBUFFERED"] = "1"
            child_env["PYTHONIOENCODING"] = "utf-8"

            self.process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                bufsize=1,
                cwd=str(youtube_BASE_DIR),
                env=child_env,
                start_new_session=True,
            )

            self.worker = threading.Thread(
                target=self._read_worker_output,
                name="youtube-scraper-output-reader",
                daemon=True,
            )
            self.worker.start()
            self.status_var.set("Scraper process running...")
            self.log_ui(f"[control] worker process started | pid={self.process.pid}\n")
            self.log_ui(f"[control] python={sys.executable}\n")
            self.log_ui(f"[control] script={Path(__file__).resolve()}\n")
            self.root.after(750, self._startup_check)
        except Exception as exc:
            self.start_btn.config(state="normal")
            self.stop_btn.config(state="disabled")
            self.status_var.set("Ready")
            try:
                self.db = youtube_Database(youtube_DB_PATH)
            except Exception:
                pass
            messagebox.showerror("Start Scrape Error", f"{type(exc).__name__}: {exc}")
            self.log_ui(f"[control] START ERROR: {type(exc).__name__}: {exc}\n")

    def _startup_check(self) -> None:
        process = self.process
        if process is None:
            return
        rc = process.poll()
        if rc is None:
            self.log_ui("[control] worker is alive; waiting for first scraper message...\n")
        else:
            self.log_ui(f"[control] worker exited before startup check | exit_code={rc}\n")

    def _read_worker_output(self) -> None:
        process = self.process
        if process is None or process.stdout is None:
            self.ui_queue.put(("process_done", -1))
            return

        try:
            for raw_line in process.stdout:
                line = raw_line.rstrip("\n")
                if line.startswith("[PROGRESS]|"):
                    parts = line.split("|", 3)
                    if len(parts) == 4:
                        try:
                            self.ui_queue.put(("progress", int(parts[1]), int(parts[2]), parts[3]))
                            continue
                        except ValueError:
                            pass
                m = re.search(r"^\[run\] (\d+) \|", line)
                if m:
                    try:
                        self.ui_queue.put(("run_id", int(m.group(1))))
                    except ValueError:
                        pass
                self.ui_queue.put(("log", raw_line))
        except Exception as exc:
            self.ui_queue.put(("log", f"[control] output-reader error: {type(exc).__name__}: {exc}\n"))
        finally:
            try:
                rc = process.wait()
            except Exception:
                rc = -1
            self.ui_queue.put(("process_done", rc))

    def _force_kill_if_needed(self) -> None:
        process = self.process
        if process is not None and process.poll() is None and self.stop_clicked:
            self.log_ui("[control] process did not exit after Stop; forcing termination...\n")
            try:
                process.kill()
            except Exception as exc:
                self.log_ui(f"[control] force-termination error: {type(exc).__name__}: {exc}\n")

    def _process_finished(self, return_code: int) -> None:
        # Reopen the GUI connection after the worker is completely gone.
        try:
            self.db = youtube_Database(youtube_DB_PATH)
        except Exception as exc:
            self.log_ui(f"[control] database reopen error: {type(exc).__name__}: {exc}\n")

        if self.job_path:
            try:
                self.job_path.unlink(missing_ok=True)
            except Exception:
                pass
            self.job_path = None

        was_stopped = self.stop_clicked
        self.process = None
        self.worker = None
        self.start_btn.config(state="normal")
        self.stop_btn.config(state="disabled")

        if was_stopped:
            self.status_var.set("Stopped")
            if self.last_run_id:
                try:
                    with self.db.lock:
                        self.db.conn.execute(
                            "UPDATE scrape_runs SET finished_at=?, status=?, notes=COALESCE(notes, '') || ? WHERE id=? AND (finished_at IS NULL OR status IS NULL)",
                            (youtube_now_utc(), "STOPPED", " | GUI terminated worker process.", self.last_run_id),
                        )
                        self.db.conn.commit()
                    self.log_ui(f"[control] marked run {self.last_run_id} STOPPED in database\n")
                except Exception as exc:
                    self.log_ui(f"[control] could not mark run stopped: {type(exc).__name__}: {exc}\n")
            self.log_ui(f"[control] scraper process stopped | exit_code={return_code}\n")
        elif return_code == 0:
            self.status_var.set("Ready")
            self.log_ui("[control] scraper process completed successfully\n")
        else:
            self.status_var.set("Failed")
            self.log_ui(f"[control] scraper process exited with code {return_code}\n")

    def stop(self) -> None:
        process = self.process
        if process is None or process.poll() is not None:
            self.status_var.set("Ready")
            self.log_ui("[control] no active scrape process to stop\n")
            return

        self.stop_clicked = True
        youtube_request_stop()
        self.stop_btn.config(state="disabled")
        self.status_var.set("Stopping scraper process...")
        self.log_ui(
            "\n[control] STOP clicked — terminating the isolated scraper process now.\n"
        )
        try:
            process.terminate()
        except Exception as exc:
            self.log_ui(f"[control] terminate error: {type(exc).__name__}: {exc}\n")
            try:
                process.kill()
            except Exception:
                pass
        try:
            self.root.after(1500, self._force_kill_if_needed)
        except Exception:
            pass

    def export_last(self) -> None:
        if not self.last_run_id:
            messagebox.showwarning("Export", "No scrape run is available yet.")
            return

        folder = filedialog.askdirectory(title="Choose export folder")
        if not folder:
            return

        try:
            outputs = youtube_export_run_csvs(self.db, self.last_run_id, Path(folder))
            self.log_ui("\n[export] completed:\n")
            for name, path in outputs.items():
                self.log_ui(f"  {name}: {path}\n")
            messagebox.showinfo("Export", f"Exported {len(outputs)} CSV files.")
        except Exception as exc:
            messagebox.showerror("Export Error", str(exc))

    def open_db_folder(self) -> None:
        folder = str(youtube_DB_PATH.parent)
        try:
            if sys.platform == "darwin":
                subprocess.run(["open", folder], check=False)
            elif os.name == "nt":
                os.startfile(folder)  # type: ignore[attr-defined]
            else:
                subprocess.run(["xdg-open", folder], check=False)
        except Exception as exc:
            messagebox.showerror("Open Folder", str(exc))


def youtube_worker_main(job_file: str) -> int:
    """Run one scrape in an isolated process so the GUI can terminate it."""
    print(f"[worker] process started | pid={os.getpid()} | python={sys.executable}", flush=True)
    job_path = Path(job_file)
    print(f"[worker] job={job_path}", flush=True)
    try:
        job = json.loads(job_path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"[worker] could not read job file: {type(exc).__name__}: {exc}", flush=True)
        return 2

    global youtube_COLLECT_COMMENTS
    # V48: one shared comments toggle controls YouTube, Instagram, and TikTok.
    # The parent scheduler persists the selection in both the job file and env.
    youtube_COLLECT_COMMENTS = bool(job.get("collect_comments", social_env_bool("SOCIAL_COLLECT_COMMENTS", False)))

    print("[worker] opening database...", flush=True)
    db = youtube_Database(youtube_DB_PATH)
    try:
        print("[worker] database opened", flush=True)
        print(f"[worker] build={youtube_COLLECTOR_BUILD}", flush=True)
        youtube_load_cookies()
        print(f"[worker] comment collection toggle={'ON' if youtube_COLLECT_COMMENTS else 'OFF'}", flush=True)
        print(f"[worker] yt-dlp={'available' if youtube_yt_dlp else 'MISSING'}", flush=True)
        if youtube_yt_dlp:
            js = youtube_detect_ytdlp_js_support()
            print(
                f"[worker] JS runtime status | Deno={'YES' if js['deno'] else 'NO'} | "
                f"yt-dlp-ejs={'YES' if js['ejs'] else 'NO'} | "
                f"npm_fallback={'YES' if js['remote_ejs_fallback'] else 'NO'}",
                flush=True,
            )
        print("[worker] constructing scraper...", flush=True)
        scraper = youtube_Scraper(
            db,
            log_callback=None,
            progress_callback=lambda current, total, phase: print(
                f"[PROGRESS]|{current}|{total}|{phase}", flush=True
            ),
        )
        print("[worker] starting Scraper.run()...", flush=True)
        run_id = scraper.run(
            job.get("inputs") or [],
            int(job.get("limit", youtube_DEFAULT_LIMIT)),
            str(job.get("mode", "Maximum")),
            bool(job.get("force_refresh", False)),
        )
        print(f"[worker] finished run_id={run_id}", flush=True)
        return 0
    except Exception as exc:
        print(f"[worker] FATAL: {type(exc).__name__}: {exc}", flush=True)
        print(traceback.format_exc(), flush=True)
        return 1
    finally:
        try:
            db.close()
        except Exception:
            pass


def youtube_main() -> None:
    if len(sys.argv) >= 3 and sys.argv[1] == "--worker":
        raise SystemExit(youtube_worker_main(sys.argv[2]))

    root = tk.Tk()
    app = youtube_App(root)

    def close() -> None:
        youtube_request_stop()
        try:
            app.db.close()
        finally:
            root.destroy()

    root.protocol("WM_DELETE_WINDOW", close)
    root.mainloop()



