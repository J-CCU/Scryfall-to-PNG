        if box is None:
            continue
        box.delete("1.0", tk.END)
        if values:
            box.insert("1.0", "\n".join(values) + "\n")
    counts = ", ".join(f"{k}={len(v)}" for k, v in universe.items())
    if hasattr(app, "production_universe_var"):
        app.production_universe_var.set(f"{PRODUCTION_UNIVERSE_FILE.name} | {counts}")
    if announce and hasattr(app, "output"):
        app.output.insert(tk.END, f"[universe] loaded {PRODUCTION_UNIVERSE_FILE} | {counts}\n")
