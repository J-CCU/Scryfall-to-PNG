def _v38_repair_complete_checkpoints(db: youtube_Database, mode: str = "Maximum") -> int:
    """Repair checkpoint-only drift from persisted payload + comment evidence."""
    with db.lock:
        rows = db.conn.execute(
            "SELECT video_id FROM video_ingestion "
            "WHERE last_enriched_at IS NOT NULL AND "
            "(COALESCE(enrichment_state,'') <> 'COMPLETE' OR COALESCE(last_error,'') <> '')"
        ).fetchall()
    repaired = 0
    for row in rows:
        vid = str(row[0] or "")
        state = db.get_video_sync(vid) or {}
        if _v35_youtube_payload_complete(db, state, mode) and _v38_comments_complete(db, state):
            if _v38_finalize_video(db, vid):
                repaired += 1
    return repaired


# Existing indexed channels may contain thousands of V35 COMPLETE rows whose
# only missing stage is comments. Return a large comment-only backlog plus the
# original small heavy-repair allowance, so upgrading to V38 does not take
# hundreds of weekly rotations to backfill comments.
def v38__youtube_backlog(self: youtube_Database, channel_id: str, mode: str, limit: int) -> list:
    with self.lock:
        cur = self.conn.execute(
            """
            SELECT v.*
            FROM videos v
            JOIN video_ingestion vi ON vi.video_id=v.video_id
            WHERE v.channel_id=?
            ORDER BY COALESCE(v.timestamp,0) DESC, v.video_id
            """,
            (channel_id,),
        )
        cols = [d[0] for d in cur.description]
        candidates = [dict(zip(cols, r)) for r in cur.fetchall()]

    heavy = []
    comments = []
    for v in candidates:
        state = self.get_video_sync(str(v.get("video_id") or "")) or {}
        if not _v35_youtube_payload_complete(self, state, mode):
            if len(heavy) < V38_HEAVY_REPAIR_PER_CHANNEL:
                heavy.append(v)
            continue
        if not _v38_comments_complete(self, state):
            if len(comments) < V38_COMMENT_BACKLOG_PER_CHANNEL:
                comments.append(v)
        if len(heavy) >= V38_HEAVY_REPAIR_PER_CHANNEL and len(comments) >= V38_COMMENT_BACKLOG_PER_CHANNEL:
            break
    return heavy + comments


