def youtube_parse_channel_data(
    channel_id: str,
    page_data: Optional[dict],
    browse_data: Optional[dict],
    page_html: str = "",
    ytdlp_info: Optional[dict] = None,
    api_item: Optional[dict] = None,
) -> dict:
    flat = youtube_compact_json(page_data or browse_data or {})
    c = {
        "channel_id": channel_id,
        "handle": "",
        "title": "",
        "description": "",
        "custom_url": "",
        "channel_url": f"{youtube_YOUTUBE}/channel/{channel_id}",
        "avatar_url": "",
        "banner_url": "",
        "country": "",
        "subscribers_text": "",
        "subscribers_exact": "",
        "total_views_text": "",
        "total_views_exact": "",
        "video_count_text": "",
        "uploads_playlist_id": youtube_uploads_playlist(channel_id),
    }

    data_candidates = [x for x in (page_data, browse_data) if x]

    # First, inspect explicit channel-header renderers. This avoids selecting
    # subscriber text from a recommendation/related channel.
    for data in data_candidates:
        for header in youtube_deep_find_objects(data, "c4TabbedHeaderRenderer"):
            c["title"] = c["title"] or youtube_text_from_runs(header.get("title", {}))
            c["subscribers_text"] = c["subscribers_text"] or youtube_text_from_runs(
                header.get("subscriberCountText", {})
            )
            c["custom_url"] = c["custom_url"] or str(
                header.get("vanityChannelUrl") or header.get("canonicalBaseUrl") or ""
            )
            handle_value = header.get("vanityChannelUrl") or header.get("canonicalBaseUrl") or ""
            if isinstance(handle_value, str) and "/@" in handle_value:
                c["handle"] = c["handle"] or youtube_clean_handle(handle_value)

        # Search channelMetadataRenderer for the exact channel externalId.
        for meta in youtube_deep_find_objects(data, "channelMetadataRenderer"):
            external_id = meta.get("externalId")
            if external_id == channel_id:
                c["title"] = c["title"] or meta.get("title", "")
                c["description"] = c["description"] or youtube_text_from_runs(meta.get("description", {}))
                c["handle"] = c["handle"] or youtube_clean_handle(meta.get("vanityChannelUrl", ""))

        # Newer page header view model structures.
        for header in youtube_deep_find_objects(data, "pageHeaderRenderer"):
            c["title"] = c["title"] or youtube_text_from_runs(header.get("title", {}))

        c["description"] = c["description"] or youtube_text_from_runs(
            youtube_deep_find_first(data, "description")
        )
        c["video_count_text"] = c["video_count_text"] or youtube_text_from_runs(
            youtube_deep_find_first(data, "videosCountText")
        )

        # Only use a generic subscriberCountText as a fallback after exact
        # header extraction, not as the primary source.
        if not c["subscribers_text"]:
            for value in youtube_deep_find_values(data, "subscriberCountText"):
                candidate = youtube_text_from_runs(value)
                if candidate and "subscriber" in candidate.lower():
                    c["subscribers_text"] = candidate
                    break

        for value in youtube_deep_find_values(data, "canonicalBaseUrl"):
            if isinstance(value, str) and "/@" in value:
                handle = youtube_clean_handle(value)
                if handle and not c["handle"]:
                    c["handle"] = handle
                    break

        if not c["custom_url"]:
            for key in ("canonicalBaseUrl", "vanityChannelUrl"):
                value = youtube_deep_find_first(data, key)
                if isinstance(value, str):
                    c["custom_url"] = value
                    break

        for key in ("avatar", "avatarThumbnail", "thumbnail"):
            for obj in youtube_deep_find_objects(data, key):
                thumbs = obj.get("thumbnails")
                if isinstance(thumbs, list) and thumbs:
                    url = thumbs[-1].get("url")
                    if url and not c["avatar_url"]:
                        c["avatar_url"] = url
                        break
            if c["avatar_url"]:
                break

        banner = youtube_deep_find_first(data, "bannerExternalUrl")
        if isinstance(banner, str):
            c["banner_url"] = c["banner_url"] or banner

    # HTML metadata fallback for subscribers. Prefer exact header snippets.
    if page_html and not c["subscribers_text"]:
        patterns = (
            r'"subscriberCountText"\s*:\s*\{"simpleText":"([^"]+subscriber[^"]*)"\}',
            r'"subscriberCountText"\s*:\s*\{"accessibility"\s*:\s*\{"accessibilityData"\s*:\s*\{"label":"([^"]*subscriber[^"]*)"',
        )
        for pattern in patterns:
            m = re.search(pattern, page_html, re.I)
            if m:
                c["subscribers_text"] = html.unescape(m.group(1))
                break

    # yt-dlp is a valuable independent fallback and often exposes the exact
    # rounded public follower count directly.
    if ytdlp_info:
        c["title"] = c["title"] or ytdlp_info.get("channel") or ytdlp_info.get("uploader") or ""
        c["description"] = c["description"] or ytdlp_info.get("description") or ""
        c["handle"] = c["handle"] or youtube_clean_handle(
            ytdlp_info.get("channel_handle")
            or ytdlp_info.get("uploader_id")
            or ""
        )

        follower_count = ytdlp_info.get("channel_follower_count")
        if follower_count not in (None, "") and not c["subscribers_exact"]:
            c["subscribers_exact"] = str(follower_count)
            c["subscribers_text"] = f"{follower_count:,} subscribers"

        video_count = ytdlp_info.get("playlist_count") or ytdlp_info.get("channel_video_count")
        if video_count not in (None, ""):
            c["video_count_text"] = c["video_count_text"] or str(video_count)

    # Optional official Data API fallback. subscriberCount is rounded down to
    # three significant figures and hiddenSubscriberCount indicates whether it
    # is public, so we preserve that distinction.
    if api_item:
        snippet = api_item.get("snippet") or {}
        stats = api_item.get("statistics") or {}
        hidden = bool(stats.get("hiddenSubscriberCount"))

        c["title"] = c["title"] or snippet.get("title", "")
        c["description"] = c["description"] or snippet.get("description", "")
        c["custom_url"] = c["custom_url"] or snippet.get("customUrl", "")

        if not hidden and stats.get("subscriberCount") not in (None, ""):
            exact = str(stats["subscriberCount"])
            c["subscribers_exact"] = exact
            c["subscribers_text"] = f"{int(exact):,} subscribers"

        if stats.get("viewCount") not in (None, ""):
            exact_views = str(stats["viewCount"])
            c["total_views_exact"] = exact_views
            c["total_views_text"] = f"{int(exact_views):,} views"

        if stats.get("videoCount") not in (None, ""):
            c["video_count_text"] = f"{stats['videoCount']} public videos"

        playlists = (api_item.get("contentDetails") or {}).get("relatedPlaylists") or {}
        if playlists.get("uploads"):
            c["uploads_playlist_id"] = playlists["uploads"]

    if not c["total_views_text"]:
        m = re.search(r'([\d,.]+\s*[KMBT]?)\s+views', flat, re.I)
        if m:
            c["total_views_text"] = m.group(1)

    c["subscribers_exact"] = c["subscribers_exact"] or youtube_digits_only(c["subscribers_text"])
    c["total_views_exact"] = c["total_views_exact"] or youtube_digits_only(c["total_views_text"])
    return c


def youtube_scrape_channel_metadata(
    run_id: int,
    db: youtube_Database,
    channel_id: str,
    emit_fn: Optional[Callable[[str], None]] = None,
) -> dict:
    youtube_log = emit_fn or (lambda message: youtube_debug(message))
    if youtube_stop_requested():
        return {"channel_id": channel_id, "handle": "", "title": "", "subscribers_text": "", "total_views_text": ""}
    about_url = f"{youtube_YOUTUBE}/channel/{channel_id}/about"
    youtube_log("  [channel metadata] 1/4 fetching About page...")
    stage_started = time.monotonic()
    page, status = youtube_get_page(about_url)
    youtube_log(f"  [channel metadata] 1/4 About page finished in {time.monotonic() - stage_started:.1f}s | HTTP {status}")
    raw_html_id = None

    if page:
        youtube_log("  [channel metadata] 2/4 storing About HTML in database...")
        stage_started = time.monotonic()
        raw_html_id = db.raw(
            run_id,
            channel_id=channel_id,
            video_id=None,
            source="html",
            endpoint=about_url,
            status=status,
            payload=page,
            content_type="text/html",
        )
        youtube_log(f"  [channel metadata] 2/4 About HTML stored in {time.monotonic() - stage_started:.1f}s | raw_id={raw_html_id}")

    # Do not parse the entire ytInitialData blob yet. First fetch the smaller
    # InnerTube About response; only parse the page JSON as a fallback when we
    # still need fields that were not exposed by the InnerTube response.
    page_data = None
    browse_data = None
    raw_browse_id = None
    if youtube_INNERTUBE_API_KEY:
        youtube_log("  [channel metadata] 3/4 fetching InnerTube About data...")
        stage_started = time.monotonic()
        browse_data, bstatus, bbody = youtube_innertube_post(
            "browse",
            {"browseId": channel_id, "params": "EgVhYm91dA%3D%3D"},
        )
        youtube_log(f"  [channel metadata] 3/4 InnerTube About finished in {time.monotonic() - stage_started:.1f}s | HTTP {bstatus}")
        if bbody:
            stage_started = time.monotonic()
            raw_browse_id = db.raw(
                run_id,
                channel_id=channel_id,
                video_id=None,
                source="innertube",
                endpoint="browse/about",
                status=bstatus,
                payload=bbody,
                content_type="application/json",
            )
            youtube_log(f"  [channel metadata] InnerTube raw data stored in {time.monotonic() - stage_started:.1f}s | raw_id={raw_browse_id}")

    # Channel-level yt-dlp is intentionally skipped by default. The expensive
    # yt-dlp path is still used at the video level, where it adds much more value.
    ytdlp_info = None
    if youtube_yt_dlp is not None and youtube_COLLECT_CHANNEL_YTDLP_METADATA:
        youtube_log("  [channel metadata] fetching yt-dlp channel metadata...")
        stage_started = time.monotonic()
        try:
            opts = {
                "quiet": True,
                "no_warnings": True,
                "ignoreerrors": True,
                "extract_flat": True,
                "skip_download": True,
                "socket_timeout": youtube_REQUEST_TIMEOUT,
            }
            with youtube_yt_dlp.YoutubeDL(opts) as ydl:
                ytdlp_info = ydl.extract_info(
                    f"{youtube_YOUTUBE}/channel/{channel_id}",
                    download=False,
                )
                if ytdlp_info:
                    sanitized = ydl.sanitize_info(ytdlp_info)
                    db.raw(
                        run_id,
                        channel_id=channel_id,
                        video_id=None,
                        source="yt-dlp",
                        endpoint=f"{youtube_YOUTUBE}/channel/{channel_id}",
                        status=200,
                        payload=sanitized,
                        content_type="application/json",
                        note="channel_metadata",
                    )
            youtube_log(f"  [channel metadata] yt-dlp channel metadata finished in {time.monotonic() - stage_started:.1f}s")
        except Exception as exc:
            youtube_log(f"  [channel metadata] yt-dlp channel metadata FAILED after {time.monotonic() - stage_started:.1f}s | {type(exc).__name__}: {exc}")
            youtube_debug(f"[channel yt-dlp] {type(exc).__name__}: {exc}")
    elif youtube_yt_dlp is not None:
        youtube_log("  [channel metadata] yt-dlp channel metadata skipped (video-level yt-dlp remains enabled)")

    # Parse the large page JSON only when the smaller InnerTube About response
    # is missing useful identity/metric fields. This avoids a costly full-tree
    # parse on every channel.
    preliminary = youtube_parse_channel_data(
        channel_id, None, browse_data, page_html=page or "", ytdlp_info=ytdlp_info
    )
    need_page_parse = bool(page and (
        not preliminary.get("description")
        or not preliminary.get("subscribers_text")
        or not preliminary.get("total_views_text")
    ))
    if need_page_parse:
        youtube_log("  [channel metadata] parsing large About page JSON fallback...")
        stage_started = time.monotonic()
        page_data = youtube_parse_yt_initial_data(page)
        youtube_log(
            f"  [channel metadata] page JSON fallback finished in {time.monotonic() - stage_started:.1f}s | "
            f"initial_data={'yes' if page_data else 'no'}"
        )

    api_item = None
    # V39: the direct per-channel Data API request is intentionally suppressed.
    # It used one quota-bearing channels.list call per channel per rotation even
    # though About/InnerTube already provide channel metadata. V39 performs
    # quota-aware channel metrics refreshes separately instead of spending 105+
    # redundant requests every five minutes.
    if youtube_YOUTUBE_API_KEY and not bool(globals().get("V39_SUPPRESS_REDUNDANT_CHANNEL_API", False)):
        try:
            r = youtube_SESSION.get(
                "https://www.googleapis.com/youtube/v3/channels",
                params={"part": "snippet,statistics,contentDetails", "id": channel_id, "key": youtube_YOUTUBE_API_KEY},
                timeout=youtube_REQUEST_TIMEOUT,
                headers={"User-Agent": youtube_UA},
            )
            if r.status_code == 200:
                items = r.json().get("items") or []
                api_item = items[0] if items else None
            else:
                youtube_debug(f"[api/channel] HTTP {r.status_code}: {r.text[:500]}")
        except Exception as exc:
            youtube_debug(f"[api/channel] {type(exc).__name__}: {exc}")

    c = youtube_parse_channel_data(
        channel_id,
        page_data,
        browse_data,
        page_html=page or "",
        ytdlp_info=ytdlp_info,
        api_item=api_item,
    )

    db.upsert_channel(c)
    db.channel_snapshot(run_id, c, raw_html_id, raw_browse_id)
    youtube_log(f"  [db] channel metadata snapshot saved | channel_id={channel_id} raw_html={raw_html_id or 'none'} raw_innertube={raw_browse_id or 'none'}")
    return c


