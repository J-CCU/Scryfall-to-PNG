        pid = p.get("post_id")
        with self.lock:
            self.conn.execute(
                "UPDATE post_ingestion SET last_enriched_at=?, last_full_refresh_at=CASE WHEN ? THEN ? ELSE last_full_refresh_at END, last_maximum_refresh_at=CASE WHEN ? THEN ? ELSE last_maximum_refresh_at END, enrichment_attempts=enrichment_attempts+1,last_run_id=?,last_error=? WHERE post_id=?",
                (instagram_now_utc(),1 if full else 0,instagram_now_utc() if full else None,1 if maximum else 0,instagram_now_utc() if maximum else None,run_id,error,pid),
            )
            self.conn.commit()

    def upsert_snapshot(self, run_id: int, p: dict) -> None:
        with self.lock:
            self.conn.execute(
                "INSERT INTO post_snapshots(scrape_run_id,post_id,snapshot_at,likes,comments_count,video_view_count,video_duration,caption,is_sponsored,is_pinned) VALUES(?,?,?,?,?,?,?,?,?,?)",
                (run_id,p.get("post_id"),instagram_now_utc(),instagram_safe_int(p.get("likes")),instagram_safe_int(p.get("comments_count")),instagram_safe_int(p.get("video_view_count")),instagram_safe_float(p.get("video_duration")),p.get("caption"),p.get("is_sponsored"),p.get("is_pinned")),
            )
            self.conn.commit()

    def upsert_sidecar_items(self, post_id: str, items: List[dict]) -> int:
        n = 0
        with self.lock:
            for i, item in enumerate(items):
                cur = self.conn.execute(
                    "INSERT OR IGNORE INTO sidecar_items(post_id,item_index,media_id,shortcode,typename,display_url,video_url,thumbnail_url,is_video,width,height) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                    (post_id,i,item.get("media_id"),item.get("shortcode"),item.get("typename"),item.get("display_url"),item.get("video_url"),item.get("thumbnail_url"),item.get("is_video"),instagram_safe_int(item.get("width")),instagram_safe_int(item.get("height"))),
                )
                if cur.rowcount > 0:
                    n += 1
            self.conn.commit()
        return n

    def insert_comment(self, run_id: int, post_id: str, c: dict, raw_node_id: Optional[int]) -> bool:
        with self.lock:
            cur = self.conn.execute(
                "INSERT OR IGNORE INTO comments(comment_id,scrape_run_id,post_id,parent_comment_id,owner_user_id,owner_username,text,like_count,created_at,created_epoch,is_reply,raw_node_id,captured_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (str(c.get("comment_id") or ""),run_id,post_id,c.get("parent_comment_id"),c.get("owner_user_id"),c.get("owner_username"),c.get("text"),instagram_safe_int(c.get("like_count")),c.get("created_at"),instagram_safe_int(c.get("created_epoch")),c.get("is_reply"),raw_node_id,instagram_now_utc()),
            )
            self.conn.commit()
            return cur.rowcount > 0

    def get_backlog(self, account_id: str, limit: int) -> List[dict]:
        with self.lock:
            rows = self.conn.execute(
                "SELECT p.*, i.last_enriched_at, i.last_error FROM posts p JOIN post_ingestion i ON i.post_id=p.post_id WHERE p.account_id=? AND (i.last_enriched_at IS NULL OR i.last_error IS NOT NULL) ORDER BY COALESCE(p.published_epoch,0) DESC LIMIT ?",
                (account_id, max(0,int(limit))),
            ).fetchall()
        return [dict(r) for r in rows]

    def account_is_indexed(self, account_id: str) -> bool:
        with self.lock:
            row = self.conn.execute("SELECT index_complete FROM accounts WHERE account_id=?", (account_id,)).fetchone()
            return bool(row and row["index_complete"] == "YES")

    def update_account_index(self, account_id: str, complete: bool, count: int, discovered: int) -> None:
        with self.lock:
            self.conn.execute("UPDATE accounts SET last_indexed_at=?, index_complete=?, indexed_post_count=?, last_discovery_count=?, updated_at=? WHERE account_id=?", (instagram_now_utc(),"YES" if complete else "NO",count,discovered,instagram_now_utc(),account_id))
            self.conn.commit()

    def counts(self) -> dict:
        with self.lock:
            return {name: int(self.conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]) for name,table in {
                "accounts":"accounts","posts":"posts","snapshots":"post_snapshots","comments":"comments","sidecars":"sidecar_items","raw_data":"raw_data","errors":"errors","ingestion":"post_ingestion"
            }.items()}

    def log_counts(self, run_id: int, prefix: str = "") -> None:
        c = self.counts()
        instagram_log(prefix + " | " + " ".join(f"{k}={v}" for k,v in c.items()))

    def record_error(self, run_id: int, account_id: str = "", post_id: str = "", stage: str = "", exc: Optional[Exception] = None, message: str = "") -> None:
        with self.lock:
            self.conn.execute("INSERT INTO errors(scrape_run_id,account_id,post_id,stage,error_type,message,traceback,captured_at) VALUES(?,?,?,?,?,?,?,?)", (run_id,account_id,post_id,stage,type(exc).__name__ if exc else "Error",message or (str(exc) if exc else ""),traceback.format_exc() if exc else "",instagram_now_utc()))
            self.conn.commit()


