def v13__tiktok_rate_text(text: str) -> bool:
    lowered = str(text or "").lower()
    if not lowered:
        return False
    if re.search(r"\b(?:http(?:\s+error)?\s*)?429\s+(?:too\s+many\s+requests|requests?)\b", lowered):
        return True
    if re.search(r"\b(?:http\s+)?status(?:[_ ]code)?\s*[:=]?\s*429\b", lowered):
        return True
    explicit = (
        "too many requests", "rate limit", "rate-limited", "request frequency",
        "requests are too frequent", "temporarily blocked", "unusual activity",
        "try again later", "access denied due to rate limiting"
    )
    return any(x in lowered for x in explicit)

tiktok_is_tiktok_rate_limit_text = v13__tiktok_rate_text


def v13__tiktok_page_throttle(page: str, status: int = 200) -> bool:
    if int(status or 0) == 429:
        return True
    raw = str(page or "")
    if not raw:
        return False
    visible = re.sub(r"<script\b[^>]*>.*?</script>", " ", raw, flags=re.I|re.S)
    visible = re.sub(r"<style\b[^>]*>.*?</style>", " ", visible, flags=re.I|re.S)
    visible = re.sub(r"<noscript\b[^>]*>.*?</noscript>", " ", visible, flags=re.I|re.S)
    visible = re.sub(r"<[^>]+>", " ", visible)
    visible = html.unescape(visible)
    visible = re.sub(r"\s+", " ", visible).strip()
    return tiktok_is_tiktok_rate_limit_text(visible) or tiktok_is_challenge_text(visible)

