def production_load_universe(path: Path = PRODUCTION_UNIVERSE_FILE) -> Dict[str, List[str]]:
    """Load enabled platform locators from the editable research-universe CSV."""
    result: Dict[str, List[str]] = {"youtube": [], "instagram": [], "tiktok": []}
    if not Path(path).exists():
        return result
    seen = {k: set() for k in result}
    with Path(path).open("r", encoding="utf-8-sig", newline="") as fh:
        for row in csv.DictReader(fh):
            platform = str(row.get("platform") or "").strip().lower()
            if platform not in result:
                continue
            enabled = str(row.get("enabled") or "1").strip().lower()
            if enabled in {"0", "false", "no", "off", "disabled"}:
                continue
            locator = str(row.get("locator") or row.get("handle") or row.get("account") or "").strip()
            if not locator or locator.lower() in seen[platform]:
                continue
            seen[platform].add(locator.lower())
            result[platform].append(locator)
    return result


def production_apply_universe_to_gui(app, *, announce: bool = True) -> Dict[str, List[str]]:
    universe = production_load_universe()
    for platform, values in universe.items():
