class instagram_FeedPostIterator:
    """Anonymous Instagram post iterator using the mobile feed endpoint.

    Instaloader 4.15.3's anonymous profile/timeline path can hit broken or
    misleading 401/429 responses from web_profile_info / the old GraphQL
    timeline. The maintained upstream fix is to use api/v1/feed/user/{id}/
    with max_id pagination. This local implementation keeps the collector
    independent of the unreleased upstream patch.
    """

    def __init__(self, context: Any, user_id: str, first_page: Optional[dict] = None):
        self.context = context
        self.user_id = str(user_id)
        self.data = first_page if first_page is not None else self._query()
        self.index = 0
        self.first_item = None

    def __iter__(self):
        return self

    def _query(self, max_id: Optional[str] = None) -> dict:
        params = {"count": 12}
        if max_id:
            params["max_id"] = max_id
        return self.context.get_json(f"api/v1/feed/user/{self.user_id}/", params=params)

    def __next__(self):
        while True:
            items = self.data.get("items") or []
            if self.index < len(items):
                item = items[self.index]
                self.index += 1
                post = instagram_instaloader.Post.from_iphone_struct(self.context, item)
                if self.first_item is None or getattr(post, "date_local", None) and getattr(self.first_item, "date_local", None) and post.date_local > self.first_item.date_local:
                    self.first_item = post
                elif self.first_item is None:
                    self.first_item = post
                return post

            if self.data.get("more_available") and self.data.get("next_max_id"):
                self.data = self._query(str(self.data["next_max_id"]))
                self.index = 0
                continue
            raise StopIteration()


def instagram_profile_from_feed(loader: Any, username: str) -> Optional[dict]:
    """Resolve an Instagram profile and live post iterator through feed API."""
    if not username or instagram_instaloader is None:
        return None
    if not instagram_wait_for_request_slot("Full", f"mobile-feed profile @{username}"):
        return None

    try:
        feed = loader.context.get_json(
            f"api/v1/feed/user/{username.lower()}/username/",
            params={"count": 12},
        )
    except Exception as exc:
        if isinstance(exc, instagram_TooManyRequestsException):
            raise
        # Some Instagram responses are reported as ConnectionException/BadRequest
        # when this endpoint is unavailable. They are not proof of a platform-wide
        # cooldown; let the caller record the endpoint failure without parking IG.
        instagram_log(f"[resolve/feed] feed endpoint failed | @{username} | {type(exc).__name__}: {exc}")
        return None

    user = feed.get("user") if isinstance(feed, dict) else None
    if not isinstance(user, dict) or not user.get("pk") or not user.get("username"):
        instagram_log(f"[resolve/feed] no usable profile node | @{username}")
        return None

    actual = str(user.get("username") or "")
    if actual.lower() != username.lower():
        instagram_log(f"[resolve/feed] username mismatch | requested=@{username} resolved=@{actual}")
        return None

    node = {
        "id": str(user.get("pk") or user.get("id") or ""),
        "pk": str(user.get("pk") or user.get("id") or ""),
        "username": actual,
        "full_name": str(user.get("full_name") or user.get("name") or ""),
        "biography": str(user.get("biography") or ""),
        "external_url": str(user.get("external_url") or ""),
        "profile_pic_url": str(user.get("profile_pic_url") or ""),
        "profile_pic_url_hd": str(user.get("profile_pic_url") or user.get("profile_pic_url_hd") or ""),
        "is_private": bool(user.get("is_private")),
        "is_verified": bool(user.get("is_verified")),
        "is_business_account": bool(user.get("is_business_account")),
        "iphone_struct": user,
        "edge_followed_by": {"count": user.get("follower_count")} if user.get("follower_count") is not None else {"count": None},
        "edge_follow": {"count": user.get("following_count")} if user.get("following_count") is not None else {"count": None},
        "edge_owner_to_timeline_media": {"count": user.get("media_count")} if user.get("media_count") is not None else {"count": None},
    }

    try:
        profile = instagram_instaloader.Profile(loader.context, node)
    except Exception as exc:
        instagram_log(f"[resolve/feed] Profile object construction failed | @{username} | {type(exc).__name__}: {exc}")
        return None

    # Avoid Profile.get_posts() falling back into the broken anonymous GraphQL
    # implementation in Instaloader 4.15.3. Use our mobile-feed iterator.
    iterator = instagram_FeedPostIterator(loader.context, str(user.get("pk")), first_page=feed)
    profile.get_posts = MethodType(lambda _self: iterator, profile)

    account = {
        "account_id": str(user.get("pk")),
        "username": actual,
        "full_name": str(user.get("full_name") or user.get("name") or ""),
        "biography": str(user.get("biography") or ""),
        "external_url": str(user.get("external_url") or ""),
        "profile_pic_url": str(user.get("profile_pic_url") or user.get("profile_pic_url_hd") or ""),
        "is_private": bool(user.get("is_private")),
        "is_verified": bool(user.get("is_verified")),
        "is_business_account": bool(user.get("is_business_account")),
        "followers": instagram_safe_int(user.get("follower_count")),
        "followees": instagram_safe_int(user.get("following_count")),
        "media_count": instagram_safe_int(user.get("media_count")),
        "account_url": f"{instagram_INSTAGRAM}/{actual}/",
        "resolution_method": "Instagram mobile feed endpoint",
        "resolution_verified": True,
        "_raw_node": user,
        "_profile": profile,
    }
    instagram_log(f"[resolve/feed] @{actual} -> {account['account_id']} [mobile feed endpoint]")
    return account


def instagram_resolve_profile_feedfirst(loader: Any, username: str) -> Optional[dict]:
    """Prefer mobile feed resolution where anonymous Instaloader is affected."""
    username = str(username or "").strip().lstrip("@").split("/")[0]
    if not username:
        return None

    # Anonymous collection: use the feed endpoint directly. This avoids the
    # known web_profile_info 401/429 trap seen with Instaloader 4.15.3.
    if not getattr(loader.context, "is_logged_in", False):
        try:
            result = instagram_profile_from_feed(loader, username)
            if result:
                return result
        except instagram_TooManyRequestsException:
            raise
        except Exception as exc:
            instagram_log(f"[resolve/feed] anonymous fallback failed | @{username} | {type(exc).__name__}: {exc}")
        return None

    # Logged-in collection keeps the existing Instaloader resolver first. If
    # Instagram refuses web_profile_info, retry through the same mobile feed
    # endpoint rather than waiting out an endpoint-specific backoff.
    try:
        result = instagram__INSTAGRAM_OLD_RESOLVE_PROFILE(loader, username)
        if result:
            return result
    except Exception as exc:
        if not instagram_is_rate_limit_exception(exc):
            instagram_log(f"[resolve] logged-in primary failed | @{username} | {type(exc).__name__}: {exc}")
        else:
            instagram_log(f"[resolve] primary endpoint refused profile; trying mobile feed fallback | @{username}")
    try:
        return instagram_profile_from_feed(loader, username)
    except Exception as exc:
        if isinstance(exc, instagram_TooManyRequestsException):
            raise
        instagram_log(f"[resolve/feed] logged-in fallback failed | @{username} | {type(exc).__name__}: {exc}")
        return None


def instagram_instagram_graph_map() -> dict:
    mapping = {}
    if instagram_INSTAGRAM_GRAPH_ACCOUNT_MAP_JSON:
        try:
            raw = json.loads(instagram_INSTAGRAM_GRAPH_ACCOUNT_MAP_JSON)
            if isinstance(raw, dict):
                mapping = {str(k).lstrip("@").lower(): str(v) for k, v in raw.items() if v}
        except Exception as exc:
            instagram_log(f"[graph] invalid INSTAGRAM_GRAPH_ACCOUNT_MAP JSON: {exc}")
    if instagram_INSTAGRAM_GRAPH_USERNAME and instagram_INSTAGRAM_GRAPH_IG_USER_ID:
        mapping[instagram_INSTAGRAM_GRAPH_USERNAME] = instagram_INSTAGRAM_GRAPH_IG_USER_ID
    return mapping


def instagram_instagram_graph_account_id(username: str) -> str:
    return instagram_instagram_graph_map().get(str(username or "").lstrip("@").lower(), "")


def instagram_instagram_graph_enabled(username: str = "", account_id: str = "") -> bool:
    if not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN:
        return False
    mapped = instagram_instagram_graph_account_id(username)
    return bool(mapped and (not account_id or str(account_id) == str(mapped))) or bool(account_id and instagram_INSTAGRAM_GRAPH_IG_USER_ID and str(account_id) == str(instagram_INSTAGRAM_GRAPH_IG_USER_ID))


def instagram_instagram_graph_budget_state(db: Optional[instagram_Database] = None) -> tuple[str, int]:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    if db is None:
        return today, 0
    try:
        day = db.get_runtime_state("instagram_graph_budget_day") or ""
        count = int(db.get_runtime_state("instagram_graph_request_count") or 0)
        if day != today:
            db.set_runtime_state("instagram_graph_budget_day", today)
            db.set_runtime_state("instagram_graph_request_count", "0")
            return today, 0
        return day, count
    except Exception:
        return today, 0


def instagram_instagram_graph_budget_available(db: Optional[instagram_Database] = None) -> bool:
    _, count = instagram_instagram_graph_budget_state(db)
    return count < instagram_INSTAGRAM_GRAPH_DAILY_REQUEST_LIMIT


def instagram_instagram_graph_note_request(db: Optional[instagram_Database] = None) -> None:
    if db is None:
        return
    day, count = instagram_instagram_graph_budget_state(db)
    db.set_runtime_state("instagram_graph_budget_day", day)
    db.set_runtime_state("instagram_graph_request_count", str(count + 1))


def instagram_instagram_graph_get(path: str, params: Optional[dict] = None, db: Optional[instagram_Database] = None) -> Optional[dict]:
    if not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN or not instagram_instagram_graph_budget_available(db):
        return None
    instagram_instagram_graph_note_request(db)
    try:
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM_GRAPH_BASE_URL}/{str(path).lstrip('/')}",
            params={**(params or {}), "access_token": instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN},
            timeout=instagram_REQUEST_TIMEOUT,
        )
        if r.status_code == 429:
            if db is not None:
                instagram_set_rate_limit(db, f"Instagram Graph API HTTP 429", pending_account_id="", pending_post_id=str(path).split('/')[0])
            return None
        if r.status_code != 200:
            instagram_log(f"[graph] HTTP {r.status_code} {path}: {r.text[:500]}")
            return None
        data = r.json()
        if isinstance(data, dict) and data.get("error"):
            instagram_log(f"[graph] API error {path}: {str(data.get('error'))[:500]}")
            return None
        return data if isinstance(data, dict) else None
    except Exception as exc:
        instagram_log(f"[graph] {path} {type(exc).__name__}: {exc}")
        return None


