# ---------------------------------------------------------------------------
# Instagram: direct one-shot HTTP path. This bypasses Instaloader's endpoint
# wrapper when necessary, while still using the normal public request surface.
# 401/"Please wait" is recorded as endpoint_unavailable, not a platform-wide
# cooldown. Only explicit 429 is promoted to scheduler throttle.
# ---------------------------------------------------------------------------
def v14__ig_direct_json(path: str, params: dict) -> Optional[dict]:
    try:
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM}/{path.lstrip('/')}",
            params=params,
            timeout=instagram_REQUEST_TIMEOUT,
            headers={
                "User-Agent": instagram_UA,
                "x-ig-app-id": "936619743392459",
                "X-ASBD-ID": "198387",
                "X-Requested-With": "XMLHttpRequest",
                "Referer": instagram_INSTAGRAM + "/",
                "Origin": instagram_INSTAGRAM,
                "Accept": "application/json,text/plain,*/*",
                "Connection": "keep-alive",
            },
        )
        body = r.text or ""
        if r.status_code == 429:
            raise instagram_TooManyRequestsException(body[:1000])
        if r.status_code == 401:
            instagram_log(f"[resolve/direct] endpoint unavailable | HTTP 401 | body={body[:180]}")
            return None
        if r.status_code >= 400:
            instagram_log(f"[resolve/direct] endpoint unavailable | HTTP {r.status_code} | body={body[:180]}")
            return None
        try:
            return r.json()
        except Exception:
            instagram_log(f"[resolve/direct] non-JSON HTTP {r.status_code} | body={body[:180]}")
            return None
    except instagram_TooManyRequestsException:
        raise
    except Exception as exc:
        instagram_log(f"[resolve/direct] request failed | {type(exc).__name__}: {str(exc)[:180]}")
        return None

def v14__ig_direct_feed(loader, username: str = "", account_id: str = "", source_label: str = "direct mobile feed") -> Optional[dict]:
    target = account_id or username
    if not target:
        return None
    path = f"api/v1/feed/user/{target}/" + ("username/" if not account_id else "")
    if not instagram_wait_for_request_slot("Full", f"direct-feed @{username or account_id}"):
        return None
    feed = v14__ig_direct_json(path, {"count": 12})
    if not feed:
        return None
    return v13__instagram_profile_from_feed_page(loader, feed, username, source_label)

# Replace the v13 resolver with direct-first attempts plus the same strict
# one-shot behavior.
def v14__ig_resolve(loader, username: str) -> Optional[dict]:
    username = str(username or "").strip().lstrip("@").split("/")[0]
    if not username:
        return None
    db = v14__ACTIVE_IG_DB
    cached = v13__instagram_find_cached_account(db, username) if db is not None else None
    if cached and cached.get("account_id"):
        result = v14__ig_direct_feed(loader, username, str(cached["account_id"]), "Instagram direct mobile feed cached-ID")
        if result:
            return result
    # One-shot metadata endpoint. This often fails with 401/400 on current
    # Instagram, so it is deliberately not retried.
    web = v13__instagram_web_profile_one_shot(loader, username)
    if web:
        result = v14__ig_direct_feed(loader, username, str(web["account_id"]), "Instagram direct mobile feed after web profile")
        if result:
            result.update({k:v for k,v in web.items() if k not in {"_profile","_raw_node"} and v not in (None,"")})
            result["resolution_method"] = "Instagram web_profile_info one-shot + direct mobile feed"
            result["_raw_node_web_profile"] = web.get("_raw_node") or {}
            return result
    # Final username endpoint, once. A 401/"Please wait" is an endpoint access
    # failure, not evidence of a global throttle.
    try:
        return v13__instagram_profile_from_feed(loader, username)
    except instagram_TooManyRequestsException:
        raise
    except Exception as exc:
        instagram_log(f"[resolve] final Instagram feed failed without cooldown | @{username} | {type(exc).__name__}: {str(exc)[:240]}")
        return None

