def v13__youtube_choose(db: youtube_Database, video: dict, mode: str, force_refresh: bool = False) -> str:
    state = db.get_video_sync(video.get("video_id", ""))
    if force_refresh:
        return "FORCE"
    if not state:
        return "NEW"
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE":
        if state.get("enrichment_attempts") and state.get("last_error"):
            return "RESUME"
        return "RESUME" if state.get("last_enriched_at") or state.get("yt_dlp_status") or state.get("checkpoint_at") else "NEW"
    if not youtube_state_is_complete(state, mode):
        return "RESUME"
    if youtube_heavy_refresh_due(state, video, mode):
        return "HEAVY_REFRESH"
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = youtube_hours_since(last)
    return "PERFORMANCE_REFRESH" if elapsed is None or elapsed >= youtube_video_refresh_interval_hours(video) else "SKIP"

