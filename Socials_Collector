class instagram_App:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Instagram Maximum-Data Collector")
        self.root.geometry("1450x900")
        self.db = instagram_Database(instagram_DB_PATH)
        self.process: Optional[subprocess.Popen] = None
        self.worker = None
        self.stop_clicked = False
        self.job_path: Optional[Path] = None
        self.last_run_id: Optional[int] = None
        self.ui_queue: queue.Queue = queue.Queue()
        self._build_ui()
        self.root.after(100, self._pump_ui)

    def _build_ui(self) -> None:
        frame = ttk.Frame(self.root, padding=10)
        frame.pack(fill="both", expand=True)
        ttk.Label(frame, text="Instagram accounts / URLs / post URLs (one per line):").pack(anchor="w")
        self.inputs = tk.Text(frame, height=7, width=130)
        self.inputs.pack(fill="x", pady=(4,8))

        row = ttk.Frame(frame)
        row.pack(fill="x")
        ttk.Label(row, text="Post limit:").pack(side="left")
        self.limit_var = tk.StringVar(value="All available")
        ttk.Combobox(row, textvariable=self.limit_var, values=["Latest 30","Latest 100","Latest 300","Latest 1000","All available"], state="readonly", width=18).pack(side="left", padx=(6,20))
        ttk.Label(row, text="Mode:").pack(side="left")
        self.mode_var = tk.StringVar(value="Maximum")
        ttk.Combobox(row, textvariable=self.mode_var, values=["Fast","Full","Maximum"], state="readonly", width=12).pack(side="left", padx=6)
        self.force_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(row, text="Force full refresh of existing posts", variable=self.force_var).pack(side="left", padx=15)
        ttk.Label(row, text="Maximum = comments + sidecars + raw nodes + yt-dlp enrichment",).pack(side="left", padx=15)

        buttons = ttk.Frame(frame)
        buttons.pack(fill="x", pady=8)
        self.start_btn = ttk.Button(buttons, text="Start Scrape", command=self.start)
        self.start_btn.pack(side="left", padx=4)
        self.stop_btn = ttk.Button(buttons, text="End (finish current item)", command=self.stop, state="disabled")
        self.stop_btn.pack(side="left", padx=4)
        ttk.Button(buttons, text="Export Last Run", command=self.export_last).pack(side="left", padx=4)
        ttk.Button(buttons, text="Open DB Folder", command=self.open_db_folder).pack(side="left", padx=4)

        self.progress = ttk.Progressbar(frame, orient="horizontal", mode="determinate")
        self.progress.pack(fill="x")
        self.status_var = tk.StringVar(value="Ready")
        ttk.Label(frame, textvariable=self.status_var).pack(anchor="w", pady=4)

        out_frame = ttk.Frame(frame)
        out_frame.pack(fill="both", expand=True)
        self.output = tk.Text(out_frame, height=35, width=140, wrap="word")
        self.output.pack(side="left", fill="both", expand=True)
        scrollbar = ttk.Scrollbar(out_frame, orient="vertical", command=self.output.yview)
        scrollbar.pack(side="right", fill="y")
        self.output.configure(yscrollcommand=scrollbar.set)

    def _limit_value(self) -> int:
        value = self.limit_var.get()
        mapping = {"Latest 30":30,"Latest 100":100,"Latest 300":300,"Latest 1000":1000,"All available":0}
        return mapping.get(value, 0)

    def log_ui(self, message: str) -> None:
        try:
            self.output.insert(tk.END, message)
            self.output.see(tk.END)
        except Exception:
            pass

    def _pump_ui(self) -> None:
        try:
            while True:
                item = self.ui_queue.get_nowait()
                kind = item[0]
                if kind == "log":
                    self.log_ui(item[1])
                elif kind == "progress":
                    _, cur, total, phase = item
                    self.progress["maximum"] = max(total,1)
                    self.progress["value"] = min(cur,total)
                    self.status_var.set(phase)
                elif kind == "run_id":
                    self.last_run_id = int(item[1])
                elif kind == "done":
                    self._process_finished(int(item[1]))
        except queue.Empty:
            pass
        self.root.after(100, self._pump_ui)

    def start(self) -> None:
        if self.process and self.process.poll() is None:
            messagebox.showwarning("Collector", "A collection run is already active.")
            return
        raw = self.inputs.get("1.0", tk.END).splitlines()
        inputs = [x.strip() for x in raw if x.strip()]
        if not inputs:
            messagebox.showwarning("Collector", "Enter at least one Instagram username or URL.")
            return
        mode = self.mode_var.get()
        limit = self._limit_value()
        job = {"inputs": inputs, "limit": limit, "mode": mode, "force_refresh": bool(self.force_var.get())}
        self.stop_clicked = False
        self.start_btn.config(state="disabled")
        self.stop_btn.config(state="normal")
        self.status_var.set("Starting collector...")
        self.log_ui("\n[control] starting isolated Instagram collector process...\n")
        try:
            self.job_path = Path(tempfile.gettempdir()) / f"instagram_collector_job_{os.getpid()}_{int(time.time()*1000)}.json"
            self.job_path.write_text(json.dumps(job, ensure_ascii=False), encoding="utf-8")
            self.process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--worker", str(self.job_path)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
            threading.Thread(target=self._read_worker_output, daemon=True).start()
        except Exception as exc:
            self.start_btn.config(state="normal")
            self.stop_btn.config(state="disabled")
            self.status_var.set("Ready")
            messagebox.showerror("Start Error", str(exc))

    def _read_worker_output(self) -> None:
        process = self.process
        if not process or process.stdout is None:
            self.ui_queue.put(("done",-1))
            return
        try:
            for raw in process.stdout:
                line = raw.rstrip("\n")
                if line.startswith("[PROGRESS]|"):
                    parts = line.split("|",3)
                    if len(parts)==4:
                        try:
                            self.ui_queue.put(("progress",int(parts[1]),int(parts[2]),parts[3]))
                            continue
                        except ValueError:
                            pass
                m = re.match(r"^\[run\] (\d+) \|", line)
                if m:
                    self.ui_queue.put(("run_id",int(m.group(1))))
                self.ui_queue.put(("log", raw))
        except Exception as exc:
            self.ui_queue.put(("log", f"[control] output-reader error: {type(exc).__name__}: {exc}\n"))
        finally:
            try:
                rc = process.wait()
            except Exception:
                rc = -1
            self.ui_queue.put(("done",rc))

    def _process_finished(self, rc: int) -> None:
        try:
            self.db = instagram_Database(instagram_DB_PATH)
        except Exception:
            pass
        if self.job_path:
            try: self.job_path.unlink(missing_ok=True)
            except Exception: pass
            self.job_path = None
        was_stopped = self.stop_clicked
        self.process = None
        self.worker = None
        self.start_btn.config(state="normal")
        self.stop_btn.config(state="disabled")
        if was_stopped:
            self.status_var.set("Stopped")
            self.log_ui(f"[control] Instagram collector stopped | exit_code={rc}\n")
        elif rc == 0:
            self.status_var.set("Ready")
            self.log_ui("[control] Instagram collector completed successfully\n")
        else:
            self.status_var.set("Failed")
            self.log_ui(f"[control] Instagram collector exited with code {rc}\n")

    def stop(self) -> None:
        if not self.process or self.process.poll() is not None:
            self.log_ui("[control] no active Instagram collector process to stop\n")
            return
        self.stop_clicked = True
        self.stop_btn.config(state="disabled")
        self.status_var.set("Stopping collector...")
        self.log_ui("\n[control] STOP clicked — terminating isolated Instagram collector now.\n")
        try:
            self.process.terminate()
        except Exception:
            try: self.process.kill()
            except Exception: pass
        self.root.after(1500, self._force_kill_if_needed)

    def _force_kill_if_needed(self) -> None:
        if self.process and self.process.poll() is None and self.stop_clicked:
            try: self.process.kill()
            except Exception: pass

    def export_last(self) -> None:
        if not self.last_run_id:
            messagebox.showwarning("Export", "No collection run is available yet.")
            return
        folder = filedialog.askdirectory(title="Choose export folder")
        if not folder:
            return
        try:
            outputs = instagram_export_run_csvs(self.db, self.last_run_id, Path(folder))
            self.log_ui("\n[export] completed:\n")
            for name, path in outputs.items():
                self.log_ui(f"  {name}: {path}\n")
            messagebox.showinfo("Export", f"Exported {len(outputs)} CSV files.")
        except Exception as exc:
            messagebox.showerror("Export Error", str(exc))

    def open_db_folder(self) -> None:
        folder = str(instagram_DB_PATH.parent)
        try:
            if sys.platform == "darwin": subprocess.run(["open", folder], check=False)
            elif os.name == "nt": os.startfile(folder)  # type: ignore[attr-defined]
            else: subprocess.run(["xdg-open", folder], check=False)
        except Exception as exc:
            messagebox.showerror("Open Folder", str(exc))


def instagram_worker_main(job_file: str) -> int:
    job_path = Path(job_file)
    try:
        job = json.loads(job_path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"[worker] could not read job file: {type(exc).__name__}: {exc}", flush=True)
        return 2
    db = instagram_Database(instagram_DB_PATH)
    exit_code = 0
    try:
        print(f"[worker] process started | pid={os.getpid()} | python={sys.executable}", flush=True)
        print(f"[worker] Instaloader={'available' if instagram_instaloader else 'MISSING'} | yt-dlp={'available' if instagram_yt_dlp else 'MISSING'}", flush=True)
        print(f"[worker] build={INSTAGRAM_COLLECTOR_BUILD}", flush=True)
        print("[worker] Instagram anonymous resolver=mobile-feed-first | web_profile_info=DISABLED", flush=True)
        collector = instagram_Collector(db, progress_callback=lambda c,t,p: print(f"[PROGRESS]|{c}|{t}|{p}", flush=True))
        run_id = collector.run(job.get("inputs") or [], int(job.get("limit", instagram_DEFAULT_LIMIT)), str(job.get("mode", "Maximum")), bool(job.get("force_refresh", False)))
        print(f"[worker] finished run_id={run_id}", flush=True)
        exit_code = 0
    except Exception as exc:
        print(f"[worker] FATAL: {type(exc).__name__}: {exc}", flush=True)
        print(traceback.format_exc(), flush=True)
        exit_code = 1
    finally:
        try:
            db.close()
        except Exception:
            pass
        # Instaloader/requests can leave interpreter-owned resources alive after
        # a worker run. In the orchestrated subprocess we need a deterministic
        # process boundary so the master scheduler can move to the next platform.
        # DB work and all stdout above are already flushed/closed before exiting.
        if instagram_ORCHESTRATED_RUN:
            os._exit(exit_code)
    return exit_code



