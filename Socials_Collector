def tiktok_merge_tiktok_video_sources(*sources: Iterable[dict], limit: int = 0) -> list[dict]:
    merged: dict[str, dict] = {}
    for source in sources:
        for row in source or []:
            vid = str(row.get("video_id") or "")
            if not vid:
                continue
            if vid not in merged:
                merged[vid] = dict(row)
                continue
            dst = merged[vid]
            for k, v in row.items():
                if v not in (None, "", [], {}) and dst.get(k) in (None, "", [], {}):
                    dst[k] = v
            # Prefer current yt-dlp counts over archived Research API counts when both exist.
            if row.get("view_count") is not None and row.get("research_source") is None:
                for k in ("view_count", "like_count", "comment_count", "repost_count", "save_count"):
                    if row.get(k) is not None:
                        dst[k] = row[k]
    out = list(merged.values())
    out.sort(key=lambda v: tiktok_safe_int(v.get("timestamp")) or 0, reverse=True)
    return out[:limit] if limit > 0 else out


def tiktok__date_chunks_backward(start: datetime, end: datetime, window_days: int) -> Iterable[tuple[str, str]]:
    cur_end = end
    while cur_end >= start:
        cur_start = max(start, cur_end - timedelta(days=window_days))
        # API accepts upper bound no more than 30 days after lower bound.
        yield cur_start.strftime("%Y%m%d"), cur_end.strftime("%Y%m%d")
        if cur_start <= start:
            break
        cur_end = cur_start - timedelta(days=1)


def tiktok_research_discover_all_history(username: str, account_id: str, *, limit: int, full_catalog: bool, db: tiktok_Database) -> list[dict]:
    if not (tiktok_COLLECT_RESEARCH_API and tiktok_ensure_research_access_token(db)):
        return []
    now_dt = datetime.now(timezone.utc).date()
    earliest_raw = tiktok_TIKTOK_RESEARCH_EARLIEST_DATE
    try:
        earliest = datetime.strptime(earliest_raw, "%Y%m%d").date()
    except Exception:
        earliest = now_dt - timedelta(days=365 * 8)
    if not full_catalog:
        earliest = max(earliest, now_dt - timedelta(days=31))
    start_dt = datetime.combine(earliest, datetime.min.time(), tzinfo=timezone.utc)
    end_dt = datetime.combine(now_dt, datetime.max.time(), tzinfo=timezone.utc)
    rows: list[dict] = []
    for start_s, end_s in tiktok__date_chunks_backward(start_dt, end_dt, tiktok_TIKTOK_RESEARCH_WINDOW_DAYS):
        if tiktok_stop_requested() or not tiktok_tiktok_research_budget_available(db):
            break
        page_rows = tiktok_research_video_query(username, start_s, end_s, db=db, max_count=100)
        if page_rows:
            rows.extend(tiktok_normalize_research_video_row(x, account_id, username) for x in page_rows if isinstance(x, dict))
            rows = tiktok_merge_tiktok_video_sources(rows)
            if limit > 0 and len(rows) >= limit:
                return rows[:limit]
    return tiktok_merge_tiktok_video_sources(rows, limit=limit)


def tiktok_research_refresh_video_parity(video: dict, db: tiktok_Database) -> Optional[dict]:
    if not (tiktok_COLLECT_RESEARCH_API and tiktok_ensure_research_access_token(db)):
        return None
    ts = tiktok_safe_int(video.get("timestamp"))
    username = str(video.get("username") or "")
    if not ts or not username:
        return None
    dt = datetime.fromtimestamp(ts, tz=timezone.utc)
    day = dt.strftime("%Y%m%d")
    rows = tiktok_research_video_query(username, day, day, db=db, max_count=100)
    target = next((x for x in rows if str(x.get("id") or "") == str(video.get("video_id"))), None)
    if not target:
        return None
    return tiktok_normalize_research_video_row(target, video.get("account_id") or "", username)


def tiktok__db_migrate_tiktok_parity(self: tiktok_Database) -> None:
    with self.lock:
        columns = {r[1] for r in self.conn.execute("PRAGMA table_info(videos)").fetchall()}
        additions = {
            "hashtags_json": "TEXT",
            "effect_ids_json": "TEXT",
            "voice_to_text": "TEXT",
            "is_stem_verified": "TEXT",
            "favorites_count": "INTEGER",
            "video_label": "TEXT",
            "video_tag": "TEXT",
            "research_source": "TEXT",
            "research_updated_at": "TEXT",
        }
        for name, typ in additions.items():
            if name not in columns:
                self.conn.execute(f"ALTER TABLE videos ADD COLUMN {name} {typ}")
        ing_cols = {r[1] for r in self.conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        if "last_performance_refresh_at" not in ing_cols:
            self.conn.execute("ALTER TABLE video_ingestion ADD COLUMN last_performance_refresh_at TEXT")
        self.conn.commit()


