def instagram_choose_post_action_parity(db: instagram_Database, p: dict, mode: str, force_refresh: bool) -> str:
    if force_refresh:
        return "FORCE"
    state = db.get_post_state(p.get("post_id", ""))
    if not state or not state["last_enriched_at"]:
        return "NEW"
    if state["last_error"]:
        return "RESUME"
    age = instagram_post_age_days(p)
    performance_hours = instagram_ACTIVE_POST_REFRESH_HOURS if age is None or age <= 30 else instagram_MATURE_POST_REFRESH_HOURS
    last = state["last_enriched_at"]
    if instagram_hours_since_iso(last) is None or instagram_hours_since_iso(last) >= performance_hours:
        return "PERFORMANCE_REFRESH"
    if mode == "Maximum":
        heavy_last = state["last_maximum_refresh_at"] or state["last_enriched_at"]
        if instagram_hours_since_iso(heavy_last) is None or instagram_hours_since_iso(heavy_last) >= instagram_HEAVY_REFRESH_HOURS:
