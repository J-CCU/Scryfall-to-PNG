# Goal: maximize safe throughput without creating competing versions of a row.
#
# The base runner remains responsible for channel resolution, official API
# discovery, batched videos.list metadata, and catalog registration.  V38 makes
# the expensive per-video stages asynchronous:
#
#   discovery/API main lane  ---> SQLite catalog immediately
#   yt-dlp/caption lane      ---> persistent worker queue
#   comments API lane        ---> separate persistent worker queue
#
# Both worker lanes use the existing youtube_Database RLock, so SQLite writes
# remain serialized even though network/extraction work is concurrent.  Video
# rows are keyed by video_id; comments are manually UPSERTed by
# (video_id, comment_id) inside the same DB lock.  This preserves the existing
# database instead of creating a second staging interpretation of YouTube data.
#
# YouTube comments are mandatory in V38 regardless of the unified Instagram /
# TikTok comments checkbox.  Missing comments are repaired without rerunning an
# already-complete yt-dlp/caption payload.

V38_BUILD = "ALL_FIXES_V38_PARALLEL_YOUTUBE_COMMENTS_ON"
V38_YTDLP_WORKERS = max(1, min(8, int(os.getenv("SOCIAL_YOUTUBE_YTDLP_WORKERS", "4"))))
V38_COMMENT_WORKERS = max(1, min(8, int(os.getenv("SOCIAL_YOUTUBE_COMMENT_WORKERS", "4"))))
V38_COMMENT_API_RESERVE = max(250, int(os.getenv("SOCIAL_YOUTUBE_API_RESERVE", "1000")))
V38_COMMENT_BACKLOG_PER_CHANNEL = max(25, int(os.getenv("SOCIAL_YOUTUBE_COMMENT_BACKLOG", "250")))
V38_HEAVY_REPAIR_PER_CHANNEL = max(1, int(os.getenv("SOCIAL_YOUTUBE_HEAVY_REPAIR", "5")))
V38_ACTIVE_COMMENT_REFRESH_HOURS = max(1.0, float(os.getenv("SOCIAL_YOUTUBE_ACTIVE_COMMENT_REFRESH_HOURS", "24")))
V38_MATURE_COMMENT_REFRESH_HOURS = max(24.0, float(os.getenv("SOCIAL_YOUTUBE_MATURE_COMMENT_REFRESH_HOURS", "168")))
V38_DRAIN_LOG_SECONDS = 15.0

_V38_PIPELINE_LOCK = threading.RLock()
_V38_PIPELINE = None
_V38_PIPELINE_ACTIVE = False


def _v38_migrate_youtube_schema(db: youtube_Database) -> None:
    """Small additive migration only; never rewrites existing YouTube payload rows."""
    with db.lock:
        cols = {row[1] for row in db.conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        if "last_comments_refresh_at" not in cols:
            db.conn.execute("ALTER TABLE video_ingestion ADD COLUMN last_comments_refresh_at TEXT")
        if "last_comments_attempt_at" not in cols:
            db.conn.execute("ALTER TABLE video_ingestion ADD COLUMN last_comments_attempt_at TEXT")
        # This non-unique index speeds the manual UPSERT lookup without deleting or
        # changing any historical rows that may predate V38.
        db.conn.execute(
            "CREATE INDEX IF NOT EXISTS idx_comments_video_comment ON comments(video_id, comment_id)"
        )
        db.conn.commit()


def _v38_parse_utc(value: Any) -> Optional[datetime]:
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)
    except Exception:
        return None


def _v38_hours_since(value: Any) -> Optional[float]:
    dt = _v38_parse_utc(value)
    if dt is None:
        return None
    return max(0.0, (datetime.now(timezone.utc) - dt).total_seconds() / 3600.0)


def _v38_comments_complete(db: youtube_Database, state: Optional[dict]) -> bool:
    if not state:
        return False
    d = dict(state)
    vid = str(d.get("video_id") or "")
    if not vid:
        return False
    status = str(d.get("comments_status") or "").upper()
    if status not in {"SUCCESS", "SUCCESS_EMPTY"}:
        return False
    if status == "SUCCESS":
        with db.lock:
            row = db.conn.execute(
                "SELECT 1 FROM comments WHERE video_id=? LIMIT 1", (vid,)
            ).fetchone()
        if not row:
            return False
    return True


def _v38_comment_refresh_due(db: youtube_Database, video: dict, state: Optional[dict] = None) -> bool:
    state = dict(state or db.get_video_sync(str(video.get("video_id") or "")) or {})
    if not _v38_comments_complete(db, state):
        return True
    last = state.get("last_comments_refresh_at")
    if not last:
        # Upgrade path: a historical SUCCESS may predate the V38 timestamp.  Use
        # the newest persisted comment capture as evidence when one exists.
        vid = str(video.get("video_id") or state.get("video_id") or "")
        if vid:
            with db.lock:
                row = db.conn.execute(
                    "SELECT MAX(captured_at) FROM comments WHERE video_id=?", (vid,)
                ).fetchone()
            last = row[0] if row and row[0] else None
    elapsed = _v38_hours_since(last)
    if elapsed is None:
        return True
    age_days = youtube_video_age_days(video)
    threshold = (
        V38_ACTIVE_COMMENT_REFRESH_HOURS
        if age_days is None or age_days <= youtube_ACTIVE_VIDEO_DAYS
        else V38_MATURE_COMMENT_REFRESH_HOURS
    )
    return elapsed >= threshold


def _v38_youtube_complete(db: youtube_Database, state: Optional[dict], mode: str = "Maximum") -> bool:
    # Payload proof deliberately ignores the checkpoint bit, then V38 adds the
    # independent mandatory comment proof and finally requires COMPLETE.
    if not _v35_youtube_payload_complete(db, state, mode):
        return False
    if not _v38_comments_complete(db, state):
        return False
    return str((state or {}).get("enrichment_state") or "").upper() == "COMPLETE"


