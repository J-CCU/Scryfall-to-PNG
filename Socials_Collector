# ---------------------------------------------------------------------------
# Cheap, off-thread GUI statistics.  V42/V44 used to run several EXISTS scans
# plus COUNT(*) over multi-million-row evidence tables every two seconds on the
# Tk thread.  V46 samples indexed ingestion states and uses MAX(id) for append-
# only evidence tables, keeping the GUI informative without competing with the
# collector for SQLite pages.
# ---------------------------------------------------------------------------
def _v46_open_readonly(path: Path) -> Optional[sqlite3.Connection]:
    if not Path(path).exists():
        return None
    try:
        uri = Path(path).resolve().as_uri() + "?mode=ro"
        conn = sqlite3.connect(uri, uri=True, timeout=1.0)
    except Exception:
        conn = sqlite3.connect(str(path), timeout=1.0)
    try:
        conn.execute("PRAGMA query_only=ON")
        conn.execute("PRAGMA busy_timeout=1000")
    except Exception:
        pass
    return conn


def _v46_scalar(conn: sqlite3.Connection, sql: str, params: tuple = (), default=0):
    try:
        row = conn.execute(sql, params).fetchone()
        return default if not row or row[0] is None else row[0]
    except Exception:
        return default


def _v46_fast_rows(conn: sqlite3.Connection, table: str) -> int:
    # All large evidence tables in these collectors use monotonically increasing
    # integer IDs and are append/update oriented. MAX(id) is O(log n) on the PK
    # instead of scanning millions of rows. The GUI labels this as approximate.
    cols = _v42_table_columns(conn, table)
    if "id" in cols:
        return int(_v46_scalar(conn, f"SELECT COALESCE(MAX(id),0) FROM {table}") or 0)
    return int(_v46_scalar(conn, f"SELECT COUNT(*) FROM {table}") or 0)


def _v46_youtube_stats(path: Path) -> tuple[dict, dict, str]:
    empty = {"items":0,"complete":0,"payload":0,"core_payload":0,"pending":0,"comments_collected":0,"comments_empty":0,"comments_disabled":0,"comments_deferred":0,"comments_failed":0,"comments_pending":0,"comment_rows":0,"catalogs_verified":0,"catalogs_total":0}
    storage = {"canonical":0,"snapshots":0,"raw":0,"formats":0,"captions":0,"comments":0,"sidecars":0,"heavy_work":0,"comment_work":0}
    conn = _v46_open_readonly(path)
    if conn is None:
        return empty, storage, "API" if youtube_YOUTUBE_API_KEY else "yt-dlp fallback (no API key)"
    try:
        total = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion") or 0)
        complete = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE completeness_audit_status='COMPLETE' AND enrichment_state='COMPLETE'") or 0)
        payload = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE completeness_audit_status IN ('COMPLETE','MISSING_COMMENTS')") or 0)
        core = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE last_enriched_at IS NOT NULL AND yt_dlp_status='SUCCESS'") or 0)
        collected = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status='SUCCESS'") or 0)
        empty_comments = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status='SUCCESS_EMPTY'") or 0)
        disabled = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status IN ('COMMENTS_DISABLED','DISABLED')") or 0)
        deferred = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status LIKE 'DEFERRED%' OR comments_status IN ('RATE_LIMITED','STOPPED','PARTIAL','PENDING_UNVERIFIED_EMPTY')") or 0)
        failed = int(_v46_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status IN ('FAILED','ERROR')") or 0)
        catalogs_total = int(_v46_scalar(conn, "SELECT COUNT(*) FROM channels") or 0)
        catalogs_verified = int(_v46_scalar(conn, "SELECT COUNT(*) FROM channels WHERE index_complete='1' AND catalog_verification_version=?", (V39_CATALOG_PROOF_VERSION,)) or 0)
        comment_rows = _v46_fast_rows(conn, "comments")
        c = dict(empty)
        c.update(items=total, complete=complete, payload=payload, core_payload=core, pending=max(0,total-complete),
                 comments_collected=collected, comments_empty=empty_comments, comments_disabled=disabled,
                 comments_deferred=deferred, comments_failed=failed,
                 comments_pending=max(0,total-min(total,collected+empty_comments+disabled)),
                 comment_rows=comment_rows, catalogs_verified=catalogs_verified, catalogs_total=catalogs_total)
        storage.update(
            canonical=int(_v46_scalar(conn, "SELECT COUNT(*) FROM videos") or 0),
            snapshots=_v46_fast_rows(conn, "video_snapshots"), raw=_v46_fast_rows(conn, "raw_data"),
            formats=_v46_fast_rows(conn, "formats"), captions=_v46_fast_rows(conn, "caption_tracks"),
            comments=comment_rows,
            heavy_work=int(_v46_scalar(conn, "SELECT COUNT(*) FROM youtube_work_queue WHERE stage='heavy' AND state<>'DONE'") or 0),
            comment_work=int(_v46_scalar(conn, "SELECT COUNT(*) FROM youtube_work_queue WHERE stage='comments' AND state<>'DONE'") or 0),
        )
        source = "API"
        today = youtube_youtube_api_today_key()
        circuit_day = str(_v46_scalar(conn, "SELECT value FROM runtime_state WHERE key='youtube_api_circuit_day'", default="") or "")
        circuit_reason = str(_v46_scalar(conn, "SELECT value FROM runtime_state WHERE key='youtube_api_circuit_reason'", default="") or "")
        transient_until = float(_v46_scalar(conn, "SELECT value FROM runtime_state WHERE key='youtube_api_transient_cooldown_until'", default="0") or 0)
        fallback_until = float(_v46_scalar(conn, "SELECT value FROM runtime_state WHERE key='v46_ytdlp_comment_cooldown_until'", default="0") or 0)
        if circuit_day == today and circuit_reason:
            source = "yt-dlp fallback (daily quota)"
        elif transient_until > time.time():
            source = "yt-dlp fallback (API cooldown)"
        elif not youtube_YOUTUBE_API_KEY:
            source = "yt-dlp fallback (no API key)"
        if fallback_until > time.time() and source.startswith("yt-dlp"):
            source += " [fallback cooling]"
        return c, storage, source
    finally:
        conn.close()


def _v46_other_stats(path: Path, platform: str, comments_required: bool) -> tuple[dict, dict]:
