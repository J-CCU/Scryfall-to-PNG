def _v37_pick_inner_caption(v: dict, tracks: list) -> Optional[dict]:
    usable = [t for t in (tracks or []) if isinstance(t, dict) and t.get("baseUrl")]
    if not usable:
        return None
    preferred = str((v or {}).get("language") or "").strip().lower()
    def score(t):
        lang = str(t.get("languageCode") or "").lower()
        kind = str(t.get("kind") or "").lower()
        manual = 0 if kind != "asr" else 10
        if preferred and lang == preferred:
            lang_score = 0
        elif preferred and lang.split("-",1)[0] == preferred.split("-",1)[0]:
            lang_score = 1
        elif lang == "en":
            lang_score = 2
        elif lang.startswith("en-"):
            lang_score = 3
        else:
            lang_score = 8
        return (manual + lang_score, lang)
    return sorted(usable, key=score)[0]


