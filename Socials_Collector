def tiktok_resolve_account_v51(username: str, db: tiktok_Database, *, mode: str, force_refresh: bool = False) -> Optional[dict]:
    uname = tiktok_normalized_username(username)
    if not uname:
        return None
    key = f"v51_tiktok_resolve_retry_after:{uname.lower()}"
    if not force_refresh:
        # A verified cache always wins even while a prior failure cooldown exists.
        cached = db.cached_account_resolution(uname)
        if cached:
            return _v51_resolve_prev(uname, db, mode=mode, force_refresh=False)
        try:
            retry_after = float(db.get_runtime_state(key) or 0)
        except Exception:
            retry_after = 0.0
        if retry_after > time.time():
            tiktok_log(
                f"[resolve/v51] @{uname} unresolved cooldown | retry in "
                f"{max(1,int((retry_after-time.time())//60))}m | network resolve skipped"
            )
            return None
    result = _v51_resolve_prev(uname, db, mode=mode, force_refresh=force_refresh)
    if result:
        db.set_runtime_state(key, "")
        return result
    if not tiktok_tiktok_rate_limited():
        db.set_runtime_state(key, str(time.time() + V51_TIKTOK_RESOLVE_RETRY_SECONDS))
        tiktok_log(
            f"[resolve/v51] @{uname} unresolved | network retry deferred "
            f"{int(V51_TIKTOK_RESOLVE_RETRY_SECONDS//3600)}h"
        )
    return None


