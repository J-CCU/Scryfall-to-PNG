def youtube_video_refresh_interval_hours(video: dict) -> float:
    age = youtube_video_age_days(video)
    if age is None:
        return youtube_MATURE_VIDEO_REFRESH_HOURS
    if age < 1:
        return 1.0
    if age < 7:
        return 6.0
    if age < youtube_ACTIVE_VIDEO_DAYS:
        return 24.0
    return float(youtube_MATURE_VIDEO_REFRESH_HOURS)


def youtube_state_is_complete(state: Optional[dict], mode: str) -> bool:
    if not state or not state.get("last_enriched_at"):
        return False
    okay = {"SUCCESS", "SKIPPED_NO_API_KEY"}
    if state.get("yt_dlp_status") not in okay:
        return False
    if state.get("player_status") not in okay:
        return False
    if mode == "Maximum":
        format_caption_ok = {"SUCCESS", "SKIPPED_NO_API_KEY", "SUCCESS_EMPTY"}
        if state.get("captions_status") not in format_caption_ok:
            return False
        if state.get("formats_status") not in format_caption_ok:
            return False
        # Individual video comments are disabled. Existing comment-stage states
        # must never make an otherwise complete video eligible for re-enrichment.
    return True


def youtube_heavy_refresh_due(state: Optional[dict], video: dict, mode: str) -> bool:
    if mode != "Maximum":
        return False
    if not youtube_state_is_complete(state, mode):
        return True
    age = youtube_video_age_days(video)
    if age is None or age > youtube_ACTIVE_VIDEO_DAYS:
        return False
    last = state.get("last_heavy_refresh_at") or state.get("last_enriched_at")
    elapsed = youtube_hours_since(last)
    return elapsed is None or elapsed >= youtube_HEAVY_REFRESH_HOURS


def youtube_choose_video_action(db: youtube_Database, video: dict, mode: str, force_refresh: bool = False) -> str:
    state = db.get_video_sync(video["video_id"])
    if state is None:
        return "NEW"
    if force_refresh:
        return "FORCE"
    if not youtube_state_is_complete(state, mode):
        return "RESUME"
    if youtube_heavy_refresh_due(state, video, mode):
        return "HEAVY_REFRESH"
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = youtube_hours_since(last)
    if elapsed is None or elapsed >= youtube_video_refresh_interval_hours(video):
        return "PERFORMANCE_REFRESH"
    return "SKIP"


def youtube_refresh_performance_batch_via_youtube_api(run_id: int, db: "Database", videos: List[dict]) -> int:
    """Refresh views/likes/comments for performance-only actions without yt-dlp calls."""
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not videos:
        return 0
    youtube_log(f"  [youtube-api] performance refresh START | videos={len(videos)} | batch_size={youtube_YOUTUBE_API_VIDEO_BATCH_SIZE}")
    updated = youtube_youtube_api_enrich_videos_batch(run_id, db, videos)
    committed = 0
    for v in videos:
        state = db.get_video_sync(v.get("video_id", "")) or {}
        v["yt_dlp_status"] = state.get("yt_dlp_status") or "SUCCESS"
        v["player_status"] = state.get("player_status") or "SUCCESS"
        v["comments_status"] = state.get("comments_status") or "SUCCESS_EMPTY"
        v["captions_status"] = state.get("captions_status") or "SUCCESS_EMPTY"
        v["formats_status"] = state.get("formats_status") or "SUCCESS_EMPTY"
        db.upsert_video(v)
        db.video_snapshot(run_id, v)
        db.mark_video_enrichment(run_id, v, full=False, heavy=False)
        committed += 1
    youtube_log(f"  [youtube-api] performance refresh COMPLETE | api_updated={updated} | db_committed={committed}")
    return committed


def youtube_enrich_video_with_rate_limit_retry(
    run_id: int,
    db: youtube_Database,
    video: dict,
    mode: str,
    action: str,
) -> dict:
    """Enrich one video, waiting through a yt-dlp rate limit and retrying that same video first."""
    retry_no = 0
    while True:
        if youtube_stop_requested():
            return video
        retry_no += 1
        result = youtube_enrich_video(run_id, db, video, mode, action=action)
        if video.get("yt_dlp_status") != "RATE_LIMITED" and not youtube_ytdlp_rate_limited():
            # A successful retry clears any stale pending pointer left by a prior attempt.
            if retry_no > 1:
                youtube_clear_ytdlp_rate_limit(db)
                with youtube_YTDLP_RATE_LIMIT_LOCK:
                    global youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF, youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER
                    youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF += 1
                    if youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF >= 25 and youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER > 1.0:
                        youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER = max(1.0, youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER * 0.75)
                        youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF = 0
                youtube_log(
                    f"      [throttle] RETRY SUCCESS | video={video.get('video_id','')} | "
                    f"attempt={retry_no} | resuming normal queue"
                )
            return result

        pending_id = video.get("video_id", "")
        youtube_set_ytdlp_rate_limit(
            "yt-dlp rate limit triggered for video",
            db,
            video_id=pending_id,
            channel_id=video.get("channel_id", ""),
            run_id=run_id,
            action=action,
        )
        youtube_persist_ytdlp_rate_limit(db)
        youtube_log(
            f"      [throttle] video parked safely | video={pending_id} | "
            f"retry_attempt={retry_no} | committed catalog/state retained"
        )
        if not youtube_wait_for_ytdlp_rate_limit_clear(db, pending_video_id=pending_id):
            return result
        youtube_log(
            f"      [throttle] RETRYING THROTTLED VIDEO FIRST | video={pending_id} | "
            f"attempt={retry_no + 1}"
        )
        # Loop immediately on the exact same video; do not advance the queue.

# FINAL VIDEO ENRICHMENT
# ============================================================================

def youtube_enrich_video(run_id: int, db: youtube_Database, v: dict, mode: str, action: str = "NEW") -> dict:
    maximum = mode == "Maximum" and action in {"NEW", "RESUME", "FORCE", "HEAVY_REFRESH"}
    refresh_only = action == "PERFORMANCE_REFRESH"

    started_at = time.monotonic()
    try:
        if youtube_stop_requested():
            return v
        # Existing videos due for an update get lightweight performance
        # refreshes only. Individual video comments are disabled; captions and
        # formats remain available in Maximum mode.
        youtube_log(f"      [stage] yt-dlp START | video={v.get('video_id','')} | maximum={'yes' if maximum and not refresh_only else 'no'}")
        ytdlp_info = youtube_fetch_ytdlp_video(run_id, db, v, mode, maximum and not refresh_only)
        if v.get("yt_dlp_status") == "RATE_LIMITED" or youtube_ytdlp_rate_limited():
            youtube_persist_ytdlp_rate_limit(db)
            remaining = youtube_ytdlp_rate_limit_remaining()
            youtube_log(
                f"      [throttle] rate-limit pause engaged after yt-dlp | video={v.get('video_id','')} | "
                f"remaining={remaining // 60}m {remaining % 60}s"
            )
            db.mark_video_enrichment(
                run_id, v, full=False, heavy=False,
                error="YouTube yt-dlp session rate-limited; video left incomplete for safe resume."
            )
            return v
        if v.get("yt_dlp_status") == "SUCCESS":
            db.mark_video_stage(v["video_id"], "yt_dlp", "SUCCESS")
        else:
            db.mark_video_stage(v["video_id"], "yt_dlp", v.get("yt_dlp_status", "FAILED"))

        if youtube_stop_requested():
            return v
        player_data = None
        fast_path = bool(
            youtube_THROUGHPUT_PROFILE == "high"
            and youtube_SKIP_INNERTUBE_PLAYER_IN_HIGH_THROUGHPUT
            and ytdlp_info
            and not refresh_only
        )
        if refresh_only:
            youtube_log(f"      [stage] InnerTube player SKIPPED | performance refresh only | video={v.get('video_id','')}")
            db.mark_video_stage(v["video_id"], "player", "SKIPPED_PERFORMANCE_REFRESH")
        elif fast_path:
            youtube_log(f"      [stage] InnerTube player SKIPPED | yt-dlp fast path | video={v.get('video_id','')}")
            db.mark_video_stage(v["video_id"], "player", "SKIPPED_FAST_PATH")
        else:
            youtube_log(f"      [stage] InnerTube player START | video={v.get('video_id','')}")
            player_data = youtube_fetch_inner_player(run_id, db, v)
        if player_data:
            youtube_log(f"      [stage] InnerTube player COMPLETE | video={v.get('video_id','')}")
            db.mark_video_stage(v["video_id"], "player", "SUCCESS")
            db.mark_video_stage(v["video_id"], "formats", "SUCCESS" if youtube_extract_inner_formats(player_data) else "SUCCESS_EMPTY")
        elif fast_path:
            db.mark_video_stage(v["video_id"], "formats", "SUCCESS_FAST_PATH")
        elif not youtube_INNERTUBE_API_KEY:
            db.mark_video_stage(v["video_id"], "player", "SKIPPED_NO_API_KEY")

        if youtube_stop_requested():
            return v
        if maximum and fast_path and ytdlp_info:
            try:
                youtube_log(f"      [maximum/fast] captions START | video={v.get('video_id','')}")
                caption_count = youtube_fetch_ytdlp_caption_content(run_id, db, v, ytdlp_info)
                db.mark_video_stage(v["video_id"], "captions", "SUCCESS" if caption_count else "SUCCESS_EMPTY")
                youtube_log(f"      [maximum/fast] captions={caption_count} | db_status={'SUCCESS' if caption_count else 'SUCCESS_EMPTY'}")
            except Exception as exc:
                db.mark_video_stage(v["video_id"], "captions", "FAILED")
                db.error(
                    run_id, channel_id=v.get("channel_id"), video_id=v.get("video_id"),
                    stage="captions", endpoint="yt-dlp captionTracks", status=None,
                    exc_type=type(exc).__name__, message=str(exc), detail=traceback.format_exc(),
                )
        elif maximum and player_data:
            try:
                youtube_log(f"      [maximum] captions START | video={v.get('video_id','')}")
                caption_count = youtube_fetch_caption_content(run_id, db, v, player_data)
                db.mark_video_stage(v["video_id"], "captions", "SUCCESS" if caption_count else "SUCCESS_EMPTY")
                youtube_log(f"      [maximum/InnerTube] captions={caption_count} | db_status={'SUCCESS' if caption_count else 'SUCCESS_EMPTY'}")
            except Exception as exc:
                db.mark_video_stage(v["video_id"], "captions", "FAILED")
                db.error(
                    run_id, channel_id=v.get("channel_id"), video_id=v.get("video_id"),
                    stage="captions", endpoint="captionTracks", status=None,
                    exc_type=type(exc).__name__, message=str(exc), detail=traceback.format_exc(),
                )
        elif maximum and not player_data and not fast_path and not youtube_INNERTUBE_API_KEY:
            db.mark_video_stage(v["video_id"], "captions", "SKIPPED_NO_API_KEY")

        if maximum and not youtube_stop_requested():
            # Individual video comments are disabled for performance. The
            # scalar comment_count field is still retained from video metadata.
            db.mark_video_stage(v["video_id"], "comments", "SKIPPED_DISABLED")
        v["classification"] = youtube_classify_video(v)
        youtube_log(f"      [db] upsert videos | {v.get('video_id','')}")
        db.upsert_video(v)
        youtube_log(f"      [db] insert video_snapshot | run={run_id} | {v.get('video_id','')}")
        db.video_snapshot(run_id, v)
        db.mark_video_enrichment(
            run_id, v,
            full=not refresh_only,
            heavy=maximum and not refresh_only,
        )
        youtube_log(
            f"      [db] ingestion state updated | full={'yes' if not refresh_only else 'no'} "
            f"heavy={'yes' if maximum and not refresh_only else 'no'} | elapsed={time.monotonic() - started_at:.1f}s"
        )
        return v
    except Exception as exc:
        db.mark_video_enrichment(run_id, v, full=False, heavy=False, error=f"{type(exc).__name__}: {exc}")
        raise


