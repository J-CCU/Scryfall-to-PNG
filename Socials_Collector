def _v23_business_media_rows(account: dict) -> list[dict]:
    data = account.get("_business_discovery_raw") or {}
    media = data.get("media") if isinstance(data, dict) else None
    items = media.get("data") if isinstance(media, dict) else []
    rows = []
    for item in items or []:
        if not isinstance(item, dict):
            continue
        ts = str(item.get("timestamp") or "")
        try:
            epoch = int(datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()) if ts else None
        except Exception:
            epoch = None
        media_type = str(item.get("media_type") or "")
        rows.append({
            "post_id": str(item.get("id") or ""),
            "shortcode": "",
            "account_id": str(account.get("account_id") or ""),
            "username": str(account.get("username") or ""),
            "typename": media_type,
            "taken_at": ts,
            "published_epoch": epoch,
            "caption": str(item.get("caption") or ""),
            "likes": instagram_safe_int(item.get("like_count")),
            "comments_count": instagram_safe_int(item.get("comments_count")),
            "video_view_count": None,
            "video_duration": None,
            "width": None,
            "height": None,
            "is_video": "YES" if media_type.upper() in {"VIDEO", "REELS"} else "NO",
            "is_sponsored": "NO",
            "is_pinned": "NO",
            "display_url": str(item.get("media_url") or ""),
            "video_url": str(item.get("media_url") or "") if media_type.upper() in {"VIDEO", "REELS"} else "",
            "thumbnail_url": str(item.get("thumbnail_url") or item.get("media_url") or ""),
            "post_url": str(item.get("permalink") or ""),
            "media_product_type": str(item.get("media_product_type") or ""),
            "graph_raw": item,
            "_business_discovery": True,
        })
    return rows


