    instagram_STOP_EVENT.set()


def instagram_normalized_username(value: str) -> str:
    s = str(value or "").strip()
    if not s:
        return ""
    if s.startswith("@"):
        s = s[1:]
    if "instagram.com" in s.lower():
        parsed = urlparse(s if re.match(r"^https?://", s, re.I) else "https://" + s)
        parts = [p for p in parsed.path.split("/") if p]
        if parts:
            s = parts[0]
    s = s.split("?")[0].split("#")[0].strip("/")
    return s


def instagram_shortcode_from_url(url: str) -> str:
    try:
        parsed = urlparse(url if re.match(r"^https?://", url, re.I) else "https://" + url)
        parts = [p for p in parsed.path.split("/") if p]
        for prefix in ("p", "reel", "tv"):
            if prefix in parts:
                i = parts.index(prefix)
                if i + 1 < len(parts):
                    return parts[i + 1]
    except Exception:
        pass
    return ""


def instagram_normalize_input(value: str) -> Tuple[str, str]:
    raw = str(value or "").strip()
    if not raw:
        return "", ""
    if re.match(r"^https?://", raw, re.I) and "instagram.com" in raw.lower():
        code = instagram_shortcode_from_url(raw)
        if code:
            return "post_url", raw
        return "username", instagram_normalized_username(raw)
    if raw.startswith("/") and raw.count("/") >= 2:
        code = instagram_shortcode_from_url("https://instagram.com" + raw)
        if code:
            return "post_url", "https://instagram.com" + raw
    return "username", instagram_normalized_username(raw)


def instagram_post_url(shortcode: str) -> str:
    return f"{instagram_INSTAGRAM}/p/{shortcode}/" if shortcode else ""


def instagram_reel_url(shortcode: str) -> str:
    return f"{instagram_INSTAGRAM}/reel/{shortcode}/" if shortcode else ""


def instagram_canonical_post_url(shortcode: str, typename: str = "") -> str:
    if not shortcode:
        return ""
    if "VIDEO" in typename.upper() or "REEL" in typename.upper():
        return instagram_reel_url(shortcode)
    return instagram_post_url(shortcode)


