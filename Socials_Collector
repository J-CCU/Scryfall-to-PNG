# V40: Windows-safe Pacific quota-day helper.  Python on Windows commonly has
# no IANA timezone database unless the optional tzdata package is installed.
# Prefer ZoneInfo when available, but never require it for collector startup.
_V40_PACIFIC_TZ_FALLBACK_LOGGED = False

def _v40_pacific_day_key(now_utc: Optional[datetime] = None) -> str:
    global _V40_PACIFIC_TZ_FALLBACK_LOGGED
    if now_utc is None:
        try:
            return datetime.now(ZoneInfo("America/Los_Angeles")).strftime("%Y-%m-%d")
        except Exception as exc:
            now_utc = datetime.now(timezone.utc)
            if not _V40_PACIFIC_TZ_FALLBACK_LOGGED:
                _V40_PACIFIC_TZ_FALLBACK_LOGGED = True
                try:
                    print(
                        f"[timezone/v40] IANA Pacific timezone unavailable ({type(exc).__name__}); "
                        "using built-in PST/PDT quota-day fallback; no tzdata package required",
                        flush=True,
                    )
                except Exception:
                    pass
    elif now_utc.tzinfo is None:
        now_utc = now_utc.replace(tzinfo=timezone.utc)
    else:
        now_utc = now_utc.astimezone(timezone.utc)

    # Current US Pacific DST rules (Energy Policy Act rules, in force since 2007):
    # DST starts on the second Sunday in March at 02:00 PST == 10:00 UTC,
    # and ends on the first Sunday in November at 02:00 PDT == 09:00 UTC.
    # We only need the local calendar day used by YouTube's Pacific-time quota reset.
    year = now_utc.year
    march8 = datetime(year, 3, 8, tzinfo=timezone.utc)
    second_sunday_march = 8 + ((6 - march8.weekday()) % 7)
    nov1 = datetime(year, 11, 1, tzinfo=timezone.utc)
    first_sunday_nov = 1 + ((6 - nov1.weekday()) % 7)
    dst_start_utc = datetime(year, 3, second_sunday_march, 10, 0, 0, tzinfo=timezone.utc)
    dst_end_utc = datetime(year, 11, first_sunday_nov, 9, 0, 0, tzinfo=timezone.utc)
    offset_seconds = -7 * 3600 if dst_start_utc <= now_utc < dst_end_utc else -8 * 3600
    pacific_epoch = now_utc.timestamp() + offset_seconds
    return datetime.fromtimestamp(pacific_epoch, timezone.utc).strftime("%Y-%m-%d")

def youtube_youtube_api_today_key() -> str:
    return _v40_pacific_day_key()


def youtube_youtube_api_budget_available(db: Optional["Database"] = None) -> bool:
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
        return False
    try:
        today = youtube_youtube_api_today_key()
        if db is None:
            with youtube_YOUTUBE_API_REQUEST_LOCK:
                return youtube_YOUTUBE_API_REQUEST_COUNT < youtube_YOUTUBE_API_DAILY_BUDGET
        stored_day = db.get_runtime_state("youtube_api_quota_day")
        if stored_day != today:
            db.set_runtime_state("youtube_api_quota_day", today)
            db.set_runtime_state("youtube_api_quota_used", "0")
            return True
        used = youtube_safe_int(db.get_runtime_state("youtube_api_quota_used")) or 0
        return used < youtube_YOUTUBE_API_DAILY_BUDGET
    except Exception:
        return True


def youtube_youtube_api_note_request(db: Optional["Database"] = None) -> int:
    global youtube_YOUTUBE_API_REQUEST_COUNT
    with youtube_YOUTUBE_API_REQUEST_LOCK:
        youtube_YOUTUBE_API_REQUEST_COUNT += 1
        n = youtube_YOUTUBE_API_REQUEST_COUNT
    if db is not None:
        try:
            today = youtube_youtube_api_today_key()
            if db.get_runtime_state("youtube_api_quota_day") != today:
                db.set_runtime_state("youtube_api_quota_day", today)
                db.set_runtime_state("youtube_api_quota_used", "1")
            else:
                used = youtube_safe_int(db.get_runtime_state("youtube_api_quota_used")) or 0
                db.set_runtime_state("youtube_api_quota_used", str(used + 1))
        except Exception:
            pass
    return n


def youtube_youtube_api_get(endpoint: str, params: dict, *, db: Optional["Database"] = None, run_id: Optional[int] = None, note: str = "") -> Tuple[Optional[dict], int, str]:
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_youtube_api_budget_available(db):
        return None, 0, "YouTube Data API unavailable or daily budget reached"
    try:
        q = dict(params)
        q["key"] = youtube_YOUTUBE_API_KEY
        started = time.monotonic()
        r = youtube_SESSION.get(f"https://www.googleapis.com/youtube/v3/{endpoint}", params=q, timeout=youtube_REQUEST_TIMEOUT, headers={"User-Agent": youtube_UA})
        req_no = youtube_youtube_api_note_request(db)
        youtube_debug(f"[youtube-api] {endpoint} request #{req_no} | status={r.status_code} | elapsed={time.monotonic()-started:.2f}s | note={note}")
        if r.status_code != 200:
            return None, r.status_code, r.text[:4000]
        return r.json(), r.status_code, r.text
    except Exception as exc:
        return None, 0, str(exc)


def youtube_parse_iso8601_duration(value: str) -> Optional[int]:
    if not value or not str(value).startswith("P"):
        return None
    m = re.fullmatch(r"P(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9]+(?:\.[0-9]+)?)S)?)?", str(value))
    if not m:
        return None
    return int(m.group(1) or 0) * 86400 + int(m.group(2) or 0) * 3600 + int(m.group(3) or 0) * 60 + int(float(m.group(4) or 0))


def youtube_youtube_api_discover_videos(run_id: int, db: "Database", channel_id: str, limit: int) -> Tuple[List[dict], bool]:
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_youtube_api_budget_available(db):
        return [], False
    playlist_id = youtube_uploads_playlist(channel_id)
    if not playlist_id:
        return [], False
    videos = []
    token = ""
    while True:
        if youtube_stop_requested():
            return videos, False
        params = {"part": "snippet,contentDetails,status", "playlistId": playlist_id, "maxResults": youtube_YOUTUBE_API_PLAYLIST_PAGE_SIZE}
        if token:
            params["pageToken"] = token
        data, status, body = youtube_youtube_api_get("playlistItems", params, db=db, run_id=run_id, note="channel_video_discovery")
        if not data:
            db.error(run_id, channel_id=channel_id, stage="youtube_api_discovery", endpoint="playlistItems", status=status, exc_type="YouTubeAPIError", message="playlistItems request failed", detail=body[:2000])
            return videos, False
        raw_id = db.raw(run_id, channel_id=channel_id, video_id=None, source="youtube_api", endpoint="playlistItems", status=status, payload=data, content_type="application/json", note="channel_video_discovery")
        for item in data.get("items") or []:
            snippet = item.get("snippet") or {}
            content = item.get("contentDetails") or {}
            vid = content.get("videoId") or (snippet.get("resourceId") or {}).get("videoId")
            published = content.get("videoPublishedAt") or snippet.get("publishedAt") or ""
            if not vid:
                continue
            ts = None
            if published:
                try:
                    ts = int(datetime.fromisoformat(published.replace("Z", "+00:00")).timestamp())
                except Exception:
                    pass
            thumbs = snippet.get("thumbnails") or {}
            thumb = (thumbs.get("high") or thumbs.get("default") or {}).get("url", "")
            videos.append({"video_id": vid, "channel_id": channel_id, "title": snippet.get("title") or "", "description": snippet.get("description") or "", "published_text": published, "upload_date": published[:10], "timestamp": ts, "duration_seconds": None, "view_count": None, "like_count": None, "comment_count": None, "channel_name": snippet.get("channelTitle") or "", "uploader_id": channel_id, "category": "", "language": "", "availability": "", "age_limit": None, "live_status": "", "classification": "Longform", "is_live": "", "is_short": "", "is_premiere": "", "is_family_safe": "", "is_monetized": "", "has_paid_promotion": "", "is_premium_content": "", "thumbnail_url": thumb or f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg", "webpage_url": f"https://www.youtube.com/watch?v={vid}", "listing_status": "SUCCESS", "player_status": "NOT_FETCHED", "yt_dlp_status": "NOT_FETCHED", "raw_listing_id": raw_id, "raw_player_id": None, "raw_ytdlp_id": None, "source_raw_listing": item})
            if limit > 0 and len(videos) >= limit:
                return youtube_unique_by_id(videos[:limit], "video_id"), True
        token = data.get("nextPageToken") or ""
        if not token:
            return youtube_unique_by_id(videos, "video_id"), True


def youtube_youtube_api_enrich_videos_batch(run_id: int, db: "Database", videos: List[dict]) -> int:
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not videos:
        return 0
    updated = 0
    for start in range(0, len(videos), youtube_YOUTUBE_API_VIDEO_BATCH_SIZE):
        if youtube_stop_requested() or not youtube_youtube_api_budget_available(db):
            break
        batch = videos[start:start + youtube_YOUTUBE_API_VIDEO_BATCH_SIZE]
        ids = [v.get("video_id") for v in batch if v.get("video_id")]
        data, status, body = youtube_youtube_api_get("videos", {"part": "snippet,contentDetails,statistics,status,topicDetails,liveStreamingDetails,recordingDetails", "id": ",".join(ids)}, db=db, run_id=run_id, note=f"video_batch_{start+1}_{start+len(ids)}")
        if not data:
            youtube_log(f"  [youtube-api] video batch FAILED | start={start+1} count={len(ids)} status={status}")
            continue
        raw_id = db.raw(run_id, channel_id=None, video_id=None, source="youtube_api", endpoint="videos", status=status, payload=data, content_type="application/json", note="video_batch_enrichment")
        by_id = {i.get("id"): i for i in data.get("items") or []}
        for v in batch:
            item = by_id.get(v.get("video_id"))
            if not item:
                continue
            sn = item.get("snippet") or {}
            st = item.get("statistics") or {}
            cd = item.get("contentDetails") or {}
            if sn.get("title"): v["title"] = sn["title"]
            if sn.get("description"): v["description"] = sn["description"]
            pub = sn.get("publishedAt") or v.get("published_text") or ""
            if pub:
                v["published_text"] = pub; v["upload_date"] = pub[:10]
                try: v["timestamp"] = int(datetime.fromisoformat(pub.replace("Z", "+00:00")).timestamp())
                except Exception: pass
            if cd.get("duration"): v["duration_seconds"] = youtube_parse_iso8601_duration(cd["duration"])
            v["view_count"] = youtube_safe_int(st.get("viewCount")); v["like_count"] = youtube_safe_int(st.get("likeCount")); v["comment_count"] = youtube_safe_int(st.get("commentCount"))
            v["language"] = sn.get("defaultAudioLanguage") or sn.get("defaultLanguage") or v.get("language", "")
            v["category"] = sn.get("categoryId") or v.get("category", "")
            v["_youtube_api_raw_id"] = raw_id
            v["_youtube_api_item"] = item
            updated += 1
    youtube_log(f"  [youtube-api] batched video enrichment COMPLETE | updated={updated}/{len(videos)}")
    return updated


