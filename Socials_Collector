# ===========================================================================
# V28 — hard-isolated three-platform lifecycle
# ===========================================================================
# V28 intentionally replaces the scheduler lifecycle instead of wrapping its
# completion semantics.  Each platform owns its subprocess, slot thread,
# restart/backoff state and completion state.  A child exiting successfully can
# never signal global shutdown.  The master exits only after explicit End or
# Force Stop.
V28_BUILD = "ALL_FIXES_V28_HARD_ISOLATED_PLATFORM_LIFECYCLE"

class UnifiedSchedulerV28(UnifiedSchedulerV23):
    RESTART_GUARD_SECONDS = 3.0

    def __init__(self, app: "UnifiedApp") -> None:
        super().__init__(app)
        self.shutdown_event = threading.Event()
        self.graceful_end_requested = False
        self.slot_stop_events = {p.key: threading.Event() for p in UNIFIED_PLATFORMS}
        self.slot_generation = {p.key: 0 for p in UNIFIED_PLATFORMS}
        self.slot_last_activity = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.slot_last_exit = {p.key: "" for p in UNIFIED_PLATFORMS}
        self._slot_restart_after = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        # Compatibility only.  V28 never uses this event to represent child
        # completion; it is set only during explicit global shutdown.
        self.stop_event = self.shutdown_event

    @property
    def running(self) -> bool:
        return self.thread is not None and self.thread.is_alive() and not self.shutdown_event.is_set()

    def start(self, inputs, limit, mode, force_refresh, continuous,
              high_throughput, extended_surfaces, collect_comments=False) -> None:
        if self.running:
            return
        if not any(inputs.get(p.key) for p in UNIFIED_PLATFORMS):
            self.ui_log("[multiplatform/v28] No platform inputs supplied.\n")
            return

        self.shutdown_event.clear()
        self.wake_event.clear()
        self.graceful_end_requested = False
        self.processes.clear()
        self.slot_threads.clear()
        for ev in self.slot_stop_events.values():
            ev.clear()
        self.slot_generation = {p.key: 0 for p in UNIFIED_PLATFORMS}
        self.slot_last_activity = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.slot_last_exit = {p.key: "" for p in UNIFIED_PLATFORMS}
        self._slot_restart_after = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.collect_comments_enabled = bool(collect_comments)
        self.inputs = {p.key: list(inputs.get(p.key) or []) for p in UNIFIED_PLATFORMS}
        self.limit = int(limit)
        self.mode = str(mode)
        self.force_refresh = bool(force_refresh)
        self.continuous = bool(continuous)
        self.high_throughput = bool(high_throughput)
        self.extended_surfaces = bool(extended_surfaces)
        self.platform_runs = {}
        self.platform_failures = {p.key: 0 for p in UNIFIED_PLATFORMS}
        self.platform_reasons = {p.key: "" for p in UNIFIED_PLATFORMS}
        self.platform_cooldown_until = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.platform_states = {p.key: ("READY" if self.inputs.get(p.key) else "EMPTY") for p in UNIFIED_PLATFORMS}

        self.ui_log("[server/v28] HARD-ISOLATED lifecycle | child COMPLETE cannot stop master or siblings\n")
        self.thread = threading.Thread(target=self._main, name="UnifiedSchedulerV28-Master", daemon=True)
        self.thread.start()

    def _slot_should_stop(self, key: str) -> bool:
        return self.shutdown_event.is_set() or self.slot_stop_events[key].is_set()

    def _interruptible_wait(self, key: str, seconds: float) -> bool:
        end = time.monotonic() + max(0.0, seconds)
        while time.monotonic() < end:
            if self._slot_should_stop(key) or self.graceful_end_requested:
                return False
            self.wake_event.wait(min(0.5, max(0.0, end - time.monotonic())))
            self.wake_event.clear()
        return not self._slot_should_stop(key) and not self.graceful_end_requested

    def _run_platform_process_v28(self, platform: UnifiedPlatform) -> str:
        key = platform.key
        inputs = self.inputs.get(key) or []
        if not inputs:
            self.ui_platform(key, "EMPTY")
            return "EMPTY"

        job_path = self._write_job(platform)
        explicit_pause = False
        explicit_access_block = False
        rc = -1
        proc = None
        self.ui_platform(key, "RUNNING")
        self.platform_runs[key] = self.platform_runs.get(key, 0) + 1
        generation = self.slot_generation.get(key, 0)
        self.slot_last_activity[key] = time.time()
        self.ui_log(
            f"\n[multiplatform/v28] >>> {platform.label} | generation={generation} | "
            f"worker_run={self.platform_runs[key]} | inputs={len(inputs)} | "
            f"limit={'ALL' if self.limit <= 0 else self.limit}\n"
        )
        try:
            cmd = [sys.executable, str(Path(__file__).resolve()), "--platform-worker", key, str(job_path)]
            proc = subprocess.Popen(
                cmd, cwd=str(BASE_DIR), env=self._worker_env(platform),
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                encoding="utf-8", errors="replace", bufsize=1,
            )
            with self.process_lock:
                self.processes[key] = proc
            self.ui_log(f"[multiplatform/v28] {platform.label} PID={proc.pid} | isolated subprocess started\n")

            if proc.stdout is not None:
                for raw in proc.stdout:
                    self.slot_last_activity[key] = time.time()
                    if self._slot_should_stop(key):
                        break
                    line = raw.rstrip("\n")
                    if line.startswith("[PROGRESS]|"):
                        parts = line.split("|", 3)
                        if len(parts) == 4:
                            try:
                                self.app.enqueue_ui(("progress", key, int(parts[1]), int(parts[2]), parts[3]))
                            except Exception:
                                pass
                        if self.graceful_end_requested:
                            self.ui_log(f"[control/v28] {platform.label} item committed; stopping this worker at boundary.\n")
                            try:
                                if proc.poll() is None:
                                    proc.terminate()
                            except Exception:
                                pass
                            break
                    self.ui_log(line + "\n")
                    lower = line.lower()
                    is_access_block = key == "instagram" and "[orchestrator]" in lower and "access-blocked" in lower
                    is_explicit_throttle = "[throttle]" in lower and any(p.search(line) for p in platform.throttle_patterns)
                    is_orchestrator_pause = "[orchestrator]" in lower and any(p.search(line) for p in platform.throttle_patterns)
                    is_tiktok_challenge = key == "tiktok" and "challenge/verification" in lower
                    if is_access_block or is_explicit_throttle or is_orchestrator_pause or is_tiktok_challenge:
                        explicit_pause = True
                        explicit_access_block = bool(is_access_block or is_tiktok_challenge)
                        self.platform_reasons[key] = line[:500]
                        try:
                            if proc.poll() is None:
                                proc.terminate()
                        except Exception:
                            pass
                        break

            try:
                rc = proc.wait(timeout=10.0) if proc is not None else -1
            except Exception:
                try:
                    if proc is not None and proc.poll() is None:
                        proc.terminate()
                    rc = proc.wait(timeout=3.0) if proc is not None else -1
                except Exception:
                    rc = proc.poll() if proc is not None and proc.poll() is not None else -1
        except BaseException as exc:
            self.platform_reasons[key] = f"{type(exc).__name__}: {exc}"[:500]
            self.ui_log(f"[multiplatform/v28] {platform.label} worker exception | {type(exc).__name__}: {exc}\n")
            rc = -1
        finally:
            with self.process_lock:
                if self.processes.get(key) is proc:
                    self.processes.pop(key, None)
            try:
                job_path.unlink(missing_ok=True)
            except Exception:
                pass
            self.slot_last_activity[key] = time.time()

        if self._slot_should_stop(key) or self.graceful_end_requested:
            self.ui_platform(key, "STOPPED")
            return "STOPPED"

        until = self._cooldown_until(platform)
        if explicit_access_block:
            if until <= time.time():
                until = time.time() + (900.0 if key == "tiktok" else 600.0)
            self.ui_platform(key, "ACCESS_BLOCKED")
            self.ui_cooldown(key, until)
            return "ACCESS_BLOCKED"
        if explicit_pause or until > time.time():
            if until <= time.time():
                until = time.time() + 60.0
            self.ui_platform(key, "COOLDOWN")
            self.ui_cooldown(key, until)
            return "COOLDOWN"
        if rc == 0:
            self.platform_failures[key] = 0
            self.platform_reasons[key] = ""
            self.ui_platform(key, "COMPLETE")
            self.ui_log(
                f"[multiplatform/v28] <<< {platform.label} PASS COMPLETE | "
                "master=ALIVE | siblings=UNTOUCHED\n"
            )
            return "COMPLETE"

        self.platform_failures[key] = self.platform_failures.get(key, 0) + 1
        self.ui_platform(key, "RETRYING")
        return "FAILED"

    def _platform_loop_v28(self, platform: UnifiedPlatform, generation: int) -> None:
        key = platform.key
        try:
            pre_state, pre_reason = v20_preflight(platform, self.inputs.get(key, []))
            self.platform_reasons[key] = pre_reason
            self.ui_log(f"[preflight/v28/{key}] {pre_state} | {pre_reason}\n")
            if pre_state == "FAILED":
                self.ui_platform(key, "FAILED")
                return

            while not self._slot_should_stop(key) and not self.graceful_end_requested:
                until = self._cooldown_until(platform)
                if until > time.time():
                    kind = self._cooldown_kind(platform)
                    self.ui_platform(key, kind)
                    self.ui_cooldown(key, until)
                    while time.time() < until and not self._slot_should_stop(key) and not self.graceful_end_requested:
                        self._interruptible_wait(key, min(1.0, max(0.0, until-time.time())))
                    if self._slot_should_stop(key) or self.graceful_end_requested:
                        break

                status = self._run_platform_process_v28(platform)
                self.slot_last_exit[key] = status
                if status in {"STOPPED", "EMPTY"}:
                    break
                if status == "COMPLETE":
                    if not self.continuous:
                        # Slot remains complete, but master and siblings remain alive.
                        self.ui_log(f"[multiplatform/v28] {platform.label} parked COMPLETE; siblings continue.\n")
                        while not self._slot_should_stop(key) and not self.graceful_end_requested:
                            self._interruptible_wait(key, 1.0)
                        break
                    self.ui_log(
                        f"[multiplatform/v28] {platform.label} scheduling next isolated rotation in "
                        f"{self.RESTART_GUARD_SECONDS:.0f}s; siblings continue.\n"
                    )
                    self.ui_platform(key, "READY")
                    if not self._interruptible_wait(key, self.RESTART_GUARD_SECONDS):
                        break
                    continue
                if status in {"COOLDOWN", "ACCESS_BLOCKED"}:
                    continue
                if status == "FAILED":
                    n = self.platform_failures.get(key, 1)
                    delay = min(V20_RETRY_FAILURE_MAX, V20_RETRY_FAILURE_INITIAL * (2 ** min(n - 1, 4)))
                    self.ui_platform(key, "RETRYING")
                    self.ui_cooldown(key, time.time() + delay)
                    self.ui_log(f"[multiplatform/v28] {platform.label} isolated retry in {int(delay)}s; siblings continue.\n")
                    if not self._interruptible_wait(key, delay):
                        break
        except BaseException as exc:
            self.platform_reasons[key] = f"{type(exc).__name__}: {exc}"[:500]
            self.ui_platform(key, "FAILED")
            self.ui_log(f"[multiplatform/v28] {platform.label} SLOT CRASH | {type(exc).__name__}: {exc}\n")
        finally:
            self.slot_last_activity[key] = time.time()
            if self._slot_should_stop(key) or self.graceful_end_requested:
                self.ui_platform(key, "STOPPED")
            self.ui_log(
                f"[multiplatform/v28] {platform.label} slot generation {generation} returned | "
                f"global_shutdown={'YES' if self.shutdown_event.is_set() else 'NO'}\n"
            )

    def _spawn_slot_v28(self, platform: UnifiedPlatform, reason: str) -> None:
        key = platform.key
        self.slot_generation[key] = self.slot_generation.get(key, 0) + 1
        gen = self.slot_generation[key]
        self.slot_stop_events[key].clear()
        t = threading.Thread(
            target=self._platform_loop_v28, args=(platform, gen),
            name=f"Platform-{key}-V28-g{gen}", daemon=True,
        )
        self.slot_threads[key] = t
        t.start()
        self.ui_log(f"[multiplatform/v28] STARTED isolated slot: {platform.label} | generation={gen} | reason={reason}\n")

    def _main(self) -> None:
        self.ui_log("\n[multiplatform/v28] MASTER SERVICE STARTED\n")
        self.ui_log("[multiplatform/v28] Shutdown authority: USER CONTROL ONLY (End / Force Stop).\n")
        for p in UNIFIED_PLATFORMS:
            if self.inputs.get(p.key):
                self._spawn_slot_v28(p, "initial")
        try:
            while not self.shutdown_event.is_set() and not self.graceful_end_requested:
                now = time.time()
                for p in UNIFIED_PLATFORMS:
                    key = p.key
                    if not self.inputs.get(key):
                        continue
                    t = self.slot_threads.get(key)
                    if t is not None and t.is_alive():
                        continue
                    # A non-continuous COMPLETE slot is intentionally parked and
                    # must not be watchdog-restarted.
                    if self.slot_last_exit.get(key) == "COMPLETE" and not self.continuous:
                        continue
                    if now < self._slot_restart_after.get(key, 0.0):
                        continue
                    self._slot_restart_after[key] = now + 2.0
                    self.ui_log(f"[multiplatform/v28] WATCHDOG restarting {p.label} slot only; siblings untouched.\n")
                    self._spawn_slot_v28(p, "watchdog")
                self.wake_event.wait(0.5)
                self.wake_event.clear()

            if self.graceful_end_requested and not self.shutdown_event.is_set():
                self.ui_log("[control/v28] Graceful End: waiting for active workers to reach item boundaries.\n")
                while True:
                    with self.process_lock:
                        active = [proc for proc in self.processes.values() if proc.poll() is None]
                    if not active:
                        break
                    self.wake_event.wait(0.25)
                    self.wake_event.clear()
                self.shutdown_event.set()
        except BaseException as exc:
            self.ui_log(f"[multiplatform/v28] MASTER ERROR | {type(exc).__name__}: {exc}\n")
            # A master exception is diagnostic, not permission to silently kill
            # children. Explicitly stop them because the supervisor cannot safely
            # continue without its master loop.
            self.shutdown_event.set()
        finally:
            self.wake_event.set()
            self.ui_log("[multiplatform/v28] MASTER SERVICE STOPPED\n")
            self.app.enqueue_ui(("scheduler_done",))

    def stop(self) -> None:
        if self.graceful_end_requested or self.shutdown_event.is_set():
            return
        self.graceful_end_requested = True
        self.wake_event.set()
        self.ui_log(
            "[control/v28] END requested | no new platform rotations; each active worker "
            "will stop independently after its next committed item.\n"
        )
        with self.process_lock:
            active = list(self.processes.values())
        if not active:
            self.shutdown_event.set()

    def force_stop(self) -> None:
        self.ui_log("[control/v28] FORCE STOP requested | explicit global shutdown.\n")
        self.graceful_end_requested = True
        self.shutdown_event.set()
        for ev in self.slot_stop_events.values():
            ev.set()
        self.wake_event.set()
        with self.process_lock:
            procs = list(self.processes.items())
        for key, proc in procs:
            if proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    try:
                        proc.kill()
                    except Exception:
                        pass
        try:
            self.app.root.after(1200, self._force_kill_all)
        except Exception:
            pass


