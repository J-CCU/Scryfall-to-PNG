def tiktok_discover_videos_parity(self: tiktok_Collector, run_id: int, account: dict, limit: int, mode: str, force_refresh: bool = False) -> Tuple[List[dict], bool]:
    old_rows, old_complete = tiktok__TIKTOK_OLD_DISCOVER_VIDEOS(self, run_id, account, limit, mode, force_refresh)
    full_catalog = bool(limit <= 0 and (force_refresh or not self.db.account_is_indexed(account["account_id"])))
    if tiktok_COLLECT_RESEARCH_API and (tiktok_ensure_research_access_token(self.db)):
        self.emit(f"  [research] video catalog supplement START | @{account['username']} | full_catalog={'yes' if full_catalog else 'no'}")
        started = time.monotonic()
        try:
            research_rows = tiktok_research_discover_all_history(account["username"], account["account_id"], limit=limit, full_catalog=full_catalog, db=self.db)
        except Exception as exc:
            research_rows = []
            self.db.record_error(run_id, account_id=account["account_id"], stage="research_video_discovery", exc=exc)
            self.emit(f"  [research] discovery ERROR | {type(exc).__name__}: {exc}")
        for row in research_rows:
            self.db.upsert_video_listing(row)
            self.db.register_discovery(run_id, row)
            self.db.tiktok_db_update_tiktok_video_extras(row)
            self.db.insert_raw(run_id, account["account_id"], row["video_id"], "TikTok Research API", "video_query", row.get("_research_raw") or {})
        merged = tiktok_merge_tiktok_video_sources(old_rows, research_rows, limit=limit)
        self.emit(f"  [research] video catalog supplement COMPLETE | new_source_rows={len(research_rows)} | merged={len(merged)} | elapsed={time.monotonic()-started:.1f}s")
        return merged, old_complete or (full_catalog and bool(research_rows))
    return old_rows, old_complete

