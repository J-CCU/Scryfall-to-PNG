def _v37_token_fingerprint(token: str) -> str:
    token = str(token or "")
    return hashlib.sha256(token.encode("utf-8")).hexdigest()[:12] if token else "none"


def _v37_read_config_yaml() -> tuple[dict, float]:
    path = BASE_DIR / "config.yaml"
    if not path.exists():
        return {}, 0.0
    try:
        import yaml
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        return (data if isinstance(data, dict) else {}), path.stat().st_mtime
    except Exception:
        return {}, 0.0


def _v37_graph_auth_config() -> tuple[str, str]:
    cfg, _ = _v37_read_config_yaml()
    ig = cfg.get("facebook_instagram") if isinstance(cfg.get("facebook_instagram"), dict) else {}
    app_id = (
        os.getenv("META_APP_ID", "").strip()
        or os.getenv("FACEBOOK_APP_ID", "").strip()
        or os.getenv("INSTAGRAM_GRAPH_APP_ID", "").strip()
        or str(ig.get("app_id") or ig.get("facebook_app_id") or "").strip()
    )
    app_secret = (
        os.getenv("META_APP_SECRET", "").strip()
        or os.getenv("FACEBOOK_APP_SECRET", "").strip()
        or os.getenv("INSTAGRAM_GRAPH_APP_SECRET", "").strip()
        or str(ig.get("app_secret") or ig.get("facebook_app_secret") or "").strip()
    )
    return app_id, app_secret


def _v37_load_graph_token_from_disk() -> str:
    """Prefer the newest local token source. Never log token material."""
    cfg, cfg_mtime = _v37_read_config_yaml()
    ig = cfg.get("facebook_instagram") if isinstance(cfg.get("facebook_instagram"), dict) else {}
    cfg_token = str(ig.get("access_token") or "").strip()
    file_token = ""
    file_mtime = 0.0
    try:
        if V37_IG_TOKEN_FILE.exists():
            file_token = V37_IG_TOKEN_FILE.read_text(encoding="utf-8").strip()
            file_mtime = V37_IG_TOKEN_FILE.stat().st_mtime
    except Exception:
        file_token = ""
    env_token = os.getenv("INSTAGRAM_GRAPH_ACCESS_TOKEN", "").strip()

    if cfg_token and cfg_mtime > file_mtime + 1.0:
        return cfg_token
    if file_token:
        return file_token
    if env_token:
        return env_token
    return cfg_token


def _v37_reload_graph_token(db: Optional[instagram_Database] = None) -> bool:
    global instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN
    candidate = _v37_load_graph_token_from_disk()
    if not candidate:
        return False
    if candidate != instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN:
        instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN = candidate
        instagram_log(
            f"[graph/v37] reloaded Graph token from local configuration | "
            f"fingerprint={_v37_token_fingerprint(candidate)} | secret=NOT_LOGGED"
        )
        if db is not None:
            try:
                db.set_runtime_state("instagram_graph_auth_invalid_fingerprint", "")
                db.set_runtime_state("instagram_access_backoff_until", "")
                db.set_runtime_state("instagram_access_backoff_reason", "")
            except Exception:
                pass
        return True
    return False


def _v37_persist_graph_token(token: str) -> bool:
    if not token:
        return False
    try:
        tmp = V37_IG_TOKEN_FILE.with_suffix(V37_IG_TOKEN_FILE.suffix + ".tmp")
        tmp.write_text(str(token).strip() + "\n", encoding="utf-8")
        os.replace(tmp, V37_IG_TOKEN_FILE)
        try:
            os.chmod(V37_IG_TOKEN_FILE, 0o600)
        except Exception:
            pass
        return True
    except Exception as exc:
        instagram_log(f"[graph/v37] could not persist renewed token | {type(exc).__name__}: {exc}")
        return False


def _v37_maybe_exchange_long_lived_token(db: Optional[instagram_Database], force: bool = False) -> bool:
    """Best-effort official token exchange. Failure never blocks other platforms."""
    global instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN
    token = str(instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN or "").strip()
    app_id, app_secret = _v37_graph_auth_config()
    if not token or not app_id or not app_secret:
        return False

    now = time.time()
    if db is not None and not force:
        try:
            last = float(db.get_runtime_state("instagram_graph_last_refresh_attempt") or 0)
            if now - last < V37_INSTAGRAM_REFRESH_ATTEMPT_INTERVAL:
                return False
        except Exception:
            pass
    if db is not None:
        try:
            db.set_runtime_state("instagram_graph_last_refresh_attempt", str(now))
        except Exception:
            pass

    try:
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM_GRAPH_BASE_URL}/oauth/access_token",
            params={
                "grant_type": "fb_exchange_token",
                "client_id": app_id,
                "client_secret": app_secret,
                "fb_exchange_token": token,
            },
            timeout=instagram_REQUEST_TIMEOUT,
        )
        data = r.json() if r.content else {}
        renewed = str(data.get("access_token") or "").strip() if isinstance(data, dict) else ""
        if r.status_code == 200 and renewed:
            changed = renewed != token
            instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN = renewed
            _v37_persist_graph_token(renewed)
            if db is not None:
                try:
                    db.set_runtime_state("instagram_graph_last_refresh_success", str(now))
                    db.set_runtime_state("instagram_graph_auth_invalid_fingerprint", "")
                    db.set_runtime_state("instagram_access_backoff_until", "")
                    db.set_runtime_state("instagram_access_backoff_reason", "")
                except Exception:
                    pass
            instagram_log(
                f"[graph/v37] token exchange SUCCESS | long-lived token persisted locally | "
                f"changed={'yes' if changed else 'no'} | secret=NOT_LOGGED"
            )
            return True
        err = data.get("error") if isinstance(data, dict) else None
        code = instagram_safe_int(err.get("code")) if isinstance(err, dict) else None
        instagram_log(
            f"[graph/v37] token exchange unavailable | HTTP={r.status_code} code={code or ''} | "
            "continuing with current token"
        )
    except Exception as exc:
        instagram_log(f"[graph/v37] token exchange check failed | {type(exc).__name__}: {str(exc)[:180]}")
    return False


def _v37_set_instagram_auth_wait(db: Optional[instagram_Database], reason: str) -> float:
    until = time.time() + V37_INSTAGRAM_AUTH_RETRY_SECONDS
    fp = _v37_token_fingerprint(instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN)
    if db is not None:
        try:
            db.set_runtime_state("instagram_access_backoff_until", str(until))
            db.set_runtime_state("instagram_access_backoff_reason", str(reason)[:1200])
            db.set_runtime_state("instagram_access_backoff_username", "graph-auth")
            db.set_runtime_state("instagram_graph_auth_invalid_fingerprint", fp)
        except Exception:
            pass
    instagram_log(
        f"[orchestrator] Instagram access-blocked; yielding to scheduler | "
        f"backoff={int(V37_INSTAGRAM_AUTH_RETRY_SECONDS)//60}m 0s | account=@graph-auth | "
        f"reason={str(reason)[:220]}"
    )
    return until


V37_IG_GRAPH_MIN_INTERVAL_SECONDS = max(0.25, float(os.getenv("SOCIAL_COLLECTOR_IG_GRAPH_MIN_INTERVAL_SECONDS", "2.0")))
V37_IG_GRAPH_REQUEST_LOCK = threading.Lock()
V37_IG_GRAPH_LAST_REQUEST_START = 0.0

def _v37_wait_for_graph_request_slot() -> None:
    global V37_IG_GRAPH_LAST_REQUEST_START
    with V37_IG_GRAPH_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = now - V37_IG_GRAPH_LAST_REQUEST_START if V37_IG_GRAPH_LAST_REQUEST_START else None
        wait_for = 0.0 if elapsed is None else max(0.0, V37_IG_GRAPH_MIN_INTERVAL_SECONDS - elapsed)
        if wait_for > 0:
            instagram_log(
                f"[graph/pacing] waiting {wait_for:.1f}s | "
                f"min_interval={V37_IG_GRAPH_MIN_INTERVAL_SECONDS:.1f}s"
            )
            time.sleep(wait_for)
        V37_IG_GRAPH_LAST_REQUEST_START = time.monotonic()


def instagram_instagram_graph_get_v37(path: str, params: Optional[dict] = None, db: Optional[instagram_Database] = None) -> Optional[dict]:
    global instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN
    _v37_reload_graph_token(db)
    if not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN or not instagram_instagram_graph_budget_available(db):
        return None

    if db is not None:
        until = v19__ig_access_backoff_until(db)
        if until > time.time():
            remaining = max(1, int(until - time.time()))
            raise V19InstagramAccessBackoff(f"Instagram/Meta cooldown active; remaining={remaining}s")

    def do_request():
        _v37_wait_for_graph_request_slot()
        instagram_instagram_graph_note_request(db)
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM_GRAPH_BASE_URL}/{str(path).lstrip('/')}",
            params={**(params or {}), "access_token": instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN},
            timeout=instagram_REQUEST_TIMEOUT,
        )
        try:
            data = r.json()
        except Exception:
            data = None
        return r, data

    try:
        r, data = do_request()
        err = data.get("error") if isinstance(data, dict) else None
        err = err if isinstance(err, dict) else {}
        code = instagram_safe_int(err.get("code"))
        subcode = instagram_safe_int(err.get("error_subcode"))
        message = str(err.get("message") or "")

        # Token invalid/expired. First try a supported long-lived exchange once.
        # If that cannot recover, make ONE auth failure for this pass, persist a
        # 30-minute wait, and yield only Instagram. Other platforms keep running.
        if code == 190 or subcode in {458, 459, 460, 463, 464, 467}:
            if _v37_maybe_exchange_long_lived_token(db, force=True):
                r, data = do_request()
                err = data.get("error") if isinstance(data, dict) else None
                err = err if isinstance(err, dict) else {}
                code = instagram_safe_int(err.get("code"))
                subcode = instagram_safe_int(err.get("error_subcode"))
                message = str(err.get("message") or "")
                if r.status_code == 200 and not err:
                    _v34_ig_reset_backoff_after_success(db)
                    return data if isinstance(data, dict) else None
            reason = (
                f"Meta Graph authentication expired/invalid HTTP {r.status_code} "
                f"code={code or ''} subcode={subcode or ''}: {message or 'token rejected'}"
            )
            until = _v37_set_instagram_auth_wait(db, reason)
            raise V19InstagramAccessBackoff(f"Meta Graph authentication wait; retry_at={until}")

        if r.status_code == 429 or code in {4, 17, 32, 613}:
            reason = f"Meta Graph throttle HTTP {r.status_code} code={code or ''}: {message or r.text[:220]}"
            until = v19__ig_set_access_backoff(db, reason, "graph-api") if db is not None else (time.time() + 600.0)
            remaining = max(1, int(until - time.time()))
            instagram_log(
                f"[graph/v37] THROTTLED | Instagram entering cooldown | remaining={remaining}s | "
                f"HTTP={r.status_code} code={code or ''}"
            )
            raise V19InstagramAccessBackoff(f"Meta Graph request limit reached; retry_at={until}")

        if code == 110 and subcode == 2207013:
            instagram_log(
                "[graph/v37] ACCOUNT SKIP | Business Discovery cannot resolve username | "
                "continuing to next account"
            )
            return None

        if r.status_code != 200:
            instagram_log(f"[graph] HTTP {r.status_code} {path}: {r.text[:500]}")
            return None
        if err:
            instagram_log(f"[graph] API error {path}: {str(err)[:500]}")
            return None
        if isinstance(data, dict):
            _v34_ig_reset_backoff_after_success(db)
            return data
        return None
    except V19InstagramAccessBackoff:
        raise
    except Exception as exc:
        instagram_log(f"[graph] {path} {type(exc).__name__}: {exc}")
        return None


