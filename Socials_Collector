def youtube_deep_find_values(obj: Any, key: str) -> Iterable[Any]:
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == key:
                yield v
            yield from youtube_deep_find_values(v, key)
    elif isinstance(obj, list):
        for item in obj:
            yield from youtube_deep_find_values(item, key)


def youtube_deep_find_first(obj: Any, key: str) -> Any:
    for value in youtube_deep_find_values(obj, key):
        return value
    return None


def youtube_deep_find_objects(obj: Any, key: str) -> List[dict]:
    out: List[dict] = []
    if isinstance(obj, dict):
        value = obj.get(key)
        if isinstance(value, dict):
            out.append(value)
        for child in obj.values():
            out.extend(youtube_deep_find_objects(child, key))
    elif isinstance(obj, list):
        for child in obj:
            out.extend(youtube_deep_find_objects(child, key))
    return out


def youtube_parse_balanced_json(page: str, marker: str) -> Any:
    pos = page.find(marker)
    if pos < 0:
        return None

    candidates = [page.find("{", pos), page.find("[", pos)]
    candidates = [x for x in candidates if x >= 0]
    if not candidates:
        return None
    start = min(candidates)

    opener = page[start]
    closer = "}" if opener == "{" else "]"
    depth = 0
    in_string = False
    escaped = False

    for i in range(start, len(page)):
        ch = page[i]
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
            continue
        if ch == '"':
            in_string = True
        elif ch == opener:
            depth += 1
        elif ch == closer:
            depth -= 1
            if depth == 0:
                raw = page[start:i + 1]
                try:
                    return json.loads(raw)
                except Exception:
                    try:
                        return json.loads(html.unescape(raw))
                    except Exception:
                        return None
    return None


def youtube_parse_yt_initial_data(page: str) -> Any:
    for marker in (
        "var ytInitialData = ",
        "ytInitialData = ",
        "window['ytInitialData'] = ",
        'window["ytInitialData"] = ',
    ):
        data = youtube_parse_balanced_json(page, marker)
        if data is not None:
            return data
    return None


def youtube_parse_player_response(page: str) -> Any:
    for marker in (
        "var ytInitialPlayerResponse = ",
        "ytInitialPlayerResponse = ",
        "window['ytInitialPlayerResponse'] = ",
        'window["ytInitialPlayerResponse"] = ',
    ):
        data = youtube_parse_balanced_json(page, marker)
        if data is not None:
            return data
    return None


def youtube_extract_channel_id(page: str) -> Optional[str]:
    """Legacy broad extractor used only for generic channel URLs.

    Handle resolution does NOT rely on this function because a YouTube page can
    contain IDs for many related/recommended channels.
    """
    patterns = (
        r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']https?://(?:www\.)?youtube\.com/channel/(UC[a-zA-Z0-9_-]{20,})',
        r'<meta[^>]+property=["\']og:url["\'][^>]+content=["\']https?://(?:www\.)?youtube\.com/channel/(UC[a-zA-Z0-9_-]{20,})',
        r'<meta[^>]+itemprop=["\']channelId["\'][^>]+content=["\'](UC[a-zA-Z0-9_-]{20,})',
    )
    for pattern in patterns:
        match = re.search(pattern, page, re.I)
        if match:
            return match.group(1)
    return None


def youtube_extract_canonical_channel_id(page: str) -> Optional[str]:
    """Extract the channel ID from the page's canonical/OG channel URL only."""
    patterns = (
        r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']https?://(?:www\.)?youtube\.com/channel/(UC[a-zA-Z0-9_-]{20,})',
        r'<meta[^>]+property=["\']og:url["\'][^>]+content=["\']https?://(?:www\.)?youtube\.com/channel/(UC[a-zA-Z0-9_-]{20,})',
        r'<link[^>]+href=["\']https?://(?:www\.)?youtube\.com/channel/(UC[a-zA-Z0-9_-]{20,})["\']',
    )
    for pattern in patterns:
        match = re.search(pattern, page, re.I)
        if match:
            return match.group(1)
    return None


def youtube_extract_page_title(page: str) -> str:
    m = re.search(r'<title[^>]*>(.*?)</title>', page, re.I | re.S)
    if not m:
        return ""
    return html.unescape(re.sub(r'\\s+', ' ', m.group(1))).strip()


def youtube_extract_main_channel_from_initial_data(data: Any) -> Tuple[Optional[str], str, str]:
    """Find the main channel header, not an arbitrary related-channel ID."""
    if not isinstance(data, (dict, list)):
        return None, "", ""

    # c4TabbedHeaderRenderer is the classic channel header.
    for header in youtube_deep_find_objects(data, "c4TabbedHeaderRenderer"):
        cid = header.get("channelId")
        if isinstance(cid, str) and cid.startswith("UC"):
            title = youtube_text_from_runs(header.get("title", {}))
            handle = ""
            for key in ("vanityChannelUrl", "canonicalBaseUrl"):
                value = header.get(key)
                if isinstance(value, str) and "/@" in value:
                    handle = value.split("/@", 1)[1].split("/", 1)[0]
                    break
            return cid, title, handle

    # Newer pageHeaderRenderer structures can carry a pageHeaderViewModel.
    for header in youtube_deep_find_objects(data, "pageHeaderRenderer"):
        cid = header.get("channelId")
        title = youtube_text_from_runs(header.get("title", {}))
        if isinstance(cid, str) and cid.startswith("UC"):
            return cid, title, ""

        view_model = header.get("content", {})
        if isinstance(view_model, dict):
            cid = youtube_deep_find_first(view_model, "channelId")
            if isinstance(cid, str) and cid.startswith("UC"):
                return cid, title, ""

    return None, "", ""


def youtube_extract_page_canonical_handle(page: str) -> str:
    """Extract the channel handle from canonical/og:url HTML tags, regardless of attribute order."""
    if not page:
        return ""

    for tag in re.findall(r"<link\b[^>]*>", page, re.I):
        rel = re.search(r"\brel\s*=\s*[\"']([^\"']+)", tag, re.I)
        href = re.search(r"\bhref\s*=\s*[\"']([^\"']+)", tag, re.I)
        if rel and href and "canonical" in rel.group(1).lower():
            handle = youtube_normalize_handle(href.group(1))
            if handle:
                return handle

    for tag in re.findall(r"<meta\b[^>]*>", page, re.I):
        prop = re.search(r"\b(?:property|name)\s*=\s*[\"']([^\"']+)", tag, re.I)
        content = re.search(r"\bcontent\s*=\s*[\"']([^\"']+)", tag, re.I)
        if prop and content and prop.group(1).lower() == "og:url":
            handle = youtube_normalize_handle(content.group(1))
            if handle:
                return handle

    # Some YouTube page JSON contains a direct canonicalBaseUrl such as /@handle.
    for m in re.finditer(r"[\"']canonicalBaseUrl[\"']\s*:\s*[\"'](/@[^\"']+)", page, re.I):
        handle = youtube_normalize_handle(m.group(1))
        if handle:
            return handle
    return ""


def youtube_extract_channel_identity_from_page(page: str) -> Tuple[Optional[str], str, str]:
    """Return the page's own channel ID, title and handle."""
    canonical_id = youtube_extract_canonical_channel_id(page)
    title = youtube_extract_page_title(page)
    handle = ""

    # Search exact canonical handle URLs, regardless of HTML attribute order.
    handle = youtube_extract_page_canonical_handle(page)

    data = youtube_parse_yt_initial_data(page)
    if data:
        main_id, main_title, main_handle = youtube_extract_main_channel_from_initial_data(data)
        if main_id:
            canonical_id = canonical_id or main_id
        title = main_title or title
        handle = main_handle or handle

    return canonical_id, title, handle


def youtube_normalize_handle_for_compare(value: str) -> str:
    value = (value or "").strip().lstrip("@").strip().lower()
    return value


def youtube_verify_handle_identity(requested_handle: str, channel_id: str) -> Tuple[bool, dict]:
    """Fetch the resolved channel and verify that its public identity matches."""
    if youtube_stop_requested():
        return False, {"requested_handle": youtube_normalize_handle_for_compare(requested_handle), "resolved_channel_id": channel_id, "verified": False, "method": "stopped"}
    requested = youtube_normalize_handle_for_compare(requested_handle)
    result = {
        "requested_handle": requested,
        "resolved_channel_id": channel_id,
        "resolved_handle": "",
        "resolved_title": "",
        "verified": False,
        "method": "",
    }

    page, status = youtube_get_page(f"{youtube_YOUTUBE}/channel/{channel_id}")
    if page:
        page_id, page_title, page_handle = youtube_extract_channel_identity_from_page(page)
        result["resolved_handle"] = page_handle
        result["resolved_title"] = page_title

        if page_id and page_id != channel_id:
            youtube_debug(
                f"[verify] channel URL canonical ID mismatch: requested={channel_id} page={page_id}"
            )
            return False, result

        if page_handle:
            result["method"] = "channel_page_canonical"
            result["verified"] = youtube_normalize_handle_for_compare(page_handle) == requested
            return result["verified"], result

    # yt-dlp is an independent resolver/identity check.
    if youtube_yt_dlp is not None:
        try:
            opts = {
                "quiet": True,
                "no_warnings": True,
                "ignoreerrors": True,
                "extract_flat": True,
                "skip_download": True,
                "socket_timeout": youtube_REQUEST_TIMEOUT,
            }
            with youtube_yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(f"{youtube_YOUTUBE}/@{requested}", download=False)

            if info:
                ytdlp_id = info.get("channel_id") or info.get("uploader_id")
                ytdlp_handle = (
                    info.get("channel_handle")
                    or info.get("uploader_id")
                    or info.get("webpage_url_basename")
                    or ""
                )
                ytdlp_title = info.get("channel") or info.get("uploader") or info.get("title") or ""

                if ytdlp_id and ytdlp_id.startswith("UC"):
                    result["resolved_channel_id"] = ytdlp_id
                result["resolved_handle"] = str(ytdlp_handle or "").lstrip("@")
                result["resolved_title"] = str(ytdlp_title or "")
                result["method"] = "yt_dlp_identity"
                result["verified"] = (
                    result["resolved_channel_id"] == channel_id
                    and youtube_normalize_handle_for_compare(result["resolved_handle"]) == requested
                )
                return result["verified"], result
        except Exception as exc:
            youtube_debug(f"[verify/yt-dlp] {type(exc).__name__}: {exc}")

    return False, result


def youtube_youtube_api_resolve_handle(handle: str) -> Optional[dict]:
    """Optional exact resolver/statistics lookup using the official Data API."""
    if youtube_stop_requested():
        return None
    if not youtube_YOUTUBE_API_KEY:
        return None

    try:
        r = youtube_SESSION.get(
            "https://www.googleapis.com/youtube/v3/channels",
            params={
                "part": "snippet,statistics,contentDetails",
                "forHandle": f"@{handle}",
                "key": youtube_YOUTUBE_API_KEY,
            },
            timeout=youtube_REQUEST_TIMEOUT,
            headers={"User-Agent": youtube_UA},
        )
        if r.status_code != 200:
            youtube_debug(f"[api/forHandle] HTTP {r.status_code}: {r.text[:500]}")
            return None

        data = r.json()
        items = data.get("items") or []
        if not items:
            return None

        return items[0]
    except Exception as exc:
        youtube_debug(f"[api/forHandle] {type(exc).__name__}: {exc}")
        return None


def youtube_parse_duration(value: Any) -> Optional[int]:
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        return int(value)
    s = str(value).strip()
    if s.isdigit():
        return int(s)
    try:
        parts = [int(p) for p in s.split(":")]
        if len(parts) == 2:
            return parts[0] * 60 + parts[1]
        if len(parts) == 3:
            return parts[0] * 3600 + parts[1] * 60 + parts[2]
    except Exception:
        return None
    return None


def youtube_format_duration(seconds: Any) -> str:
    value = youtube_safe_int(seconds)
    if value is None or value < 0:
        return "?"
    h, rem = divmod(value, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{sec:02d}"
    return f"{m}:{sec:02d}"


