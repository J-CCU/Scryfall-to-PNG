def tiktok_tiktok_adaptive_interval_for_mode(mode: str) -> float:
    base = float(tiktok_TIKTOK_MIN_INTERVAL_BY_MODE.get(mode, tiktok_TIKTOK_MIN_INTERVAL_BY_MODE["Full"]))
    with tiktok_RATE_LIMIT_LOCK:
        mult = max(1.0, float(tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER))
    return base * mult


def tiktok_tiktok_policy_text_parity(mode: str) -> str:
    with tiktok_RATE_LIMIT_LOCK:
        mult = max(1.0, float(tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER))
    return (
        f"collector_policy_min_interval={tiktok_tiktok_adaptive_interval_for_mode(mode):.1f}s | "
        f"request_sleep={tiktok_TIKTOK_REQUEST_SLEEP_BY_MODE.get(mode, 1.0):.1f}s | adaptive_multiplier={mult:.2f}x"
    )


def tiktok_wait_for_request_slot_parity(mode: str, label: str) -> bool:
    global tiktok_LAST_TOP_LEVEL_REQUEST_START, tiktok_REQUEST_COUNTER
    if tiktok_stop_requested() or tiktok_tiktok_rate_limited():
        return False
    min_interval = tiktok_tiktok_adaptive_interval_for_mode(mode)
    with tiktok_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = None if not tiktok_LAST_TOP_LEVEL_REQUEST_START else now - tiktok_LAST_TOP_LEVEL_REQUEST_START
        wait_for = 0.0 if elapsed is None else max(0.0, min_interval - elapsed)
        if elapsed is not None:
            wait_for += random.uniform(0.0, min(1.5, max(0.25, min_interval * 0.12)))
        if wait_for > 0:
            tiktok_log(f"      [throttle] waiting {wait_for:.1f}s before TikTok {label} | {tiktok_tiktok_policy_text_parity(mode)}")
            if tiktok_STOP_EVENT.wait(wait_for):
                return False
            if tiktok_tiktok_rate_limited() or tiktok_stop_requested():
                return False
        tiktok_LAST_TOP_LEVEL_REQUEST_START = time.monotonic()
        tiktok_REQUEST_COUNTER += 1
        request_no = tiktok_REQUEST_COUNTER
    tiktok_log(f"      [throttle] TikTok {label} request START | #{request_no} | min_interval={min_interval:.1f}s")
    return True


tiktok_wait_for_request_slot = tiktok_wait_for_request_slot_parity
tiktok_policy_text = tiktok_tiktok_policy_text_parity


def tiktok_tiktok_research_budget_state(db: Optional[tiktok_Database] = None) -> tuple[int, int]:
    if db is None:
        return 0, 0
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    try:
        day = db.get_runtime_state("tiktok_research_budget_day") or ""
        count = int(db.get_runtime_state("tiktok_research_request_count") or 0)
        if day != today:
            db.set_runtime_state("tiktok_research_budget_day", today)
            db.set_runtime_state("tiktok_research_request_count", "0")
            return today, 0
        return day, count
    except Exception:
        return today, 0


def tiktok_tiktok_research_budget_available(db: Optional[tiktok_Database] = None) -> bool:
    day, count = tiktok_tiktok_research_budget_state(db)
    return count < min(tiktok_TIKTOK_RESEARCH_DAILY_REQUEST_LIMIT, tiktok_TIKTOK_RESEARCH_MAX_REQUESTS_PER_RUN)


def tiktok_tiktok_research_note_request(db: Optional[tiktok_Database] = None) -> None:
    if db is None:
        return
    day, count = tiktok_tiktok_research_budget_state(db)
    db.set_runtime_state("tiktok_research_budget_day", day)
    db.set_runtime_state("tiktok_research_request_count", str(count + 1))


def tiktok_research_post_parity(path: str, params: dict, body: dict, db: Optional[tiktok_Database] = None, _retry_auth: bool = True) -> Optional[dict]:
    if not tiktok_tiktok_research_budget_available(db):
        tiktok_log("[research] daily/run request budget reached | Research API deferred safely")
        return None
    tiktok_tiktok_research_note_request(db)
    return tiktok__TIKTOK_OLD_RESEARCH_POST(path, params, body, db, _retry_auth)


tiktok_research_post = tiktok_research_post_parity


def tiktok_normalize_research_video_row(row: dict, account_id: str, username: str) -> dict:
    vid = str(row.get("id") or "")
    ts = tiktok_safe_int(row.get("create_time"))
    hashtags = row.get("hashtag_names")
    return {
        "video_id": vid,
