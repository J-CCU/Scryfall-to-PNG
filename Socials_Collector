    def get_cached_channel_resolution(self, handle: str) -> Optional[dict]:
        """Return a previously verified handle -> channel mapping without a network request.

        Only mappings explicitly marked as verified are trusted. A recently verified
        mapping is preferred from channels; channel_inputs is used as a durable fallback
        for handles that were previously resolved but whose channel row was refreshed.
        """
        wanted = youtube_normalize_handle_for_compare(handle)
        if not wanted:
            return None
        with self.lock:
            row = self.conn.execute(
                """
                SELECT channel_id, handle, title, requested_handle, resolution_method,
                       resolution_verified, updated_at
                FROM channels
                WHERE channel_id IS NOT NULL
                  AND resolution_verified IN ('True','true','1')
                  AND (lower(ltrim(handle, '@')) = ?
                       OR lower(ltrim(requested_handle, '@')) = ?)
                ORDER BY updated_at DESC
                LIMIT 1
                """,
                (wanted, wanted),
            ).fetchone()
            if row:
                return {
                    "channel_id": row[0], "resolved_handle": row[1] or row[3] or wanted,
                    "resolved_title": row[2] or "",
                    "method": "cached_verified", "verified": True,
                    "cache_updated_at": row[6] or "",
                }

            row = self.conn.execute(
                """
                SELECT ci.channel_id, c.handle, c.title, ci.resolution_method,
                       ci.resolution_verified, ci.captured_at
                FROM channel_inputs ci
                LEFT JOIN channels c ON c.channel_id = ci.channel_id
                WHERE lower(ltrim(ci.normalized_input, '@')) = ?
                  AND ci.channel_id IS NOT NULL
                  AND ci.resolution_verified IN ('True','true','1')
                ORDER BY ci.captured_at DESC
                LIMIT 1
                """,
                (wanted,),
            ).fetchone()
            if row:
                return {
                    "channel_id": row[0], "resolved_handle": row[1] or wanted,
                    "resolved_title": row[2] or "",
                    "method": "cached_verified_input", "verified": True,
                    "cache_updated_at": row[5] or "",
                }
        return None

    def upsert_channel(self, c: dict) -> None:
        with self.lock:
            self.conn.execute(
                """
                INSERT INTO channels
                (channel_id, handle, title, description, custom_url, channel_url,
                 avatar_url, banner_url, country, subscribers_text,
                 subscribers_exact, total_views_text, total_views_exact,
                 video_count_text, uploads_playlist_id, requested_handle,
                 resolution_method, resolution_verified, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(channel_id) DO UPDATE SET
                    handle=excluded.handle,
                    title=excluded.title,
                    description=excluded.description,
                    custom_url=excluded.custom_url,
