def youtube_refresh_innertube_config() -> bool:
    global youtube_INNERTUBE_API_KEY, youtube_VISITOR_DATA, youtube_WEB_CLIENT_VERSION
    if youtube_stop_requested():
        return False
    try:
        r = youtube_SESSION.get(youtube_HOME, timeout=youtube_REQUEST_TIMEOUT)
        youtube_debug(f"[config] homepage HTTP {r.status_code}")
        if r.status_code != 200:
            return False

        page = r.text

        m = re.search(r'"INNERTUBE_API_KEY":"([^"]+)"', page)
        if m:
            youtube_INNERTUBE_API_KEY = m.group(1)

        m = re.search(r'"INNERTUBE_CLIENT_VERSION":"([^"]+)"', page)
        if m:
            youtube_WEB_CLIENT_VERSION = m.group(1)
            youtube_WEB_CLIENT["clientVersion"] = youtube_WEB_CLIENT_VERSION

        m = re.search(r'"VISITOR_DATA":"([^"]+)"', page)
        if m:
            youtube_VISITOR_DATA = m.group(1)

        youtube_debug(
            f"[config] client={youtube_WEB_CLIENT_VERSION or 'unknown'} "
            f"api_key={'yes' if youtube_INNERTUBE_API_KEY else 'no'} "
            f"visitor={'yes' if youtube_VISITOR_DATA else 'no'}"
        )
        return bool(youtube_INNERTUBE_API_KEY)
    except Exception as exc:
        youtube_log(f"[config] {type(exc).__name__}: {exc}")
        return False


