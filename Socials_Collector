                "graph_raw": item,
                "media_product_type": item.get("media_product_type") or "",
            })
        paging = data.get("paging") or {}
        next_url = paging.get("next")
        if not next_url:
            break
        # Use the next absolute URL as a path-free GET; keep the budget tracking.
        try:
            instagram_instagram_graph_note_request(db)
            r = instagram_SESSION.get(next_url, timeout=instagram_REQUEST_TIMEOUT, headers={"User-Agent": instagram_UA})
            if r.status_code != 200:
                break
            data = r.json()
            # Feed the next page by emulating the same loop with the returned response.
            # The simplest safe route is to process the response immediately here.
            for item in data.get("data") or []:
                if not isinstance(item, dict):
                    continue
                ts = item.get("timestamp") or ""
                try:
                    epoch = int(datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()) if ts else None
                except Exception:
                    epoch = None
                rows.append({
                    "post_id": str(item.get("id") or item.get("shortcode") or ""), "shortcode": str(item.get("shortcode") or ""),
                    "account_id": gid, "username": username, "typename": str(item.get("media_type") or ""), "taken_at": str(ts),
                    "published_epoch": epoch, "caption": str(item.get("caption") or ""), "likes": instagram_safe_int(item.get("like_count")),
                    "comments_count": instagram_safe_int(item.get("comments_count")), "video_view_count": None, "video_duration": None,
                    "width": None, "height": None, "is_video": "YES" if str(item.get("media_type") or "").upper() == "VIDEO" else "NO",
                    "is_sponsored": "NO", "is_pinned": "NO", "display_url": str(item.get("media_url") or ""),
                    "video_url": str(item.get("media_url") or "") if str(item.get("media_type") or "").upper() == "VIDEO" else "",
                    "thumbnail_url": str(item.get("thumbnail_url") or item.get("media_url") or ""), "accessibility_caption": "",
                    "location_name": "", "location_lat": None, "location_lng": None, "location_id": "", "tagged_users": [], "sponsor_users": [],
                    "post_url": str(item.get("permalink") or ""), "graph_raw": item, "media_product_type": item.get("media_product_type") or "",
                })
            paging = data.get("paging") or {}
            next_url = paging.get("next")
            if not next_url:
                break
            # Continue with the absolute next URL using a small inline page loop.
            while next_url and not instagram_stop_requested() and instagram_instagram_graph_budget_available(db):
                instagram_instagram_graph_note_request(db)
                rr = instagram_SESSION.get(next_url, timeout=instagram_REQUEST_TIMEOUT, headers={"User-Agent": instagram_UA})
                if rr.status_code != 200:
                    break
                dd = rr.json()
                for item in dd.get("data") or []:
                    if not isinstance(item, dict):
                        continue
                    ts = item.get("timestamp") or ""
                    try:
                        epoch = int(datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()) if ts else None
                    except Exception:
                        epoch = None
                    rows.append({
                        "post_id": str(item.get("id") or item.get("shortcode") or ""), "shortcode": str(item.get("shortcode") or ""),
                        "account_id": gid, "username": username, "typename": str(item.get("media_type") or ""), "taken_at": str(ts),
                        "published_epoch": epoch, "caption": str(item.get("caption") or ""), "likes": instagram_safe_int(item.get("like_count")),
                        "comments_count": instagram_safe_int(item.get("comments_count")), "video_view_count": None, "video_duration": None, "width": None, "height": None,
                        "is_video": "YES" if str(item.get("media_type") or "").upper() == "VIDEO" else "NO", "is_sponsored": "NO", "is_pinned": "NO",
                        "display_url": str(item.get("media_url") or ""), "video_url": str(item.get("media_url") or "") if str(item.get("media_type") or "").upper() == "VIDEO" else "",
                        "thumbnail_url": str(item.get("thumbnail_url") or item.get("media_url") or ""), "accessibility_caption": "", "location_name": "",
                        "location_lat": None, "location_lng": None, "location_id": "", "tagged_users": [], "sponsor_users": [], "post_url": str(item.get("permalink") or ""),
                        "graph_raw": item, "media_product_type": item.get("media_product_type") or "",
                    })
                next_url = (dd.get("paging") or {}).get("next")
            break
        except Exception as exc:
            instagram_log(f"[graph] pagination error: {type(exc).__name__}: {exc}")
            break
    rows = instagram_unique_by_id(rows, "post_id")
    rows.sort(key=lambda x: instagram_safe_int(x.get("published_epoch")) or 0, reverse=True)
    return rows[:limit] if limit > 0 else rows


