def _v42_audit_youtube(db: youtube_Database) -> dict:
    _v42_migrate_youtube(db)
    with db.lock:
        rows = db.conn.execute("SELECT video_id,comments_status,comments_evidence FROM video_ingestion").fetchall()
    repaired = 0
    for row in rows:
        vid = str(row[0] or "")
        status = str(row[1] or "").upper()
        evidence = str(row[2] or "")
        if status in {"SUCCESS", "SUCCESS_EMPTY"} and not evidence:
            with db.lock:
                actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)) or 0)
                expected = _v42_scalar(db.conn, "SELECT comment_count FROM videos WHERE video_id=?", (vid,))
                api_raw = db.conn.execute(
                    "SELECT 1 FROM raw_data WHERE video_id=? AND source='youtube_api' AND note LIKE 'video_comments_page%' LIMIT 1",
                    (vid,),
                ).fetchone()
            if status == "SUCCESS" and actual > 0:
                _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "PERSISTED_ROWS", "legacy")
            elif status == "SUCCESS_EMPTY" and api_raw:
                _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "LEGACY_API_EMPTY", "youtube_api")
            elif status == "SUCCESS_EMPTY" and expected is not None and int(expected or 0) == 0:
                _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "LEGACY_METADATA_ZERO", "legacy")
            else:
                with db.lock:
                    db.conn.execute("UPDATE video_ingestion SET comments_status='PENDING_UNVERIFIED_EMPTY' WHERE video_id=?", (vid,))
                    db.conn.commit()
                repaired += 1
        _v41_refresh_one_completeness(db, vid)
    c = _v42_live_youtube_counts(youtube_DB_PATH) if Path(youtube_DB_PATH).exists() else {}
    c["reclassified"] = repaired
    return c


