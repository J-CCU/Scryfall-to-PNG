                       snapshots=_v46_fast_rows(conn, snaps),raw=_v46_fast_rows(conn,"raw_data"),
                       formats=_v46_fast_rows(conn,"formats"),captions=_v46_fast_rows(conn,caps),
                       comments=comment_rows,sidecars=sidecars)
        return c, storage
    finally:
        conn.close()


def _v46_db_sizes(path: Path) -> tuple[int, int]:
    try: db = Path(path).stat().st_size
    except Exception: db = 0
    try: wal = Path(str(path) + "-wal").stat().st_size
    except Exception: wal = 0
    return db, wal


def _v46_human_bytes(n: int) -> str:
    n = float(max(0, int(n or 0)))
    for unit in ("B","KB","MB","GB","TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f}{unit}" if unit != "B" else f"{int(n)}B"
        n /= 1024.0
    return f"{n:.1f}TB"


def _v46_storage_line(c: dict, platform: str, path: Path) -> str:
    db_bytes, wal_bytes = _v46_db_sizes(path)
    base = (f"SQLite rows≈ items {c['canonical']:,} | snapshots {c['snapshots']:,} | raw {c['raw']:,} | "
            f"formats {c['formats']:,} | captions {c['captions']:,} | comments {c['comments']:,}")
    if platform == "instagram":
        base += f" | sidecars {c['sidecars']:,}"
    if platform == "youtube":
        base += f" | durable work payload {c['heavy_work']:,}, comments {c['comment_work']:,}"
    base += f" | db {_v46_human_bytes(db_bytes)} | wal {_v46_human_bytes(wal_bytes)}"
    return base


def _v46_stats_worker(app) -> None:
    while not getattr(app, "_v46_stats_stop", threading.Event()).is_set():
        # Never touch Tk variables from this worker thread. Keep backlog counts
        # independent of whether comments are currently required.
        comments_required = True
        try:
            yc, ys, source = _v46_youtube_stats(youtube_DB_PATH)
            ic, ins = _v46_other_stats(instagram_DB_PATH, "instagram", comments_required)
            tc, ts = _v46_other_stats(tiktok_DB_PATH, "tiktok", comments_required)
            app._v46_stats_cache = {
                "youtube": (yc, ys, source), "instagram": (ic, ins, ""), "tiktok": (tc, ts, ""),
                "sampled_at": time.time(),
            }
        except Exception as exc:
            app._v46_stats_error = f"{type(exc).__name__}: {exc}"
        stop = getattr(app, "_v46_stats_stop", None)
        if stop is None or stop.wait(V46_GUI_STATS_SECONDS):
            break


def _v42_gui_refresh_all(self) -> None:
    # UI thread only reads an in-memory snapshot. No multi-million-row query runs
    # inside Tk's event loop anymore.
    if not getattr(self, "_v46_stats_thread", None):
        self._v46_stats_stop = threading.Event()
        self._v46_stats_cache = {}
        self._v46_stats_error = ""
        self._v46_stats_thread = threading.Thread(target=_v46_stats_worker, args=(self,), name="v46-db-stats", daemon=True)
        self._v46_stats_thread.start()
    cache = getattr(self, "_v46_stats_cache", {}) or {}
    try:
