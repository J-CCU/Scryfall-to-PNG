def youtube_prepare_ytdlp_cookiefile(raw: Any) -> Optional[Path]:
    """Convert our JSON cookie export into a temporary Netscape cookie file for yt-dlp."""
    global youtube_YTDLP_COOKIEFILE
    if not isinstance(raw, list):
        return None

    lines = ["# Netscape HTTP Cookie File", "# Generated temporarily by socialblade_scraper.py"]
    count = 0
    for c in raw:
        if not isinstance(c, dict) or not c.get("name") or c.get("value") is None:
            continue
        domain = str(c.get("domain") or ".youtube.com")
        path = str(c.get("path") or "/")
        secure = "TRUE" if bool(c.get("secure", True)) else "FALSE"
        try:
            expires = int(float(c.get("expirationDate") or c.get("expires") or 0))
        except Exception:
            expires = 0
        if c.get("httpOnly") and not domain.startswith("#HttpOnly_"):
            domain = "#HttpOnly_" + domain
        clean_domain = domain[10:] if domain.startswith("#HttpOnly_") else domain
        include_subdomains = "TRUE" if clean_domain.startswith(".") else "FALSE"
        lines.append("\t".join([
            domain, include_subdomains, path, secure, str(expires),
            str(c.get("name")), str(c.get("value")),
        ]))
        count += 1

    if count == 0:
        return None
    path = Path(tempfile.gettempdir()) / f"socialblade_ytdlp_cookies_{os.getpid()}.txt"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    youtube_YTDLP_COOKIEFILE = path
    def _cleanup_cookiefile() -> None:
        try:
            if path.exists():
                path.unlink()
        except Exception:
            pass
    atexit.register(_cleanup_cookiefile)
    youtube_log(f"[cookies] prepared yt-dlp cookiefile | cookies={count} | path={path}")
    return path


def youtube_load_cookies() -> int:
    if not youtube_COOKIES_PATH.exists():
        youtube_log("[cookies] cookies.json not found; public requests only.")
        return 0

    try:
        raw = json.loads(youtube_COOKIES_PATH.read_text(encoding="utf-8"))
    except Exception as exc:
        youtube_log(f"[cookies] could not read cookies.json: {exc}")
        return 0

    count = 0
    for c in raw if isinstance(raw, list) else []:
        if not isinstance(c, dict):
            continue
        if not all(k in c for k in ("name", "value")):
            continue
        try:
            youtube_SESSION.cookies.set(
                c["name"],
                c["value"],
                domain=c.get("domain"),
                path=c.get("path", "/"),
            )
            count += 1
        except Exception:
            continue

    youtube_log(f"[cookies] loaded {count} cookies")
    youtube_prepare_ytdlp_cookiefile(raw)
    return count


def youtube_get_sapisid() -> Optional[str]:
    names = {"SAPISID", "__Secure-3PAPISID", "__Secure-1PAPISID"}
    preferred = [".youtube.com", ".google.com"]

    for domain in preferred:
        for c in youtube_SESSION.cookies:
            if c.name in names and c.domain == domain:
                return c.value
    for c in youtube_SESSION.cookies:
        if c.name in names:
            return c.value
    return None


def youtube_sapisid_hash() -> Optional[str]:
    sapisid = youtube_get_sapisid()
    if not sapisid:
        return None
    ts = int(time.time())
    digest = hashlib.sha1(
        f"{ts} {sapisid} {youtube_YOUTUBE}".encode("utf-8")
    ).hexdigest()
    return f"SAPISIDHASH {ts}_{digest}"


