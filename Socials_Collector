        "is_reply": "YES" if parent_id else "NO",
    }


def _v42_graph_page(path: str, params: dict, db: Optional[instagram_Database]) -> Optional[dict]:
    return instagram_instagram_graph_get(path, params, db)


def instagram_graph_post_comments_v42(post_id: str, db: Optional[instagram_Database] = None) -> list[dict]:
    fields = "id,text,username,timestamp,like_count,replies.limit(100){id,text,username,timestamp,like_count}"
    rows: list[dict] = []
    seen = set()
    after = ""
    complete = True
    while not instagram_stop_requested():
        params = {"fields": fields, "limit": 100}
        if after:
            params["after"] = after
        data = _v42_graph_page(post_id + "/comments", params, db)
        if data is None:
            complete = False
            break
        items = data.get("data") or []
        for c in items:
            if not isinstance(c, dict):
                continue
            cid = str(c.get("id") or "")
            if cid and cid not in seen:
                seen.add(cid)
                rows.append(_v42_graph_comment_row(c))
            replies = c.get("replies") if isinstance(c.get("replies"), dict) else {}
            for r in replies.get("data") or []:
                rid = str((r or {}).get("id") or "")
                if rid and rid not in seen:
                    seen.add(rid)
                    rows.append(_v42_graph_comment_row(r, cid or None))
            rpaging = replies.get("paging") or {}
            rafter = ((rpaging.get("cursors") or {}).get("after") if isinstance(rpaging, dict) else None)
            while rafter and not instagram_stop_requested():
                rdata = _v42_graph_page(
                    cid + "/replies",
                    {"fields": "id,text,username,timestamp,like_count", "limit": 100, "after": rafter},
                    db,
                )
                if rdata is None:
                    complete = False
                    break
                for r in rdata.get("data") or []:
                    rid = str((r or {}).get("id") or "")
                    if rid and rid not in seen:
                        seen.add(rid)
                        rows.append(_v42_graph_comment_row(r, cid or None))
                rpg = rdata.get("paging") or {}
                nxt = ((rpg.get("cursors") or {}).get("after") if isinstance(rpg, dict) else None)
                if not nxt or nxt == rafter:
                    rafter = ""
                else:
                    rafter = str(nxt)
            if not complete:
                break
        if not complete:
            break
        paging = data.get("paging") or {}
        nxt = ((paging.get("cursors") or {}).get("after") if isinstance(paging, dict) else None)
        if not nxt or nxt == after:
            break
        after = str(nxt)
    if instagram_stop_requested():
        complete = False
    _v42_ig_fetch_record(post_id, "COMPLETE" if complete else "PARTIAL", "Meta Graph API", len(rows))
    return rows

