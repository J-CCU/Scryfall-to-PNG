def v13__youtube_state_is_complete(state: Optional[dict], mode: str) -> bool:
    if not state:
        return False
    if str(state.get("enrichment_state") or "").upper() == "COMPLETE":
        return True
    if str(state.get("enrichment_state") or "").upper() in {"IN_PROGRESS", "FAILED", "DISCOVERED"}:
        return False
    if not state.get("last_enriched_at"):
        return False
    if state.get("yt_dlp_status") != "SUCCESS":
        return False
    if state.get("player_status") not in {"SUCCESS", "SKIPPED_NO_API_KEY", "SKIPPED_FAST_PATH", "SKIPPED_PERFORMANCE_REFRESH"}:
        return False
    if mode == "Maximum":
        if state.get("captions_status") not in {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}:
            return False
        if state.get("formats_status") not in {"SUCCESS", "SUCCESS_EMPTY", "SUCCESS_FAST_PATH", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}:
            return False
    return True

