def unified_dispatch_worker_v46(platform_key: str, job_file: str) -> int:
    key = str(platform_key or "").lower()
    path = {"youtube": youtube_DB_PATH, "instagram": instagram_DB_PATH, "tiktok": tiktok_DB_PATH}.get(key)
    print(f"[worker] build={V46_BUILD}", flush=True)
    print(f"[storage/v46] LOCAL SQLITE authoritative | root={V46_DATA_DIR}", flush=True)
    stop = threading.Event()
    thread = None
    if path is not None:
        thread = threading.Thread(target=_v46_db_maintenance_loop, args=(Path(path), stop), name=f"v46-wal-{key}", daemon=True)
        thread.start()
    try:
        return int(_v46_dispatch_prev(platform_key, job_file))
    finally:
        stop.set()
        if thread is not None:
            thread.join(timeout=2.0)
        if path is not None:
            try: _v46_checkpoint_path(Path(path), truncate=True)
            except Exception: pass


