# ---------------------------------------------------------------------------
# Strict platform throttle evidence. Generic "please wait" and numeric IDs
# are never enough to park Instagram/TikTok.
# ---------------------------------------------------------------------------
def v14__ig_is_rate_limit_exception(exc: Exception) -> bool:
    if instagram_instaloader is not None and isinstance(exc, instagram_TooManyRequestsException):
        return True
    text = str(exc or "").lower()
    if "401 unauthorized" in text and "please wait" in text:
        return False
    if re.search(r"\b(?:http(?:\s+error)?\s*)?429\s+(?:too\s+many\s+requests|requests?)\b", text):
        return True
    if re.search(r"\b(?:http\s+)?status(?:[_ ]code)?\s*[:=]?\s*429\b", text):
        return True
    return any(x in text for x in ("too many requests", "rate limit", "rate-limited", "challenge_required", "checkpoint_required", "feedback_required"))

