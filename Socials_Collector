def tiktok_parse_embedded_json(page: str, element_id: str) -> Any:
    if not page:
        return None
    patterns = [
        rf'<script[^>]+id=["\']{re.escape(element_id)}["\'][^>]*>(.*?)</script>',
        rf'<script[^>]+id=["\']{re.escape(element_id)}["\'][^>]*>(.*?)</script',
    ]
    for pat in patterns:
        m = re.search(pat, page, re.I | re.S)
        if not m:
            continue
        raw = html.unescape(m.group(1).strip())
        try:
            return json.loads(raw)
        except Exception:
            pass
    return None


def tiktok_walk_dicts(obj: Any) -> Iterable[dict]:
    if isinstance(obj, dict):
        yield obj
        for value in obj.values():
            yield from tiktok_walk_dicts(value)
    elif isinstance(obj, list):
        for value in obj:
            yield from tiktok_walk_dicts(value)


def tiktok_extract_tiktok_profile_candidate(data: Any, requested_username: str = "") -> dict:
    requested = requested_username.lower()
    best: Optional[dict] = None
    best_score = -1
    for obj in tiktok_walk_dicts(data):
        unique_id = obj.get("uniqueId") or obj.get("unique_id") or obj.get("uniqueID")
        if not isinstance(unique_id, str):
            continue
        score = 0
        if requested and unique_id.lower() == requested:
            score += 100
        if obj.get("secUid") or obj.get("sec_uid"):
            score += 10
        if obj.get("uid") or obj.get("id"):
            score += 5
        if obj.get("nickname") or obj.get("signature") is not None:
            score += 3
        stats = obj.get("stats")
        if isinstance(stats, dict):
            if any(k in stats for k in ("followerCount", "followingCount", "heartCount", "videoCount")):
                score += 8
        if score > best_score:
            stats = obj.get("stats") if isinstance(obj.get("stats"), dict) else {}
            best = {
                "username": unique_id,
                "display_name": obj.get("nickname") or obj.get("displayName") or "",
                "bio": obj.get("signature") or obj.get("bio") or "",
                "uid": obj.get("id") if isinstance(obj.get("id"), (str, int)) else obj.get("uid"),
                "sec_uid": obj.get("secUid") or obj.get("sec_uid") or "",
                "verified": bool(obj.get("verified")),
                "followers": stats.get("followerCount") or obj.get("followerCount"),
                "following": stats.get("followingCount") or obj.get("followingCount"),
                "likes": stats.get("heartCount") or obj.get("heartCount") or obj.get("likesCount"),
                "video_count": stats.get("videoCount") or obj.get("videoCount"),
                "avatar_url": (obj.get("avatarLarger") or obj.get("avatarMedium") or obj.get("avatarThumb") or obj.get("avatar_url") or ""),
                "bio_url": obj.get("bioUrl") or obj.get("bio_url") or "",
            }
            best_score = score
    return best or {}


def tiktok_extract_embedded_videos(data: Any, default_username: str = "") -> List[dict]:
    out: List[dict] = []
    for obj in tiktok_walk_dicts(data):
        vid = obj.get("id")
        if not isinstance(vid, (str, int)) or not re.fullmatch(r"\d{12,22}", str(vid)):
            continue
        if not (obj.get("desc") or obj.get("description") or obj.get("createTime")):
            continue
        stats = obj.get("stats") if isinstance(obj.get("stats"), dict) else {}
        author = obj.get("author") if isinstance(obj.get("author"), dict) else {}
        music = obj.get("music") if isinstance(obj.get("music"), dict) else {}
        out.append(
            {
                "id": str(vid),
                "title": obj.get("desc") or obj.get("description") or f"TikTok video {vid}",
                "description": obj.get("desc") or obj.get("description") or "",
                "timestamp": tiktok_safe_int(obj.get("createTime")),
                "view_count": stats.get("playCount") or stats.get("viewCount"),
                "like_count": stats.get("diggCount") or stats.get("likeCount"),
                "comment_count": stats.get("commentCount"),
                "repost_count": stats.get("shareCount") or stats.get("repostCount"),
                "save_count": stats.get("collectCount") or stats.get("saveCount"),
                "uploader": author.get("uniqueId") or default_username,
                "channel": author.get("nickname") or "",
                "channel_id": author.get("secUid") or "",
                "track": music.get("title") or "",
                "thumbnail": ((obj.get("video") or {}).get("cover") if isinstance(obj.get("video"), dict) else "") or "",
            }
        )
    return tiktok_unique_by_id(out, "id")


def tiktok_get_page_details(url: str) -> Tuple[Optional[str], int, str]:
    if tiktok_stop_requested():
        return None, 0, ""
    try:
        r = tiktok_SESSION.get(url, timeout=tiktok_REQUEST_TIMEOUT, allow_redirects=True)
        tiktok_log(f"[page] {r.status_code} {url} -> {r.url}")
        if r.status_code == 429:
            return r.text[:4000], r.status_code, str(r.url)
        return (r.text if r.status_code == 200 else r.text[:4000]), r.status_code, str(r.url)
    except Exception as exc:
        tiktok_log(f"[page] {type(exc).__name__}: {exc}")
        return None, 0, ""


