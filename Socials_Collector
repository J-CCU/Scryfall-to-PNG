def _v41_collect_comments_ytdlp_fallback(
    run_id: int, db: youtube_Database, video: dict, reason: str
) -> Tuple[str, int]:
    vid = str((video or {}).get("video_id") or "")
    if not vid:
        return "FAILED", 0
    _v38_mark_comment_attempt(db, vid)
    youtube_log(
        f"      [comments/v41] FALLBACK yt-dlp START | video={vid} | reason={reason}"
    )
    status, count, _raw_id = v18__youtube_fetch_comments_ytdlp(run_id, db, video)
    if status in {"SUCCESS", "SUCCESS_EMPTY"}:
        _v38_mark_comment_success(db, vid, status)
    elif status in {"RATE_LIMITED", "STOPPED", "PARTIAL"}:
        _v38_mark_comment_deferred(db, vid, status)
    else:
        db.mark_video_stage(vid, "comments", status)
    youtube_log(
        f"      [comments/v41] FALLBACK yt-dlp {status} | video={vid} | rows_written={count}"
    )
    return status, count


