def instagram_graph_media_rows(username: str, db: Optional[instagram_Database] = None, limit: int = 0) -> list[dict]:
    gid = instagram_instagram_graph_account_id(username)
    if not gid:
        return []
    fields = "id,caption,media_type,media_product_type,media_url,thumbnail_url,permalink,timestamp,like_count,comments_count,shortcode"
    rows: list[dict] = []
    url_path = gid + "/media"
    params = {"fields": fields, "limit": 100}
    while not instagram_stop_requested() and instagram_instagram_graph_budget_available(db):
        data = instagram_instagram_graph_get(url_path, params, db)
        if not data:
            break
        for item in data.get("data") or []:
            if not isinstance(item, dict):
                continue
            ts = item.get("timestamp") or ""
            try:
                epoch = int(datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp()) if ts else None
            except Exception:
                epoch = None
            rows.append({
                "post_id": str(item.get("id") or item.get("shortcode") or ""),
                "shortcode": str(item.get("shortcode") or ""),
                "account_id": gid,
                "username": username,
                "typename": str(item.get("media_type") or ""),
                "taken_at": str(ts),
                "published_epoch": epoch,
                "caption": str(item.get("caption") or ""),
                "likes": instagram_safe_int(item.get("like_count")),
                "comments_count": instagram_safe_int(item.get("comments_count")),
                "video_view_count": None,
