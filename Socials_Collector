# Generic SQLite -> PostgreSQL batch mirror.  Tables with a primary key are
# UPSERTed; append/evidence tables without a PK use ON CONFLICT DO NOTHING.
# A durable per-table cursor makes restarts cheap.  Mutable tables carrying an
# updated_at column are rescanned by timestamp so later refreshes reach Neon.
def _v22_qident(name: str) -> str:
    return '"' + str(name).replace('"', '""') + '"'


def _v22_stage_tables(conn: sqlite3.Connection) -> List[str]:
    rows = conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name"
    ).fetchall()
    return [str(r[0]) for r in rows]


def _v22_table_info(conn: sqlite3.Connection, table: str) -> List[sqlite3.Row]:
    return conn.execute(f"PRAGMA table_info({_v22_qident(table)})").fetchall()


def _v22_sync_one_table(local: sqlite3.Connection, pg, schema: str, table: str, state: sqlite3.Connection) -> int:
    info = _v22_table_info(local, table)
    if not info:
        return 0
    cols = [str(r[1]) for r in info]
    pk_cols = [str(r[1]) for r in sorted(info, key=lambda r: int(r[5] or 0)) if int(r[5] or 0) > 0]
    has_updated = "updated_at" in cols
    state_key = f"{schema}.{table}"
    row = state.execute("SELECT cursor_value FROM sync_state WHERE table_key=?", (state_key,)).fetchone()
    cursor_value = str(row[0]) if row and row[0] is not None else ""

    if has_updated:
        if cursor_value:
            sql = f"SELECT * FROM {_v22_qident(table)} WHERE COALESCE(updated_at,'') >= ? ORDER BY updated_at LIMIT ?"
            rows = local.execute(sql, (cursor_value, V22_SYNC_BATCH)).fetchall()
        else:
            rows = local.execute(f"SELECT * FROM {_v22_qident(table)} ORDER BY COALESCE(updated_at,'') LIMIT ?", (V22_SYNC_BATCH,)).fetchall()
    else:
        last_rowid = int(cursor_value or 0)
        rows = local.execute(
            f"SELECT rowid AS __v22_rowid__, * FROM {_v22_qident(table)} WHERE rowid > ? ORDER BY rowid LIMIT ?",
            (last_rowid, V22_SYNC_BATCH),
        ).fetchall()
    if not rows:
        return 0

    insert_cols = cols
    col_sql = ",".join(_v22_qident(c) for c in insert_cols)
    placeholders = ",".join(["%s"] * len(insert_cols))
    if pk_cols:
        non_pk = [c for c in insert_cols if c not in pk_cols]
        if non_pk:
            conflict = ",".join(_v22_qident(c) for c in pk_cols)
            updates = ",".join(f"{_v22_qident(c)}=EXCLUDED.{_v22_qident(c)}" for c in non_pk)
            tail = f" ON CONFLICT ({conflict}) DO UPDATE SET {updates}"
        else:
            tail = " ON CONFLICT DO NOTHING"
    else:
        tail = " ON CONFLICT DO NOTHING"
    stmt = f"INSERT INTO {_v22_qident(schema)}.{_v22_qident(table)} ({col_sql}) VALUES ({placeholders}){tail}"

    cur = pg.cursor()
    try:
        for r in rows:
            cur.execute(stmt, tuple(r[c] for c in insert_cols))
        pg.commit()
    except Exception:
        pg.rollback()
        raise
    finally:
        cur.close()

    if has_updated:
        new_cursor = max(str(r["updated_at"] or "") for r in rows)
        # ISO timestamps are second-granularity in much of the collector. Keeping
        # >= on the next pass intentionally replays the boundary second; UPSERT
        # makes that safe and avoids losing same-second updates after a crash.
    else:
        new_cursor = str(max(int(r["__v22_rowid__"]) for r in rows))
    state.execute(
        "INSERT INTO sync_state(table_key,cursor_value,updated_at) VALUES(?,?,?) "
        "ON CONFLICT(table_key) DO UPDATE SET cursor_value=excluded.cursor_value, updated_at=excluded.updated_at",
        (state_key, new_cursor, datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")),
    )
    state.commit()
    return len(rows)


def v22_neon_sync_worker() -> int:
    database_url = _v21_database_url()
    if not (database_url.lower().startswith("postgresql://") or database_url.lower().startswith("postgres://")):
        print("[neon-sync] DATABASE_URL is not PostgreSQL; sync worker disabled", flush=True)
        return 2
    psycopg2, _extras = _v21_pg_import()
    state_path = V22_STAGE_DIR / "neon_sync_state.db"
    state = sqlite3.connect(str(state_path), timeout=30.0)
    state.execute("PRAGMA journal_mode=WAL")
    state.execute("CREATE TABLE IF NOT EXISTS sync_state(table_key TEXT PRIMARY KEY,cursor_value TEXT,updated_at TEXT)")
    state.commit()
    print(f"[neon-sync] START | interval={V22_SYNC_INTERVAL:.1f}s | batch={V22_SYNC_BATCH}", flush=True)
    while True:
        did_work = 0
        try:
            pg = psycopg2.connect(database_url, connect_timeout=20)
            pg.autocommit = False
            try:
                for schema, path in V22_STAGE_PATHS.items():
                    if not path.exists():
                        continue
                    local = sqlite3.connect(str(path), timeout=30.0)
                    local.row_factory = sqlite3.Row
                    try:
                        for table in _v22_stage_tables(local):
                            try:
                                n = _v22_sync_one_table(local, pg, schema, table, state)
                                if n:
                                    did_work += n
                                    print(f"[neon-sync] {schema}.{table}: {n} rows", flush=True)
                            except Exception as exc:
                                # A table created locally by a newer collector may
                                # not exist in Neon yet. Initialize the schema via
                                # the normal collector DDL on the next reconnect.
                                print(f"[neon-sync] WARN {schema}.{table}: {type(exc).__name__}: {exc}", flush=True)
                    finally:
                        local.close()
            finally:
                pg.close()
        except KeyboardInterrupt:
            break
        except Exception as exc:
            print(f"[neon-sync] connection/retry: {type(exc).__name__}: {exc}", flush=True)
        time.sleep(0.2 if did_work >= V22_SYNC_BATCH else V22_SYNC_INTERVAL)
    state.close()
    return 0


# V22 scheduler: platform workers always stage locally; Neon synchronization is
# a separate process.  Stop remains crash-safe because ingestion state is durable
# before/through enrichment and the next Start re-audits incomplete evidence.
class UnifiedSchedulerV22(UnifiedSchedulerV20):
    def __init__(self, app: "UnifiedApp") -> None:
        super().__init__(app)
        self.sync_process: Optional[subprocess.Popen] = None
        self.graceful_end_requested = False

    def _worker_env(self, platform: UnifiedPlatform) -> Dict[str, str]:
        env = super()._worker_env(platform)
        env["SOCIAL_COLLECTOR_STAGE_ONLY"] = "1"
        env["SOCIAL_COLLECTOR_PERFORMANCE_MODE"] = "FAST" if self.high_throughput else "SAFE"
        # Dedicated server: use a larger but still bounded YouTube enrichment pool.
        # Real rate-limit responses still trigger the existing durable cooldown logic.
        if self.high_throughput:
            env.setdefault("SOCIAL_COLLECTOR_FAST_CONCURRENCY", "6")
        return env

    def _db_runtime_state(self, db_path: Path) -> Dict[str, str]:
        schema = _v21_platform_schema_from_path(db_path)
        path = V22_STAGE_PATHS.get(schema, db_path)
        if not Path(path).exists():
            return {}
        try:
            conn = sqlite3.connect(str(path), timeout=2.0)
            try:
                rows = conn.execute("SELECT key,value FROM runtime_state").fetchall()
                return {str(k): str(v) for k, v in rows}
            finally:
                conn.close()
        except Exception:
            return {}

    def start(self, *args, **kwargs) -> None:
        self.graceful_end_requested = False
        # Start the independent Neon uploader first.  If Neon is unavailable it
        # retries while scraping continues safely into local WAL databases.
        if self.sync_process is None or self.sync_process.poll() is not None:
            try:
                env = os.environ.copy()
                env.pop("SOCIAL_COLLECTOR_STAGE_ONLY", None)
                env["PYTHONUNBUFFERED"] = "1"
                self.sync_process = subprocess.Popen(
                    [sys.executable, str(Path(__file__).resolve()), "--neon-sync-worker"],
                    cwd=str(BASE_DIR), env=env,
                    stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT,
                )
            except Exception as exc:
                self.ui_log(f"[neon-sync] could not start background sync: {type(exc).__name__}: {exc}\n")
        super().start(*args, **kwargs)

    def stop(self) -> None:
        # Graceful END: do not set the hard stop event and do not kill workers in
        # the middle of an item. Each output monitor waits for the next PROGRESS
        # checkpoint (emitted after the current item returns), then terminates that
        # worker before another item starts. A real OS force-kill remains safe: the
        # next Start audits ingestion evidence and RESUMEs incomplete items.
        self.graceful_end_requested = True
        self.wake_event.set()
        self.ui_log("[control] END requested | finishing current item on each active platform, then stopping.\n")
        with self.process_lock:
            active = list(self.processes.keys())
        if not active:
            self.stop_event.set()

    def _main(self) -> None:
        try:
            super()._main()
        finally:
            proc = self.sync_process
            if proc is not None and proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    pass


UnifiedScheduler = UnifiedSchedulerV22

