def _v46_is_sqlite_conn(conn) -> bool:
    return isinstance(conn, sqlite3.Connection)


def _v46_tune_sqlite_connection(conn: sqlite3.Connection) -> None:
    """Throughput-oriented, crash-safe WAL settings for a local SSD database."""
    try:
        conn.execute(f"PRAGMA busy_timeout={V46_DB_BUSY_TIMEOUT_MS}")
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA synchronous=NORMAL")
        conn.execute("PRAGMA temp_store=MEMORY")
        conn.execute(f"PRAGMA cache_size=-{V46_DB_CACHE_KIB}")
        conn.execute(f"PRAGMA mmap_size={V46_DB_MMAP_BYTES}")
        conn.execute(f"PRAGMA wal_autocheckpoint={V46_WAL_AUTOCHECKPOINT_PAGES}")
        conn.execute(f"PRAGMA journal_size_limit={max(V46_WAL_SIZE_TRIGGER_BYTES * 2, 128 * 1024 * 1024)}")
        conn.execute("PRAGMA foreign_keys=ON")
    except Exception:
        pass


def _v46_add_hot_indexes(db, platform: str) -> None:
    if not _v46_is_sqlite_conn(getattr(db, "conn", None)):
        return
    with db.lock:
        if platform == "youtube":
            db.conn.executescript("""
                CREATE INDEX IF NOT EXISTS idx_v46_yt_audit_state
                    ON video_ingestion(completeness_audit_status,enrichment_state);
                CREATE INDEX IF NOT EXISTS idx_v46_yt_comment_status
                    ON video_ingestion(comments_status);
                CREATE INDEX IF NOT EXISTS idx_v46_yt_work_priority
                    ON youtube_work_queue(stage,state,priority DESC,attempts,created_at,next_attempt_at);
            """)
        elif platform == "instagram":
            db.conn.executescript("""
                CREATE INDEX IF NOT EXISTS idx_v46_ig_audit_state
                    ON post_ingestion(completeness_audit_status,enrichment_state);
                CREATE INDEX IF NOT EXISTS idx_v46_ig_comment_status
                    ON post_ingestion(comments_status);
            """)
        elif platform == "tiktok":
            db.conn.executescript("""
                CREATE INDEX IF NOT EXISTS idx_v46_tt_audit_state
                    ON video_ingestion(completeness_audit_status,enrichment_state);
                CREATE INDEX IF NOT EXISTS idx_v46_tt_comment_status
                    ON video_ingestion(comments_status);
            """)
        try:
            db.conn.execute("PRAGMA optimize")
        except Exception:
            pass
        db.conn.commit()


