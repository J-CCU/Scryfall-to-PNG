def youtube_get_page_details(url: str) -> Tuple[Optional[str], int, str]:
    """Fetch a page and retain the final URL so exact @handle redirects can be verified.

    The final URL matters for handle resolution: a successful request to the exact
    YouTube @handle route is a much stronger identity signal than a broad page regex.
    """
    if youtube_stop_requested():
        return None, 0, ""
    try:
        r = youtube_SESSION.get(
            url,
            timeout=youtube_REQUEST_TIMEOUT,
            headers={
                "User-Agent": youtube_UA,
                "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
                "Referer": youtube_HOME,
            },
            allow_redirects=True,
        )
        youtube_debug(f"[page] {r.status_code} {url} -> {r.url}")
        return (r.text if r.status_code == 200 else None), r.status_code, str(r.url or url)
    except Exception as exc:
        youtube_debug(f"[page] {type(exc).__name__}: {exc}")
        return None, 0, ""


def youtube_get_page(url: str) -> Tuple[Optional[str], int]:
    page, status, _ = youtube_get_page_details(url)
    return page, status


def youtube_normalize_handle(value: str) -> str:
    value = value.strip()
    if value.startswith("@"):
        return value[1:].split("/")[0].split("?")[0]
    if "youtube.com/@" in value:
        return value.split("youtube.com/@", 1)[1].split("/")[0].split("?")[0]
    return ""


def youtube_resolve_handle(handle: str, db: Optional["Database"] = None, *, force_refresh: bool = False) -> Optional[str]:
    """Resolve a handle with a cache-first strategy.

    New handles use the exact @handle page as the primary resolver. yt-dlp and the
    canonical channel page are fallbacks only when the page does not provide a
    sufficient identity signal. Previously verified mappings are reused without
    network calls unless force_refresh is requested.
    """
    if youtube_stop_requested():
        return None
    handle = handle.strip().lstrip("@").split("/")[0]
    if not handle:
        return None

    requested = youtube_normalize_handle_for_compare(handle)
    youtube_LAST_RESOLUTION.update({
        "requested_handle": requested, "channel_id": "", "resolved_handle": "",
        "resolved_title": "", "method": "", "verified": False,
    })

    # 1) Trusted local cache: avoid all network resolution for known handles.
    if db is not None and not force_refresh:
        cached = db.get_cached_channel_resolution(handle)
        if cached:
            cid = cached.get("channel_id")
            if isinstance(cid, str) and cid.startswith("UC"):
                youtube_LAST_RESOLUTION.update({
                    "requested_handle": requested, "channel_id": cid,
                    "resolved_handle": cached.get("resolved_handle", "") or requested,
                    "resolved_title": cached.get("resolved_title", ""),
                    "method": cached.get("method", "cached_verified"),
                    "verified": True,
                })
                youtube_debug(f"[resolve/cache] @{handle} -> {cid} [verified cache]")
                return cid

    url = f"{youtube_YOUTUBE}/@{handle}"

    # 2) Official Data API, when configured, is an exact one-request resolver.
    api_item = youtube_youtube_api_resolve_handle(handle)
    if api_item:
        cid = api_item.get("id")
        if isinstance(cid, str) and cid.startswith("UC"):
            title = (api_item.get("snippet") or {}).get("title", "")
            handle_value = ((api_item.get("snippet") or {}).get("customUrl") or "").lstrip("@")
            if not handle_value or youtube_normalize_handle_for_compare(handle_value) == requested:
                youtube_LAST_RESOLUTION.update({
                    "requested_handle": requested, "channel_id": cid,
                    "resolved_handle": handle_value or requested, "resolved_title": title,
                    "method": "YouTube Data API", "verified": True,
                })
                youtube_debug(f"[resolve/api] @{handle} -> {cid} [YouTube Data API]")
                return cid

    if youtube_stop_requested():
        return None

    # 3) PRIMARY PUBLIC resolver: fetch the exact requested @handle page once.
    # The page's canonical URL / own channel identity is sufficient to verify an
    # exact handle match, eliminating the old yt-dlp + channel-page double lookup.
    page, status, final_url = youtube_get_page_details(url)
    if page:
        cid, page_title, page_handle = youtube_extract_channel_identity_from_page(page)
        page_handle_norm = youtube_normalize_handle_for_compare(page_handle)
        final_handle_norm = youtube_normalize_handle_for_compare(youtube_normalize_handle(final_url))
        if cid and cid.startswith("UC"):
            # The exact @handle route itself is an authoritative identity signal.
            # This avoids the expensive yt-dlp fallback that previously caused
            # successful handles to take 1-3 minutes to resolve.
            route_matches = final_handle_norm == requested
            canonical_matches = page_handle_norm == requested
            if route_matches or canonical_matches:
                resolved_handle = page_handle or requested
                method = "exact @handle route" if route_matches else "exact @handle page"
                youtube_LAST_RESOLUTION.update({
                    "requested_handle": requested, "channel_id": cid,
                    "resolved_handle": resolved_handle, "resolved_title": page_title,
                    "method": method, "verified": True,
                })
                youtube_debug(f"[resolve/page] @{handle} -> {cid} [{method}]")
                return cid
            if not page_handle_norm and not final_handle_norm:
                youtube_debug(f"[resolve/page] @{handle} -> {cid} but page exposed no handle/route; fallback")
            else:
                youtube_debug(
                    f"[resolve/page] handle mismatch: requested=@{handle}, "
                    f"page=@{page_handle or '(none)'} final=@{final_handle_norm or '(none)'}; rejecting candidate"
                )

    if youtube_stop_requested():
        return None

    # 4) yt-dlp fallback. This is now only used when the exact page did not give
    # us a complete, matching identity.
    if youtube_yt_dlp is not None:
        try:
            opts = {
                "quiet": True,
                "no_warnings": True,
                "ignoreerrors": True,
                "extract_flat": True,
                "skip_download": True,
                "socket_timeout": min(8, youtube_REQUEST_TIMEOUT),
                "retries": 1,
                "fragment_retries": 1,
                "extractor_retries": 1,
                "cachedir": False,
            }
            with youtube_yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(url, download=False)

            if info:
                cid = info.get("channel_id") or info.get("uploader_id")
                candidate_handle = (
                    info.get("channel_handle")
                    or info.get("uploader_id")
                    or info.get("webpage_url_basename")
                    or ""
                )
                candidate_handle_norm = youtube_normalize_handle_for_compare(candidate_handle)
                title = info.get("channel") or info.get("uploader") or info.get("title") or ""
                if (
                    isinstance(cid, str)
                    and cid.startswith("UC")
                    and candidate_handle_norm == requested
                ):
                    youtube_LAST_RESOLUTION.update({
                        "requested_handle": requested, "channel_id": cid,
                        "resolved_handle": str(candidate_handle).lstrip("@"),
                        "resolved_title": str(title),
                        "method": "yt-dlp exact fallback", "verified": True,
                    })
                    youtube_debug(f"[resolve/yt-dlp] @{handle} -> {cid} [exact fallback]")
                    return cid
        except Exception as exc:
            youtube_debug(f"[resolve/yt-dlp] {type(exc).__name__}: {exc}")

    if youtube_stop_requested():
        return None

    # 5) Last-resort channel URL page verification when the @handle page was
    # inconclusive but a canonical channel ID was discovered.
    if page:
        cid, page_title, page_handle = youtube_extract_channel_identity_from_page(page)
        if cid and cid.startswith("UC") and youtube_normalize_handle_for_compare(page_handle) == requested:
            youtube_LAST_RESOLUTION.update({
                "requested_handle": requested, "channel_id": cid,
                "resolved_handle": page_handle, "resolved_title": page_title,
                "method": "canonical page", "verified": True,
            })
            return cid

    youtube_LAST_RESOLUTION.update({
        "requested_handle": requested, "channel_id": "",
        "resolved_handle": "", "resolved_title": "",
        "method": "unresolved", "verified": False,
    })
    return None


def youtube_get_channel_id(value: str, db: Optional["Database"] = None, *, force_refresh: bool = False) -> Optional[str]:
    if youtube_stop_requested():
        return None
    youtube_LAST_RESOLUTION.update({
        "requested_handle": "", "channel_id": "", "resolved_handle": "",
        "resolved_title": "", "method": "direct", "verified": True,
    })
    value = value.strip()

    if re.fullmatch(r"UC[a-zA-Z0-9_-]{20,}", value):
        youtube_LAST_RESOLUTION["channel_id"] = value
        return value

    if "/channel/" in value:
        cid = value.split("/channel/", 1)[1].split("/", 1)[0].split("?", 1)[0]
        if cid.startswith("UC"):
            youtube_LAST_RESOLUTION["channel_id"] = cid
            return cid

    if value.startswith("@") or "youtube.com/@" in value:
        return youtube_resolve_handle(youtube_normalize_handle(value), db=db, force_refresh=force_refresh)

    if "youtube.com/" in value:
        page, _ = youtube_get_page(value)
        if page:
            cid = youtube_extract_channel_id(page)
            if cid:
                return cid
        return None

    return None


