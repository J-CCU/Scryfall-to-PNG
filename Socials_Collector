# Physical persistence visibility. These counts answer "is it in SQLite?"
# separately from strict per-item completion.
# ---------------------------------------------------------------------------
def _v44_storage_counts(db_path: Path, platform: str) -> dict:
    if not Path(db_path).exists():
        return {"canonical":0,"snapshots":0,"raw":0,"formats":0,"captions":0,"comments":0,"sidecars":0,"heavy_work":0,"comment_work":0}
    conn = sqlite3.connect(str(db_path), timeout=2.0)
    try:
        p = str(platform).lower()
        if p == "youtube":
            tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
            work = {"heavy_work":0,"comment_work":0}
            if "youtube_work_queue" in tables:
                work["heavy_work"] = int(conn.execute("SELECT COUNT(*) FROM youtube_work_queue WHERE stage='heavy' AND state<>'DONE'").fetchone()[0] or 0)
                work["comment_work"] = int(conn.execute("SELECT COUNT(*) FROM youtube_work_queue WHERE stage='comments' AND state<>'DONE'").fetchone()[0] or 0)
            return {
                "canonical": int(conn.execute("SELECT COUNT(*) FROM videos").fetchone()[0] or 0),
                "snapshots": int(conn.execute("SELECT COUNT(*) FROM video_snapshots").fetchone()[0] or 0),
                "raw": int(conn.execute("SELECT COUNT(*) FROM raw_data").fetchone()[0] or 0),
                "formats": int(conn.execute("SELECT COUNT(*) FROM formats").fetchone()[0] or 0),
                "captions": int(conn.execute("SELECT COUNT(*) FROM caption_tracks").fetchone()[0] or 0),
