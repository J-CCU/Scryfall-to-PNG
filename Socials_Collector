def v18__youtube_fetch_comments_api(run_id: int, db: youtube_Database, video: dict) -> Tuple[str, int, Optional[int]]:
    if not youtube_YOUTUBE_API_KEY or not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
        return "UNAVAILABLE_NO_API_KEY", 0, None
    vid = str(video.get("video_id") or "")
    if not vid:
        return "FAILED", 0, None
    comments: List[dict] = []
    raw_pages = 0
    page_token = ""
    try:
        while not youtube_stop_requested():
            params = {"part": "snippet,replies", "videoId": vid, "maxResults": 100, "order": "time", "textFormat": "plainText"}
            if page_token:
                params["pageToken"] = page_token
            data, status, body = youtube_youtube_api_get("commentThreads", params, db=db, run_id=run_id, note=f"video_comments_{vid}")
            if status == 403 and "commentsDisabled" in body:
                return "SUCCESS_EMPTY", 0, None
            if not data:
                if status == 403 and "commentsDisabled" in body:
                    return "SUCCESS_EMPTY", 0, None
                return "FAILED", len(comments), None
            raw_pages += 1
            raw_id = db.raw(run_id, channel_id=video.get("channel_id"), video_id=vid, source="youtube_api", endpoint="commentThreads", status=status, payload=data, content_type="application/json", note="video_comments_page")
            page_items = data.get("items") or []
            for thread in page_items:
                sn = thread.get("snippet") or {}
                top = sn.get("topLevelComment") or {}
                c = v18__youtube_comment_from_api_item(top, vid, "root")
                if c and c.get("id"):
                    comments.append(c)
                total_reply_count = int(sn.get("totalReplyCount") or 0)
                included_replies = ((thread.get("replies") or {}).get("comments") or [])
                for reply in included_replies:
                    rc = v18__youtube_comment_from_api_item(reply, vid, str(top.get("id") or "root"))
                    if rc and rc.get("id"):
                        comments.append(rc)
                if total_reply_count > len(included_replies) and top.get("id"):
                    reply_token = ""
                    while not youtube_stop_requested():
                        rp = {"part": "snippet", "parentId": top.get("id"), "maxResults": 100, "textFormat": "plainText"}
                        if reply_token:
                            rp["pageToken"] = reply_token
                        rdata, rstatus, rbody = youtube_youtube_api_get("comments", rp, db=db, run_id=run_id, note=f"video_comment_replies_{vid}")
                        if not rdata:
                            break
                        rid = db.raw(run_id, channel_id=video.get("channel_id"), video_id=vid, source="youtube_api", endpoint="comments", status=rstatus, payload=rdata, content_type="application/json", note="video_comment_replies_page")
                        for reply in rdata.get("items") or []:
                            rc = v18__youtube_comment_from_api_item(reply, vid, str(top.get("id") or "root"))
                            if rc and rc.get("id"):
                                comments.append(rc)
                        reply_token = rdata.get("nextPageToken") or ""
                        if not reply_token:
                            break
            page_token = data.get("nextPageToken") or ""
            if not page_token:
                break
        if youtube_stop_requested():
            return "PARTIAL", len(comments), None
        expected = youtube_safe_int(video.get("comment_count"))
        inserted = db.insert_comments_batch(run_id, comments, None)
        # The API's page traversal completed. If the published count is known and
        # we still have fewer persisted comments, leave the stage PARTIAL so a
        # later run will audit/resume it rather than declaring false completeness.
        if expected is not None and expected > len(comments):
            return "PARTIAL", inserted, None
        return ("SUCCESS" if comments else "SUCCESS_EMPTY"), inserted, None
    except Exception as exc:
        if "commentsDisabled" in str(exc):
            return "SUCCESS_EMPTY", len(comments), None
        db.error(run_id, channel_id=video.get("channel_id"), video_id=vid, stage="youtube_comments", endpoint="commentThreads", status=None, exc_type=type(exc).__name__, message=str(exc), detail=traceback.format_exc())
        return "FAILED", len(comments), None


def v18__youtube_fetch_comments_ytdlp(run_id: int, db: youtube_Database, video: dict) -> Tuple[str, int, Optional[int]]:
    if youtube_yt_dlp is None:
        return "UNAVAILABLE_NO_YTDLP", 0, None
    vid = str(video.get("video_id") or "")
    url = video.get("webpage_url") or f"https://www.youtube.com/watch?v={vid}"
    opts = youtube_ytdlp_base_opts(False, use_cookies=not youtube_YTDLP_PUBLIC_FIRST)
    opts["noplaylist"] = True
    opts["extract_flat"] = False
    opts["getcomments"] = True
    opts["extractor_args"] = {
        "youtube": {
            "comment_sort": "new",
            "max_comments": "all,all,all,all,all",
        }
    }
    started = time.monotonic()
    try:
        # Comments are an optional heavy operation. Keep their own top-level
        # start pacing rather than interfering with the primary video cadence.
        if not youtube_wait_for_ytdlp_video_slot("Maximum", label=f"comments:{vid}"):
            return ("RATE_LIMITED" if youtube_ytdlp_rate_limited() else "STOPPED"), 0, None
        with youtube_yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            sanitized = ydl.sanitize_info(info) if info else None
        if not info:
            return "FAILED", 0, None
        raw_id = None
        if sanitized is not None:
            raw_id = db.raw(run_id, channel_id=video.get("channel_id"), video_id=vid, source="yt-dlp", endpoint=url, status=200, payload=sanitized, content_type="application/json", note="video_comments")
        extracted = []
        for c in info.get("comments") or []:
            if isinstance(c, dict):
                row = dict(c)
                row["video_id"] = vid
                extracted.append(row)
        expected = youtube_safe_int(video.get("comment_count"))
        inserted = db.insert_comments_batch(run_id, extracted, raw_id)
        if youtube_stop_requested():
            return "PARTIAL", inserted, raw_id
        if expected is not None and expected > len(extracted):
            return "PARTIAL", inserted, raw_id
        return ("SUCCESS" if extracted else "SUCCESS_EMPTY"), inserted, raw_id
    except Exception as exc:
        text = str(exc)
        if "429" in text and "too many requests" in text.lower():
            return "RATE_LIMITED", 0, None
        db.error(run_id, channel_id=video.get("channel_id"), video_id=vid, stage="youtube_comments", endpoint=url, status=None, exc_type=type(exc).__name__, message=text, detail=traceback.format_exc())
        return "FAILED", 0, None


