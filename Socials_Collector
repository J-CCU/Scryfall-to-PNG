def _v42_ig_enrich(self: instagram_Collector, run_id: int, p: dict, mode: str, action: str) -> None:
    if action != "COMMENT_REPAIR":
        return _v42_ig_enrich_prev(self, run_id, p, mode, action)
    pid = str(p.get("post_id") or "")
    try:
        if instagram_instagram_graph_enabled(username=str(p.get("username") or ""), account_id=str(p.get("account_id") or "")):
            comments = instagram_graph_post_comments(pid, self.db)
            for c in comments:
                raw_id = self.db.insert_raw(run_id, p.get("account_id", ""), pid, "Meta Graph API", "comment", c)
                self.db.insert_comment(run_id, pid, c, raw_id)
            self.db.update_post_stage(pid, "comments_status", "SUCCESS" if comments else "SUCCESS_EMPTY")
        elif instagram_instaloader is not None and p.get("shortcode"):
            obj = self.live_posts.get(pid) or instagram_instaloader.Post.from_shortcode(self.loader.context, p.get("shortcode"))
            count = self.collect_comments(run_id, obj, pid)
            self.db.update_post_stage(pid, "comments_status", "SUCCESS" if count else "SUCCESS_EMPTY")
        else:
            self.db.update_post_stage(pid, "comments_status", "DEFERRED_NO_COMMENT_SOURCE")
        complete = _v42_refresh_ig_audit(self.db, pid)
        if complete:
            with self.db.lock:
                self.db.conn.execute("UPDATE post_ingestion SET enrichment_state='COMPLETE',current_stage='COMPLETE',last_error=NULL WHERE post_id=?", (pid,))
                self.db.conn.commit()
        self.emit(f"      [comments/v42] Instagram comment repair | post={pid} | complete={'yes' if complete else 'no'}")
    except Exception as exc:
        self.db.update_post_stage(pid, "comments_status", "FAILED", str(exc))
        self.db.record_error(run_id, account_id=p.get("account_id", ""), post_id=pid, stage="comments_v42", exc=exc)
        _v42_refresh_ig_audit(self.db, pid)
        self.emit(f"      [comments/v42] Instagram repair ERROR | post={pid} | {type(exc).__name__}: {exc}")

instagram_Collector.enrich_post = _v42_ig_enrich


