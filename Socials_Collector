def v38__youtube_run(self, *args, **kwargs):
    global youtube_COLLECT_COMMENTS, _V38_PIPELINE, _V38_PIPELINE_ACTIVE
    previous_comment_flag = youtube_COLLECT_COMMENTS
    # V48: do not override the shared comments toggle. The worker already loaded
    # the user's selection from the job/env before entering this run wrapper.
    youtube_COLLECT_COMMENTS = bool(previous_comment_flag)
    _v38_migrate_youtube_schema(self.db)

    mode = str(kwargs.get("mode") or (args[2] if len(args) > 2 else "Maximum"))
    repaired = _v38_repair_complete_checkpoints(self.db, mode)
    if repaired:
        self.emit(f"[db-repair/v38] completed checkpoints repaired={repaired} | network=0")
    self.emit(
        f"[youtube/v38] PARALLEL PIPELINE | comments={'ON' if youtube_COLLECT_COMMENTS else 'OFF'} | discovery/API runs ahead | "
        f"yt-dlp_workers={V38_YTDLP_WORKERS} | comment_workers={V38_COMMENT_WORKERS} | "
        f"comment_backlog={V38_COMMENT_BACKLOG_PER_CHANNEL}/channel | "
        f"heavy_repair={V38_HEAVY_REPAIR_PER_CHANNEL}/channel"
    )
    if youtube_COLLECT_COMMENTS:
        if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
            self.emit(
                f"[youtube/v38] comments source=official YouTube Data API | page_size={youtube_YOUTUBE_API_COMMENT_PAGE_SIZE} | "
                f"comment_ceiling={max(0, youtube_YOUTUBE_API_DAILY_BUDGET - V38_COMMENT_API_RESERVE)} | "
                f"reserved_for_discovery_metadata={V38_COMMENT_API_RESERVE} requests"
            )
        else:
            self.emit(
                "[youtube/v38] WARNING: comments ON without a YouTube Data API key; isolated yt-dlp fallback will be used"
            )
    else:
        self.emit("[youtube/v48] comments OFF | comment backlog preserved; payload/discovery work can advance without comment gating")

    # Base runner creates run_id internally. Temporarily install a lightweight
    # proxy pipeline after begin_run becomes observable via self.last_run_id.
    # The original runner sets self.last_run_id immediately after begin_run, so
    # create a lazy holder whose run_id is corrected on first submission.
    class _LazyPipeline(V38YouTubePipeline):
        def __init__(lazy_self):
            super().__init__(0, self.db, mode, self.emit)
        def _sync_run_id(lazy_self):
            rid = int(getattr(self, "last_run_id", 0) or 0)
            if rid > 0:
                lazy_self.run_id = rid
        def submit_heavy(lazy_self, video, action):
            lazy_self._sync_run_id()
            return super(_LazyPipeline, lazy_self).submit_heavy(video, action)
        def submit_comments(lazy_self, video, *, force=False):
            lazy_self._sync_run_id()
            return super(_LazyPipeline, lazy_self).submit_comments(video, force=force)

    pipeline = _LazyPipeline()
    with _V38_PIPELINE_LOCK:
        _V38_PIPELINE = pipeline
        _V38_PIPELINE_ACTIVE = True

    run_id = 0
    stats = {}
    try:
        run_id = int(_v38_youtube_run_base(self, *args, **kwargs) or 0)
        pipeline.run_id = run_id or pipeline.run_id
        stats = pipeline.drain()

        # Re-evaluate checkpoints after both lanes drain. This is local DB work;
        # it does not re-fetch anything.
        if run_id:
            with self.db.lock:
                ids = [
                    str(r[0]) for r in self.db.conn.execute(
                        "SELECT video_id FROM video_ingestion WHERE last_run_id=?", (run_id,)
                    ).fetchall() if r and r[0]
                ]
            complete_count = 0
            for vid in ids:
                if _v38_finalize_video(self.db, vid):
                    complete_count += 1
            self.emit(
                f"[youtube/v38] final checkpoint audit | run={run_id} | videos_seen={len(ids)} | "
                f"fully_complete={complete_count} | pending={max(0, len(ids)-complete_count)} | network=0"
            )

            with self.db.lock:
                row = self.db.conn.execute(
                    "SELECT status, COALESCE(notes,'') FROM scrape_runs WHERE id=?", (run_id,)
                ).fetchone()
            old_status = str(row[0]) if row else "COMPLETED"
            old_notes = str(row[1]) if row else ""
            final_status = "STOPPED" if youtube_stop_requested() else old_status
            v38_note = (
                f"v38_ytdlp={stats.get('heavy_completed',0)}/{stats.get('heavy_submitted',0)} "
                f"v38_ytdlp_failed={stats.get('heavy_failed',0)} "
                f"v38_comments={stats.get('comment_completed',0)}/{stats.get('comment_submitted',0)} "
                f"v38_comments_deferred={stats.get('comment_deferred',0)} "
                f"v38_comments_failed={stats.get('comment_failed',0)}"
            )
            self.db.finish_run(run_id, final_status, (old_notes + " | " + v38_note).strip(" |"))

        self.emit(
            f"[youtube/v38] LANES DRAINED | yt-dlp={stats.get('heavy_completed',0)}/{stats.get('heavy_submitted',0)} "
            f"failed={stats.get('heavy_failed',0)} | comments={stats.get('comment_completed',0)}/{stats.get('comment_submitted',0)} "
            f"deferred={stats.get('comment_deferred',0)} failed={stats.get('comment_failed',0)}"
        )
        return run_id
    finally:
        try:
            pipeline.close()
        finally:
            with _V38_PIPELINE_LOCK:
                _V38_PIPELINE = None
                _V38_PIPELINE_ACTIVE = False
            youtube_COLLECT_COMMENTS = previous_comment_flag


