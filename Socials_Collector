def tiktok_hours_since_iso(value: Any) -> Optional[float]:
    if not value:
        return None
    try:
        dt = datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return max(0.0, (datetime.now(timezone.utc) - dt).total_seconds() / 3600.0)
    except Exception:
        return None


def tiktok_choose_video_action(db: tiktok_Database, video: dict, mode: str, force_refresh: bool) -> str:
    if force_refresh:
        return "FORCE"
    state = db.get_video_state(video.get("video_id", "")) or {}
    if not state or not state.get("last_enriched_at"):
        return "NEW"
    if state.get("last_error"):
        return "RESUME"
    age_hours = tiktok_hours_since_iso(state.get("last_enriched_at"))
    if age_hours is None:
        return "RESUME"
    refresh_hours = 24.0 if (tiktok_video_age_days(video) or 999) <= 30 else 168.0
    heavy_due = tiktok_hours_since_iso(state.get("last_maximum_refresh_at"))
    if mode == "Maximum" and (heavy_due is None or heavy_due >= 168.0):
        return "HEAVY_REFRESH"
    if age_hours >= refresh_hours:
        return "PERFORMANCE_REFRESH"
    return "SKIP"


