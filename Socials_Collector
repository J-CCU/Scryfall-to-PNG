def instagram_build_instaloader() -> "instaloader.Instaloader":
    if instagram_instaloader is None:
        raise RuntimeError("instaloader is not installed")
    loader = instagram_instaloader.Instaloader(
        sleep=True,
        quiet=True,
        download_pictures=False,
        download_videos=False,
        download_video_thumbnails=False,
        download_geotags=False,
        download_comments=False,
        save_metadata=False,
        compress_json=True,
        max_connection_attempts=(1 if not instagram_INSTAGRAM_LOGIN_USERNAME else 3),
        request_timeout=instagram_REQUEST_TIMEOUT,
        resume_prefix="instagram_collector",
        check_resume_bbd=True,
    )
    if instagram_INSTAGRAM_LOGIN_USERNAME:
        session_file = instagram_INSTAGRAM_SESSION_FILE or None
        try:
            loader.load_session_from_file(instagram_INSTAGRAM_LOGIN_USERNAME, filename=session_file)
            instagram_log(f"[session] Instaloader session loaded | username={instagram_INSTAGRAM_LOGIN_USERNAME}")
        except FileNotFoundError:
            instagram_log(f"[session] session file not found | username={instagram_INSTAGRAM_LOGIN_USERNAME} | using anonymous/public mode")
        except Exception as exc:
            instagram_log(f"[session] session load failed | {type(exc).__name__}: {exc}")
    return loader


def instagram_object_node(obj: Any) -> Any:
    for attr in ("_node", "_full_metadata", "node"):
        try:
            value = getattr(obj, attr)
            if isinstance(value, (dict, list)):
                return value
        except Exception:
            pass
    return {}


def instagram_profile_to_dict(profile: Any, username: str, method: str, verified: bool) -> dict:
    pid = str(getattr(profile, "userid", "") or getattr(profile, "user_id", "") or "")
    return {
        "account_id": pid or username,
        "username": str(getattr(profile, "username", "") or username),
        "full_name": str(getattr(profile, "full_name", "") or ""),
        "biography": str(getattr(profile, "biography", "") or ""),
        "external_url": str(getattr(profile, "external_url", "") or ""),
        "profile_pic_url": str(getattr(profile, "profile_pic_url", "") or ""),
        "is_private": bool(getattr(profile, "is_private", False)),
        "is_verified": bool(getattr(profile, "is_verified", False)),
        "is_business_account": bool(getattr(profile, "is_business_account", False)),
        "followers": instagram_safe_int(getattr(profile, "followers", None)),
        "followees": instagram_safe_int(getattr(profile, "followees", None)),
        "media_count": instagram_safe_int(getattr(profile, "mediacount", None)),
