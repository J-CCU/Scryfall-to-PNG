def _v52_ig_ytdlp_payload_only(self: instagram_Collector, run_id: int, p: dict, mode: str, action: str) -> bool:
    pid = str(p.get("post_id") or "")
    if not pid or instagram_yt_dlp is None:
        return False
    url = str(p.get("post_url") or instagram_post_url(str(p.get("shortcode") or "")))
    if not url:
        return False
    try:
        if not instagram_wait_for_request_slot(mode, f"V52 DB-first post {pid} via yt-dlp"):
            return False
        info = instagram_ytdlp_extract(url, mode)
        if not info:
            raise RuntimeError("yt-dlp returned no post payload")
        live = instagram_merge_ytdlp_into_post(dict(p), info)
        raw_id = self.db.insert_raw(run_id, p.get("account_id", ""), pid, "yt-dlp", "post_full_info", info)
        live["raw_latest_id"] = raw_id
        self.db.upsert_post(live)
        self.db.update_post_stage(pid, "instaloader_status", "NO_DATA")
        self.db.update_post_stage(pid, "ytdlp_status", "SUCCESS")
        if instagram_COLLECT_SIDECARS:
            self.db.update_post_stage(pid, "sidecar_status", "NO_DATA")
        formats, captions = instagram_instagram_extract_ytdlp_tracks(info)
        if formats:
            self.db.instagram_db_insert_instagram_formats(run_id, pid, formats)
            self.db.update_post_stage(pid, "formats_status", "SUCCESS")
        else:
            self.db.update_post_stage(pid, "formats_status", "SUCCESS_EMPTY")
        if captions:
            self.db.instagram_db_insert_instagram_captions(run_id, pid, captions)
            self.db.update_post_stage(pid, "captions_status", "SUCCESS")
            if mode == "Maximum":
                instagram_instagram_fetch_caption_content(self.db, run_id, pid)
        else:
            self.db.update_post_stage(pid, "captions_status", "SUCCESS_EMPTY")
        if instagram_COLLECT_COMMENTS:
            _v52_ig_defer_comments(self.db, pid)
        else:
            self.db.update_post_stage(pid, "comments_status", "SKIPPED")
        self.db.upsert_snapshot(run_id, live)
        self.db.mark_enriched(run_id, live, full=True, maximum=(mode == "Maximum"))
        with self.db.lock:
            self.db.conn.execute("UPDATE post_ingestion SET payload_retry_after=NULL WHERE post_id=?", (pid,))
            self.db.conn.commit()
        self.emit(f"      [instagram/v52] DB-FIRST yt-dlp payload committed | post={pid} | action={action}")
        return True
    except Exception as exc:
        retry_at = time.time() + V52_IG_PAYLOAD_RETRY_SECONDS
        with self.db.lock:
            self.db.conn.execute(
                "UPDATE post_ingestion SET payload_retry_after=?,ytdlp_status='ERROR',last_error=? WHERE post_id=?",
                (retry_at, str(exc)[:1000], pid),
            )
            self.db.conn.commit()
        self.emit(
            f"      [instagram/v52] DB-FIRST yt-dlp unavailable | post={pid} | "
            f"retry_in={int(V52_IG_PAYLOAD_RETRY_SECONDS)//60}m | {type(exc).__name__}: {str(exc)[:180]}"
        )
        return True


_v52_ig_enrich_prev = instagram_Collector.enrich_post

def v52_instagram_enrich_post(self: instagram_Collector, run_id: int, p: dict, mode: str, action: str) -> None:
    pid = str(p.get("post_id") or "")
    public_cooling = _v52_public_backoff_until(self.db) > time.time()
    if public_cooling:
        # Payload already proven: do not repeat expensive post extraction just
        # because comments are temporarily inaccessible.
        if action == "COMMENT_REPAIR":
            retry_at = _v52_ig_defer_comments(self.db, pid)
            self.emit(
                f"      [instagram/v52] comments deferred | post={pid} | "
                f"public source cooling | retry_in={max(1,int((retry_at-time.time())//60))}m"
            )
            return
        # Missing payload can still advance independently through the direct
        # post URL.  This is the key DB-first recovery path.
        if action in {"NEW", "RESUME", "FORCE", "HEAVY_REFRESH"}:
            if _v52_ig_ytdlp_payload_only(self, run_id, p, mode, action):
                return
        if action == "PERFORMANCE_REFRESH":
            self.emit(f"      [instagram/v52] performance refresh deferred | post={pid} | public discovery cooling")
            return
    return _v52_ig_enrich_prev(self, run_id, p, mode, action)

