V42_REPAIR_ALL_LIMIT = max(10000, int(os.getenv("SOCIAL_ALL_PLATFORM_REPAIR_LIMIT", "100000")))

# A DB row is the durable obligation.  Do not strand old incomplete history
# behind the V29 50-row backlog cap.
instagram_BACKLOG_ENRICHMENT_BATCH = V42_REPAIR_ALL_LIMIT
tiktok_BACKLOG_ENRICHMENT_BATCH = V42_REPAIR_ALL_LIMIT

_V42_IG_COMMENT_FETCH: Dict[str, dict] = {}
