# ============================================================================
# V52 — INSTAGRAM DB-FIRST RECOVERY + TRUE SOURCE-LOCAL BACKOFF
# ============================================================================
# V51 exposed a remaining Instagram deadlock: when the anonymous mobile-feed
# endpoint returned 401/"Please wait", the public lane entered cooldown.  If
# Graph was also unavailable/cooling, account resolution returned None for every
# input, so the worker never reached the durable post backlog already in SQLite.
# The old shared backoff-event counter could also carry Graph throttle history
# into the public lane, making a fresh public failure jump directly to 120m+.
#
# V52 makes the source isolation complete:
#   * public and Graph backoff escalation histories are independent;
#   * legacy oversized public cooldowns are clamped on migration;
#   * cached account identities may drive an OFFLINE/DB-FIRST pass while public
#     profile discovery is cooling;
#   * existing missing payloads can use direct post-level yt-dlp without needing
#     profile resolution;
#   * comment-only work is deferred durably while the only usable comment source
#     is cooling, instead of being retried thousands of times per rotation;
#   * the scheduler keeps Instagram runnable when durable DB work exists even if
#     both network discovery lanes are temporarily cooling.

V52_BUILD = "SOCIAL_COLLECTOR_PRODUCTION_2026_09_INSTAGRAM_DB_FIRST_RECOVERY"
PRODUCTION_BUILD = V52_BUILD
SOCIAL_COLLECTOR_BUILD = V52_BUILD
youtube_COLLECTOR_BUILD = V52_BUILD
INSTAGRAM_COLLECTOR_BUILD = V52_BUILD
tiktok_COLLECTOR_BUILD = V52_BUILD

V52_IG_PUBLIC_BACKOFF_SCHEDULE = (600.0, 1200.0, 2400.0, 3600.0)
V52_IG_COMMENT_DEFER_FLOOR = max(300.0, float(os.getenv("SOCIAL_COLLECTOR_IG_COMMENT_DEFER_SECONDS", "900")))
V52_IG_PAYLOAD_RETRY_SECONDS = max(300.0, float(os.getenv("SOCIAL_COLLECTOR_IG_PAYLOAD_RETRY_SECONDS", "1800")))
V52_IG_OFFLINE_BACKLOG_BATCH = max(50, int(os.getenv("SOCIAL_COLLECTOR_IG_OFFLINE_BACKLOG_BATCH", "250")))


