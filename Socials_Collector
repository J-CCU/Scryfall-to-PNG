def tiktok_export_query(db: tiktok_Database, query: str, path: Path) -> None:
    with db.lock:
        cur = db.conn.execute(query)
        cols = [d[0] for d in cur.description]
        rows = cur.fetchall()
    with path.open("w", newline="", encoding="utf-8-sig") as f:
        writer = csv.writer(f)
        writer.writerow(cols)
        for row in rows:
            writer.writerow([row[c] for c in cols])


def tiktok_export_run_csvs(db: tiktok_Database, run_id: int, folder: Path) -> Dict[str, Path]:
    folder.mkdir(parents=True, exist_ok=True)
    outputs: Dict[str, Path] = {}
    queries = {
        "accounts": f"SELECT * FROM accounts WHERE account_id IN (SELECT DISTINCT account_id FROM account_inputs WHERE scrape_run_id={int(run_id)})",
        "videos": f"SELECT * FROM videos WHERE video_id IN (SELECT DISTINCT video_id FROM video_snapshots WHERE scrape_run_id={int(run_id)}) OR account_id IN (SELECT DISTINCT account_id FROM account_inputs WHERE scrape_run_id={int(run_id)})",
        "video_snapshots": f"SELECT * FROM video_snapshots WHERE scrape_run_id={int(run_id)}",
        "video_ingestion": "SELECT * FROM video_ingestion",
        "comments": f"SELECT * FROM comments WHERE scrape_run_id={int(run_id)}",
        "formats": f"SELECT * FROM formats WHERE scrape_run_id={int(run_id)}",
        "captions": f"SELECT * FROM captions WHERE scrape_run_id={int(run_id)}",
        "account_inputs": f"SELECT * FROM account_inputs WHERE scrape_run_id={int(run_id)}",
        "errors": f"SELECT * FROM errors WHERE scrape_run_id={int(run_id)}",
        "raw_data_index": f"SELECT id,scrape_run_id,account_id,video_id,source,data_type,sha256,captured_at FROM raw_data WHERE scrape_run_id={int(run_id)}",
        "surface_items": "SELECT * FROM surface_items ORDER BY last_seen_at DESC",
        "surface_snapshots": f"SELECT * FROM surface_snapshots WHERE scrape_run_id={int(run_id)} ORDER BY id",
    }
    for name, query in queries.items():
        path = folder / f"tiktok_{name}_run_{run_id}.csv"
        tiktok_export_query(db, query, path)
        outputs[name] = path
    return outputs


