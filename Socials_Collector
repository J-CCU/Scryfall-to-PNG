def _v24_media_rows_from_items(account: dict, items: list) -> list[dict]:
    shadow = dict(account)
    shadow["_business_discovery_raw"] = {"media": {"data": items or []}}
    return _v23_business_media_rows(shadow)


def _v24_persist_business_rows(self: instagram_Collector, run_id: int, account: dict, rows: list[dict]) -> None:
    for row in rows:
        try:
            raw_id = self.db.insert_raw(
                run_id, row.get("account_id", ""), row.get("post_id", ""),
                "Meta Business Discovery", "media", row.get("graph_raw") or {},
            )
            row["raw_latest_id"] = raw_id
            self.db.upsert_post(row)
            self.db.register_discovery(run_id, row)
            self.db.upsert_snapshot(run_id, row)
            self.db.update_post_stage(row.get("post_id", ""), "instaloader_status", "NOT_NEEDED_OFFICIAL_GRAPH")
        except Exception as exc:
            self.emit(
                f"  [business-discovery] persist error | post={row.get('post_id','')} | "
                f"{type(exc).__name__}: {exc}"
            )


def v24_instagram_discover_profile_posts(self: instagram_Collector, run_id: int, account: dict, limit: int, mode: str, force_refresh: bool) -> Tuple[List[dict], bool]:
    if not account.get("_business_discovery"):
        return _v23_discover_posts_prev(self, run_id, account, limit, mode, force_refresh)

    username = str(account.get("username") or "")
    raw = account.get("_business_discovery_raw") or {}
    media = raw.get("media") if isinstance(raw, dict) else {}
    items = list(media.get("data") or []) if isinstance(media, dict) else []
    paging = media.get("paging") if isinstance(media, dict) else {}
    after = ((paging or {}).get("cursors") or {}).get("after") if isinstance(paging, dict) else None

    wanted = int(limit or 0)
    rows: list[dict] = []
    page_no = 1
    started = time.monotonic()

    while True:
        page_rows = _v24_media_rows_from_items(account, items)
        if wanted > 0:
            page_rows = page_rows[:max(0, wanted - len(rows))]
        _v24_persist_business_rows(self, run_id, account, page_rows)
        rows.extend(page_rows)
        self.emit(
            f"  [business-discovery] @{username} | page={page_no} | "
            f"saved={len(page_rows)} | total={len(rows)}"
        )

        if wanted > 0 and len(rows) >= wanted:
            return rows, False
        if not after:
            self.emit(
                f"  [business-discovery] @{username} COMPLETE | media={len(rows)} | "
                f"pages={page_no} | elapsed={time.monotonic()-started:.1f}s"
            )
            return rows, True
        if instagram_stop_requested():
            self.emit(f"  [business-discovery] @{username} STOP requested after {len(rows)} media")
            return rows, False

        next_media = _v24_business_media_page(username, str(after), self.db)
        if not next_media:
            self.emit(
                f"  [business-discovery] @{username} pagination stopped after page={page_no}; "
                "the official API returned no next page"
            )
            return rows, False
        items = list(next_media.get("data") or [])
        next_paging = next_media.get("paging") or {}
        next_after = ((next_paging.get("cursors") or {}).get("after") if isinstance(next_paging, dict) else None)
        # Defensive loop guard for a repeated cursor.
        if next_after == after and not items:
            return rows, False
        after = next_after
        page_no += 1


instagram_Collector.discover_profile_posts = v24_instagram_discover_profile_posts

# Direct local storage scheduler. This deliberately derives from V20 rather than
