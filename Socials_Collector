def _v49_runtime_age_seconds(db: youtube_Database, key: str) -> Optional[float]:
    raw = db.get_runtime_state(key)
    if not raw:
        return None
    try:
        return max(0.0, time.time() - float(raw))
    except Exception:
        return None


def youtube_collect_community_posts(run_id: int, db: youtube_Database, channel: dict, limit: int, mode: str) -> int:
    cid = str((channel or {}).get("channel_id") or "")
    if not cid:
        return _v49_collect_community_prev(run_id, db, channel, limit, mode)
    last_key = f"v49_youtube_community_last:{cid}"
    full_key = f"v49_youtube_community_full:{cid}"
    age = _v49_runtime_age_seconds(db, last_key)
    if age is not None and age < V49_YOUTUBE_COMMUNITY_TTL_SECONDS:
        youtube_log(
            f"  [surface:community/v49] CACHE SKIP | channel={cid} | "
            f"next refresh in {int(V49_YOUTUBE_COMMUNITY_TTL_SECONDS - age)}s"
        )
        return 0

    full_done = str(db.get_runtime_state(full_key) or "") == "1"
    effective_limit = int(limit or 0)
    if full_done and effective_limit <= 0:
        effective_limit = V49_YOUTUBE_COMMUNITY_RECENT_LIMIT

    with db.lock:
        before = int(db.conn.execute(
            "SELECT COUNT(*) FROM raw_data WHERE channel_id=? AND note='community/posts surface'",
            (cid,),
        ).fetchone()[0] or 0)
    count = _v49_collect_community_prev(run_id, db, channel, effective_limit, mode)
    with db.lock:
        after = int(db.conn.execute(
            "SELECT COUNT(*) FROM raw_data WHERE channel_id=? AND note='community/posts surface'",
            (cid,),
        ).fetchone()[0] or 0)
    db.set_runtime_state(last_key, f"{time.time():.3f}")
    if not full_done and int(limit or 0) <= 0 and after > before:
        db.set_runtime_state(full_key, "1")
        youtube_log(f"  [surface:community/v49] full historical proof stored | channel={cid}")
    return count


