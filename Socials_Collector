                db.conn.execute("INSERT INTO videos(video_id,channel_id,title,comment_count,timestamp,updated_at) VALUES('payload_only','c','p',5,100,?)", (now,))
                db.conn.execute("""INSERT INTO video_ingestion(video_id,channel_id,last_enriched_at,yt_dlp_status,player_status,comments_status,captions_status,formats_status,enrichment_state,last_error)
                                  VALUES('payload_only','c',?,'QUEUED_V38','QUEUED_V38','PENDING','SUCCESS_EMPTY','QUEUED_V38','IN_PROGRESS','old comment failure')""", (now,))
                db.conn.execute("INSERT INTO video_snapshots(scrape_run_id,channel_id,video_id,captured_at) VALUES(1,'c','payload_only',?)", (now,))
                db.conn.execute("INSERT INTO raw_data(scrape_run_id,captured_at,channel_id,video_id,source,endpoint,http_status,content_type,note) VALUES(1,?,'c','payload_only','yt-dlp','x',200,'application/json','video_full_info')", (now,))
                db.conn.execute("INSERT INTO formats(scrape_run_id,video_id,source,format_id,captured_at) VALUES(1,'payload_only','yt-dlp','f1',?)", (now,))

                # comments_only can finish as soon as heavy succeeds and should
                # therefore receive finish-first heavy priority.
                db.conn.execute("INSERT INTO videos(video_id,channel_id,title,comment_count,timestamp,updated_at) VALUES('comments_only','c','c',1,50,?)", (now,))
                db.conn.execute("""INSERT INTO video_ingestion(video_id,channel_id,comments_status,enrichment_state,comments_evidence)
                                  VALUES('comments_only','c','SUCCESS','IN_PROGRESS','PERSISTED_ROWS')""")
                db.conn.execute("INSERT INTO comments(scrape_run_id,video_id,comment_id,text,captured_at) VALUES(1,'comments_only','cm','x',?)", (now,))
                db.conn.commit()

            _v44_fast_audit_youtube(db)
            pstate = db.get_video_sync('payload_only') or {}
            assert _v45_youtube_payload_complete(db, pstate, 'Maximum')
            assert pstate.get('completeness_audit_status') == 'MISSING_COMMENTS'
            q = _v44_bootstrap_youtube_work(db, 1)
            with db.lock:
                h = db.conn.execute("SELECT state FROM youtube_work_queue WHERE video_id='payload_only' AND stage='heavy'").fetchone()
                cp = db.conn.execute("SELECT state,priority FROM youtube_work_queue WHERE video_id='comments_only' AND stage='heavy'").fetchone()
            # payload-only work must not exist as unfinished heavy work.
            assert h is None or h[0] == 'DONE'
            assert cp and cp[0] in ('PENDING','RETRY') and int(cp[1]) >= V45_FINISH_PRIORITY_BOOST
            # Re-submitting payload_only heavy cannot reopen it.
            added = _v44_youtube_enqueue(db, 'payload_only', 'heavy', 'RESUME', 1, 100)
            assert added is False
            with db.lock:
                h2 = db.conn.execute("SELECT state FROM youtube_work_queue WHERE video_id='payload_only' AND stage='heavy'").fetchone()
            assert h2 is None or h2[0] == 'DONE'
        finally:
            db.close()


