class instagram_Collector:
    def __init__(self, db: instagram_Database, log_callback: Optional[Callable[[str], None]] = None, progress_callback: Optional[Callable[[int,int,str],None]] = None):
        self.db = db
        self.log_callback = log_callback
        self.progress_callback = progress_callback
        self.last_run_id: Optional[int] = None
        self.loader = None
        self.live_posts: Dict[str, Any] = {}

    def emit(self, message: str) -> None:
        instagram_log(message)
        if self.log_callback:
            self.log_callback(message + "\n")

    def progress(self, current: int, total: int, phase: str) -> None:
        if self.progress_callback:
            self.progress_callback(current, total, phase)

    def save_account_snapshot(self, run_id: int, account: dict) -> dict:
        raw_id = self.db.insert_raw(run_id, account["account_id"], "", "Instaloader", "account_profile_node", account.get("_raw_node") or {})
        self.db.upsert_account(account)
        self.db.account_snapshot(run_id, account, raw_id)
        self.emit(f"  [db] account snapshot committed | @{account['username']} | raw_json={raw_id}")
        self.db.log_counts(run_id, "  [db] after account commit")
        return account

    def discover_profile_posts(self, run_id: int, account: dict, limit: int, mode: str, force_refresh: bool) -> Tuple[List[dict], bool]:
        profile = account.get("_profile")
        username = account["username"]
        account_id = account["account_id"]
        indexed = self.db.account_is_indexed(account_id)
        full_catalog = bool(limit <= 0 and ((force_refresh and instagram_FORCE_FULL_DISCOVERY_WITH_ALL) or not indexed))
        discovery_limit = 0 if full_catalog else (limit if limit > 0 else instagram_INCREMENTAL_DISCOVERY_WINDOW)
        self.emit(f"  [discovery] Instaloader profile START | @{username} | window={'ALL' if discovery_limit<=0 else discovery_limit} | full_catalog={'yes' if full_catalog else 'no'}")
        if instagram_rate_limited() and not instagram_wait_for_rate_limit_clear(self.db):
            return [], False
        posts: List[dict] = []
        complete = False
        consecutive_known = 0
        try:
            for n, post in enumerate(profile.get_posts(), 1):
                if instagram_stop_requested():
                    break
                p = instagram_post_to_dict(post, account_id, username)
                if not p.get("post_id"):
                    continue
                self.live_posts[p["post_id"]] = post
                posts.append(p)
                # Persist discovery immediately; this is the no-data-loss checkpoint.
                self.db.upsert_post(p)
                raw_id = self.db.insert_raw(run_id, account_id, p["post_id"], "Instaloader", "post_discovery_node", p.get("_raw_node") or {})
                p["raw_latest_id"] = raw_id
                self.db.upsert_post(p)
                self.db.register_discovery(run_id, p)
                self.emit(f"    [discover {len(posts)}] {p['post_id']} | {p['taken_at'] or '?'} | {p.get('typename','')} | {p.get('caption','')[:100]}")
                self.progress(len(posts), max(discovery_limit or len(posts), 1), f"@{username} discovery")
                state = self.db.get_post_state(p["post_id"])
                if state and state["last_enriched_at"]:
                    consecutive_known += 1
                else:
                    consecutive_known = 0
                if discovery_limit > 0 and len(posts) >= discovery_limit:
                    break
            complete = bool(full_catalog and not instagram_stop_requested() and discovery_limit <= 0)
        except Exception as exc:
            if instagram_is_rate_limit_exception(exc):
                instagram_set_rate_limit(self.db, str(exc), pending_account_id=account_id)
            else:
                self.db.record_error(run_id, account_id=account_id, stage="post_discovery", exc=exc)
                self.emit(f"  [discovery] ERROR | {type(exc).__name__}: {exc}")
        self.emit(f"  [discovery] Instaloader profile COMPLETE | posts={len(posts)} | complete={'yes' if complete else 'no'}")
        return instagram_unique_by_id(posts, "post_id"), complete

    def collect_comments(self, run_id: int, p_obj: Any, post_id: str) -> int:
        count = 0
        if not instagram_COLLECT_COMMENTS:
            return count
        try:
            for comment in p_obj.get_comments():
                if instagram_stop_requested():
                    break
                c = instagram_comment_to_dict(comment)
                if c.get("comment_id"):
                    raw_id = self.db.insert_raw(run_id, "", post_id, "Instaloader", "comment_node", c.get("_raw_node") or {})
                    if self.db.insert_comment(run_id, post_id, c, raw_id):
                        count += 1
                answers = getattr(comment, "answers", None)
                if answers is not None:
                    try:
                        for answer in answers:
                            if instagram_stop_requested():
                                break
                            rc = instagram_comment_to_dict(answer, c.get("comment_id") or "")
                            if rc.get("comment_id"):
                                raw_id = self.db.insert_raw(run_id, "", post_id, "Instaloader", "comment_reply_node", rc.get("_raw_node") or {})
                                if self.db.insert_comment(run_id, post_id, rc, raw_id):
                                    count += 1
                            if instagram_MAX_COMMENTS_PER_POST is not None and count >= instagram_MAX_COMMENTS_PER_POST:
                                return count
                    except Exception as exc:
                        if instagram_is_rate_limit_exception(exc):
                            raise
                if instagram_MAX_COMMENTS_PER_POST is not None and count >= instagram_MAX_COMMENTS_PER_POST:
                    break
        except Exception as exc:
            if instagram_is_rate_limit_exception(exc):
                raise
            raise
        return count

    def enrich_post(self, run_id: int, p: dict, mode: str, action: str) -> None:
        pid = p["post_id"]
        username = p.get("username", "")
        url = p.get("post_url") or instagram_post_url(p.get("shortcode", ""))
        self.emit(f"    [stage] {action} | {pid} | {p.get('caption','')[:110]}")
        if instagram_rate_limited() and not instagram_wait_for_rate_limit_clear(self.db, pending_post_id=pid):
            return
        profile = None
        try:
            # Reuse a live object from discovery when available; otherwise resolve by shortcode.
            profile = self.live_posts.get(pid)
            if profile is None and p.get("shortcode"):
                profile = instagram_instaloader.Post.from_shortcode(self.loader.context, p["shortcode"])
            if profile is None:
                self.db.update_post_stage(pid, "instaloader_status", "NO_POST_OBJECT")
                self.db.mark_enriched(run_id, p, False, False, "No Post object")
                return

            live = instagram_post_to_dict(profile, p.get("account_id", ""), username)
            for k, v in p.items():
                if live.get(k) in (None, "", 0) and v not in (None, "", 0):
                    live[k] = v
            raw_id = self.db.insert_raw(run_id, p.get("account_id", ""), pid, "Instaloader", "post_full_node", live.get("_raw_node") or {})
            live["raw_latest_id"] = raw_id
            self.db.upsert_post(live)
            self.db.update_post_stage(pid, "instaloader_status", "SUCCESS")

            sidecars = []
            if instagram_COLLECT_SIDECARS and "Sidecar" in str(live.get("typename", "")):
                try:
                    nodes = getattr(profile, "get_sidecar_nodes", None)
                    if callable(nodes):
                        for node in nodes():
                            sidecars.append(instagram_sidecar_to_dict(node))
                    inserted = self.db.upsert_sidecar_items(pid, sidecars)
                    self.db.update_post_stage(pid, "sidecar_status", "SUCCESS")
                    self.emit(f"      [maximum] sidecar_items={len(sidecars)} | inserted_new={inserted}")
                except Exception as exc:
                    self.db.update_post_stage(pid, "sidecar_status", "ERROR", str(exc))
                    self.emit(f"      [sidecar] ERROR | {type(exc).__name__}: {exc}")

            if instagram_COLLECT_COMMENTS:
                self.emit(f"      [maximum/Instaloader] comments START | post={pid} | limit={'ALL' if instagram_MAX_COMMENTS_PER_POST is None else instagram_MAX_COMMENTS_PER_POST}")
                count = self.collect_comments(run_id, profile, pid)
                self.db.update_post_stage(pid, "comments_status", "SUCCESS")
                self.emit(f"      [db] comments committed | rows_new={count} | post={pid}")
            else:
                self.db.update_post_stage(pid, "comments_status", "SKIPPED")

            if instagram_COLLECT_YTDLP_ENRICHMENT and instagram_yt_dlp is not None and (not instagram_YTDLP_VIDEO_ONLY or live.get("is_video") == "YES"):
                try:
                    if instagram_wait_for_request_slot(mode, f"post {pid} via yt-dlp"):
                        info = instagram_ytdlp_extract(url, mode)
                        if info:
                            live = instagram_merge_ytdlp_into_post(live, info)
                            raw_ytdlp = self.db.insert_raw(run_id, p.get("account_id", ""), pid, "yt-dlp", "post_full_info", info)
                            live["raw_latest_id"] = raw_ytdlp
                            self.db.upsert_post(live)
                            self.db.update_post_stage(pid, "ytdlp_status", "SUCCESS")
                            self.emit(f"      [yt-dlp] enrichment committed | post={pid}")
                        else:
                            self.db.update_post_stage(pid, "ytdlp_status", "NO_DATA")
                except Exception as exc:
                    if instagram_is_rate_limit_exception(exc):
                        instagram_set_rate_limit(self.db, str(exc), pending_post_id=pid, pending_account_id=p.get("account_id", ""))
                        self.db.update_post_stage(pid, "ytdlp_status", "RATE_LIMITED", str(exc))
                        self.emit(f"      [yt-dlp] RATE LIMITED | post={pid}")
                    else:
                        self.db.update_post_stage(pid, "ytdlp_status", "ERROR", str(exc))
                        self.emit(f"      [yt-dlp] ERROR | {type(exc).__name__}: {exc}")

            self.db.upsert_snapshot(run_id, live)
            self.db.mark_enriched(run_id, live, full=True, maximum=(mode == "Maximum"))
            self.emit(f"      [db] post snapshot + ingestion committed | post={pid}")
        except Exception as exc:
            if instagram_is_rate_limit_exception(exc):
                instagram_set_rate_limit(self.db, str(exc), pending_post_id=pid, pending_account_id=p.get("account_id", ""))
                self.db.update_post_stage(pid, "instaloader_status", "RATE_LIMITED", str(exc))
                self.db.mark_enriched(run_id, p, False, False, "RATE_LIMITED")
                self.emit(f"      [Instaloader] RATE LIMITED | post={pid} | saved as pending retry")
                return
            if instagram_is_login_or_challenge(exc):
                self.db.update_post_stage(pid, "instaloader_status", "CHALLENGE", str(exc))
                self.db.mark_enriched(run_id, p, False, False, str(exc)[:1000])
                self.db.record_error(run_id, account_id=p.get("account_id", ""), post_id=pid, stage="instaloader", exc=exc)
                self.emit(f"      [Instaloader] LOGIN/CHALLENGE | post={pid} | saved as incomplete")
                return
            self.db.update_post_stage(pid, "instaloader_status", "ERROR", str(exc))
            self.db.mark_enriched(run_id, p, False, False, str(exc)[:1000])
            self.db.record_error(run_id, account_id=p.get("account_id", ""), post_id=pid, stage="instaloader", exc=exc)
            self.emit(f"      [Instaloader] ERROR | post={pid} | {type(exc).__name__}: {exc}")

    def process_post_url(self, run_id: int, url: str, mode: str) -> Optional[dict]:
        code = instagram_shortcode_from_url(url)
        if not code:
            return None
        if instagram_rate_limited() and not instagram_wait_for_rate_limit_clear(self.db, pending_post_id=code):
            return None
        try:
            post = instagram_instaloader.Post.from_shortcode(self.loader.context, code)
            owner = getattr(post, "owner_profile", None)
            if owner:
                account = instagram_profile_to_dict(owner, str(getattr(owner, "username", "") or ""), "post owner profile", True)
                p = instagram_post_to_dict(post, account["account_id"], account["username"])
                self.live_posts[p.get("post_id", code)] = post
                self.db.upsert_account(account)
                self.db.upsert_post(p)
                self.db.register_discovery(run_id, p)
                return {"account": account, "post": p, "post_obj": post}
        except Exception as exc:
            if instagram_is_rate_limit_exception(exc):
                instagram_set_rate_limit(self.db, str(exc), pending_post_id=code)
            else:
                self.db.record_error(run_id, post_id=code, stage="resolve_post_url", exc=exc)
                self.emit(f"[resolve/post] ERROR | {type(exc).__name__}: {exc}")
        return None

    def run(self, inputs: list, limit: int, mode: str, force_refresh: bool = False) -> int:
        _surface_ensure_schema(self.db)
        run_id = self.db.begin_run(mode, limit, inputs)
        self.last_run_id = run_id
        self.emit(f"[run] {run_id} | platform=Instagram | mode={mode} | limit={'ALL' if limit<=0 else limit} | incremental=yes | force_refresh={'yes' if force_refresh else 'no'} | Instaloader={'available' if instagram_instaloader else 'MISSING'} | yt-dlp={'available' if instagram_yt_dlp else 'MISSING'}")
        self.emit(f"[config] database={instagram_DB_PATH}")
        self.emit(f"[config] rate policy: {instagram_policy_text(mode)} (collector policy; not an official Instagram limit)")
        self.emit(f"[config] comments={'ON' if instagram_COLLECT_COMMENTS and mode=='Maximum' else 'OFF'} | sidecars={'ON' if instagram_COLLECT_SIDECARS else 'OFF'} | yt-dlp post enrichment={'ON' if instagram_COLLECT_YTDLP_ENRICHMENT and instagram_yt_dlp else 'OFF'}")
        self.emit(f"[config] session={'configured' if instagram_INSTAGRAM_LOGIN_USERNAME else 'anonymous/public'}")
        self.emit("[config] Instagram resolver=mobile-feed-first for anonymous collection | avoids web_profile_info 401/429 trap")
        self.emit(f"[config] extended surfaces: {'ON' if instagram_COLLECT_EXTENDED_SURFACES and mode == 'Maximum' else 'OFF'} | reels=ON | igtv=ON | tagged=ON | stories=ON | highlights=ON")
        if instagram_instaloader is None:
            self.db.finish_run(run_id, "FAILED", "Instaloader is not installed")
            self.emit("[run] FATAL: Instaloader is not installed")
            return run_id
        self.loader = instagram_build_instaloader()
        instagram_load_rate_limit_state(self.db)
        if instagram_rate_limited() and not instagram_wait_for_rate_limit_clear(self.db):
            self.db.finish_run(run_id, "STOPPED", "Stopped during Instagram cooldown")
            return run_id

        processed_accounts = set()
        try:
            unique_inputs = list(dict.fromkeys(str(x).strip() for x in inputs if str(x).strip()))
            total_inputs = len(unique_inputs)
            for input_idx, original in enumerate(unique_inputs, 1):
                if instagram_stop_requested():
                    self.db.finish_run(run_id, "STOPPED", "Stop requested")
                    return run_id
                kind, normalized = instagram_normalize_input(original)
                self.emit(f"\n[resolve {input_idx}/{total_inputs}] Checking: {original}")
                if kind == "post_url":
                    result = self.process_post_url(run_id, normalized, mode)
                    if not result:
                        self.db.record_account_input(run_id, original, normalized, kind, "", "", "unresolved_post", False, False)
                        continue
                    account = result["account"]
                    post = result["post"]
                    self.db.record_account_input(run_id, original, normalized, kind, account["account_id"], account["username"], "post owner profile", True, account["account_id"] in processed_accounts)
                    if account["account_id"] in processed_accounts:
                        continue
                    processed_accounts.add(account["account_id"])
                    account["_profile"] = getattr(result["post"], "owner_profile", None)
                    account = self.save_account_snapshot(run_id, account)
                    queue_rows = [post]
                    self.db.update_account_index(account["account_id"], False, 0, 1)
                else:
                    username = instagram_normalized_username(normalized)
                    try:
                        account = instagram_resolve_profile(self.loader, username)
                    except Exception as exc:
                        if instagram_is_rate_limit_exception(exc):
                            instagram_set_rate_limit(self.db, str(exc), pending_account_id=username)
                            if not instagram_wait_for_rate_limit_clear(self.db, pending_post_id=""):
                                self.db.finish_run(run_id, "STOPPED", "Stopped during cooldown")
                                return run_id
                            account = instagram_resolve_profile(self.loader, username)
                        else:
                            account = None
                    if not account:
                        self.db.record_account_input(run_id, original, normalized, kind, "", username, "unresolved", False, False)
                        self.emit(f"  Resolution FAILED | {original}")
                        continue
                    duplicate = account["account_id"] in processed_accounts
                    self.db.record_account_input(run_id, original, normalized, kind, account["account_id"], account["username"], account["resolution_method"], True, duplicate)
                    if duplicate:
                        self.emit(f"  [dedupe] account already processed this run | {account['account_id']}")
                        continue
                    processed_accounts.add(account["account_id"])
                    account = self.save_account_snapshot(run_id, account)
                    self.emit(f"\n[account {input_idx}] Processing: @{account['username']} | id={account['account_id']}")
                    self.emit(
                        f"  [ACTIVE/INSTAGRAM] {account.get('full_name') or account.get('username') or '(unknown)'}"
                        f" | @{account.get('username') or '(unknown)'}"
                        f" | {account.get('account_id') or '(unknown)'}"
                    )
                    discovered, complete = self.discover_profile_posts(run_id, account, limit, mode, force_refresh)
                    queue_rows = list(discovered)
                    if limit <= 0 and not force_refresh:
                        backlog = self.db.get_backlog(account["account_id"], instagram_BACKLOG_ENRICHMENT_BATCH)
                        known = {p.get("post_id") for p in queue_rows}
                        queue_rows.extend(p for p in backlog if p.get("post_id") not in known)
                    self.db.update_account_index(account["account_id"], complete, self._account_indexed_count(account["account_id"]), len(discovered))
                    queue_rows = v16__sort_instagram_queue(queue_rows)
                self.emit(f"  [posts] {len(queue_rows)} posts queued for enrichment on this account")
                total_queue = len(queue_rows)
                for n, p in enumerate(queue_rows, 1):
                    if instagram_stop_requested():
                        break
                    action = instagram_choose_post_action(self.db, p, mode, force_refresh)
                    if action == "SKIP":
                        self.emit(f"    [{n}/{total_queue}] {p.get('post_id')} | SKIP | already complete/not due")
                        continue
                    self.progress(n, max(total_queue,1), f"@{account['username'] if 'account' in locals() else p.get('username','')} posts")
                    self.emit(f"    [{n}/{total_queue}] {p.get('post_id')} | {action}")
                    self.enrich_post(run_id, p, mode, action)
                    if instagram_rate_limited():
                        if not instagram_wait_for_rate_limit_clear(self.db, pending_post_id=p.get("post_id", "")):
                            self.db.finish_run(run_id, "STOPPED", "Stopped during Instagram rate-limit cooldown")
                            return run_id
                        self.emit(f"[throttle] RETRYING PRIORITY POST FIRST | {p.get('post_id')}")
                        self.enrich_post(run_id, p, mode, "PRIORITY_RETRY")
                if instagram_COLLECT_EXTENDED_SURFACES and mode == "Maximum" and not instagram_stop_requested():
                    instagram_collect_extended_surfaces(self, run_id, account, limit, mode)

                if instagram_stop_requested():
                    self.db.finish_run(run_id, "STOPPED", "Stop requested")
                    return run_id

            self.db.finish_run(run_id, "COMPLETE", f"Processed {len(processed_accounts)} unique accounts")
            self.emit(f"\n[run] COMPLETE | run_id={run_id} | unique_accounts={len(processed_accounts)}")
            self.db.log_counts(run_id, "[db] final")
            return run_id
        except Exception as exc:
            self.db.record_error(run_id, stage="run", exc=exc)
            self.db.finish_run(run_id, "FAILED", str(exc)[:1000])
            self.emit(f"[run] FATAL: {type(exc).__name__}: {exc}")
            self.emit(traceback.format_exc())
            return run_id

    def _account_indexed_count(self, account_id: str) -> int:
        with self.db.lock:
            return int(self.db.conn.execute("SELECT COUNT(*) FROM posts WHERE account_id=?", (account_id,)).fetchone()[0])


