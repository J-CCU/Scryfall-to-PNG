# ---------------------------------------------------------------------------
# Instagram batch persistence for comments/raw nodes. One transaction per
# batch rather than one commit per comment. Stop still flushes the current
# batch before returning.
# ---------------------------------------------------------------------------
def v14__ig_insert_raw_batch(self, run_id: int, account_id: str, post_id: str, rows: list) -> list[int]:
    out = []
    if not rows:
        return out
    captured = instagram_now_utc()
    with self.lock:
        for source, data_type, content in rows:
            blob = instagram_gzip_text(content)
            digest = instagram_sha256_blob(blob)
            cur = self.conn.execute(
                "INSERT INTO raw_data(scrape_run_id,account_id,post_id,source,data_type,content_gzip,sha256,captured_at) VALUES(?,?,?,?,?,?,?,?)",
                (run_id, account_id, post_id, source, data_type, blob, digest, captured),
            )
            out.append(int(cur.lastrowid))
        self.conn.commit()
    return out

def v14__ig_insert_comments_batch(self, run_id: int, post_id: str, comments: list) -> int:
    if not comments:
        return 0
    inserted = 0
    captured = instagram_now_utc()
    with self.lock:
        for c, raw_id in comments:
            cur = self.conn.execute(
                "INSERT OR IGNORE INTO comments(comment_id,scrape_run_id,post_id,parent_comment_id,owner_user_id,owner_username,text,like_count,created_at,created_epoch,is_reply,raw_node_id,captured_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (str(c.get("comment_id") or ""), run_id, post_id, c.get("parent_comment_id"), c.get("owner_user_id"), c.get("owner_username"), c.get("text"), instagram_safe_int(c.get("like_count")), c.get("created_at"), instagram_safe_int(c.get("created_epoch")), c.get("is_reply"), raw_id, captured),
            )
            if cur.rowcount > 0:
                inserted += 1
        self.conn.commit()
    return inserted

instagram_Database.insert_raw_batch_v14 = v14__ig_insert_raw_batch
instagram_Database.insert_comments_batch_v14 = v14__ig_insert_comments_batch

def v14__ig_collect_comments(self, run_id: int, p_obj: Any, post_id: str) -> int:
    if not instagram_COLLECT_COMMENTS:
        return 0
    pending = []
    raw_pending = []
    total = 0
    def flush() -> None:
        nonlocal pending, raw_pending, total
        if not pending:
            raw_pending = []
            return
        raw_ids = self.db.insert_raw_batch_v14(run_id, "", post_id, raw_pending)
        # raw_pending and pending are kept in the same order.
        pairs = [(c, raw_id) for (c, _), raw_id in zip(pending, raw_ids)]
        total += self.db.insert_comments_batch_v14(run_id, post_id, pairs)
        pending = []
        raw_pending = []
    try:
        for comment in p_obj.get_comments():
            if instagram_stop_requested():
                break
            c = instagram_comment_to_dict(comment)
            if c.get("comment_id"):
                pending.append((c, None))
                raw_pending.append(("Instaloader", "comment_node", c.get("_raw_node") or {}))
            answers = getattr(comment, "answers", None)
            if answers is not None:
                try:
                    for answer in answers:
                        if instagram_stop_requested():
                            break
                        rc = instagram_comment_to_dict(answer, c.get("comment_id") or "")
                        if rc.get("comment_id"):
                            pending.append((rc, None))
                            raw_pending.append(("Instaloader", "comment_reply_node", rc.get("_raw_node") or {}))
                        if len(pending) >= 100:
                            flush()
                        if instagram_MAX_COMMENTS_PER_POST is not None and total >= instagram_MAX_COMMENTS_PER_POST:
                            flush()
                            return total
                except Exception as exc:
                    if instagram_is_rate_limit_exception(exc):
                        raise
            if len(pending) >= 100:
                flush()
            if instagram_MAX_COMMENTS_PER_POST is not None and total + len(pending) >= instagram_MAX_COMMENTS_PER_POST:
                flush()
                break
        flush()
        return total
    except Exception:
        flush()
        raise

