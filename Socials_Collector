def _v49_channel_row(db: youtube_Database, channel_id: str) -> Optional[dict]:
    _v39_migrate_youtube_schema(db)
    with db.lock:
        cur = db.conn.execute("SELECT * FROM channels WHERE channel_id=?", (str(channel_id),))
        row = cur.fetchone()
        if not row:
            return None
        if isinstance(row, sqlite3.Row):
            return dict(row)
        return dict(zip([d[0] for d in cur.description], row))


