def _v53_completion_text(platform: str, c: dict, comments_required: bool) -> str:
    key = str(platform or "").strip().lower()
    if key != "tiktok":
        return _v55_completion_prev(platform, c, comments_required)
    unresolved = int(c.get("universe_unresolved", 0) or 0)
    if unresolved:
        names = list(c.get("unresolved_locators") or [])
        suffix = f" ({', '.join(names[:2])}{'…' if len(names) > 2 else ''})" if names else ""
        return f"NOT FINISHED — {unresolved:,} account{'s' if unresolved != 1 else ''} unresolved{suffix}"
    total = int(c.get("items", 0) or 0)
    complete = int(c.get("complete", 0) or 0)
    if total <= 0:
        return "NO DATA"
    item_pending = max(0, total - complete)
    catalogs_total = int(c.get("catalogs_total", 0) or 0)
    catalogs_verified = int(c.get("catalogs_verified", 0) or 0)
    catalogs_limited = int(c.get("catalogs_limited", 0) or 0)
    catalog_pending = max(0, catalogs_total - catalogs_verified - catalogs_limited)
    required_comment_pending = int(c.get("owned_pending", 0) or 0) if comments_required else 0
    profile_limited = int(c.get("universe_limited", 0) or 0)
    if item_pending == 0 and catalog_pending == 0 and required_comment_pending == 0:
        limited = int(c.get("limited", 0) or 0)
        if limited or catalogs_limited or profile_limited:
            if profile_limited:
                return f"FINISHED — LIMITED ({limited:,} videos, {catalogs_limited:,} catalogs, {profile_limited:,} account{'s' if profile_limited != 1 else ''})"
            return f"FINISHED — LIMITED ({limited:,} videos, {catalogs_limited:,} catalogs)"
        return "FINISHED — FULL"
    blockers = []
    if item_pending:
        blockers.append(f"{item_pending:,} videos")
    if catalog_pending:
        blockers.append(f"{catalog_pending:,} catalogs")
    if required_comment_pending:
        blockers.append(f"{required_comment_pending:,} required comments")
    return "NOT FINISHED — " + ", ".join(blockers or ["pending evidence"])


def _v54_tiktok_compact_line(c: dict, comments_required: bool) -> str:
    reasons = _v53_reason_summary(c.get("limited_reason_counts")) or "none"
    cat_reasons = _v53_reason_summary(c.get("catalog_limited_reason_counts"))
    total = int(c.get("items", 0) or 0)
    complete = int(c.get("complete", 0) or 0)
    full = int(c.get("full_payload", c.get("payload", 0)) or 0)
    limited = int(c.get("limited", 0) or 0)
    cv = int(c.get("catalogs_verified", 0) or 0)
    cl = int(c.get("catalogs_limited", 0) or 0)
    ct = int(c.get("catalogs_total", 0) or 0)
    ut = int(c.get("universe_total", 0) or 0)
    ur = int(c.get("universe_resolved", 0) or 0)
    ul = int(c.get("universe_limited", 0) or 0)
    missing = list(c.get("unresolved_locators") or [])
    limited_names = list(c.get("limited_locators") or [])
    if ut:
        universe = f"universe {ur}/{ut} resolved"
        if ul:
            universe += f" + {ul} access-limited"
        universe += f" [{c.get('universe_source','unknown')}]"
    else:
        universe = "universe not loaded"
    if missing:
        universe += f"; unresolved {', '.join(missing[:3])}{'…' if len(missing) > 3 else ''}"
    if limited_names:
        universe += f"; limited {', '.join(limited_names[:3])}{'…' if len(limited_names) > 3 else ''}"
    first = (
        f"Known videos {complete:,}/{total:,} terminal | full {full:,} | limited {limited:,} ({reasons}) | "
        f"catalogs full {cv:,} + limited {cl:,} / known {ct:,} | {universe}"
    )
    if cat_reasons:
        first += f" | catalog limit: {cat_reasons}"
    access = "browser impersonation READY" if bool(c.get("impersonation_available", False)) else "browser impersonation MISSING"
    policy = "comments optional for public completion" if not comments_required else "third-party comments not required for public completion"
    second = (
        f"Comments: collected {int(c.get('comments_collected',0) or 0):,}, empty {int(c.get('comments_empty',0) or 0):,}, "
        f"unavailable {int(c.get('comments_unavailable',0) or 0):,}, deferred {int(c.get('comments_deferred',0) or 0):,}, "
        f"failed {int(c.get('comments_failed',0) or 0):,} | {policy} | access: {access}"
    )
    due = int(c.get("limited_retry_due", 0) or 0)
    cat_due = int(c.get("catalog_retry_due", 0) or 0)
    if due or cat_due:
        second += f" | retry due: videos {due:,}, catalogs {cat_due:,}"
    return first + "\n" + second


_v55_guard_prev = _v44_fast_database_guard

def _v55_reopen_tiktok_access(db: tiktok_Database) -> dict:
    sig = _v54_impersonation_signature()
    marker = "v55_impersonation_recovery_signature"
    if not sig or str(db.get_runtime_state(marker) or "") == sig:
        return {"videos": 0, "catalogs": 0, "resolvers": 0}
    _v51_migrate_tiktok(db)
    with db.lock:
        vcur = db.conn.execute(
            "UPDATE video_ingestion SET access_retry_after=0 WHERE access_state='COMPLETE_LIMITED' AND access_reason IN ('IP_BLOCKED','NO_FORMATS','UNAVAILABLE')"
        )
        acur = db.conn.execute(
            "UPDATE accounts SET catalog_retry_after=0 WHERE catalog_access_status='LIMITED'"
        )
        rows = db.conn.execute(
            "SELECT key FROM runtime_state WHERE key LIKE 'v51_tiktok_resolve_retry_after:%' AND COALESCE(value,'')<>''"
        ).fetchall()
        for row in rows:
            db.conn.execute("UPDATE runtime_state SET value='',updated_at=? WHERE key=?", (tiktok_now_utc(), str(row[0])))
        # Re-test profiles that an earlier build had already classified limited.
        db.conn.execute(
            "UPDATE runtime_state SET value='',updated_at=? WHERE key LIKE 'v55_tiktok_profile_limited:%'",
            (tiktok_now_utc(),),
        )
        db.conn.commit()
        videos = max(0, int(vcur.rowcount or 0))
        catalogs = max(0, int(acur.rowcount or 0))
        resolvers = len(rows)
    db.set_runtime_state(marker, sig)
    tiktok_log(
        f"[tiktok/v55] FINAL ACCESS RECOVERY | curl_cffi ready | reopened videos={videos} | "
        f"catalogs={catalogs} | resolver cooldowns={resolvers} | retry clocks preserved by V55"
    )
    return {"videos": videos, "catalogs": catalogs, "resolvers": resolvers}


def _v44_fast_database_guard(platform_key: str = "") -> dict:
    key = str(platform_key or "").strip().lower()
    if key in {"", "tiktok"} and _v53_tiktok_impersonation_available() and Path(tiktok_DB_PATH).exists():
        try:
            db = tiktok_Database(tiktok_DB_PATH)
            try:
                _v55_reopen_tiktok_access(db)
            finally:
                db.close()
        except Exception as exc:
            tiktok_log(f"[tiktok/v55] final access recovery skipped | {type(exc).__name__}: {exc}")
    return _v55_guard_prev(platform_key)


