def youtube_parse_ytdlp_rate_limit_duration(text: str) -> float:
    """Extract a cooldown duration from yt-dlp/YouTube wording when available.

    yt-dlp commonly reports "for up to an hour". That is an upper bound rather
    than an exact expiry, so we add a small safety buffer. If the error contains
    no duration, fall back to the documented one-hour maximum used by this app.
    """
    lowered = str(text or "").lower()
    patterns = [
        (r"for\s+up\s+to\s+(?:an\s+)?hour", 3600.0),
        (r"up\s+to\s+(\d+(?:\.\d+)?)\s*(seconds?|secs?)", 1.0),
        (r"up\s+to\s+(\d+(?:\.\d+)?)\s*(minutes?|mins?)", 60.0),
        (r"up\s+to\s+(\d+(?:\.\d+)?)\s*(hours?|hrs?)", 3600.0),
        (r"up\s+to\s+(\d+(?:\.\d+)?)\s*(days?)", 86400.0),
        (r"(?:retry|try\s+again|wait)[^0-9]{0,30}(\d+(?:\.\d+)?)\s*(seconds?|secs?|minutes?|mins?|hours?|hrs?)", None),
    ]
    for pattern, multiplier in patterns:
        m = re.search(pattern, lowered)
        if not m:
            continue
        if multiplier is not None:
            return float(m.group(1)) * multiplier if m.lastindex else multiplier
        value = float(m.group(1))
        unit = m.group(2)
        if unit.startswith("sec"):
            return value
        if unit.startswith("min"):
            return value * 60.0
        return value * 3600.0
    return youtube_YTDLP_RATE_LIMIT_COOLDOWN


def youtube_set_ytdlp_rate_limit(
    reason: str = "",
    db: Optional["Database"] = None,
    *,
    video_id: str = "",
    channel_id: str = "",
    run_id: Optional[int] = None,
    action: str = "",
) -> None:
    """Persist a YouTube yt-dlp cooldown and the exact video that triggered it."""
    global youtube_YTDLP_RATE_LIMITED_UNTIL, youtube_YTDLP_RATE_LIMIT_EVENTS, youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER, youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF
    now = time.time()
    parsed = max(60.0, youtube_parse_ytdlp_rate_limit_duration(reason))
    proposed_until = now + parsed + youtube_YTDLP_RATE_LIMIT_BUFFER_SECONDS
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        was_active = youtube_YTDLP_RATE_LIMITED_UNTIL > now
        if not was_active:
            youtube_YTDLP_RATE_LIMIT_EVENTS += 1
            youtube_YTDLP_RATE_LIMITED_UNTIL = proposed_until
            youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER = min(4.0, max(1.5, youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER * 1.5))
            youtube_YTDLP_SUCCESSFUL_REQUESTS_SINCE_BACKOFF = 0
        else:
            # Keep the existing expiry. Repeated warning lines from one yt-dlp
            # extraction must not extend the cooldown over and over again.
            youtube_YTDLP_RATE_LIMITED_UNTIL = youtube_YTDLP_RATE_LIMITED_UNTIL
        remaining = max(0, int(youtube_YTDLP_RATE_LIMITED_UNTIL - now))

    if db is not None:
        try:
            db.set_runtime_state("yt_dlp_rate_limited_until", str(youtube_YTDLP_RATE_LIMITED_UNTIL))
            if video_id:
                db.set_runtime_state("yt_dlp_rate_limit_pending_video_id", video_id)
                db.set_runtime_state("yt_dlp_rate_limit_pending_channel_id", channel_id or "")
                db.set_runtime_state("yt_dlp_rate_limit_pending_run_id", str(run_id or ""))
                db.set_runtime_state("yt_dlp_rate_limit_pending_action", action or "RESUME")
            if reason:
                db.set_runtime_state("yt_dlp_rate_limit_reason", reason)
        except Exception:
            pass

    prefix = "[throttle] YouTube/yt-dlp rate limit detected"
    if was_active:
        prefix = "[throttle] YouTube/yt-dlp rate limit still active"
    pending = f" | pending_video={video_id}" if video_id else ""
    youtube_log(
        f"{prefix} | paused for {remaining // 60} min {remaining % 60}s "
        f"(includes {int(youtube_YTDLP_RATE_LIMIT_BUFFER_SECONDS)}s safety buffer){pending} | "
        f"reason={reason or 'session rate limit'}"
    )


def youtube_ytdlp_rate_limited() -> bool:
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        return time.time() < youtube_YTDLP_RATE_LIMITED_UNTIL


def youtube_ytdlp_rate_limit_remaining() -> int:
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        return max(0, int(youtube_YTDLP_RATE_LIMITED_UNTIL - time.time()))


def youtube_ytdlp_target_videos_per_hour(mode: str) -> int:
    target = int(youtube_YT_DLP_TARGETS_BY_MODE.get(mode, youtube_YT_DLP_TARGETS_BY_MODE["Full"]))
    if mode == "Maximum" and youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
        # Once comments/stats/catalog work are offloaded to the official API,
        # the remaining yt-dlp load is materially lighter, so use the faster
        # 15s policy while still staying below the documented ~300/hour guest
        # ceiling and allowing adaptive backoff to slow down if needed.
        return max(target, 240)
    return target


def youtube_ytdlp_video_interval_seconds(mode: str) -> float:
    target = max(1, youtube_ytdlp_target_videos_per_hour(mode))
    base = max(youtube_YT_DLP_MIN_INTERVAL_SECONDS, 3600.0 / target)
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        multiplier = max(1.0, float(youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER))
    return base * multiplier


def youtube_ytdlp_policy_text(mode: str) -> str:
    target = youtube_ytdlp_target_videos_per_hour(mode)
    interval = youtube_ytdlp_video_interval_seconds(mode)
    request_sleep = (1.0 if (mode == "Maximum" and youtube_USE_YOUTUBE_DATA_API_ACCELERATOR) else (youtube_YT_DLP_MAXIMUM_REQUEST_SLEEP if mode == "Maximum" else youtube_YT_DLP_REQUEST_SLEEP))
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        multiplier = max(1.0, float(youtube_YTDLP_ADAPTIVE_INTERVAL_MULTIPLIER))
    return (
        f"target={target} video starts/hour | min_interval={interval:.1f}s | adaptive_multiplier={multiplier:.2f}x | "
        f"published_guest~{youtube_YT_DLP_PUBLISHED_GUEST_VIDEOS_HOUR}/hour | "
        f"published_account~{youtube_YT_DLP_PUBLISHED_ACCOUNT_VIDEOS_HOUR}/hour | "
        f"request_sleep={request_sleep:.1f}s"
    )


def youtube_wait_for_ytdlp_video_slot(mode: str, label: str = "video") -> bool:
    """Enforce a conservative interval between top-level yt-dlp video starts.

    This is an application policy, not a guaranteed YouTube-safe threshold. The
    interval is measured from request start to request start so a long extraction
    naturally counts toward the delay.
    """
    global youtube_YTDLP_LAST_VIDEO_REQUEST_START, youtube_YTDLP_VIDEO_REQUEST_STARTS

    if youtube_ytdlp_rate_limited() or youtube_stop_requested():
        return False

    min_interval = youtube_ytdlp_video_interval_seconds(mode)
    with youtube_YTDLP_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = (
            now - youtube_YTDLP_LAST_VIDEO_REQUEST_START
            if youtube_YTDLP_LAST_VIDEO_REQUEST_START
            else None
        )
        wait_for = 0.0 if elapsed is None else max(0.0, min_interval - elapsed)
        if elapsed is not None:
            # Small jitter avoids a perfectly periodic pattern without adding
            # seconds of idle time to the high-throughput cadence.
            jitter_cap = min(0.75, max(0.20, min_interval * 0.08))
            wait_for += random.uniform(0.0, jitter_cap)

        if wait_for > 0:
            youtube_log(
                f"      [throttle] waiting {wait_for:.1f}s before yt-dlp {label} | "
                f"{youtube_ytdlp_policy_text(mode)}"
            )
            if youtube_STOP_EVENT.wait(wait_for):
                return False
            if youtube_ytdlp_rate_limited() or youtube_stop_requested():
                return False

        youtube_YTDLP_LAST_VIDEO_REQUEST_START = time.monotonic()
        youtube_YTDLP_VIDEO_REQUEST_STARTS += 1
        request_no = youtube_YTDLP_VIDEO_REQUEST_STARTS

    youtube_log(
        f"      [throttle] yt-dlp {label} request START | #{request_no} | "
        f"target={youtube_ytdlp_target_videos_per_hour(mode)}/hour | "
        f"min_interval={min_interval:.1f}s"
    )
    return True


def youtube_wait_for_ytdlp_surface_slot(label: str = "surface", interval: Optional[float] = None) -> bool:
    """Pace non-video yt-dlp surfaces independently of video enrichment."""
    global youtube_YTDLP_LAST_SURFACE_REQUEST_START
    if youtube_ytdlp_rate_limited() or youtube_stop_requested():
        return False
    wait_interval = (
        youtube_YTDLP_SURFACE_INTERVAL_SECONDS if interval is None
        else max(0.0, float(interval))
    )
    with youtube_YTDLP_SURFACE_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = (
            now - youtube_YTDLP_LAST_SURFACE_REQUEST_START
            if youtube_YTDLP_LAST_SURFACE_REQUEST_START else None
        )
        wait_for = 0.0 if elapsed is None else max(0.0, wait_interval - elapsed)
        if wait_for > 0 and youtube_STOP_EVENT.wait(wait_for):
            return False
        if youtube_ytdlp_rate_limited() or youtube_stop_requested():
            return False
        youtube_YTDLP_LAST_SURFACE_REQUEST_START = time.monotonic()
    youtube_log(
        f"      [throttle] yt-dlp {label} request START | "
        f"surface_interval={wait_interval:.2f}s"
    )
    return True


