def youtube_clean_handle(value: Any) -> str:
    """Return only a real YouTube handle, never a URL fragment such as @http:."""
    if value is None:
        return ""
    text = str(value).strip()
    if not text:
        return ""
    if "/@" in text:
        text = text.split("/@", 1)[1].split("/", 1)[0].split("?", 1)[0]
    text = text.lstrip("@").strip()
    if re.fullmatch(r"[A-Za-z0-9._-]{3,30}", text):
        return text
    return ""


