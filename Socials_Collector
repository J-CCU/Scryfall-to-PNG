# ============================================================================
# V47 — TIKTOK PUBLIC-COMPLETE + OWNED BUSINESS COMMENTS
# ============================================================================
# TikTok's public collector is useful without Research API access.  V47 stops
# treating unavailable third-party comments as a blocker for an otherwise
# complete public payload.  Owned accounts can optionally be upgraded with the
# TikTok API for Business Accounts API comment endpoints when credentials are
# configured.  The local SQLite DB remains authoritative.
V47_BUILD = "ALL_FIXES_V47_TIKTOK_PUBLIC_COMPLETE_BUSINESS_COMMENTS"
V47_TIKTOK_BUSINESS_BASE = "https://business-api.tiktok.com/open_api/v1.3"
V47_TIKTOK_BUSINESS_ACCESS_TOKEN = os.getenv("TIKTOK_BUSINESS_ACCESS_TOKEN", "").strip()
V47_TIKTOK_BUSINESS_ID = os.getenv("TIKTOK_BUSINESS_ID", "").strip()
V47_TIKTOK_BUSINESS_OWNED_HANDLES = {
    x.strip().lstrip("@").lower()
    for x in os.getenv("TIKTOK_BUSINESS_OWNED_HANDLES", "").replace(";", ",").split(",")
    if x.strip()
}
V47_TIKTOK_BUSINESS_TIMEOUT = max(10, int(os.getenv("TIKTOK_BUSINESS_TIMEOUT", "30")))
V47_TIKTOK_BUSINESS_PAGE_SIZE = 30


def _v47_tiktok_business_configured() -> bool:
    return bool(V47_TIKTOK_BUSINESS_ACCESS_TOKEN and V47_TIKTOK_BUSINESS_ID and V47_TIKTOK_BUSINESS_OWNED_HANDLES)


def _v47_tiktok_research_configured() -> bool:
    return bool(
        tiktok_COLLECT_RESEARCH_COMMENTS
        and (tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN or (tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET))
    )


def _v47_norm_handle(value: Any) -> str:
    return str(value or "").strip().lstrip("@").lower()


def _v47_tiktok_owned_username(value: Any) -> bool:
    return bool(_v47_norm_handle(value) in V47_TIKTOK_BUSINESS_OWNED_HANDLES)


def _v47_video_username(db: tiktok_Database, video_id: str, fallback: str = "") -> str:
    if fallback:
        return _v47_norm_handle(fallback)
    try:
        with db.lock:
            row = db.conn.execute("SELECT username FROM videos WHERE video_id=?", (str(video_id),)).fetchone()
        return _v47_norm_handle(row[0] if row else "")
    except Exception:
        return ""


def _v47_tiktok_comments_required_for_video(db: tiktok_Database, video_id: str, username: str = "") -> str:
    """Return BUSINESS, RESEARCH, or PUBLIC_ONLY for this durable video obligation."""
    # V48: even configured Business/Research sources stay idle when comments are OFF.
    if not tiktok_COLLECT_RESEARCH_COMMENTS:
        return "PUBLIC_ONLY"
    uname = _v47_video_username(db, video_id, username)
    if _v47_tiktok_business_configured() and _v47_tiktok_owned_username(uname):
        return "BUSINESS"
    if _v47_tiktok_research_configured():
        return "RESEARCH"
    return "PUBLIC_ONLY"


def _v47_tt_comments_terminal(db: tiktok_Database, state: dict) -> bool:
    vid = str((state or {}).get("video_id") or "")
    status = str((state or {}).get("comments_status") or "").upper()
    evidence = str((state or {}).get("comments_evidence") or "").upper()
    if not vid:
        return False
    with db.lock:
        actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)) or 0)
        expected = _v42_scalar(db.conn, "SELECT comment_count FROM videos WHERE video_id=?", (vid,))
    if status == "SUCCESS":
        return actual > 0
    if status == "SUCCESS_EMPTY":
        return evidence in {
            "RESEARCH_API_PAGINATION_COMPLETE", "BUSINESS_API_PAGINATION_COMPLETE",
            "METADATA_ZERO", "LEGACY_METADATA_ZERO"
        } or (expected is not None and int(expected or 0) == 0)
    return False


# V42/V44 action/audit code resolves this name dynamically.
_v42_tt_comments_terminal = _v47_tt_comments_terminal


def _v47_public_payload_complete(db: tiktok_Database, state: Optional[dict]) -> bool:
    if not state:
        return False
    try:
        return bool(_v42_tiktok_payload_complete(db, state, True, require_comments=False))
    except Exception:
        return False


def _v47_refresh_tt_audit(db: tiktok_Database, video_id: str) -> bool:
    vid = str(video_id or "")
    state = dict(db.get_video_state(vid) or {})
    payload = _v47_public_payload_complete(db, state)
    policy = _v47_tiktok_comments_required_for_video(db, vid, state.get("username", ""))
    comments = _v47_tt_comments_terminal(db, state)
    required = policy in {"BUSINESS", "RESEARCH"}
    complete = bool(payload and (comments or not required))
    if complete:
        status = "COMPLETE"
    elif not payload and required and not comments:
        status = "MISSING_PAYLOAD_COMMENTS"
    elif not payload:
        status = "MISSING_PAYLOAD"
    else:
        status = "MISSING_COMMENTS"
    now = tiktok_now_utc()
    with db.lock:
        if payload and not required and not comments:
            db.conn.execute(
                """UPDATE video_ingestion
                   SET comments_status='UNAVAILABLE_NOT_REQUIRED',
                       comments_evidence='NO_AUTHORIZED_THIRD_PARTY_SOURCE',
                       comments_last_source='public_completion_policy'
                   WHERE video_id=? AND COALESCE(comments_status,'') NOT IN ('SUCCESS','SUCCESS_EMPTY')""",
                (vid,),
            )
        db.conn.execute(
            """UPDATE video_ingestion
               SET completeness_audit_status=?, last_completeness_audit_at=?,
                   enrichment_state=?, current_stage=?, last_error=CASE WHEN ? THEN NULL ELSE last_error END
               WHERE video_id=?""",
            (status, now, "COMPLETE" if complete else "IN_PROGRESS", "COMPLETE" if complete else ("comments" if status == "MISSING_COMMENTS" else "FINALIZE"), 1 if complete else 0, vid),
        )
        db.conn.commit()
    return complete


_v42_refresh_tt_audit = _v47_refresh_tt_audit


def _v47_required_owned_sql(alias: str = "v") -> tuple[str, list]:
    handles = sorted(V47_TIKTOK_BUSINESS_OWNED_HANDLES)
    if not tiktok_COLLECT_RESEARCH_COMMENTS:
        return "0", []
    if not (_v47_tiktok_business_configured() and handles):
        return "0", []
    marks = ",".join("?" for _ in handles)
    return f"LOWER(LTRIM(COALESCE({alias}.username,''),'@')) IN ({marks})", handles


def _v47_fast_audit_tiktok(db: tiktok_Database) -> dict:
    """Set-based startup reconciliation using attainable TikTok completion policy."""
    _v42_migrate_tiktok(db)
    now = tiktok_now_utc()
    payload = _v44_tt_payload_expr("i")
    comments = """(
        (COALESCE(i.comments_status,'')='SUCCESS' AND EXISTS(SELECT 1 FROM comments c WHERE c.video_id=i.video_id))
        OR (COALESCE(i.comments_status,'')='SUCCESS_EMPTY' AND (
            COALESCE(i.comments_evidence,'') IN ('RESEARCH_API_PAGINATION_COMPLETE','BUSINESS_API_PAGINATION_COMPLETE','METADATA_ZERO','LEGACY_METADATA_ZERO')
            OR v.comment_count=0
        ))
    )"""
    owned_sql, owned_args = _v47_required_owned_sql("v")
    research_all = _v47_tiktok_research_configured()
    if research_all:
        required_sql, required_args = "1", []
    elif owned_args:
        required_sql, required_args = owned_sql, owned_args
    else:
        required_sql, required_args = "0", []
    with db.lock:
        # Durable rows always win over stale status labels.
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_evidence='PERSISTED_ROWS', comments_last_source=COALESCE(NULLIF(comments_last_source,''),'legacy'), comments_status='SUCCESS'
            WHERE EXISTS(SELECT 1 FROM comments c WHERE c.video_id=video_ingestion.video_id)
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_evidence='LEGACY_METADATA_ZERO', comments_last_source=COALESCE(NULLIF(comments_last_source,''),'legacy'), comments_status='SUCCESS_EMPTY'
            WHERE COALESCE(comments_status,'')<>'SUCCESS'
              AND EXISTS(SELECT 1 FROM videos v WHERE v.video_id=video_ingestion.video_id AND v.comment_count=0)
        """)
        # If Business credentials have become available, reopen owned rows that
        # were previously considered public-complete so their comments can be upgraded.
        if owned_args:
            db.conn.execute(
                f"""UPDATE video_ingestion AS i
                    SET comments_status='PENDING_BUSINESS_API', comments_evidence='BUSINESS_API_REQUIRED',
                        comments_last_source='TikTok Business Accounts API'
                    WHERE EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({owned_sql}))
                      AND COALESCE(i.comments_status,'') IN ('UNAVAILABLE_NOT_REQUIRED','DEFERRED_NO_RESEARCH_ACCESS','UNAVAILABLE_NO_RESEARCH_ACCESS','DEFERRED_BUSINESS_API_NOT_CONFIGURED')""",
                owned_args,
            )
        # For rows whose comments are not currently obtainable/required, preserve
        # that fact without keeping the payload permanently "unfinished".
        if not research_all:
            if owned_args:
                not_required_sql = f"NOT EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({owned_sql}))"
                db.conn.execute(
                    f"""UPDATE video_ingestion AS i
                        SET comments_status='UNAVAILABLE_NOT_REQUIRED', comments_evidence='NO_AUTHORIZED_THIRD_PARTY_SOURCE',
                            comments_last_source='public_completion_policy'
                        WHERE ({payload}) AND ({not_required_sql})
                          AND COALESCE(i.comments_status,'') NOT IN ('SUCCESS','SUCCESS_EMPTY')""",
                    owned_args,
                )
            else:
                db.conn.execute(
                    f"""UPDATE video_ingestion AS i
                        SET comments_status='UNAVAILABLE_NOT_REQUIRED', comments_evidence='NO_AUTHORIZED_THIRD_PARTY_SOURCE',
                            comments_last_source='public_completion_policy'
                        WHERE ({payload}) AND COALESCE(i.comments_status,'') NOT IN ('SUCCESS','SUCCESS_EMPTY')"""
                )
        # Completion: public payload is sufficient unless an authorized comment
        # source is actually configured for this row.
        db.conn.execute(
            f"""UPDATE video_ingestion AS i
                SET completeness_audit_status = CASE
                    WHEN ({payload}) AND (
                        NOT EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({required_sql}))
                        OR EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({comments}))
                    ) THEN 'COMPLETE'
                    WHEN NOT ({payload}) AND EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({required_sql}))
                         AND NOT EXISTS(SELECT 1 FROM videos v WHERE v.video_id=i.video_id AND ({comments})) THEN 'MISSING_PAYLOAD_COMMENTS'
                    WHEN NOT ({payload}) THEN 'MISSING_PAYLOAD'
                    ELSE 'MISSING_COMMENTS'
                END,
                last_completeness_audit_at=?""",
            [*required_args, *required_args, now],
        )
        db.conn.execute("UPDATE video_ingestion SET enrichment_state='COMPLETE',current_stage='COMPLETE',last_error=NULL WHERE completeness_audit_status='COMPLETE'")
        db.conn.execute("""
            UPDATE video_ingestion SET enrichment_state='IN_PROGRESS',
                current_stage=CASE WHEN completeness_audit_status='MISSING_COMMENTS' THEN 'comments' ELSE 'FINALIZE' END
            WHERE completeness_audit_status<>'COMPLETE' AND enrichment_state='COMPLETE'
        """)
        db.conn.commit()
    return _v47_live_tiktok_counts(Path(db.path))


_v44_fast_audit_tiktok = _v47_fast_audit_tiktok


def _v47_business_get(path: str, params: dict) -> dict:
    if not _v47_tiktok_business_configured():
        raise RuntimeError("TikTok Business Accounts API is not configured")
    headers = {"Access-Token": V47_TIKTOK_BUSINESS_ACCESS_TOKEN, "Accept": "application/json"}
    r = requests.get(V47_TIKTOK_BUSINESS_BASE + path, headers=headers, params=params, timeout=V47_TIKTOK_BUSINESS_TIMEOUT)
    if r.status_code == 429:
        raise RuntimeError("TikTok Business Accounts API rate limited (HTTP 429)")
    if r.status_code in (401, 403):
        raise PermissionError(f"TikTok Business Accounts API authorization failed (HTTP {r.status_code})")
    r.raise_for_status()
    data = r.json()
    code = data.get("code", 0)
    if str(code) not in {"0", "None", ""} and code not in (0, None):
        raise RuntimeError(f"TikTok Business Accounts API code={code}: {data.get('message') or 'unknown error'}")
    return data


def _v47_business_normalize_comment(row: dict, video_id: str, parent_id: str = "") -> dict:
    return {
        "id": str(row.get("comment_id") or row.get("id") or ""),
        "video_id": str(row.get("video_id") or video_id or ""),
        "parent_comment_id": str(row.get("parent_comment_id") or parent_id or "") or None,
        "text": row.get("text"),
        "like_count": tiktok_safe_int(row.get("likes") if row.get("likes") is not None else row.get("like_count")),
        "reply_count": tiktok_safe_int(row.get("replies") if row.get("replies") is not None else row.get("reply_count")),
        "create_time": tiktok_safe_int(row.get("create_time")),
    }


def _v47_business_comment_rows(data: dict, *, replies: bool = False) -> list:
    payload = (data or {}).get("data") or {}
    if replies:
        return list(payload.get("replies") or payload.get("comments") or payload.get("reply_list") or [])
    return list(payload.get("comments") or [])


def _v47_collect_business_comments(db: tiktok_Database, run_id: int, video: dict) -> tuple[int, bool]:
    """Collect every available owned-video comment + reply page through Accounts API."""
    vid = str(video.get("video_id") or "")
    aid = str(video.get("account_id") or "")
    if not vid:
        raise ValueError("missing TikTok video_id")
    seen: dict[str, dict] = {}
    top_level: list[dict] = []
    cursor = 0
    page = 0
    while True:
        page += 1
        resp = _v47_business_get("/business/comment/list/", {
            "business_id": V47_TIKTOK_BUSINESS_ID,
            "video_id": vid,
            "status": "ALL",
            "sort_field": "create_time",
            "sort_order": "asc",
            "cursor": cursor,
            "max_count": V47_TIKTOK_BUSINESS_PAGE_SIZE,
            "include_replies": "false",
        })
        db.insert_raw(run_id, aid, vid, "TikTok Business Accounts API", f"comments_page:{page}", resp)
        payload = (resp or {}).get("data") or {}
        rows = _v47_business_comment_rows(resp)
        for row in rows:
            c = _v47_business_normalize_comment(row, vid)
            if c["id"]:
                seen[c["id"]] = c
                top_level.append(c)
        if not payload.get("has_more"):
            break
        nxt = payload.get("cursor")
        if nxt is None or str(nxt) == str(cursor):
            raise RuntimeError("TikTok Business comment pagination stalled")
        cursor = nxt
        if page > 10000:
            raise RuntimeError("TikTok Business comment pagination safety limit reached")
    # Fetch complete reply lists when TikTok reports replies on a top-level comment.
    for parent in top_level:
        if int(parent.get("reply_count") or 0) <= 0:
            continue
        rcursor = 0
        rpage = 0
        while True:
            rpage += 1
            resp = _v47_business_get("/business/comment/reply/list/", {
                "business_id": V47_TIKTOK_BUSINESS_ID,
                "video_id": vid,
                "comment_id": parent["id"],
                "status": "ALL",
                "sort_field": "create_time",
                "sort_order": "asc",
                "cursor": rcursor,
                "max_count": V47_TIKTOK_BUSINESS_PAGE_SIZE,
            })
            db.insert_raw(run_id, aid, vid, "TikTok Business Accounts API", f"comment_replies:{parent['id']}:{rpage}", resp)
            payload = (resp or {}).get("data") or {}
            for row in _v47_business_comment_rows(resp, replies=True):
                c = _v47_business_normalize_comment(row, vid, parent["id"])
                if c["id"]:
                    seen[c["id"]] = c
            if not payload.get("has_more"):
                break
            nxt = payload.get("cursor")
            if nxt is None or str(nxt) == str(rcursor):
                raise RuntimeError("TikTok Business reply pagination stalled")
            rcursor = nxt
            if rpage > 10000:
                raise RuntimeError("TikTok Business reply pagination safety limit reached")
    rows = list(seen.values())
    inserted = db.insert_comments_batch(run_id, rows, "TikTok Business Accounts API")
    _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "BUSINESS_API_PAGINATION_COMPLETE", "TikTok Business Accounts API")
    db.mark_stage(vid, "comments", "SUCCESS" if rows else "SUCCESS_EMPTY")
    return inserted, True


def tiktok_choose_video_action_v47(db: tiktok_Database, video: dict, mode: str, force_refresh: bool = False) -> str:
    if force_refresh:
        return "FORCE"
    vid = str(video.get("video_id") or "")
    state = dict(db.get_video_state(vid) or {})
    if not state:
        return "NEW"
    if not _v47_public_payload_complete(db, state):
        return "RESUME"
    policy = _v47_tiktok_comments_required_for_video(db, vid, video.get("username", ""))
    if policy == "BUSINESS" and not _v47_tt_comments_terminal(db, state):
        return "BUSINESS_COMMENT_REPAIR"
    if policy == "RESEARCH" and not _v47_tt_comments_terminal(db, state):
        return "COMMENT_REPAIR"
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE" or str(state.get("completeness_audit_status") or "").upper() != "COMPLETE":
        _v47_refresh_tt_audit(db, vid)
    age_days = tiktok_video_age_days(video)
    refresh_hours = 24.0 if age_days is not None and age_days <= 30 else 168.0
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = _v29_hours(last)
    return "PERFORMANCE_REFRESH" if elapsed is None or elapsed >= refresh_hours else "SKIP"


