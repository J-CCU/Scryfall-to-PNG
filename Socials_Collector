    def insert_comments_batch(self, run_id: int, comments: list, raw_json_id: Optional[int]) -> int:
        """Upsert many comments in one transaction to avoid one COMMIT per row."""
        prepared = []
        for c in comments:
            if not isinstance(c, dict):
                continue
            video_id = c.get("video_id", "")
            comment_id = c.get("id", "")
            if not video_id or not comment_id:
                continue
            prepared.append((
                run_id, video_id, comment_id, c.get("author", ""), c.get("author_id", ""),
                c.get("author_url", ""), c.get("author_thumbnail", ""),
                str(c.get("author_is_verified", "")), str(c.get("author_is_uploader", "")),
                c.get("text", ""), c.get("html", ""), c.get("timestamp"), c.get("parent", "root"),
                c.get("like_count"), c.get("dislike_count"), str(c.get("is_favorited", "")),
                str(c.get("is_pinned", "")), c.get("start_time"), c.get("end_time"),
                raw_json_id, youtube_now_utc(),
            ))
        if not prepared:
            return 0

        with self.lock:
            by_video = {}
            for row in prepared:
                by_video.setdefault(row[1], []).append(row[2])

            existing = set()
            for video_id, ids in by_video.items():
                for start in range(0, len(ids), 400):
                    chunk = ids[start:start + 400]
                    placeholders = ",".join("?" for _ in chunk)
                    rows = self.conn.execute(
                        f"SELECT video_id, comment_id FROM comments WHERE video_id=? AND comment_id IN ({placeholders})",
                        [video_id, *chunk],
                    ).fetchall()
                    existing.update((r[0], r[1]) for r in rows)

            update_sql = """
                UPDATE comments SET scrape_run_id=?, author=?, author_id=?, author_url=?,
                    author_thumbnail=?, author_verified=?, author_is_uploader=?, text=?, html=?,
                    timestamp=?, parent_id=?, like_count=?, dislike_count=?, is_favorited=?,
                    is_pinned=?, start_time=?, end_time=?, raw_json_id=?, captured_at=?
                WHERE video_id=? AND comment_id=?
            """
            insert_sql = """
                INSERT INTO comments
                (scrape_run_id, video_id, comment_id, author, author_id, author_url,
                 author_thumbnail, author_verified, author_is_uploader, text, html, timestamp,
                 parent_id, like_count, dislike_count, is_favorited, is_pinned, start_time,
                 end_time, raw_json_id, captured_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """

            updates = []
            inserts = []
            for row in prepared:
                key = (row[1], row[2])
                if key in existing:
                    updates.append((
                        row[0], row[3], row[4], row[5], row[6], row[7], row[8],
                        row[9], row[10], row[11], row[12], row[13], row[14], row[15],
                        row[16], row[17], row[18], row[19], row[20], row[1], row[2],
                    ))
                else:
                    inserts.append(row)

            if updates:
                self.conn.executemany(update_sql, updates)
            if inserts:
                self.conn.executemany(insert_sql, inserts)
            self.conn.commit()
        return len(prepared)

