    def stop(self) -> None:
        # Preserve the V22 user-facing graceful End behavior without Neon staging.
        self.graceful_end_requested = True
        self.wake_event.set()
        self.ui_log("[control] END requested | current in-flight work will checkpoint before shutdown.\n")
