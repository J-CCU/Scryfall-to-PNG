# ============================================================================
# V50 — INSTAGRAM SOURCE ISOLATION + GRAPH DEGRADATION + YOUTUBE METRIC REPAIR
# ============================================================================
# Meta Graph is a supplement, not the Instagram platform itself.  Earlier
# builds stored Meta application throttles in the same platform-wide access
# backoff used for Instagram's anonymous/public endpoint.  A single Graph code
# 4 therefore stopped the entire Instagram worker for up to an hour even though
# the public/mobile/yt-dlp paths could still make progress.
#
# V50 separates those failure domains:
#   * Graph throttle/auth failures -> Graph-only cooldown; public collection runs.
#   * Public 401/Please-wait -> public-only cooldown; Graph collection can run.
#   * Scheduler pauses Instagram only when every configured source is cooling.
#   * Business Discovery automatically falls back to the public resolver.
#   * Legacy Graph-created platform backoffs are migrated on preflight.
#
# It also repairs V49's already-cached YouTube compact-count corruption.  V49
# fixed future parsing, but a row such as 62.5K/exact=625 could remain cached as
# "API fresh".  Suspicious cached metrics now force one official API refresh.

V50_BUILD = "SOCIAL_COLLECTOR_PRODUCTION_2026_09_INSTAGRAM_RESILIENT_FAST"
PRODUCTION_BUILD = V50_BUILD
SOCIAL_COLLECTOR_BUILD = V50_BUILD
youtube_COLLECTOR_BUILD = V50_BUILD
INSTAGRAM_COLLECTOR_BUILD = V50_BUILD
tiktok_COLLECTOR_BUILD = V50_BUILD

V50_IG_GRAPH_COOLDOWN_INITIAL = max(
    900.0, float(os.getenv("SOCIAL_COLLECTOR_IG_GRAPH_COOLDOWN_INITIAL", "3600"))
)
V50_IG_GRAPH_COOLDOWN_MAX = max(
    V50_IG_GRAPH_COOLDOWN_INITIAL,
    float(os.getenv("SOCIAL_COLLECTOR_IG_GRAPH_COOLDOWN_MAX", "21600")),
)


def _v50_graph_cooldown_until(db: Optional[instagram_Database]) -> float:
    if db is None:
        return 0.0
    try:
        value = float(db.get_runtime_state("instagram_graph_cooldown_until") or 0)
        if value <= time.time():
            if value:
                db.set_runtime_state("instagram_graph_cooldown_until", "")
                db.set_runtime_state("instagram_graph_cooldown_reason", "")
            return 0.0
        return value
    except Exception:
        return 0.0


def _v50_set_graph_cooldown(db: Optional[instagram_Database], reason: str, *, auth: bool = False) -> float:
    if db is None:
        return time.time() + (V37_INSTAGRAM_AUTH_RETRY_SECONDS if auth else V50_IG_GRAPH_COOLDOWN_INITIAL)
    try:
        events = int(float(db.get_runtime_state("instagram_graph_cooldown_events") or 0))
    except Exception:
        events = 0
    if auth:
        cooldown = float(V37_INSTAGRAM_AUTH_RETRY_SECONDS)
    else:
        cooldown = min(V50_IG_GRAPH_COOLDOWN_MAX, V50_IG_GRAPH_COOLDOWN_INITIAL * (2 ** min(events, 3)))
    until = time.time() + cooldown
    try:
        db.set_runtime_state("instagram_graph_cooldown_until", str(until))
        db.set_runtime_state("instagram_graph_cooldown_reason", str(reason)[:1200])
        db.set_runtime_state("instagram_graph_cooldown_events", str(events + 1))
        db.set_runtime_state("instagram_graph_success_streak", "0")
    except Exception:
        pass
    instagram_log(
        f"[graph/v50] SOURCE COOLDOWN | Graph only | retry_in={int(cooldown)//60}m | "
        f"public Instagram remains enabled | reason={str(reason)[:220]}"
    )
    return until


def _v50_clear_graph_cooldown_after_success(db: Optional[instagram_Database]) -> None:
    if db is None:
        return
    try:
        streak = int(float(db.get_runtime_state("instagram_graph_success_streak") or 0)) + 1
        db.set_runtime_state("instagram_graph_success_streak", str(streak))
        # A handful of consecutive successes proves the app-level throttle has cleared.
        if streak >= 5:
            db.set_runtime_state("instagram_graph_cooldown_until", "")
            db.set_runtime_state("instagram_graph_cooldown_reason", "")
            db.set_runtime_state("instagram_graph_cooldown_events", "0")
    except Exception:
        pass


def _v50_migrate_legacy_graph_backoff(db: Optional[instagram_Database]) -> None:
    """Move old Graph-created platform backoff into the Graph-only circuit."""
    if db is None:
        return
    try:
        reason = str(db.get_runtime_state("instagram_access_backoff_reason") or "")
        who = str(db.get_runtime_state("instagram_access_backoff_username") or "")
        until = float(db.get_runtime_state("instagram_access_backoff_until") or 0)
        graph_owned = who in {"graph-api", "graph-auth"} or "meta graph" in reason.lower()
        if not graph_owned:
            return
        if until > time.time():
            existing = _v50_graph_cooldown_until(db)
            db.set_runtime_state("instagram_graph_cooldown_until", str(max(existing, until)))
            db.set_runtime_state("instagram_graph_cooldown_reason", reason[:1200])
        db.set_runtime_state("instagram_access_backoff_until", "")
        db.set_runtime_state("instagram_access_backoff_reason", "")
        db.set_runtime_state("instagram_access_backoff_username", "")
        instagram_log("[graph/v50] migrated legacy Graph platform backoff -> Graph-only cooldown")
    except Exception as exc:
        instagram_log(f"[graph/v50] legacy cooldown migration skipped | {type(exc).__name__}: {exc}")


def instagram_instagram_graph_get_v50(path: str, params: Optional[dict] = None, db: Optional[instagram_Database] = None) -> Optional[dict]:
    global instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN
    _v37_reload_graph_token(db)
    if not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN or not instagram_instagram_graph_budget_available(db):
        return None
    _v50_migrate_legacy_graph_backoff(db)
    until = _v50_graph_cooldown_until(db)
    if until > time.time():
        return None

    def do_request():
        _v37_wait_for_graph_request_slot()
        instagram_instagram_graph_note_request(db)
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM_GRAPH_BASE_URL}/{str(path).lstrip('/')}",
            params={**(params or {}), "access_token": instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN},
            timeout=instagram_REQUEST_TIMEOUT,
        )
        try:
            data = r.json()
        except Exception:
            data = None
        return r, data

    try:
        r, data = do_request()
        err = data.get("error") if isinstance(data, dict) else None
        err = err if isinstance(err, dict) else {}
        code = instagram_safe_int(err.get("code"))
        subcode = instagram_safe_int(err.get("error_subcode"))
        message = str(err.get("message") or "")

        if code == 190 or subcode in {458, 459, 460, 463, 464, 467}:
            if _v37_maybe_exchange_long_lived_token(db, force=True):
                r, data = do_request()
