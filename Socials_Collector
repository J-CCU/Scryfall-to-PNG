def tiktok_prepare_ytdlp_cookiefile(raw: Any) -> Optional[Path]:
    global tiktok_YTDLP_COOKIEFILE
    if not isinstance(raw, list):
        return None
    lines = ["# Netscape HTTP Cookie File", "# Generated temporarily by tiktok_scraper.py"]
    count = 0
    for c in raw:
        if not isinstance(c, dict) or not c.get("name") or c.get("value") is None:
            continue
        domain = str(c.get("domain") or ".tiktok.com")
        path = str(c.get("path") or "/")
        secure = "TRUE" if bool(c.get("secure", True)) else "FALSE"
        try:
            expires = int(float(c.get("expirationDate") or c.get("expires") or 0))
        except Exception:
            expires = 0
        include_subdomains = "TRUE" if domain.startswith(".") else "FALSE"
        lines.append("\t".join([domain, include_subdomains, path, secure, str(expires), str(c.get("name")), str(c.get("value"))]))
        count += 1
    if count == 0:
        return None
    path = Path(tempfile.gettempdir()) / f"tiktok_ytdlp_cookies_{os.getpid()}.txt"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    tiktok_YTDLP_COOKIEFILE = path

    def cleanup() -> None:
        try:
            path.unlink(missing_ok=True)
        except Exception:
            pass

    atexit.register(cleanup)
    tiktok_log(f"[cookies] prepared yt-dlp cookiefile | cookies={count} | path={path}")
    return path


def tiktok_load_cookies() -> int:
    if not tiktok_COOKIES_PATH.exists():
        tiktok_log("[cookies] tiktok_cookies.json not found; public requests only")
        return 0
    try:
        raw = json.loads(tiktok_COOKIES_PATH.read_text(encoding="utf-8"))
    except Exception as exc:
        tiktok_log(f"[cookies] could not read {tiktok_COOKIES_PATH.name}: {exc}")
        return 0
    count = 0
    if isinstance(raw, list):
        for c in raw:
            if not isinstance(c, dict) or not c.get("name") or c.get("value") is None:
                continue
            try:
                tiktok_SESSION.cookies.set(c["name"], c["value"], domain=c.get("domain"), path=c.get("path", "/"))
                count += 1
            except Exception:
                pass
    tiktok_prepare_ytdlp_cookiefile(raw)
    tiktok_log(f"[cookies] loaded {count} cookies")
    return count


