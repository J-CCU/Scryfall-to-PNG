def tiktok_research_comments_parity(video_id: str, db: Optional[tiktok_Database] = None) -> List[dict]:
    base = tiktok__TIKTOK_OLD_RESEARCH_COMMENTS(video_id, db)
    out = list(base)
    seen = {str(x.get("id") or "") for x in out if x.get("id")}
    for parent in list(out):
        if tiktok_stop_requested() or not tiktok_tiktok_research_budget_available(db):
            break
        if tiktok_safe_int(parent.get("reply_count")) and tiktok_safe_int(parent.get("reply_count")) > 0 and not parent.get("parent_comment_id"):
            data = tiktok_research_post(
                "/video/comment/list/",
                {"fields": "id,video_id,text,like_count,reply_count,parent_comment_id,create_time"},
                {"comment_id": int(parent.get("id")), "max_count": tiktok_MAX_RESEARCH_COMMENTS_PER_PAGE, "cursor": 0},
                db,
            )
            payload = (data or {}).get("data") or {}
            for row in payload.get("comments") or []:
                cid = str(row.get("id") or "")
                if cid and cid not in seen:
                    seen.add(cid)
                    out.append(row)
    return out

