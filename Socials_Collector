def _v35_repair_youtube_checkpoints(db: "youtube_Database", mode: str = "Maximum") -> int:
    """Repair stale checkpoints/errors entirely from already-persisted evidence."""
    try:
        with db.lock:
            rows = db.conn.execute(
                """
                SELECT video_id
                FROM video_ingestion
                WHERE last_enriched_at IS NOT NULL
                  AND (COALESCE(enrichment_state,'') <> 'COMPLETE' OR COALESCE(last_error,'') <> '')
                """
            ).fetchall()
        repaired = 0
        for row in rows:
            vid = str(row[0] or "")
            if not vid:
                continue
            state = db.get_video_sync(vid) or {}
            if not _v35_youtube_payload_complete(db, state, mode):
                continue
            with db.lock:
                v13__set_checkpoint(
                    db.conn, "video_ingestion", "video_id", vid,
                    state="COMPLETE", stage="COMPLETE", error_marker=None,
                )
                db.conn.execute(
                    "UPDATE video_ingestion SET last_error=NULL WHERE video_id=?", (vid,)
                )
                db.conn.commit()
            repaired += 1
        return repaired
    except Exception as exc:
        youtube_log(f"[db-repair/v35] YouTube checkpoint repair warning | {type(exc).__name__}: {exc}")
        return 0


def youtube_choose_video_action_v35(
    db: youtube_Database, video: dict, mode: str, force_refresh: bool = False
) -> str:
    state = db.get_video_sync(video.get("video_id", ""))
    if state is None:
        return "NEW"
    if force_refresh:
        return "FORCE"
    if not _v35_youtube_complete(db, state, mode):
        return "RESUME"
    # Once the persisted payload is proven complete, a stale historical error is
    # not allowed to reopen the item. The repair pass clears that marker locally.
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = _v29_hours(last)
    if elapsed is None or elapsed >= youtube_video_refresh_interval_hours(video):
        return "PERFORMANCE_REFRESH"
    return "SKIP"


