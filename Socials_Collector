            CREATE TABLE IF NOT EXISTS youtube_work_queue (
                video_id TEXT NOT NULL,
                stage TEXT NOT NULL,
                action TEXT,
                state TEXT NOT NULL DEFAULT 'PENDING',
                priority INTEGER NOT NULL DEFAULT 0,
                run_id INTEGER NOT NULL DEFAULT 0,
