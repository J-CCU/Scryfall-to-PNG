def tiktok_main() -> None:
    if len(sys.argv) >= 3 and sys.argv[1] == "--worker":
        raise SystemExit(tiktok_worker_main(sys.argv[2]))
    if len(sys.argv) >= 2 and sys.argv[1] == "--self-test":
        raise SystemExit(tiktok_self_test())

    root = tk.Tk()
    app = tiktok_App(root)

    def close() -> None:
        if app.process and app.process.poll() is None:
            app.stop_clicked = True
            try:
                app.process.terminate()
            except Exception:
                pass
        try:
            app.db.close()
        finally:
            root.destroy()

    root.protocol("WM_DELETE_WINDOW", close)
    root.mainloop()



