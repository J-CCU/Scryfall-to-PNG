def instagram_post_state_complete_v30(state, maximum: bool) -> bool:
    if not state:
        return False
    d = dict(state)
    if str(d.get("enrichment_state") or "").upper() == "COMPLETE":
        return True
    if str(d.get("enrichment_state") or "").upper() == "FAILED":
