            rows = conn.execute(
                "SELECT resolved_username FROM account_inputs WHERE COALESCE(account_id,'')<>'' AND UPPER(COALESCE(resolution_verified,''))='YES'"
            ).fetchall()
            for row in rows:
                u = tiktok_normalized_username(row[0])
                if u:
                    resolved.add(u.lower())
        except Exception:
            pass
        limited = set()
        try:
            rows = conn.execute(
                "SELECT key,value FROM runtime_state WHERE key LIKE 'v55_tiktok_profile_limited:%' AND COALESCE(value,'')<>''"
            ).fetchall()
            for key, value in rows:
                u = str(key or "").split(":", 1)[-1].strip().lower()
                if u:
                    limited.add(u)
        except Exception:
            pass
        missing = [u for u in expected if u.lower() not in resolved and u.lower() not in limited]
        limited_expected = [u for u in expected if u.lower() in limited and u.lower() not in resolved]
        out["universe_resolved"] = sum(1 for u in expected if u.lower() in resolved)
        out["universe_limited"] = len(limited_expected)
        out["universe_unresolved"] = len(missing)
        out["unresolved_locators"] = [f"@{u}" for u in missing]
        out["limited_locators"] = [f"@{u}" for u in limited_expected]
        return out
    finally:
        if conn is not None:
            conn.close()


