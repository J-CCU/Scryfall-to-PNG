def v13__instagram_resolve_profile(loader: Any, username: str) -> Optional[dict]:
    username = str(username or "").strip().lstrip("@").split("/")[0]
    if not username:
        return None
    # Cached account id lets us bypass the username feed endpoint that currently
    # refuses some anonymous sessions.
    db = getattr(loader, "_v13_db", None)
    cached = v13__instagram_find_cached_account(db, username) if db is not None else None
    if cached and cached.get("account_id"):
        try:
            if instagram_wait_for_request_slot("Full", f"mobile-feed cached-id @{username}"):
                feed = v13__instagram_feed_get_json(loader, f"api/v1/feed/user/{cached['account_id']}/", {"count": 12})
                result = v13__instagram_profile_from_feed_page(loader, feed, username, "Instagram mobile feed cached-ID endpoint")
                if result:
                    return result
        except Exception as exc:
            if isinstance(exc, instagram_TooManyRequestsException):
                raise
            instagram_log(f"[resolve/cache-feed] cached-ID feed failed | @{username} | {type(exc).__name__}: {str(exc)[:200]}")

    # One-shot web_profile_info first. If it refuses, immediately use the feed.
    web = v13__instagram_web_profile_one_shot(loader, username)
    if web:
        # Anonymous posts still use the feed iterator. Merge metadata from web endpoint.
        try:
            if instagram_wait_for_request_slot("Full", f"mobile-feed profile @{username}"):
                feed = v13__instagram_feed_get_json(loader, f"api/v1/feed/user/{web['account_id']}/", {"count": 12})
                result = v13__instagram_profile_from_feed_page(loader, feed, username, "Instagram web_profile_info + mobile feed")
                if result:
                    result.update({k:v for k,v in web.items() if k not in {"_profile","_raw_node"} and v not in (None,"")})
                    result["resolution_method"] = "Instagram web_profile_info one-shot + mobile feed"
                    result["_raw_node_web_profile"] = web.get("_raw_node") or {}
                    return result
        except Exception as exc:
            if isinstance(exc, instagram_TooManyRequestsException):
                # Feed endpoint got a genuine 429; let scheduler see it.
                raise
            instagram_log(f"[resolve/web->feed] feed-by-id failed | @{username} | {type(exc).__name__}: {str(exc)[:240]}")

    # Final anonymous fallback: username feed, once, no hidden retries.
    return v13__instagram_profile_from_feed(loader, username)

