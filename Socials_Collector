            self.conn.commit()

    def insert_raw(self, run_id: int, account_id: str, video_id: str, source: str, data_type: str, payload: Any) -> int:
        raw = payload if isinstance(payload, bytes) else tiktok_compact_json(payload).encode("utf-8", errors="replace")
        packed = tiktok_gzip_bytes(raw)
        digest = tiktok_sha256_bytes(raw)
        with self.lock:
            cur = self.conn.execute(
                "INSERT INTO raw_data(scrape_run_id,account_id,video_id,source,data_type,content_gzip,sha256,captured_at) VALUES(?,?,?,?,?,?,?,?)",
                (run_id, account_id, video_id, source, data_type, sqlite3.Binary(packed), digest, tiktok_now_utc()),
            )
            self.conn.commit()
            return int(cur.lastrowid)

    def insert_formats(self, run_id: int, video_id: str, formats: list, source: str = "yt-dlp") -> int:
        count = 0
        with self.lock:
            for f in formats or []:
                try:
                    self.conn.execute(
                        """INSERT INTO formats(scrape_run_id,video_id,source,format_id,ext,width,height,fps,tbr,filesize,vcodec,acodec,format_note,url,captured_at)
                        VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                        ON CONFLICT(video_id,source,format_id,url) DO UPDATE SET
                            scrape_run_id=excluded.scrape_run_id,width=excluded.width,height=excluded.height,fps=excluded.fps,tbr=excluded.tbr,
                            filesize=excluded.filesize,vcodec=excluded.vcodec,acodec=excluded.acodec,format_note=excluded.format_note,captured_at=excluded.captured_at""",
                        (
                            run_id, video_id, source, f.get("format_id"), f.get("ext"), tiktok_safe_int(f.get("width")), tiktok_safe_int(f.get("height")),
                            tiktok_safe_float(f.get("fps")), tiktok_safe_float(f.get("tbr")), tiktok_safe_int(f.get("filesize")), f.get("vcodec"), f.get("acodec"),
                            f.get("format_note"), f.get("url"), tiktok_now_utc(),
                        ),
                    )
                    count += 1
                except Exception:
                    continue
            self.conn.commit()
        return count

    def insert_captions(self, run_id: int, video_id: str, captions: list) -> int:
        count = 0
        with self.lock:
            for c in captions or []:
                self.conn.execute(
                    """INSERT OR REPLACE INTO captions(scrape_run_id,video_id,language_code,track_type,name,ext,url,content,captured_at)
                    VALUES(?,?,?,?,?,?,?,?,?)""",
                    (run_id, video_id, c.get("language_code"), c.get("track_type"), c.get("name"), c.get("ext"), c.get("url"), c.get("content"), tiktok_now_utc()),
                )
                count += 1
            self.conn.commit()
        return count

    def insert_comments_batch(self, run_id: int, comments: list, source: str) -> int:
        count = 0
        with self.lock:
            for c in comments or []:
                cid = str(c.get("id") or "")
                vid = str(c.get("video_id") or "")
                if not cid or not vid:
                    continue
                self.conn.execute(
                    """INSERT INTO comments(comment_id,scrape_run_id,video_id,parent_comment_id,text,like_count,reply_count,create_time,captured_at,source)
                    VALUES(?,?,?,?,?,?,?,?,?,?)
                    ON CONFLICT(comment_id) DO UPDATE SET
                        scrape_run_id=excluded.scrape_run_id,parent_comment_id=excluded.parent_comment_id,text=excluded.text,
                        like_count=excluded.like_count,reply_count=excluded.reply_count,create_time=excluded.create_time,captured_at=excluded.captured_at,source=excluded.source""",
                    (cid, run_id, vid, c.get("parent_comment_id"), c.get("text"), tiktok_safe_int(c.get("like_count")), tiktok_safe_int(c.get("reply_count")), tiktok_safe_int(c.get("create_time")), tiktok_now_utc(), source),
                )
                count += 1
            self.conn.commit()
        return count

    def record_error(self, run_id: int, account_id: str = "", video_id: str = "", stage: str = "", exc: Optional[BaseException] = None, message: str = "") -> None:
        etype = type(exc).__name__ if exc else "Error"
        msg = message or (str(exc) if exc else "")
        tb = traceback.format_exc() if exc else ""
        with self.lock:
            self.conn.execute(
                "INSERT INTO errors(scrape_run_id,account_id,video_id,stage,error_type,message,traceback,captured_at) VALUES(?,?,?,?,?,?,?,?)",
                (run_id, account_id, video_id, stage, etype, msg, tb, tiktok_now_utc()),
            )
            self.conn.commit()

    def counts(self) -> dict:
        with self.lock:
            def c(table: str) -> int:
                row = self.conn.execute(f"SELECT COUNT(*) AS n FROM {table}").fetchone()
                return int(row["n"] if row else 0)
            return {
                "accounts": c("accounts"), "videos": c("videos"), "ingestion": c("video_ingestion"),
                "snapshots": c("video_snapshots"), "comments": c("comments"), "formats": c("formats"),
                "captions": c("captions"), "raw": c("raw_data"), "errors": c("errors"),
            }

    def log_counts(self, run_id: int, prefix: str = "[db]") -> None:
        x = self.counts()
        tiktok_log(
            f"{prefix} run={run_id} | accounts={x['accounts']} videos={x['videos']} ingestion={x['ingestion']} "
            f"snapshots={x['snapshots']} comments={x['comments']} formats={x['formats']} captions={x['captions']} raw={x['raw']} errors={x['errors']}"
        )


