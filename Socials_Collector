def instagram_resolve_profile(loader: Any, username: str) -> Optional[dict]:
    if not username:
        return None
    if not instagram_wait_for_request_slot("Full", f"profile @{username}"):
        return None
    try:
        profile = instagram_instaloader.Profile.from_username(loader.context, username)
        actual = str(getattr(profile, "username", "") or "")
        if actual.lower() != username.lower():
            instagram_log(f"[resolve] username mismatch | requested=@{username} resolved=@{actual}")
            return None
        a = instagram_profile_to_dict(profile, username, "Instaloader Profile.from_username", True)
        return {**a, "_profile": profile}
    except instagram_ProfileNotExistsException as exc:
        instagram_log(f"[resolve] profile does not exist | @{username}")
        return None
    except instagram_PrivateProfileNotFollowedException as exc:
        instagram_log(f"[resolve] private profile not followed | @{username} | metadata may remain limited")
        try:
            profile = instagram_instaloader.Profile.from_username(loader.context, username)
            a = instagram_profile_to_dict(profile, username, "Instaloader private-profile lookup", True)
            return {**a, "_profile": profile}
        except Exception:
            return None
    except Exception as exc:
        if instagram_is_rate_limit_exception(exc):
            raise
        instagram_log(f"[resolve] FAILED @{username} | {type(exc).__name__}: {exc}")
        return None


def instagram_hours_since_iso(value: Any) -> Optional[float]:
    if not value:
        return None
    try:
        dt = datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return max(0.0, (datetime.now(timezone.utc) - dt).total_seconds() / 3600.0)
    except Exception:
        return None


def instagram_post_age_days(post: dict) -> Optional[float]:
    try:
        ts = int(post.get("published_epoch"))
        return max(0.0, (time.time() - ts) / 86400.0)
    except Exception:
        return None


def instagram_choose_post_action(db: instagram_Database, p: dict, mode: str, force_refresh: bool) -> str:
    if force_refresh:
        return "FORCE"
    state = db.get_post_state(p.get("post_id", ""))
    if not state or not state["last_enriched_at"]:
        return "NEW"
    if state["last_error"]:
        return "RESUME"
    age_hours = instagram_hours_since_iso(state["last_enriched_at"])
    if age_hours is None:
        return "RESUME"
    active = (instagram_post_age_days(p) or 999) <= 30
    refresh = 24.0 if active else 168.0
    if mode == "Maximum":
        heavy = instagram_hours_since_iso(state["last_maximum_refresh_at"])
        if heavy is None or heavy >= 168.0:
            return "HEAVY_REFRESH"
    if age_hours >= refresh:
        return "PERFORMANCE_REFRESH"
    return "SKIP"


