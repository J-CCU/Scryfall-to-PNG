V55_TIKTOK_PROFILE_LIMITED_RETRY_SECONDS = 7 * 24 * 60 * 60


def _v55_tt_preserve_existing_limited(db: tiktok_Database, video_id: str, category: str, run_id: int = 0) -> bool:
    """Keep a terminal limited row terminal without moving its existing retry clock."""
    vid = str(video_id or "")
    if not vid or not _v51_tt_listing_evidence_sufficient(db, vid):
        return False
    _v51_migrate_tiktok(db)
    _v51_tt_persist_limited_evidence(db, int(run_id or 0), vid, str(category or "LIMITED"))
    now_iso = tiktok_now_utc()
    with db.lock:
        db.conn.execute(
            """UPDATE video_ingestion
               SET access_state='COMPLETE_LIMITED',
                   access_reason=COALESCE(NULLIF(access_reason,''),?),
                   access_retry_after=COALESCE(access_retry_after,0),
                   limited_completed_at=COALESCE(limited_completed_at,?),
                   ytdlp_status=CASE WHEN COALESCE(ytdlp_status,'')='SUCCESS' THEN ytdlp_status ELSE 'SUCCESS_LIMITED' END,
                   formats_status=CASE WHEN COALESCE(formats_status,'') IN ('SUCCESS','SUCCESS_EMPTY') THEN formats_status ELSE 'UNAVAILABLE_LIMITED' END,
                   captions_status=CASE WHEN COALESCE(captions_status,'') IN ('SUCCESS','SUCCESS_EMPTY') THEN captions_status ELSE 'UNAVAILABLE_LIMITED' END,
                   enrichment_state='COMPLETE', current_stage='COMPLETE_LIMITED',
                   completeness_audit_status='COMPLETE_LIMITED', last_completeness_audit_at=?
               WHERE video_id=?""",
            (str(category or "LIMITED"), now_iso, now_iso, vid),
        )
        if not tiktok_COLLECT_RESEARCH_COMMENTS:
            db.conn.execute(
                """UPDATE video_ingestion SET comments_status='UNAVAILABLE_NOT_REQUIRED',
                   comments_evidence='NO_AUTHORIZED_THIRD_PARTY_SOURCE',
                   comments_last_source='public_completion_policy'
                   WHERE video_id=? AND COALESCE(comments_status,'') NOT IN ('SUCCESS','SUCCESS_EMPTY')""",
                (vid,),
            )
        db.conn.commit()
    return True


def _v51_tt_reconcile_limited(db: tiktok_Database) -> dict:
    """V55: reconcile the failed tail without resetting COMPLETE_LIMITED retry clocks."""
    _v51_migrate_tiktok(db)
    with db.lock:
        rows = db.conn.execute(
            """SELECT video_id,enrichment_attempts,last_run_id,last_error,access_state,access_reason
               FROM video_ingestion
               WHERE COALESCE(completeness_audit_status,'')<>'COMPLETE'
                  OR COALESCE(enrichment_state,'')<>'COMPLETE'
                  OR COALESCE(access_state,'') IN ('COMPLETE_LIMITED','RETRY_PENDING')"""
        ).fetchall()
    finalized = 0
    deferred = 0
    preserved = 0
    for row in rows:
        d = dict(row)
        vid = str(d.get("video_id") or "")
        if str(d.get("access_state") or "").upper() == "COMPLETE_LIMITED":
            if _v55_tt_preserve_existing_limited(db, vid, str(d.get("access_reason") or "LIMITED"), int(d.get("last_run_id") or 0)):
                preserved += 1
            continue
        category = _v51_tt_error_category(d.get("last_error"))
        if not category or not _v51_tt_listing_evidence_sufficient(db, vid):
            continue
        attempts = int(d.get("enrichment_attempts") or 0)
        if attempts >= V51_TIKTOK_LIMITED_AFTER_ATTEMPTS:
            if _v51_tt_finalize_limited(db, vid, category, int(d.get("last_run_id") or 0)):
                finalized += 1
        else:
            _v51_tt_schedule_retry(db, vid, category)
            deferred += 1
    return {"limited_finalized": finalized, "limited_deferred": deferred, "limited_preserved": preserved}


