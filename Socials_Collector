def tiktok_flatten_subtitle_tracks(info: dict) -> List[dict]:
    rows = []
    for track_type, mapping in (("manual", info.get("subtitles") or {}), ("automatic", info.get("automatic_captions") or {})):
        if not isinstance(mapping, dict):
            continue
        for language, formats in mapping.items():
            if not isinstance(formats, list):
                continue
            for idx, item in enumerate(formats):
                if not isinstance(item, dict):
                    continue
                rows.append(
                    {
                        "language_code": language,
                        "track_type": track_type,
                        "name": item.get("name") or str(idx),
                        "ext": item.get("ext") or "",
                        "url": item.get("url") or "",
                        "content": None,
                    }
                )
    return rows


def tiktok_build_format_rows(info: dict) -> List[dict]:
    out = []
    for f in info.get("formats") or []:
        if isinstance(f, dict):
            out.append(f)
    return out


