    side_clause = "1" if not instagram_COLLECT_SIDECARS else f"COALESCE({i}.sidecar_status,'') IN ('SUCCESS','SUCCESS_EMPTY','SKIPPED','NO_DATA','')"
    return f"""
        {i}.last_enriched_at IS NOT NULL AND COALESCE({i}.last_error,'')=''
        AND COALESCE({i}.instaloader_status,'') IN ('SUCCESS','SUCCESS_EMPTY','NOT_NEEDED_OFFICIAL_GRAPH','SUCCESS_GRAPH','SKIPPED_GRAPH_OBJECT','SKIPPED','NO_DATA')
        AND ({yt_clause}) AND ({side_clause})
        AND COALESCE({i}.formats_status,'') IN ('SUCCESS','SUCCESS_EMPTY','NO_DATA','SKIPPED','')
        AND COALESCE({i}.captions_status,'') IN ('SUCCESS','SUCCESS_EMPTY','NO_DATA','SKIPPED','')
