def _v41_live_db_counts(db_path: Path = youtube_DB_PATH) -> dict:
    if not Path(db_path).exists():
        return {"videos": 0, "complete": 0, "pending": 0, "catalogs_verified": 0, "catalogs_total": 0,
                "comments_complete": 0, "comments_pending": 0}
    conn = sqlite3.connect(str(db_path), timeout=2.0)
    try:
        cols = {r[1] for r in conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        has_audit = "completeness_audit_status" in cols
        total = int(conn.execute("SELECT COUNT(*) FROM video_ingestion").fetchone()[0] or 0)
        if has_audit:
            complete = int(conn.execute(
                "SELECT COUNT(*) FROM video_ingestion "
                "WHERE completeness_audit_status='COMPLETE' AND enrichment_state='COMPLETE'"
            ).fetchone()[0] or 0)
        else:
            complete = int(conn.execute(
                "SELECT COUNT(*) FROM video_ingestion WHERE enrichment_state='COMPLETE'"
            ).fetchone()[0] or 0)
        comments_complete = int(conn.execute(
            "SELECT COUNT(*) FROM video_ingestion WHERE comments_status IN ('SUCCESS','SUCCESS_EMPTY')"
        ).fetchone()[0] or 0)
        channel_cols = {r[1] for r in conn.execute("PRAGMA table_info(channels)").fetchall()}
        catalogs_total = int(conn.execute("SELECT COUNT(*) FROM channels").fetchone()[0] or 0)
        if "catalog_verification_version" in channel_cols:
            catalogs_verified = int(conn.execute(
                "SELECT COUNT(*) FROM channels WHERE index_complete='1' AND catalog_verification_version=?",
                (V39_CATALOG_PROOF_VERSION,),
            ).fetchone()[0] or 0)
        else:
            catalogs_verified = 0
        return {
            "videos": total,
            "complete": complete,
            "pending": max(0, total - complete),
            "catalogs_verified": catalogs_verified,
            "catalogs_total": catalogs_total,
            "comments_complete": comments_complete,
            "comments_pending": max(0, total - comments_complete),
        }
    finally:
        conn.close()


