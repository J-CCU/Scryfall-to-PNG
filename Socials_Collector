def v20_instagram_graph_account(username: str, db: instagram_Database) -> Optional[dict]:
    username = instagram_normalized_username(username)
    if not username or not instagram_instagram_graph_enabled(username=username):
        return None
    data = instagram_graph_profile_info(username, db)
    if not data or not data.get("id"):
        return None
    actual = str(data.get("username") or username)
    return {
        "account_id": str(data.get("id") or ""),
        "username": actual,
        "full_name": str(data.get("name") or ""),
        "biography": str(data.get("biography") or ""),
        "external_url": str(data.get("website") or ""),
        "profile_pic_url": str(data.get("profile_picture_url") or ""),
        "is_private": False,
        "is_verified": False,
        "is_business_account": True,
        "followers": instagram_safe_int(data.get("followers_count")),
        "followees": instagram_safe_int(data.get("follows_count")),
        "media_count": instagram_safe_int(data.get("media_count")),
        "account_url": f"{instagram_INSTAGRAM}/{actual}/",
        "resolution_method": "Meta Graph API primary",
        "resolution_verified": actual.lower() == username.lower(),
        "_graph_mode": True,
        "_graph_raw": data,
        "_profile": None,
    }


def v20_instagram_resolve_profile(loader: Any, username: str) -> Optional[dict]:
    username = instagram_normalized_username(username)
    if not username:
        return None
    db = getattr(loader, "_v13_db", None)
    if db is None:
        db = v19__ACTIVE_IG_DB
    if db is not None and instagram_instagram_graph_enabled(username=username):
        try:
            graph_account = v20_instagram_graph_account(username, db)
            if graph_account:
                instagram_log(f"[resolve/v20] @{username} -> {graph_account['account_id']} [Meta Graph API primary]")
                return graph_account
            instagram_log(f"[resolve/v20] Graph API primary unavailable for @{username}; falling back to public/authenticated strategy")
        except Exception as exc:
            instagram_log(f"[resolve/v20] Graph primary error | @{username} | {type(exc).__name__}: {exc}")
    return v20__instagram_old_resolve_profile(loader, username)


instagram_resolve_profile = v20_instagram_resolve_profile


def v20_instagram_discover_profile_posts(
    self: instagram_Collector,
    run_id: int,
    account: dict,
    limit: int,
    mode: str,
    force_refresh: bool,
) -> Tuple[List[dict], bool]:
    username = str(account.get("username") or "")
    account_id = str(account.get("account_id") or "")
    if account.get("_graph_mode") and instagram_instagram_graph_enabled(username=username, account_id=account_id):
        self.emit(f"  [graph/v20] media catalog PRIMARY START | @{username} | limit={'ALL' if limit<=0 else limit}")
        started = time.monotonic()
        rows = instagram_graph_media_rows(username, self.db, limit=limit)
        for row in rows:
            try:
                self.db.upsert_post(row)
                self.db.register_discovery(run_id, row)
                self.db.insert_raw(run_id, account_id, row.get("post_id", ""), "Meta Graph API", "media", row.get("graph_raw") or {})
            except Exception as exc:
                self.emit(f"  [graph/v20] media persist error | post={row.get('post_id','')} | {type(exc).__name__}: {exc}")
        rows = instagram_unique_by_id(rows, "post_id")
        rows.sort(key=lambda x: instagram_safe_int(x.get("published_epoch")) or 0, reverse=True)
        if limit > 0:
            rows = rows[:limit]
        # Graph pagination is driven by the API; when an unrestricted request returns
        # at least one row we treat the source as the authoritative catalog for this
        # mapped/eligible account and let the normal ingestion backlog handle refreshes.
        complete = bool(limit <= 0 and rows)
        self.emit(f"  [graph/v20] media catalog PRIMARY COMPLETE | rows={len(rows)} | complete={'yes' if complete else 'no'} | elapsed={time.monotonic()-started:.1f}s")
        if rows or instagram_instagram_graph_account_id(username):
            return rows, complete
    return v20__instagram_old_discover_profile_posts(self, run_id, account, limit, mode, force_refresh)


instagram_Collector.discover_profile_posts = v20_instagram_discover_profile_posts


def v20_instagram_enrich_post(
    self: instagram_Collector,
    run_id: int,
    p: dict,
    mode: str,
    action: str,
) -> None:
    username = str(p.get("username") or "")
    account_id = str(p.get("account_id") or "")
    pid = str(p.get("post_id") or "")
    graph_mode = bool(p.get("_graph_mode") or instagram_instagram_graph_enabled(username=username, account_id=account_id))
    if not graph_mode:
        return v20__instagram_old_enrich_post(self, run_id, p, mode, action)

    started = time.monotonic()
    payload = instagram_graph_post_refresh(pid, self.db)
    if payload:
        refreshed = instagram_instagram_graph_normalize(p, payload)
        insights = instagram_graph_post_insights(pid, self.db) if mode == "Maximum" else None
        if insights is not None:
            refreshed["insights"] = insights
        self.db.upsert_post(refreshed)
        self.db.instagram_db_update_instagram_extra(refreshed)
        self.db.insert_raw(run_id, account_id, pid, "Meta Graph API", "media_refresh", payload)

        if instagram_COLLECT_COMMENTS and mode == "Maximum":
            comments = instagram_graph_post_comments(pid, self.db)
            for c in comments:
                raw_id = self.db.insert_raw(run_id, account_id, pid, "Meta Graph API", "comment", c)
                self.db.insert_comment(run_id, pid, c, raw_id)
            self.db.update_post_stage(pid, "comments_status", "SUCCESS" if comments else "SUCCESS_EMPTY")
            self.emit(f"      [graph/v20] comments={len(comments)} | post={pid}")
        else:
            try:
                self.db.update_post_stage(pid, "comments_status", "SKIPPED_COMMENTS_DISABLED")
            except Exception:
                pass

        try:
            self.db.update_post_stage(pid, "instaloader_status", "SUCCESS_GRAPH")
            self.db.update_post_stage(pid, "ytdlp_status", "SKIPPED_GRAPH_PRIMARY")
        except Exception:
            pass
        self.db.upsert_snapshot(run_id, refreshed)
        self.db.mark_enriched(run_id, refreshed, full=True, maximum=(mode == "Maximum"))
        self.emit(f"      [graph/v20] PRIMARY enrichment committed | post={pid} | elapsed={time.monotonic()-started:.1f}s")
        return

    # Graph is an intentional source for this account, but it may temporarily be
    # unavailable for a specific object.  Fall back to per-post yt-dlp only when
    # configured; do not fall back to the broken anonymous profile iterator.
    if instagram_yt_dlp is not None and p.get("post_url"):
        try:
            info = instagram_ytdlp_extract(str(p.get("post_url")), mode)
            if info:
                self.db.insert_raw(run_id, account_id, pid, "yt-dlp", "post_full_info", info)
                self.db.update_post_stage(pid, "instaloader_status", "SKIPPED_GRAPH_OBJECT")
                self.db.update_post_stage(pid, "ytdlp_status", "SUCCESS")
                formats, captions = instagram_instagram_extract_ytdlp_tracks(info)
                if formats:
                    self.db.instagram_db_insert_instagram_formats(run_id, pid, formats)
                if captions:
                    self.db.instagram_db_insert_instagram_captions(run_id, pid, captions)
                self.db.upsert_snapshot(run_id, p)
                self.db.mark_enriched(run_id, p, full=True, maximum=(mode == "Maximum"))
                self.emit(f"      [graph/v20] Graph object unavailable; yt-dlp fallback committed | post={pid}")
                return
        except Exception as exc:
            self.db.record_error(run_id, account_id=account_id, post_id=pid, stage="graph_object_ytdlp_fallback", exc=exc)

    self.db.update_post_stage(pid, "instaloader_status", "GRAPH_OBJECT_UNAVAILABLE")
    self.db.mark_enriched(run_id, p, full=False, maximum=False, error="Graph API object unavailable")
    self.emit(f"      [graph/v20] object unavailable | post={pid}")


instagram_Collector.enrich_post = v20_instagram_enrich_post

# ---------------------------------------------------------------------------
# TikTok V20 source strategy: embedded page -> yt-dlp profile ->
# tiktokuser:<channel_id> -> preserve seed videos from page data.
# ---------------------------------------------------------------------------
v20__tiktok_old_resolve_account = tiktok_resolve_account


def v20_tiktok_resolve_account(username: str, db: tiktok_Database, *, mode: str, force_refresh: bool = False) -> Optional[dict]:
    username = tiktok_normalized_username(username)
    if not username:
        return None

    # Cache remains the cheapest and safest first step.
    if not force_refresh:
        cached = db.cached_account_resolution(username)
        if cached:
            out = {
                "account_id": cached["account_id"],
                "username": cached.get("username") or username,
                "display_name": cached.get("display_name") or "",
                "bio": "",
                "uid": "",
                "sec_uid": cached["account_id"],
                "verified": True,
                "followers": None,
                "following": None,
                "likes": None,
                "video_count": None,
                "avatar_url": "",
                "bio_url": "",
                "account_url": f"{tiktok_TIKTOK}/@{username}",
                "resolution_method": "cached_verified",
                "resolution_verified": True,
            }
            tiktok_log(f"[resolve/v20] @{username} -> {out['account_id']} [verified cache]")
            return out

    url = f"{tiktok_TIKTOK}/@{username}"
    page, status, final_url = tiktok_get_page_details(url)
    if tiktok_is_tiktok_page_throttle(page or "", status):
        tiktok_set_tiktok_rate_limit(db, reason=f"profile page HTTP {status}", pending_account_id=username)
        return None

    candidate: dict = {}
    embedded_videos: List[dict] = []
    raw_json = None
    if page:
        for key in ("SIGI_STATE", "sigi-persisted-data", "__UNIVERSAL_DATA_FOR_REHYDRATION__"):
            obj = tiktok_parse_embedded_json(page, key)
            if obj:
                raw_json = obj
                candidate = tiktok_extract_tiktok_profile_candidate(obj, username)
                embedded_videos = tiktok_merge_tiktok_video_sources(
                    embedded_videos,
                    tiktok_extract_embedded_videos(obj, username),
                    limit=0,
                )
                if candidate and candidate.get("username", "").lower() == username.lower():
                    break

    if candidate and candidate.get("username", "").lower() == username.lower():
        cid = candidate.get("sec_uid") or candidate.get("uid") or candidate.get("username")
        candidate.update({
            "account_id": str(cid),
            "account_url": f"{tiktok_TIKTOK}/@{candidate.get('username') or username}",
            "resolution_method": "embedded profile JSON",
            "resolution_verified": True,
        })
        if embedded_videos:
            candidate["_seed_videos"] = embedded_videos
        tiktok_log(f"[resolve/v20] @{username} -> {cid} [embedded profile JSON]")
        return candidate

    # Direct public yt-dlp profile extraction is still useful, but it is no longer
    # the only strategy.
    if tiktok_yt_dlp is not None and tiktok_wait_for_request_slot(mode, f"profile @{username}"):
        try:
            info = tiktok_ytdlp_extract(url, mode, flat=True, db=db, pending_account_id=username)
            if info:
                entries = info.get("entries") if isinstance(info, dict) else None
                profile_username = info.get("uploader") or info.get("channel") or username
                sec_uid = info.get("channel_id") or info.get("uploader_id") or ""
                if sec_uid or profile_username:
                    account = {
                        "account_id": str(sec_uid or profile_username),
                        "username": str(profile_username),
                        "display_name": info.get("channel") or info.get("uploader") or "",
                        "bio": "",
                        "uid": info.get("uploader_id") or "",
                        "sec_uid": sec_uid,
                        "verified": bool(info.get("channel_is_verified") or info.get("uploader_is_verified")),
                        "followers": tiktok_safe_int(info.get("channel_follower_count") or info.get("uploader_follower_count")),
                        "following": tiktok_safe_int(info.get("channel_following_count") or info.get("uploader_following_count")),
                        "likes": None,
                        "video_count": len(entries) if isinstance(entries, list) else None,
                        "avatar_url": info.get("channel_thumbnail") or info.get("thumbnail") or "",
                        "bio_url": "",
                        "account_url": f"{tiktok_TIKTOK}/@{profile_username}",
                        "resolution_method": "yt-dlp public profile",
                        "resolution_verified": str(profile_username).lower() == username.lower(),
                    }
                    if account["resolution_verified"]:
                        if embedded_videos:
                            account["_seed_videos"] = embedded_videos
                        tiktok_log(f"[resolve/v20] @{username} -> {account['account_id']} [yt-dlp public profile]")
                        return account
        except Exception as exc:
            tiktok_log(f"[resolve/v20] yt-dlp profile failed | @{username} | {type(exc).__name__}: {exc}")
            if tiktok_tiktok_rate_limited():
                return None

    # Current yt-dlp issue guidance explicitly points to tiktokuser:<channel_id>
    # when the profile extractor cannot discover the secondary user ID.  We can
    # use that route whenever the page itself exposed a video containing it.
    channel_id = ""
    if embedded_videos:
        for row in embedded_videos:
            channel_id = str(row.get("channel_id") or "")
            if channel_id:
                break

    if channel_id and tiktok_yt_dlp is not None and tiktok_wait_for_request_slot(mode, f"channel-id fallback @{username}"):
        try:
            info = tiktok_ytdlp_extract(f"tiktokuser:{channel_id}", mode, flat=True, db=db, pending_account_id=username)
            if info:
                entries = info.get("entries") if isinstance(info, dict) else []
                sample = entries[0] if isinstance(entries, list) and entries else {}
                resolved_username = str(
                    info.get("uploader") or info.get("channel") or
                    sample.get("uploader") if isinstance(sample, dict) else ""
                ) or username
                account = {
                    "account_id": channel_id,
                    "username": resolved_username,
                    "display_name": str(info.get("channel") or info.get("uploader") or username),
                    "bio": "",
                    "uid": str(info.get("uploader_id") or channel_id),
                    "sec_uid": channel_id,
                    "verified": bool(info.get("channel_is_verified") or info.get("uploader_is_verified")),
                    "followers": tiktok_safe_int(info.get("channel_follower_count") or info.get("uploader_follower_count")),
                    "following": tiktok_safe_int(info.get("channel_following_count") or info.get("uploader_following_count")),
                    "likes": None,
                    "video_count": len(entries) if isinstance(entries, list) else None,
                    "avatar_url": info.get("channel_thumbnail") or "",
                    "bio_url": "",
                    "account_url": f"{tiktok_TIKTOK}/@{username}",
                    "resolution_method": "tiktokuser:<channel_id> fallback",
                    "resolution_verified": resolved_username.lower() == username.lower() or bool(channel_id),
                }
                if embedded_videos:
                    account["_seed_videos"] = embedded_videos
                tiktok_log(f"[resolve/v20] @{username} -> {channel_id} [tiktokuser:<channel_id> fallback]")
                return account
        except Exception as exc:
            tiktok_log(f"[resolve/v20] tiktokuser:<channel_id> failed | @{username} | {type(exc).__name__}: {exc}")
            if tiktok_tiktok_rate_limited():
                return None

    # Even if no account identity could be proven, do not silently invent one.
    # The actual worker will record a failed resolution rather than corrupting
    # the account table.
    tiktok_log(f"[resolve/v20] FAILED @{username} | no verified profile identity")
    return None


tiktok_resolve_account = v20_tiktok_resolve_account


v20__tiktok_old_discover_videos = tiktok_Collector.discover_videos


def v20_tiktok_discover_videos(
    self: tiktok_Collector,
    run_id: int,
    account: dict,
    limit: int,
    mode: str,
    force_refresh: bool = False,
) -> Tuple[List[dict], bool]:
    seeded = []
    for row in account.get("_seed_videos") or []:
        try:
            normalized = tiktok_normalize_video_info(row, str(account.get("account_id") or ""), str(account.get("username") or ""))
        except Exception:
            normalized = None
        if normalized and normalized.get("video_id"):
            normalized["discovery_source"] = "embedded page JSON"
            seeded.append(normalized)

    old_rows: List[dict] = []
    old_complete = False
    try:
        old_rows, old_complete = v20__tiktok_old_discover_videos(self, run_id, account, limit, mode, force_refresh)
    except Exception as exc:
        self.emit(f"  [discover/v20] primary discovery failed | {type(exc).__name__}: {exc}")

    merged = tiktok_merge_tiktok_video_sources(seeded, old_rows, limit=limit)
    if seeded:
        self.emit(f"  [discover/v20] embedded page seed videos={len(seeded)} | merged={len(merged)}")
        for row in seeded:
            try:
                self.db.upsert_video_listing(row)
                self.db.register_discovery(run_id, row)
                self.db.tiktok_db_update_tiktok_video_extras(row)
                self.db.insert_raw(run_id, str(account.get("account_id") or ""), str(row.get("video_id") or ""), "TikTok public page", "embedded_video_json", row)
            except Exception as exc:
                self.emit(f"  [discover/v20] seed persistence error | video={row.get('video_id','')} | {type(exc).__name__}: {exc}")
    return merged, old_complete or bool(seeded and limit > 0 and len(merged) >= limit)


tiktok_Collector.discover_videos = v20_tiktok_discover_videos


# ---------------------------------------------------------------------------
# Concurrent scheduler.  The old scheduler remains in the file for backwards
# compatibility and its helper functions/self-tests are preserved; V20 replaces
# only the runtime class used by UnifiedApp.
# ---------------------------------------------------------------------------

class UnifiedSchedulerV20:
    def __init__(self, app: "UnifiedApp") -> None:
        self.app = app
        self.stop_event = threading.Event()
        self.wake_event = threading.Event()
        self.thread: Optional[threading.Thread] = None
        self.slot_threads: Dict[str, threading.Thread] = {}
        self.processes: Dict[str, subprocess.Popen] = {}
        self.process_lock = threading.RLock()
        self.current: Optional[UnifiedPlatform] = None  # compatibility: last state transition
        self.current_rate_limited = False
        self.platform_states: Dict[str, str] = {p.key: "READY" for p in UNIFIED_PLATFORMS}
        self.platform_cooldown_until: Dict[str, float] = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.platform_runs: Dict[str, int] = {}
        self.platform_failures: Dict[str, int] = {p.key: 0 for p in UNIFIED_PLATFORMS}
        self.platform_reasons: Dict[str, str] = {p.key: "" for p in UNIFIED_PLATFORMS}
        self.collect_comments_enabled = False
        self.inputs: Dict[str, List[str]] = {}
        self.limit = 0
        self.mode = "Maximum"
        self.force_refresh = False
        self.continuous = False
        self.high_throughput = True
        self.extended_surfaces = True

    @property
    def running(self) -> bool:
        return self.thread is not None and self.thread.is_alive()

    def ui_log(self, msg: str) -> None:
        self.app.enqueue_ui(("log", msg))

    def ui_platform(self, key: str, state: str) -> None:
        self.platform_states[key] = state
        self.app.enqueue_ui(("platform", key, state))

    def ui_cooldown(self, key: str, until: float) -> None:
        self.platform_cooldown_until[key] = max(0.0, until)
        self.app.enqueue_ui(("cooldown", key, max(0.0, until)))

    def start(
        self,
        inputs: Dict[str, List[str]],
        limit: int,
        mode: str,
        force_refresh: bool,
        continuous: bool,
        high_throughput: bool,
        extended_surfaces: bool,
        collect_comments: bool = False,
    ) -> None:
        if self.running:
            return
        if not any(inputs.get(p.key) for p in UNIFIED_PLATFORMS):
            self.ui_log("[multiplatform] No inputs supplied. Add at least one YouTube, Instagram, or TikTok input.\n")
            return

        self.stop_event.clear()
        self.wake_event.clear()
        self.processes.clear()
        self.slot_threads.clear()
        self.current = None
        self.current_rate_limited = False
        self.collect_comments_enabled = bool(collect_comments)
        self.inputs = {p.key: list(inputs.get(p.key) or []) for p in UNIFIED_PLATFORMS}
        self.limit = int(limit)
        self.mode = str(mode)
        self.force_refresh = bool(force_refresh)
        self.continuous = bool(continuous)
        self.high_throughput = bool(high_throughput)
        self.extended_surfaces = bool(extended_surfaces)
        self.platform_runs = {}
        self.platform_failures = {p.key: 0 for p in UNIFIED_PLATFORMS}
        self.platform_reasons = {p.key: "" for p in UNIFIED_PLATFORMS}
        self.platform_cooldown_until = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.platform_states = {p.key: ("READY" if self.inputs.get(p.key) else "EMPTY") for p in UNIFIED_PLATFORMS}

        self.thread = threading.Thread(target=self._main, name="UnifiedSchedulerV20", daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()
        self.wake_event.set()
        with self.process_lock:
            procs = list(self.processes.items())
        if procs:
            self.ui_log(f"[multiplatform] STOP requested; terminating {len(procs)} active platform worker(s).\n")
        for key, proc in procs:
            if proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    try:
                        proc.kill()
                    except Exception:
                        pass
        self.app.root.after(1200, self._force_kill_all)

    def _force_kill_all(self) -> None:
        with self.process_lock:
            procs = list(self.processes.items())
        for _, proc in procs:
            if proc.poll() is None:
                try:
                    proc.kill()
                except Exception:
                    pass

    def _db_runtime_state(self, db_path: Path) -> Dict[str, str]:
        if not db_path.exists():
            return {}
        try:
            conn = sqlite3.connect(str(db_path), timeout=2.0)
            try:
                conn.execute("PRAGMA busy_timeout=2000")
                rows = conn.execute("SELECT key,value FROM runtime_state").fetchall()
                return {str(k): str(v) for k, v in rows}
            finally:
                conn.close()
        except Exception:
            return {}

    def _cooldown_until(self, platform: UnifiedPlatform) -> float:
        state = self._db_runtime_state(platform.db_path)
        keys = list(UNIFIED_COOLDOWN_KEYS.get(platform.key, ()))
        # v20 knows about both rate-limit and access-block keys.
        if platform.key == "instagram":
            keys += ["instagram_access_backoff_until"]
        for key in keys:
            raw = state.get(key)
            if not raw:
                continue
            try:
                value = float(raw)
                if value > time.time():
                    return value
            except Exception:
                pass
        return 0.0

    def _cooldown_kind(self, platform: UnifiedPlatform) -> str:
        state = self._db_runtime_state(platform.db_path)
        if platform.key == "instagram":
            try:
                if float(state.get("instagram_access_backoff_until") or 0) > time.time():
                    return "ACCESS_BLOCKED"
            except Exception:
                pass
        return "COOLDOWN"

    def _wait_until(self, until: float) -> bool:
        while not self.stop_event.is_set() and until > time.time():
            remaining = max(0.0, until - time.time())
            self.wake_event.wait(min(1.0, remaining))
            self.wake_event.clear()
        return not self.stop_event.is_set()

    def _write_job(self, platform: UnifiedPlatform) -> Path:
        payload = {
            "inputs": list(self.inputs.get(platform.key) or []),
            "limit": int(self.limit),
            "mode": str(self.mode),
            "force_refresh": bool(self.force_refresh),
            "collect_comments": bool(self.collect_comments_enabled),
        }
        fd, raw_path = tempfile.mkstemp(prefix=f"social_collector_{platform.key}_", suffix=".json", dir=str(BASE_DIR))
        os.close(fd)
        path = Path(raw_path)
        path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        return path

    def _worker_env(self, platform: UnifiedPlatform) -> Dict[str, str]:
        env = os.environ.copy()
        env["SOCIAL_COLLECTOR_ORCHESTRATED"] = "1"
        env["SOCIAL_COLLECTOR_THROUGHPUT_PROFILE"] = "high" if self.high_throughput else "normal"
        env["SOCIAL_COLLECTOR_EXTENDED_SURFACES"] = "1" if self.extended_surfaces else "0"
        env["SOCIAL_COLLECT_COMMENTS"] = "1" if self.collect_comments_enabled else "0"
        env["SOCIAL_COLLECTOR_V20_BUILD"] = V20_BUILD
        env["SOCIAL_COLLECTOR_SOURCE_STRATEGY"] = v20_strategy_description(platform.key)
        env["PYTHONUNBUFFERED"] = "1"
        env["PYTHONUTF8"] = "1"
        env["PYTHONIOENCODING"] = "utf-8:backslashreplace"
        return env

    def _run_platform_process(self, platform: UnifiedPlatform) -> str:
        inputs = self.inputs.get(platform.key) or []
        if not inputs:
            self.ui_platform(platform.key, "EMPTY")
            return "EMPTY"

        job_path = self._write_job(platform)
        output_tail: List[str] = []
        explicit_pause = False
        explicit_access_block = False
        rc = -1
        proc: Optional[subprocess.Popen] = None
        self.current = platform
        self.current_rate_limited = False
        self.ui_platform(platform.key, "RUNNING")
        self.platform_runs[platform.key] = self.platform_runs.get(platform.key, 0) + 1
        self.ui_log(
            f"\n[multiplatform/v20] >>> {platform.label} | worker_run={self.platform_runs[platform.key]} | "
            f"inputs={len(inputs)} | limit={'ALL' if self.limit <= 0 else self.limit}\n"
        )
        self.ui_log(f"[strategy/{platform.key}] {v20_strategy_description(platform.key)}\n")

        try:
            cmd = [sys.executable, str(Path(__file__).resolve()), "--platform-worker", platform.key, str(job_path)]
            self.ui_log(f"[multiplatform/v20] launch {platform.label} concurrently | high_throughput={'YES' if self.high_throughput else 'NO'}\n")
            proc = subprocess.Popen(
                cmd,
                cwd=str(BASE_DIR),
                env=self._worker_env(platform),
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                bufsize=1,
            )
            with self.process_lock:
                self.processes[platform.key] = proc

            if proc.stdout is not None:
                for raw in proc.stdout:
                    if self.stop_event.is_set():
                        break
                    line = raw.rstrip("\n")
                    output_tail.append(line)
                    if len(output_tail) > 240:
                        output_tail.pop(0)
                    if line.startswith("[PROGRESS]|"):
                        parts = line.split("|", 3)
                        if len(parts) == 4:
                            try:
                                self.app.enqueue_ui(("progress", platform.key, int(parts[1]), int(parts[2]), parts[3]))
                            except Exception:
                                pass
                        # V22 graceful END boundary: progress is emitted only after
                        # the current item has returned from its enrichment/write
                        # path. Stop this platform here, before another item begins.
                        if getattr(self, "graceful_end_requested", False):
                            self.ui_log(f"[control] {platform.label} current item checkpointed; ending worker at item boundary.\n")
                            try:
                                if proc.poll() is None:
                                    proc.terminate()
                            except Exception:
                                pass
                            break
                    self.ui_log(line + "\n")
                    lower = line.lower()

                    is_access_block = platform.key == "instagram" and (
                        "[orchestrator]" in lower and "access-blocked" in lower
                    )
                    is_explicit_throttle = (
                        "[throttle]" in lower and any(p.search(line) for p in platform.throttle_patterns)
                    )
                    is_orchestrator_pause = (
                        "[orchestrator]" in lower and any(p.search(line) for p in platform.throttle_patterns)
                    )
                    is_tiktok_challenge = platform.key == "tiktok" and "challenge/verification" in lower
                    if is_access_block or is_explicit_throttle or is_orchestrator_pause or is_tiktok_challenge:
                        explicit_pause = True
                        explicit_access_block = bool(is_access_block or is_tiktok_challenge)
                        self.current_rate_limited = not explicit_access_block
                        self.platform_reasons[platform.key] = line[:500]
                        # The collector persists its real cooldown before emitting
                        # these markers. Terminate the worker so the other platforms
                        # continue immediately.
                        if proc.poll() is None:
                            try:
                                proc.terminate()
                            except Exception:
                                pass
                        break

            try:
                rc = proc.wait(timeout=5.0) if proc is not None else -1
            except Exception:
                rc = proc.poll() if proc is not None and proc.poll() is not None else -1
        except Exception as exc:
            self.ui_log(f"[multiplatform/v20] {platform.label} worker error: {type(exc).__name__}: {exc}\n")
            self.platform_reasons[platform.key] = f"{type(exc).__name__}: {exc}"[:500]
            rc = -1
        finally:
            with self.process_lock:
                self.processes.pop(platform.key, None)
            try:
                job_path.unlink(missing_ok=True)
            except Exception:
                pass
            self.current = None

        if self.stop_event.is_set() or getattr(self, "graceful_end_requested", False):
            self.ui_platform(platform.key, "STOPPED")
            return "STOPPED"

        until = self._cooldown_until(platform)
        if explicit_access_block:
            if until <= time.time():
                until = time.time() + (900.0 if platform.key == "tiktok" else 600.0)
            self.ui_platform(platform.key, "ACCESS_BLOCKED")
            self.ui_cooldown(platform.key, until)
            self.ui_log(
                f"[multiplatform/v20] {platform.label} PAUSED: access/verification block | "
                f"resume={datetime.fromtimestamp(until, timezone.utc).isoformat()}\n"
            )
            return "ACCESS_BLOCKED"

        if explicit_pause or until > time.time():
            if until <= time.time():
                until = time.time() + 60.0
            self.ui_platform(platform.key, "COOLDOWN")
            self.ui_cooldown(platform.key, until)
            self.ui_log(
                f"[multiplatform/v20] {platform.label} PAUSED: platform cooldown | "
                f"resume={datetime.fromtimestamp(until, timezone.utc).isoformat()}\n"
            )
            return "COOLDOWN"

        if rc == 0:
            self.platform_failures[platform.key] = 0
            self.platform_reasons[platform.key] = ""
            self.ui_platform(platform.key, "COMPLETE")
            self.ui_log(f"[multiplatform/v20] <<< {platform.label} completed successfully\n")
            return "COMPLETE"

        self.platform_failures[platform.key] = self.platform_failures.get(platform.key, 0) + 1
        self.ui_platform(platform.key, "RETRYING")
        return "FAILED"

    def _platform_loop(self, platform: UnifiedPlatform) -> None:
        pre_state, pre_reason = v20_preflight(platform, self.inputs.get(platform.key, []))
        self.platform_reasons[platform.key] = pre_reason
        self.ui_log(f"[preflight/{platform.key}] {pre_state} | {pre_reason}\n")
        if pre_state == "FAILED":
            self.ui_platform(platform.key, "FAILED")
            self.ui_log(f"[preflight/{platform.key}] platform worker not started.\n")
            return

        while not self.stop_event.is_set():
            until = self._cooldown_until(platform)
            if until > time.time():
                kind = self._cooldown_kind(platform)
                self.ui_platform(platform.key, kind)
                self.ui_cooldown(platform.key, until)
                remaining = max(0.0, until - time.time())
                mins, secs = divmod(int(remaining), 60)
                self.ui_log(f"[multiplatform/v20] {platform.label} paused | {mins}m {secs}s remaining | automatic resume enabled\n")
                if not self._wait_until(until):
                    break
                self.ui_log(f"[multiplatform/v20] {platform.label} cooldown expired; restarting worker from persisted checkpoint.\n")

            status = self._run_platform_process(platform)
            if status == "STOPPED":
                break
            if status == "COMPLETE":
                if not self.continuous:
                    break
                self.ui_log(f"[multiplatform/v20] {platform.label} continuous cycle complete; restarting incremental pass.\n")
                if self.stop_event.wait(1.0):
                    break
                self.ui_platform(platform.key, "READY")
                continue
            if status in {"COOLDOWN", "ACCESS_BLOCKED"}:
                continue
            if status == "FAILED":
                failure_n = self.platform_failures.get(platform.key, 1)
                delay = min(V20_RETRY_FAILURE_MAX, V20_RETRY_FAILURE_INITIAL * (2 ** min(failure_n - 1, 4)))
                until = time.time() + delay
                self.ui_platform(platform.key, "RETRYING")
                self.ui_cooldown(platform.key, until)
                self.ui_log(
                    f"[multiplatform/v20] {platform.label} transient worker failure; "
                    f"retrying automatically in {int(delay)}s\n"
                )
                if not self._wait_until(until):
                    break
                continue

        if self.stop_event.is_set():
            self.ui_platform(platform.key, "STOPPED")

    def _main(self) -> None:
        self.ui_log("\n[multiplatform/v20] MASTER SCHEDULER STARTED\n")
        self.ui_log("[multiplatform/v20] Platform workers run CONCURRENTLY; cooldowns are independent.\n")
        self.ui_log(
            f"[multiplatform/v20] mode={self.mode} | limit={'ALL' if self.limit <= 0 else self.limit} | "
            f"continuous={'YES' if self.continuous else 'NO'} | high_throughput={'YES' if self.high_throughput else 'NO'} | "
            f"extended_surfaces={'YES' if self.extended_surfaces else 'NO'} | comments={'ON' if self.collect_comments_enabled else 'OFF'}\n"
        )

        for p in UNIFIED_PLATFORMS:
            if not self.inputs.get(p.key):
                continue
            t = threading.Thread(target=self._platform_loop, args=(p,), name=f"Platform-{p.key}-V20", daemon=True)
            self.slot_threads[p.key] = t
            t.start()
            self.ui_log(f"[multiplatform/v20] STARTED concurrent slot: {p.label}\n")

        try:
            while not self.stop_event.is_set():
                alive = [t.is_alive() for t in self.slot_threads.values()]
                if not alive or not any(alive):
                    break
                self.wake_event.wait(0.5)
                self.wake_event.clear()
        except Exception as exc:
            self.ui_log(f"[multiplatform/v20] scheduler fatal error: {type(exc).__name__}: {exc}\n")
        finally:
            self.current = None
            self.ui_log("[multiplatform/v20] MASTER SCHEDULER STOPPED\n")
            self.app.enqueue_ui(("scheduler_done",))


