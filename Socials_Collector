            if tiktok_COLLECT_CAPTIONS:
                complete = complete and str(r[6] or "") in terminal
            # Comments are an optional Research API supplement; unavailable access is terminal.
            complete = complete and (str(r[7] or "") in terminal or not r[7] or not tiktok_COLLECT_RESEARCH_COMMENTS)
            inferred = "COMPLETE" if complete else ("FAILED" if r[3] else "DISCOVERED")
            db.conn.execute("UPDATE video_ingestion SET enrichment_state=?, checkpoint_at=COALESCE(checkpoint_at,last_enriched_at) WHERE video_id=?", (inferred, r[0]))
        db.conn.commit()


