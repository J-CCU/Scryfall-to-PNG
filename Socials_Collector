def v52_instagram_resolve_profile(loader: Any, username: str) -> Optional[dict]:
    username = instagram_normalized_username(username)
    if not username:
        return None
    db = getattr(loader, "_v13_db", None) or globals().get("v19__ACTIVE_IG_DB")
    _v52_clamp_legacy_public_backoff(db)
    before_public = _v52_public_backoff_until(db)
    result = _v52_ig_resolve_prev(loader, username)
    if result:
        method = str(result.get("resolution_method") or "").lower()
        if "graph" not in method and "business discovery" not in method:
            _v52_note_public_success(db)
        return result
    # Critical recovery path: profile discovery can be unavailable while the DB
    # already contains a verified account identity and thousands of known posts.
    if _v52_public_backoff_until(db) > time.time() or before_public > time.time():
        cached = _v52_cached_account(db, username)
        if cached:
            instagram_log(
                f"[resolve/v52] @{username} -> {cached['account_id']} [cached DB identity; network discovery cooling]"
            )
            return cached
    return None

