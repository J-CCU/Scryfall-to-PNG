        ).fetchall()
        for r in rows:
            state = str(r[1] or "").upper()
            if state in {"COMPLETE", "IN_PROGRESS", "FAILED", "DISCOVERED"}:
                continue
            terminal = {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED", "NO_DATA", "UNAVAILABLE_NO_RESEARCH_ACCESS", "SKIPPED_DISABLED"}
            complete = bool(r[2]) and str(r[4] or "") == "SUCCESS"
            if tiktok_COLLECT_FORMATS:
