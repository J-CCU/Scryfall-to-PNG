# ---------------------------------------------------------------------------
def _v42_ig_comments_terminal(db: instagram_Database, state: dict) -> bool:
    if not instagram_COLLECT_COMMENTS:
        return True
    pid = str(state.get("post_id") or "")
    status = str(state.get("comments_status") or "").upper()
    evidence = str(state.get("comments_evidence") or "").upper()
    with db.lock:
        actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE post_id=?", (pid,)) or 0)
        expected = _v42_scalar(db.conn, "SELECT comments_count FROM posts WHERE post_id=?", (pid,))
    if status == "SUCCESS":
        return actual > 0
    if status == "SUCCESS_EMPTY":
        return evidence in {"GRAPH_PAGINATION_COMPLETE", "INSTALOADER_TRAVERSAL_COMPLETE", "METADATA_ZERO", "LEGACY_METADATA_ZERO"} or (expected is not None and int(expected or 0) == 0)
    return False


def _v42_instagram_payload_complete(db: instagram_Database, state: Optional[dict], maximum: bool = True, require_comments: bool = True) -> bool:
    if not state:
        return False
    d = dict(state)
    pid = str(d.get("post_id") or "")
    if not pid or not d.get("last_enriched_at") or d.get("last_error"):
        return False
    if d.get("instaloader_status") not in {
        "SUCCESS", "SUCCESS_EMPTY", "NOT_NEEDED_OFFICIAL_GRAPH", "SUCCESS_GRAPH",
        "SKIPPED_GRAPH_OBJECT", "SKIPPED", "NO_DATA"
    }:
        return False
    if instagram_COLLECT_YTDLP_ENRICHMENT and d.get("ytdlp_status") not in {
        "SUCCESS", "NO_DATA", "SKIPPED", "SUCCESS_EMPTY", "SKIPPED_GRAPH_PRIMARY"
    }:
        return False
    if instagram_COLLECT_SIDECARS and str(d.get("sidecar_status") or "") not in {
        "SUCCESS", "SUCCESS_EMPTY", "SKIPPED", "NO_DATA", ""
    }:
        return False
    if str(d.get("formats_status") or "") not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED", ""}:
        return False
    if str(d.get("captions_status") or "") not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED", ""}:
        return False
    with db.lock:
        if not db.conn.execute("SELECT 1 FROM post_snapshots WHERE post_id=? LIMIT 1", (pid,)).fetchone():
            return False
        if not db.conn.execute("SELECT 1 FROM raw_data WHERE post_id=? LIMIT 1", (pid,)).fetchone():
            return False
        if str(d.get("sidecar_status") or "") == "SUCCESS" and not db.conn.execute(
            "SELECT 1 FROM sidecar_items WHERE post_id=? LIMIT 1", (pid,)
        ).fetchone():
            return False
    if require_comments and not _v42_ig_comments_terminal(db, d):
        return False
    return True


def _v42_tt_comments_terminal(db: tiktok_Database, state: dict) -> bool:
    if not tiktok_COLLECT_RESEARCH_COMMENTS:
        return True
    vid = str(state.get("video_id") or "")
    status = str(state.get("comments_status") or "").upper()
    evidence = str(state.get("comments_evidence") or "").upper()
    with db.lock:
        actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)) or 0)
        expected = _v42_scalar(db.conn, "SELECT comment_count FROM videos WHERE video_id=?", (vid,))
    if status == "SUCCESS":
        return actual > 0
    if status == "SUCCESS_EMPTY":
        return evidence in {"RESEARCH_API_PAGINATION_COMPLETE", "METADATA_ZERO", "LEGACY_METADATA_ZERO"} or (expected is not None and int(expected or 0) == 0)
    # No Research API access is visible/deferred, not silently complete.
    return False


def _v42_tiktok_payload_complete(db: tiktok_Database, state: Optional[dict], maximum: bool = True, require_comments: bool = True) -> bool:
    if not state:
        return False
    d = dict(state)
    vid = str(d.get("video_id") or "")
    if not vid or not d.get("last_enriched_at") or d.get("last_error") or d.get("ytdlp_status") != "SUCCESS":
        return False
    if maximum and tiktok_COLLECT_FORMATS and d.get("formats_status") not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED"}:
        return False
    if maximum and tiktok_COLLECT_CAPTIONS and d.get("captions_status") not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED"}:
        return False
    with db.lock:
        if not db.conn.execute("SELECT 1 FROM video_snapshots WHERE video_id=? LIMIT 1", (vid,)).fetchone():
            return False
        if not db.conn.execute("SELECT 1 FROM raw_data WHERE video_id=? LIMIT 1", (vid,)).fetchone():
            return False
        if d.get("formats_status") == "SUCCESS" and not db.conn.execute(
            "SELECT 1 FROM formats WHERE video_id=? LIMIT 1", (vid,)
        ).fetchone():
            return False
        if d.get("captions_status") == "SUCCESS" and not db.conn.execute(
            "SELECT 1 FROM captions WHERE video_id=? LIMIT 1", (vid,)
        ).fetchone():
            return False
    if require_comments and not _v42_tt_comments_terminal(db, d):
        return False
    return True


def _v42_refresh_ig_audit(db: instagram_Database, post_id: str) -> bool:
    row = db.get_post_state(str(post_id or ""))
    state = dict(row) if row else {}
    payload = _v42_instagram_payload_complete(db, state, True, require_comments=False)
    comments = _v42_ig_comments_terminal(db, state)
    status = "COMPLETE" if payload and comments else ("MISSING_PAYLOAD_COMMENTS" if not payload and not comments else ("MISSING_PAYLOAD" if not payload else "MISSING_COMMENTS"))
    with db.lock:
        db.conn.execute(
            "UPDATE post_ingestion SET completeness_audit_status=?,last_completeness_audit_at=? WHERE post_id=?",
            (status, instagram_now_utc(), post_id),
        )
        db.conn.commit()
    return status == "COMPLETE"


def _v42_refresh_tt_audit(db: tiktok_Database, video_id: str) -> bool:
    state = db.get_video_state(str(video_id or "")) or {}
    payload = _v42_tiktok_payload_complete(db, state, True, require_comments=False)
