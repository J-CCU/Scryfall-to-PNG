def v13__instagram_profile_from_feed_page(loader: Any, feed: dict, requested_username: str, source_label: str) -> Optional[dict]:
    user = feed.get("user") if isinstance(feed, dict) else None
    if not isinstance(user, dict) or not user.get("pk") or not user.get("username"):
        return None
    actual = str(user.get("username") or "")
    if requested_username and actual.lower() != requested_username.lower():
        instagram_log(f"[resolve/feed] username mismatch | requested=@{requested_username} resolved=@{actual}")
        return None
    node = dict(user)
    node.setdefault("has_blocked_viewer", False)
    node.setdefault("restricted_by_viewer", False)
    node.setdefault("is_unpublished", False)
    node.setdefault("is_supervision_enabled", False)
    node.setdefault("edge_followed_by", {"count": user.get("follower_count")})
    node.setdefault("edge_follow", {"count": user.get("following_count")})
    node.setdefault("edge_owner_to_timeline_media", {"count": user.get("media_count")})
    node["id"] = str(user.get("pk") or user.get("id") or "")
    node["pk"] = str(user.get("pk") or user.get("id") or "")
    try:
        profile = instagram_instaloader.Profile(loader.context, node)
    except Exception as exc:
        instagram_log(f"[resolve/feed] Profile construction failed | @{requested_username} | {type(exc).__name__}: {exc}")
        return None
    iterator = instagram_FeedPostIterator(loader.context, str(user.get("pk")), first_page=feed)
    profile.get_posts = MethodType(lambda _self: iterator, profile)
    return {
        "account_id": str(user.get("pk")),
        "username": actual,
        "full_name": str(user.get("full_name") or user.get("name") or ""),
        "biography": str(user.get("biography") or ""),
        "external_url": str(user.get("external_url") or ""),
        "profile_pic_url": str(user.get("profile_pic_url") or user.get("profile_pic_url_hd") or ""),
        "is_private": bool(user.get("is_private")),
        "is_verified": bool(user.get("is_verified")),
        "is_business_account": bool(user.get("is_business_account")),
        "followers": instagram_safe_int(user.get("follower_count")),
        "followees": instagram_safe_int(user.get("following_count")),
        "media_count": instagram_safe_int(user.get("media_count")),
        "account_url": f"{instagram_INSTAGRAM}/{actual}/",
        "resolution_method": source_label,
        "resolution_verified": True,
        "_raw_node": user,
        "_profile": profile,
    }


