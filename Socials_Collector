def _v45_stage_complete(db: youtube_Database, video_id: str, stage: str) -> bool:
    state = db.get_video_sync(str(video_id)) or {}
    if stage == "heavy":
        return _v45_youtube_payload_complete(db, state, "Maximum")
    if stage == "comments":
        return _v38_comments_complete(db, state)
    return False


_v45_enqueue_prev = _v44_youtube_enqueue

def _v44_youtube_enqueue(db: youtube_Database, video_id: str, stage: str, action: str,
                         run_id: int, priority: int = 0, *, force: bool = False) -> bool:
    vid = str(video_id or "")
    stage = str(stage or "")
    if not vid or stage not in {"heavy", "comments"}:
        return False

    # This is the V44 production bug fix: COMMENT_REPAIR/RESUME must never reopen
    # a heavy job whose payload evidence is already durable. Only explicit FORCE
    # is allowed to invalidate a completed stage.
    if not force and _v45_stage_complete(db, vid, stage):
        _v45_set_work_done(db, vid, stage)
        if stage == "heavy":
            _v38_finalize_video(db, vid)
            _v41_refresh_one_completeness(db, vid)
        return False

    # Finish-first scheduling: if the sibling stage is already complete, this
    # job can turn Finished +1 and therefore outranks work missing both stages.
    boost = 0
    state = db.get_video_sync(vid) or {}
    try:
        if stage == "heavy" and _v38_comments_complete(db, state):
            boost = V45_FINISH_PRIORITY_BOOST
        elif stage == "comments" and _v45_youtube_payload_complete(db, state, "Maximum"):
            boost = V45_FINISH_PRIORITY_BOOST
    except Exception:
        boost = 0
    return _v45_enqueue_prev(db, vid, stage, action, run_id, int(priority or 0) + boost, force=force)


_v45_bootstrap_prev = _v44_bootstrap_youtube_work

def _v44_bootstrap_youtube_work(db: youtube_Database, run_id: int = 0) -> dict:
    _v45_normalize_youtube_persisted_stages(db)
    out = _v45_bootstrap_prev(db, run_id)
    # Re-rank only unfinished jobs in one set-based pass. The audit column was
    # refreshed before bootstrap and identifies jobs that can immediately finish
    # the item once their missing sibling stage succeeds.
    with db.lock:
        db.conn.execute("""
            UPDATE youtube_work_queue
            SET priority=priority+?
            WHERE stage='heavy' AND state IN ('PENDING','RETRY')
              AND video_id IN (SELECT video_id FROM video_ingestion WHERE completeness_audit_status='MISSING_PAYLOAD')
              AND priority<?
        """, (V45_FINISH_PRIORITY_BOOST, V45_FINISH_PRIORITY_BOOST))
        db.conn.execute("""
            UPDATE youtube_work_queue
            SET priority=priority+?
            WHERE stage='comments' AND state IN ('PENDING','RETRY')
              AND video_id IN (SELECT video_id FROM video_ingestion WHERE completeness_audit_status='MISSING_COMMENTS')
              AND priority<?
        """, (V45_FINISH_PRIORITY_BOOST, V45_FINISH_PRIORITY_BOOST))
        db.conn.commit()
    return out


