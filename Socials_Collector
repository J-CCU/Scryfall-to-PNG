        "resolution_method": method,
        "resolution_verified": verified,
        "_raw_node": instagram_object_node(profile),
    }


def instagram_post_to_dict(post: Any, account_id: str, username: str) -> dict:
    taken = getattr(post, "date_utc", None) or getattr(post, "date_local", None)
    epoch = None
    try:
        if taken:
            epoch = int(taken.replace(tzinfo=timezone.utc).timestamp()) if getattr(taken, "tzinfo", None) is None else int(taken.timestamp())
    except Exception:
        pass
    loc = None
    try:
        loc = getattr(post, "location", None)
    except Exception:
        loc = None
    loc_name = str(getattr(loc, "name", "") or "") if loc else ""
    loc_id = str(getattr(loc, "id", "") or "") if loc else ""
    lat = instagram_safe_float(getattr(loc, "lat", None)) if loc else None
    lng = instagram_safe_float(getattr(loc, "lng", None)) if loc else None
    shortcode = str(getattr(post, "shortcode", "") or "")
    typename = str(getattr(post, "typename", "") or "")
    is_video = bool(getattr(post, "is_video", False))
    return {
        "post_id": str(getattr(post, "mediaid", "") or "") or shortcode,
        "shortcode": shortcode,
        "account_id": account_id,
        "username": username,
        "typename": typename,
        "taken_at": instagram_iso_from_dt(taken),
        "published_epoch": epoch,
        "caption": str(getattr(post, "caption", "") or ""),
        "likes": instagram_safe_int(getattr(post, "likes", None)),
        "comments_count": instagram_safe_int(getattr(post, "comments", None)),
        "video_view_count": instagram_safe_int(getattr(post, "video_view_count", None)),
        "video_duration": instagram_safe_float(getattr(post, "video_duration", None)),
        "width": instagram_safe_int(getattr(post, "width", None)),
        "height": instagram_safe_int(getattr(post, "height", None)),
        "is_video": "YES" if is_video else "NO",
        "is_sponsored": "YES" if bool(getattr(post, "is_sponsored", False)) else "NO",
        "is_pinned": "YES" if bool(getattr(post, "is_pinned", False)) else "NO",
        "display_url": str(getattr(post, "url", "") or ""),
        "video_url": str(getattr(post, "video_url", "") or "") if is_video else "",
        "thumbnail_url": str(getattr(post, "url", "") or ""),
        "accessibility_caption": str(getattr(post, "accessibility_caption", "") or ""),
        "location_name": loc_name,
        "location_lat": lat,
        "location_lng": lng,
        "location_id": loc_id,
        "tagged_users": [getattr(u, "username", str(u)) for u in (getattr(post, "tagged_users", []) or [])],
        "sponsor_users": [getattr(u, "username", str(u)) for u in (getattr(post, "sponsor_users", []) or [])],
        "post_url": instagram_canonical_post_url(shortcode, typename),
        "_raw_node": instagram_object_node(post),
    }


