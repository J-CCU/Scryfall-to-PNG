# COLLECTOR ENGINE
# ============================================================================


class tiktok_Collector:
    def __init__(self, db: tiktok_Database, log_callback: Optional[Callable[[str], None]] = None, progress_callback: Optional[Callable[[int, int, str], None]] = None):
        self.db = db
        self.log_callback = log_callback
        self.progress_callback = progress_callback
        self.last_run_id: Optional[int] = None
        self.current_account_id = ""
        self.current_username = ""

    def emit(self, message: str) -> None:
        tiktok_log(message)
        if self.log_callback:
            self.log_callback(message + "\n")

    def progress(self, current: int, total: int, phase: str) -> None:
        if self.progress_callback:
            self.progress_callback(current, total, phase)

    def save_account_page(self, run_id: int, account: dict) -> dict:
        username = account["username"]
        page_url = f"{tiktok_TIKTOK}/@{username}"
        self.emit(f"  [account metadata] fetching @{username} page...")
        start = time.time()
        page, status, final_url = tiktok_get_page_details(page_url)
        self.emit(f"  [account metadata] page finished in {time.time()-start:.1f}s | HTTP {status}")
        if tiktok_is_tiktok_page_throttle(page or "", status):
            reason = f"account metadata page HTTP {status}" if status else "account metadata page throttle/challenge"
            tiktok_set_tiktok_rate_limit(self.db, reason=reason, pending_account_id=account.get("account_id", ""))
        raw_html_id = self.db.insert_raw(run_id, account["account_id"], "", "tiktok", "account_html", page or "") if page is not None else None
        raw_json = None
        if page:
            raw_json = tiktok_parse_embedded_json(page, "SIGI_STATE") or tiktok_parse_embedded_json(page, "sigi-persisted-data") or tiktok_parse_embedded_json(page, "__UNIVERSAL_DATA_FOR_REHYDRATION__")
            if raw_json is not None:
                raw_json_id = self.db.insert_raw(run_id, account["account_id"], "", "tiktok", "account_embedded_json", raw_json)
                parsed = tiktok_extract_tiktok_profile_candidate(raw_json, username)
                if parsed:
                    account.update({k: v for k, v in parsed.items() if v not in (None, "")})
        else:
            raw_json_id = None
        account["account_url"] = final_url or page_url
        self.db.upsert_account(account)
        self.db.account_snapshot(run_id, account, raw_html_id, raw_json_id)
        self.emit(f"  [db] account snapshot committed | @{account['username']} | raw_html={raw_html_id or 'none'} raw_json={raw_json_id or 'none'}")
        self.db.log_counts(run_id, prefix="  [db] after account commit")
        return account

    def discover_videos(self, run_id: int, account: dict, limit: int, mode: str, force_refresh: bool) -> Tuple[List[dict], bool]:
        username = account["username"]
        account_id = account["account_id"]
        indexed = self.db.account_is_indexed(account_id)
        full_catalog = bool(limit <= 0 and (force_refresh and tiktok_FORCE_FULL_DISCOVERY_WITH_ALL or not indexed))
        discovery_limit = 0 if full_catalog else (limit if limit > 0 else tiktok_INCREMENTAL_DISCOVERY_WINDOW)
        self.emit(
            f"  [discovery] yt-dlp profile START | @{username} | "
            f"window={'ALL' if discovery_limit <= 0 else discovery_limit} | full_catalog={'yes' if full_catalog else 'no'}"
        )
        if tiktok_tiktok_rate_limited():
            if not tiktok_wait_for_tiktok_cooldown(self.db):
                return [], False
        if not tiktok_wait_for_request_slot(mode, f"profile @{username}"):
            return [], False
        start = time.time()
        rows: List[dict] = []
        complete = False
        url = f"{tiktok_TIKTOK}/@{username}"
        try:
            info = tiktok_ytdlp_extract(url, mode, flat=True, db=self.db, pending_account_id=account_id)
            if info:
                if isinstance(info, dict) and info.get("entries") is not None:
                    entries = info.get("entries") or []
                    for entry in entries:
                        if tiktok_stop_requested():
                            break
                        if not isinstance(entry, dict):
                            continue
                        vid = str(entry.get("id") or "")
                        if not vid:
                            continue
                        v = tiktok_normalize_video_info(entry, account_id, username)
                        if not v.get("title"):
                            v["title"] = entry.get("title") or f"TikTok video {vid}"
                        rows.append(v)
                        if discovery_limit > 0 and len(rows) >= discovery_limit:
                            break
                    # If no playlist metadata says it's incomplete, treat ALL extraction as complete.
                    complete = full_catalog and discovery_limit <= 0
                else:
                    v = tiktok_normalize_video_info(info, account_id, username)
                    if v.get("video_id"):
                        rows.append(v)
        except Exception as exc:
            text = str(exc)
            if tiktok_is_tiktok_rate_limit_text(text):
                tiktok_set_tiktok_rate_limit(self.db, reason=text, pending_account_id=account_id)
            else:
                self.db.record_error(run_id, account_id=account_id, stage="video_discovery", exc=exc)
                self.emit(f"  [discovery] yt-dlp error | {type(exc).__name__}: {exc}")
        # Fallback to recent embedded videos from the profile page for cases where
        # yt-dlp cannot extract a secondary user ID.
        if not rows:
            page, status, _ = tiktok_get_page_details(url)
            if status == 429:
                tiktok_set_tiktok_rate_limit(self.db, reason="profile fallback HTTP 429", pending_account_id=account_id)
            elif page:
                data = tiktok_parse_embedded_json(page, "SIGI_STATE") or tiktok_parse_embedded_json(page, "__UNIVERSAL_DATA_FOR_REHYDRATION__")
                rows = [tiktok_normalize_video_info(x, account_id, username) for x in tiktok_extract_embedded_videos(data, username)] if data else []
                rows = [r for r in rows if r.get("video_id")]
                complete = False
                if rows:
                    self.emit(f"  [discovery] page JSON fallback found {len(rows)} recent videos")
        rows = tiktok_unique_by_id(rows, "video_id")
        if discovery_limit > 0:
            rows = rows[:discovery_limit]
        self.emit(f"  [discovery] yt-dlp profile COMPLETE | videos={len(rows)} | complete={'yes' if complete else 'no'} | elapsed={time.time()-start:.1f}s")
        return rows, complete

    def enrich_video(self, run_id: int, video: dict, mode: str, action: str) -> None:
        vid = video["video_id"]
        account_id = video.get("account_id", "")
        username = video.get("username", "")
        self.emit(f"    [stage] {action} | {vid} | {video.get('title','')[:110]}")
        if tiktok_tiktok_rate_limited():
            if not tiktok_wait_for_tiktok_cooldown(self.db, pending_video_id=vid):
                return
        if not tiktok_wait_for_request_slot(mode, f"video {vid}"):
            return
        start = time.time()
        self.db.mark_stage(vid, "ytdlp", "START")
        try:
            info = tiktok_ytdlp_extract(
                video.get("video_url") or tiktok_video_url(vid, username),
                mode,
                flat=False,
                db=self.db,
                pending_video_id=vid,
                pending_account_id=account_id,
            )
            if not info:
                self.db.mark_stage(vid, "ytdlp", "NO_DATA")
                self.db.mark_enrichment(run_id, video, full=True, maximum=(mode == "Maximum"), error="yt-dlp returned no info")
                self.emit(f"      [yt-dlp] NO DATA | elapsed={time.time()-start:.1f}s")
                return

            full = tiktok_normalize_video_info(info, account_id, username)
            # Keep any better values from discovery if the full extraction omitted them.
            for key in ("title", "description", "published_at", "timestamp", "view_count", "like_count", "comment_count", "repost_count", "save_count", "cover_url"):
                if full.get(key) in (None, "") and video.get(key) not in (None, ""):
                    full[key] = video.get(key)
            self.db.insert_raw(run_id, account_id, vid, "yt-dlp", "video_full_info", info)
            self.db.upsert_full_video(full)
            self.db.mark_stage(vid, "ytdlp", "SUCCESS")
            self.emit(f"      [db] raw_data + videos committed | video={vid}")

            if tiktok_COLLECT_FORMATS:
                formats = tiktok_build_format_rows(info)
                count = self.db.insert_formats(run_id, vid, formats, "yt-dlp")
                self.db.mark_stage(vid, "formats", "SUCCESS" if count or formats == [] else "SUCCESS_EMPTY")
                self.emit(f"      [maximum/yt-dlp] formats={count}")

            if tiktok_COLLECT_CAPTIONS:
                captions = tiktok_flatten_subtitle_tracks(info)
                count = self.db.insert_captions(run_id, vid, captions)
                self.db.mark_stage(vid, "captions", "SUCCESS" if count else "SUCCESS_EMPTY")
                self.emit(f"      [maximum/yt-dlp] caption_tracks={count}")

            if tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN and tiktok_COLLECT_RESEARCH_COMMENTS:
                self.emit(f"      [maximum/research] comments START | video={vid} | unlimited pagination")
                comments = tiktok_research_comments(vid, self.db)
                inserted = self.db.insert_comments_batch(run_id, comments, "TikTok Research API")
                self.db.mark_stage(vid, "comments", "SUCCESS" if inserted else "SUCCESS_EMPTY")
                self.emit(f"      [db] comments batch UPSERT | rows={inserted} | video={vid} | source=TikTok Research API")
                self.emit(f"      [maximum/research] comments COMPLETE | collected={len(comments)}")
            else:
                if tiktok_COLLECT_RESEARCH_COMMENTS:
                    self.db.mark_stage(vid, "comments", "UNAVAILABLE_NO_RESEARCH_ACCESS")
                    self.emit("      [comments] unavailable | TikTok Research API token not configured/approved")
                else:
                    self.db.mark_stage(vid, "comments", "SKIPPED_COMMENTS_DISABLED")
                    self.emit("      [comments] skipped | toggle=OFF")

            self.db.insert_snapshot(run_id, full)
            self.db.mark_enrichment(run_id, full, full=True, maximum=(mode == "Maximum"))
            self.emit(f"      [db] video_snapshot + ingestion committed | video={vid}")
            self.emit(f"      [stage] complete | yt-dlp=SUCCESS | elapsed={time.time()-start:.1f}s")
            self.db.log_counts(run_id, prefix="      [db] after video commit")
        except Exception as exc:
            text = str(exc)
            if tiktok_is_tiktok_rate_limit_text(text):
                self.db.record_error(run_id, account_id=account_id, video_id=vid, stage="yt-dlp", exc=exc)
                tiktok_set_tiktok_rate_limit(self.db, reason=text, pending_video_id=vid, pending_account_id=account_id)
                self.db.mark_stage(vid, "ytdlp", "RATE_LIMITED")
                self.db.mark_enrichment(run_id, video, full=False, maximum=False, error="RATE_LIMITED")
                self.emit(f"      [yt-dlp] RATE LIMITED | video={vid} | saved as pending retry")
                return
            if tiktok_is_challenge_text(text):
                self.db.record_error(run_id, account_id=account_id, video_id=vid, stage="yt-dlp", exc=exc)
                self.db.mark_stage(vid, "ytdlp", "CHALLENGE")
                self.db.mark_enrichment(run_id, video, full=False, maximum=False, error="CHALLENGE")
                self.emit(f"      [yt-dlp] CHALLENGE/VERIFICATION | video={vid} | saved as incomplete")
                return
            self.db.record_error(run_id, account_id=account_id, video_id=vid, stage="yt-dlp", exc=exc)
            self.db.mark_stage(vid, "ytdlp", "ERROR")
            self.db.mark_enrichment(run_id, video, full=False, maximum=False, error=text[:1000])
            self.emit(f"      [yt-dlp] ERROR | {type(exc).__name__}: {exc}")

    def run(self, inputs: list, limit: int, mode: str, force_refresh: bool = False) -> int:
        _surface_ensure_schema(self.db)
        run_id = self.db.begin_run(mode, limit, inputs)
        self.last_run_id = run_id
        self.emit(
            f"[run] {run_id} | platform=TikTok | mode={mode} | limit={'ALL' if limit <= 0 else limit} | "
            f"incremental=yes | force_refresh={'yes' if force_refresh else 'no'} | yt-dlp={'available' if tiktok_yt_dlp else 'MISSING'}"
        )
        self.emit(f"[config] database={tiktok_DB_PATH}")
        self.emit(f"[config] yt-dlp TikTok extractor={'AVAILABLE' if tiktok_yt_dlp else 'MISSING'}")
        self.emit(f"[config] rate policy: {tiktok_policy_text(mode)} (collector policy; not an official TikTok limit)")
        self.emit(f"[config] formats={'ON' if tiktok_COLLECT_FORMATS else 'OFF'} | captions={'ON' if tiktok_COLLECT_CAPTIONS else 'OFF'}")
        self.emit(
            f"[config] Research API={'ON' if bool(tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN) else 'OFF'} | "
            f"Research comments={'ON' if bool(tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN and tiktok_COLLECT_RESEARCH_COMMENTS) else 'OFF'}"
        )
        self.emit(f"[config] extended surfaces: {'ON' if tiktok_COLLECT_EXTENDED_SURFACES and mode == 'Maximum' else 'OFF'} | pinned=ON | liked=ON | reposted=ON")
        if not tiktok_yt_dlp:
            self.db.finish_run(run_id, "FAILED", "yt-dlp is not installed")
            self.emit("[run] FATAL: yt-dlp is not installed")
            return run_id
        tiktok_load_tiktok_rate_limit(self.db)
        if tiktok_COLLECT_RESEARCH_API and (tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN or (tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET)):
            tiktok_ensure_research_access_token(self.db)
        if tiktok_tiktok_rate_limited():
            if not tiktok_wait_for_tiktok_cooldown(self.db):
                self.db.finish_run(run_id, "STOPPED", "Stopped during TikTok cooldown")
                return run_id

        processed_account_ids = set()
        try:
            unique_inputs = list(dict.fromkeys(str(x).strip() for x in inputs if str(x).strip()))
            total_inputs = len(unique_inputs)
            for input_idx, original in enumerate(unique_inputs, 1):
                if tiktok_stop_requested():
                    self.db.finish_run(run_id, "STOPPED", "Stop requested")
                    self.emit("[run] STOPPED")
                    return run_id
                kind, normalized = tiktok_normalize_input(original)
                self.emit(f"\n[resolve {input_idx}/{total_inputs}] Checking: {original}")
                account: Optional[dict] = None
                if kind == "video_url":
                    try:
                        if not tiktok_wait_for_request_slot(mode, f"video input {original}"):
                            continue
                        info = tiktok_ytdlp_extract(normalized, mode, flat=False, db=self.db)
                        if info:
                            account = {
                                "account_id": str(info.get("channel_id") or info.get("uploader_id") or info.get("uploader") or ""),
                                "username": str(info.get("uploader") or tiktok_username_from_url(normalized) or ""),
                                "display_name": str(info.get("channel") or ""),
                                "bio": "", "uid": info.get("uploader_id") or "", "sec_uid": info.get("channel_id") or "",
                                "verified": False, "followers": None, "following": None, "likes": None, "video_count": None,
                                "avatar_url": info.get("channel_thumbnail") or "", "bio_url": "",
                                "account_url": f"{tiktok_TIKTOK}/@{info.get('uploader')}" if info.get("uploader") else "",
                                "resolution_method": "video extractor", "resolution_verified": bool(info.get("channel_id") or info.get("uploader")),
                            }
                            self.emit(f"  Resolution OK from video | @{account['username']} -> {account['account_id']}")
                            seed_video = tiktok_normalize_video_info(info, account["account_id"], account["username"])
                        else:
                            seed_video = None
                    except Exception as exc:
                        seed_video = None
                        self.db.record_error(run_id, stage="resolve_video_input", exc=exc)
                        self.emit(f"  Resolution FAILED | {type(exc).__name__}: {exc}")
                        if tiktok_tiktok_rate_limited():
                            self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle during video input resolution")
                            self.emit("[orchestrator] TikTok throttle detected during video input resolution; yielding to scheduler")
                            return run_id
                    if tiktok_tiktok_rate_limited():
                        self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle during video input resolution")
                        self.emit("[orchestrator] TikTok throttle detected during video input resolution; yielding to scheduler")
                        return run_id
                else:
                    username = normalized if kind == "username" else tiktok_username_from_url(normalized)
                    account = tiktok_resolve_account(username, self.db, mode=mode, force_refresh=force_refresh)
                    seed_video = None
                    if tiktok_tiktok_rate_limited():
                        self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle during account resolution")
                        self.emit("[orchestrator] TikTok throttle detected during account resolution; yielding to scheduler")
                        return run_id
                    if account:
                        self.emit(f"  Resolution OK | @{account['username']} -> {account['account_id']} | {account['resolution_method']}")
                    else:
                        self.db.record_error(run_id, stage="resolve_account", message=f"Could not resolve {original}")
                        self.db.record_account_input(run_id, original, normalized, kind, "", username, "unresolved", False, False)
                        self.emit(f"  Resolution FAILED | {original}")
                        continue

                account_id = account["account_id"]
                duplicate = account_id in processed_account_ids
                self.db.record_account_input(
                    run_id, original, normalized, kind, account_id, account.get("username", ""),
                    account.get("resolution_method", ""), bool(account.get("resolution_verified")), duplicate
                )
                if duplicate:
                    self.emit(f"  [dedupe] account already processed this run | {account_id}")
                    continue
                processed_account_ids.add(account_id)
                self.current_account_id = account_id
                self.current_username = account.get("username", "")

                # Optional official Research API profile supplement.
                if tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN:
                    try:
                        research_profile = tiktok_research_user_info(account["username"], self.db)
                        if research_profile:
                            account.update(
                                {
                                    "display_name": research_profile.get("display_name") or account.get("display_name"),
                                    "bio": research_profile.get("bio_description") or account.get("bio"),
                                    "avatar_url": research_profile.get("avatar_url") or account.get("avatar_url"),
                                    "verified": research_profile.get("is_verified") if research_profile.get("is_verified") is not None else account.get("verified"),
                                    "followers": research_profile.get("follower_count") if research_profile.get("follower_count") is not None else account.get("followers"),
                                    "following": research_profile.get("following_count") if research_profile.get("following_count") is not None else account.get("following"),
                                    "likes": research_profile.get("likes_count") if research_profile.get("likes_count") is not None else account.get("likes"),
                                    "video_count": research_profile.get("video_count") if research_profile.get("video_count") is not None else account.get("video_count"),
                                    "bio_url": research_profile.get("bio_url") or account.get("bio_url"),
                                }
                            )
                            self.emit("  [research] account info supplement received")
                    except Exception as exc:
                        self.db.record_error(run_id, account_id=account_id, stage="research_user_info", exc=exc)

                account = self.save_account_page(run_id, account)
                if tiktok_tiktok_rate_limited():
                    self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle during account metadata")
                    self.emit("[orchestrator] TikTok throttle detected during account metadata; yielding to scheduler")
                    return run_id
                self.emit(f"\n[channel {input_idx}] Processing: @{account['username']}")
                self.emit(f"  Account ID: {account_id}")
                if account.get("followers") is not None:
                    self.emit(f"  Followers: {account.get('followers')}")
                if account.get("video_count") is not None:
                    self.emit(f"  Reported video count: {account.get('video_count')}")

                if seed_video:
                    self.db.upsert_video_listing(seed_video)
                    self.db.register_discovery(run_id, seed_video)
                    self.emit(f"  [videos] seed video persisted | {seed_video['video_id']} | {seed_video.get('title','')}")
                    discovered = [seed_video]
                    complete = False
                else:
                    self.emit(f"  Indexing: {'full-index' if (limit <= 0 and (force_refresh or not self.db.account_is_indexed(account_id))) else 'incremental-index'}")
                    discovered, complete = self.discover_videos(run_id, account, limit, mode, force_refresh)
                    if tiktok_tiktok_rate_limited():
                        self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle during video discovery")
                        self.emit("[orchestrator] TikTok throttle detected during video discovery; yielding to scheduler")
                        return run_id

                for n, v in enumerate(discovered, 1):
                    if tiktok_stop_requested():
                        break
                    self.db.upsert_video_listing(v)
                    self.db.register_discovery(run_id, v)
                    self.emit(f"    [discover {n}/{len(discovered)}] {v['video_id']} | {tiktok_iso_from_timestamp(v.get('timestamp')) or '?'} | {v.get('title','')[:120]}")
                if not seed_video:
                    self.db.update_index(account_id, complete=complete, count=self._indexed_count(account_id), discovered=len(discovered))

                # Full historical baseline plus backlog. For incremental runs, newly discovered first,
                # then older incomplete videos.
                queue_rows = list(discovered)
                if limit <= 0 and not force_refresh:
                    existing_backlog = self.db.get_backlog(account_id, tiktok_BACKLOG_ENRICHMENT_BATCH)
                    known = {v.get("video_id") for v in queue_rows}
                    queue_rows.extend(v for v in existing_backlog if v.get("video_id") not in known)

                queue_rows = v16__sort_tiktok_queue(queue_rows)
                self.emit(f"  [videos] {len(queue_rows)} videos queued for enrichment on this account")
                total_queue = len(queue_rows)
                for n, v in enumerate(queue_rows, 1):
                    if tiktok_stop_requested():
                        break
                    action = tiktok_choose_video_action(self.db, v, mode, force_refresh)
                    if action == "SKIP":
                        self.emit(f"    [{n}/{total_queue}] {v.get('video_id')} | SKIP | already complete/not due")
                        continue
                    self.emit(f"    [{n}/{total_queue}] {v.get('video_id')} | {action}")
                    self.progress(n, max(total_queue, 1), f"@{account['username']} videos")
                    self.enrich_video(run_id, v, mode, action)
                    if tiktok_tiktok_rate_limited():
                        if tiktok_ORCHESTRATED_RUN:
                            self.db.finish_run(run_id, "STOPPED", "Stopped after TikTok throttle; pending item retained for scheduler retry")
                            self.emit(
                                f"[orchestrator] TikTok throttle detected; yielding to scheduler | "
                                f"retry_video={v.get('video_id') or 'none'}"
                            )
                            return run_id
                        if not tiktok_wait_for_tiktok_cooldown(self.db, pending_video_id=v.get("video_id", "")):
                            self.db.finish_run(run_id, "STOPPED", "Stopped during TikTok rate-limit cooldown")
                            self.emit("[run] STOPPED during cooldown")
                            return run_id
                        self.emit(f"[throttle] RETRYING PRIORITY VIDEO FIRST | {v.get('video_id')}")
                        self.enrich_video(run_id, v, mode, "PRIORITY_RETRY")
                if tiktok_COLLECT_EXTENDED_SURFACES and mode == "Maximum" and not tiktok_stop_requested():
                    tiktok_collect_extended_surfaces(self, run_id, account, limit, mode)

                if tiktok_stop_requested():
                    self.db.finish_run(run_id, "STOPPED", "Stop requested")
                    self.emit("[run] STOPPED")
                    return run_id

            self.db.finish_run(run_id, "COMPLETE", f"Processed {len(processed_account_ids)} unique accounts")
            self.emit(f"\n[run] COMPLETE | run_id={run_id} | unique_accounts={len(processed_account_ids)}")
            self.db.log_counts(run_id, prefix="[db] final")
            return run_id
        except Exception as exc:
            self.db.record_error(run_id, stage="run", exc=exc)
            self.db.finish_run(run_id, "FAILED", str(exc)[:1000])
            self.emit(f"[run] FATAL: {type(exc).__name__}: {exc}")
            self.emit(traceback.format_exc())
            return run_id

    def _indexed_count(self, account_id: str) -> int:
        with self.db.lock:
            row = self.db.conn.execute("SELECT COUNT(*) AS n FROM video_ingestion WHERE account_id=?", (account_id,)).fetchone()
            return int(row["n"] if row else 0)


