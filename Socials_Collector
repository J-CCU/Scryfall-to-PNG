def youtube_ytdlp_base_opts(maximum: bool = False, *, use_cookies: bool = True) -> dict:
    opts = {
        "quiet": True,
        "no_warnings": True,
        "ignoreerrors": True,
        "skip_download": True,
        "socket_timeout": youtube_REQUEST_TIMEOUT,
        "sleep_interval_requests": 1.0 if (maximum and youtube_USE_YOUTUBE_DATA_API_ACCELERATOR) else (youtube_YT_DLP_MAXIMUM_REQUEST_SLEEP if maximum else youtube_YT_DLP_REQUEST_SLEEP),
        "noplaylist": False,
        "extract_flat": True,
        "cachedir": False,
    }

    # YouTube extraction now uses an external JS runtime for challenge solving.
    # Pass Deno explicitly because GUI-launched apps on macOS may not inherit
    # the user's shell PATH. yt-dlp's Python API accepts this mapping directly.
    if youtube_YTDLP_DENO_PATH:
        opts["js_runtimes"] = {"deno": {"path": str(youtube_YTDLP_DENO_PATH)}}
        if not youtube_YTDLP_EJS_AVAILABLE:
            opts["remote_components"] = ["ejs:npm"]
    if use_cookies and youtube_YTDLP_COOKIEFILE and youtube_YTDLP_COOKIEFILE.exists():
        opts["cookiefile"] = str(youtube_YTDLP_COOKIEFILE)
    return opts


def youtube_short_surface_url(channel_id: str) -> str:
    return f"{youtube_YOUTUBE}/channel/{channel_id}/shorts"


def youtube_ytdlp_parse_listing_entries(channel_id: str, info: Optional[dict], raw_id: Optional[int], surface: str) -> Tuple[List[dict], Optional[int], bool]:
    entries = [] if not info else list(info.get("entries") or [])
    playlist_count = youtube_safe_int(info.get("playlist_count")) if info else None
    videos: List[dict] = []
    for entry in entries:
        if not entry:
            continue
        vid = entry.get("id")
        if not vid:
            continue
        is_shorts_surface = surface == "shorts" or "/shorts/" in str(entry.get("webpage_url") or "").lower()
        videos.append({
            "video_id": vid,
            "channel_id": channel_id,
            "title": entry.get("title") or "",
            "description": entry.get("description") or "",
            "published_text": "",
            "upload_date": entry.get("upload_date") or "",
            "timestamp": entry.get("timestamp"),
            "duration_seconds": entry.get("duration"),
            "view_count": entry.get("view_count"),
            "like_count": entry.get("like_count"),
            "comment_count": entry.get("comment_count"),
            "channel_name": entry.get("channel") or entry.get("uploader") or "",
            "uploader_id": entry.get("uploader_id") or "",
            "category": "",
            "language": entry.get("language") or "",
            "availability": entry.get("availability") or "",
            "age_limit": entry.get("age_limit"),
            "live_status": entry.get("live_status") or "",
            "classification": "Short" if is_shorts_surface else "Longform",
            "is_live": entry.get("is_live", ""),
            "is_short": True if is_shorts_surface else entry.get("is_short", ""),
            "is_premiere": entry.get("live_status") == "is_upcoming",
            "is_family_safe": "",
            "is_monetized": "",
            "ads_enabled": "",
            "has_paid_promotion": "",
            "is_premium_content": "",
            "thumbnail_url": entry.get("thumbnail") or f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg",
            "webpage_url": (f"https://www.youtube.com/shorts/{vid}" if is_shorts_surface else (entry.get("webpage_url") or f"https://www.youtube.com/watch?v={vid}")),
            "listing_status": "SUCCESS",
            "player_status": "NOT_FETCHED",
            "yt_dlp_status": "SUCCESS_FLAT",
            "raw_listing_id": None,
            "raw_player_id": None,
            "raw_ytdlp_id": raw_id,
            "source_raw_listing": entry,
            "_shorts_surface": is_shorts_surface,
            "width": entry.get("width"),
            "height": entry.get("height"),
        })
    return youtube_unique_by_id(videos, "video_id"), playlist_count, bool(playlist_count is None or len(entries) >= playlist_count)


def youtube_ytdlp_discover_tab(run_id: int, db: youtube_Database, channel_id: str, url: str, limit: int, surface: str) -> Tuple[List[dict], Optional[int], bool]:
    opts = youtube_ytdlp_base_opts(False)
    if limit > 0:
        opts["playlistend"] = limit
    started = time.monotonic()
    youtube_debug(f"[yt-dlp {surface} listing] START {url} | limit={'ALL' if limit <= 0 else limit}")
    try:
        with youtube_yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            sanitized = ydl.sanitize_info(info) if info else None
        raw_id = None
        if sanitized is not None:
            raw_id = db.raw(run_id, channel_id=channel_id, video_id=None, source="yt-dlp", endpoint=url, status=200, payload=sanitized, content_type="application/json", note=f"channel_{surface}_discovery")
        videos, playlist_count, parser_complete = youtube_ytdlp_parse_listing_entries(channel_id, info, raw_id, surface)
        complete = bool(limit <= 0 and parser_complete)
        youtube_debug(f"[yt-dlp {surface} listing] COMPLETE {url} | entries={len(videos)} | playlist_count={playlist_count if playlist_count is not None else 'unknown'} | complete={'yes' if complete else 'no/unknown'} | elapsed={time.monotonic()-started:.1f}s")
        return videos, raw_id, complete
    except Exception as exc:
        db.error(run_id, channel_id=channel_id, stage=f"yt_dlp_{surface}_listing", endpoint=url, status=None, exc_type=type(exc).__name__, message=str(exc), detail=traceback.format_exc())
        youtube_log(f"[yt-dlp {surface} listing] {type(exc).__name__}: {exc}")
        return [], None, False


def youtube_ytdlp_discover_videos(run_id: int, db: youtube_Database, channel_id: str, limit: int) -> Tuple[List[dict], Optional[int], bool]:
    if youtube_stop_requested():
        return [], None, False
    if youtube_yt_dlp is None and not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
        youtube_log("[yt-dlp] not installed and official API accelerator is not configured.")
        return [], None, False

    if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR and youtube_youtube_api_budget_available(db):
        api_videos, api_complete = youtube_youtube_api_discover_videos(run_id, db, channel_id, limit)
        if api_videos:
            # Supplement the API catalog with the explicit Shorts surface so Shorts
            # remain discoverable even when the channel listing is incomplete.
            if youtube_yt_dlp is None:
                return api_videos, None, api_complete
            shorts_rows, shorts_raw_id, shorts_complete = youtube_ytdlp_discover_tab(run_id, db, channel_id, youtube_short_surface_url(channel_id), limit, "shorts")
            merged = youtube_merge_video_sources(api_videos, shorts_rows, limit)
            return merged, shorts_raw_id, api_complete and shorts_complete
        youtube_log("[youtube-api] discovery unavailable; falling back to yt-dlp")

    if youtube_yt_dlp is None:
        return [], None, False

    video_rows, video_raw_id, video_complete = youtube_ytdlp_discover_tab(
        run_id, db, channel_id, f"{youtube_YOUTUBE}/channel/{channel_id}/videos", limit, "videos"
    )
    shorts_rows, shorts_raw_id, shorts_complete = youtube_ytdlp_discover_tab(
        run_id, db, channel_id, youtube_short_surface_url(channel_id), limit, "shorts"
    )
    merged = youtube_merge_video_sources(video_rows, shorts_rows, limit)
    raw_id = shorts_raw_id or video_raw_id
    # The normal /videos catalog determines overall catalog completeness. The
    # /shorts surface is a supplemental coverage pass: some channels legitimately
    # have no Shorts tab, so its absence must not make the main catalog incomplete.
    complete = video_complete
    youtube_debug(
        f"[yt-dlp discovery] merged videos+shorts | videos={len(video_rows)} | shorts={len(shorts_rows)} | merged={len(merged)} | videos_complete={'yes' if video_complete else 'no/unknown'} | shorts_complete={'yes' if shorts_complete else 'no/unknown'}"
    )
    return merged, raw_id, complete


def youtube_ytdlp_discover_with_rate_limit_retry(
    run_id: int,
    db: youtube_Database,
    channel_id: str,
    limit: int,
) -> Tuple[List[dict], Optional[int], bool]:
    """Discover one channel catalog; if YouTube rate-limits, wait and retry that same channel."""
    attempt = 0
    while True:
        if youtube_stop_requested():
            return [], None, False
        attempt += 1
        videos, raw_id, complete = youtube_ytdlp_discover_videos(run_id, db, channel_id, limit)
        if not youtube_ytdlp_rate_limited():
            return videos, raw_id, complete

        youtube_set_ytdlp_rate_limit(
            "yt-dlp rate limit triggered during video discovery",
            db,
            channel_id=channel_id,
            run_id=run_id,
            action="DISCOVERY",
        )
        youtube_log(
            f"[throttle] channel discovery parked | channel={channel_id} | "
            f"attempt={attempt} | discovered_so_far={len(videos)} | committed DB data preserved"
        )
        if not youtube_wait_for_ytdlp_rate_limit_clear(db, pending_video_id=""):
            return videos, raw_id, complete
        youtube_log(
            f"[throttle] RETRYING CHANNEL DISCOVERY FIRST | channel={channel_id} | "
            f"attempt={attempt + 1}"
        )


def youtube_merge_video_sources(inner: list, ytdlp_rows: list, limit: int) -> List[dict]:
    merged: Dict[str, dict] = {}

    for row in inner + ytdlp_rows:
        vid = row.get("video_id")
        if not vid:
            continue
        if vid not in merged:
            merged[vid] = dict(row)
            continue

        target = merged[vid]
        for k, v in row.items():
            if v not in (None, "", [], {}):
                if target.get(k) in (None, "", [], {}):
                    target[k] = v

        if row.get("raw_ytdlp_id"):
            target["raw_ytdlp_id"] = row["raw_ytdlp_id"]
        if row.get("raw_listing_id"):
            target["raw_listing_id"] = row["raw_listing_id"]

    rows = list(merged.values())
    return rows[:limit] if limit > 0 else rows


# ============================================================================
# PER-VIDEO YT-DLP ENRICHMENT
# ============================================================================

def youtube_extract_ytdlp_formats(info: dict) -> list:
    formats = info.get("formats") or []
    return [f for f in formats if isinstance(f, dict)]


def youtube_fetch_ytdlp_video(run_id: int, db: youtube_Database, video: dict, mode: str, maximum: bool) -> Optional[dict]:
    if youtube_yt_dlp is None:
        return None

    if youtube_ytdlp_rate_limited():
        remaining = youtube_ytdlp_rate_limit_remaining()
        video["yt_dlp_status"] = "RATE_LIMITED"
        youtube_log(
            f"      [yt-dlp] SKIP | video={video.get('video_id','')} | "
            f"YouTube session rate-limited | cooldown_remaining={remaining // 60}m {remaining % 60}s"
        )
        return None

    url = video.get("webpage_url") or f"https://www.youtube.com/watch?v={video['video_id']}"
    opts = youtube_ytdlp_base_opts(maximum, use_cookies=not youtube_YTDLP_PUBLIC_FIRST)
    opts["noplaylist"] = True
    opts["extract_flat"] = False
    try:
        # Keep the scalar count from discovery for analytics; never request
        # individual video comments.
        listing_comment_count = youtube_safe_int(video.get("comment_count"))
        video["_listing_comment_count"] = listing_comment_count

        if not youtube_wait_for_ytdlp_video_slot(
            mode,
            label=f"{video.get('video_id','')}"
        ):
            video["yt_dlp_status"] = "RATE_LIMITED" if youtube_ytdlp_rate_limited() else "STOPPED"
            youtube_persist_ytdlp_rate_limit(db)
            return None

        with youtube_yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if youtube_ytdlp_rate_limited():
                # The logger may have detected the rate-limit message inside
                # extract_info(), so persist the exact video that triggered it.
                youtube_set_ytdlp_rate_limit(
                    "rate limit detected during yt-dlp extraction", db,
                    video_id=video.get("video_id", ""),
                    channel_id=video.get("channel_id", ""),
                    run_id=run_id,
                    action="RESUME",
                )
                video["yt_dlp_status"] = "RATE_LIMITED"
                youtube_persist_ytdlp_rate_limit(db)
                remaining = youtube_ytdlp_rate_limit_remaining()
                youtube_log(
                    f"      [maximum/yt-dlp] rate limit triggered during extraction | "
                    f"cooldown_remaining={remaining // 60}m {remaining % 60}s"
                )
                return None
            if not info:
                if youtube_ytdlp_rate_limited():
                    video["yt_dlp_status"] = "RATE_LIMITED"
                    remaining = youtube_ytdlp_rate_limit_remaining()
                    youtube_log(
                        f"      [yt-dlp] no info | RATE_LIMITED | cooldown_remaining={remaining // 60}m {remaining % 60}s"
                    )
                else:
                    video["yt_dlp_status"] = "FAILED_EMPTY"
                    youtube_log("      [yt-dlp] no info returned")
                return None
            sanitized = ydl.sanitize_info(info)

        raw_id = db.raw(
            run_id,
            channel_id=video.get("channel_id"),
            video_id=video.get("video_id"),
            source="yt-dlp",
            endpoint=url,
            status=200,
            payload=sanitized,
            content_type="application/json",
            note="video_full_info",
        )
        youtube_log(f"      [db] raw_data INSERT | source=yt-dlp | video_full_info | id={raw_id}")
        video["raw_ytdlp_id"] = raw_id

        # Fill essentially every useful scalar exposed by yt-dlp.
        mapping = {
            "title": "title",
            "description": "description",
            "upload_date": "upload_date",
            "timestamp": "timestamp",
            "duration_seconds": "duration",
            "view_count": "view_count",
            "like_count": "like_count",
            "comment_count": "comment_count",
            "channel_name": "channel",
            "uploader_id": "uploader_id",
            "category": "categories",
            "language": "language",
            "availability": "availability",
            "age_limit": "age_limit",
            "live_status": "live_status",
            "is_live": "is_live",
            "is_short": "is_short",
            "is_premiere": "is_premiere",
            "thumbnail_url": "thumbnail",
            "webpage_url": "webpage_url",
        }

        for dest, src in mapping.items():
            if dest == "comment_count":
                continue
            value = info.get(src)
            if value not in (None, "", []):
                if dest == "category" and isinstance(value, list):
                    value = ", ".join(str(x) for x in value)
                video[dest] = value

        # Preserve technical dimensions for Shorts classification. These are
        # retained in raw yt-dlp metadata even though the canonical videos table
        # does not currently expose width/height columns.
        if info.get("width") not in (None, ""):
            video["width"] = youtube_safe_int(info.get("width"))
        if info.get("height") not in (None, ""):
            video["height"] = youtube_safe_int(info.get("height"))
        if youtube_boolish(info.get("is_short")):
            video["is_short"] = True

        if info.get("release_timestamp") and not video.get("timestamp"):
            video["timestamp"] = info.get("release_timestamp")

        video["has_paid_promotion"] = info.get("dislike_count", "") if False else info.get("has_paid_promotion", video.get("has_paid_promotion", ""))
        video["is_premium_content"] = info.get("is_premium", video.get("is_premium_content", ""))
        video["is_family_safe"] = info.get("is_family_safe", video.get("is_family_safe", ""))
        video["ads_enabled"] = info.get("_has_verified_esm", video.get("ads_enabled", ""))
        video["is_monetized"] = info.get("is_monetized", video.get("is_monetized", ""))

        formats = youtube_extract_ytdlp_formats(info)
        if formats:
            db.insert_formats(run_id, video["video_id"], formats, "yt-dlp")
        db.mark_video_stage(video["video_id"], "formats", "SUCCESS" if formats else "SUCCESS_EMPTY")
        if maximum:
            youtube_log(f"      [maximum/yt-dlp] formats={len(formats)}")

        # Store all available subtitle/caption track metadata. We don't force
        # huge caption downloads in Fast/Full mode.
        ytdlp_caption_track_count = 0
        for track_type, collection in (
            ("subtitles", info.get("subtitles") or {}),
            ("automatic_captions", info.get("automatic_captions") or {}),
        ):
            for lang, tracks in collection.items():
                for track in tracks if isinstance(tracks, list) else []:
                    if not isinstance(track, dict):
                        continue
                    db.insert_caption(run_id, {
                        "video_id": video["video_id"],
                        "language_code": lang,
                        "language_name": track.get("name", ""),
                        "kind": "asr" if track_type == "automatic_captions" else "",
                        "track_type": track_type,
                        "ext": track.get("ext", ""),
                        "url": track.get("url", ""),
                        "track_bytes": 0,
                        "sha256": "",
                        "transcript_text": "",
                    })
                    ytdlp_caption_track_count += 1

        if maximum:
            youtube_log(f"      [maximum/yt-dlp] caption_tracks={ytdlp_caption_track_count}")
            # Individual video comments are disabled. Preserve only the scalar
            # comment_count metadata reported by YouTube; do not fetch comment rows.
            db.mark_video_stage(video["video_id"], "comments", "SKIPPED_DISABLED")
            video["_ytdlp_comment_count"] = 0
            video["_reported_comment_count"] = listing_comment_count
            youtube_log("      [maximum] video comments=DISABLED | comment_count metadata retained")
        # Preserve extra metadata that does not have dedicated columns in raw.
        video["yt_dlp_status"] = "SUCCESS"
        video["classification"] = youtube_classify_video(video)
        return info

    except Exception as exc:
        exc_text = str(exc)
        if 'rate-limited' in exc_text.lower() or 'rate limit' in exc_text.lower() or 'exceeding the rate limit' in exc_text.lower():
            youtube_set_ytdlp_rate_limit(
                exc_text, db,
                video_id=video.get("video_id", ""),
                channel_id=video.get("channel_id", ""),
                run_id=run_id,
                action="RESUME",
            )
            youtube_persist_ytdlp_rate_limit(db)
            video["yt_dlp_status"] = "RATE_LIMITED"
        else:
            video["yt_dlp_status"] = "FAILED"
        db.error(
            run_id,
            channel_id=video.get("channel_id"),
            video_id=video.get("video_id"),
            stage="yt_dlp_video",
            endpoint=url,
            status=None,
            exc_type=type(exc).__name__,
            message=str(exc),
            detail=traceback.format_exc(),
        )
        youtube_debug(f"[yt-dlp video {video['video_id']}] {type(exc).__name__}: {exc}")
        return None


# ============================================================================
# PLAYER / INNER TUBE ENRICHMENT
# ============================================================================

def youtube_boolish(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return False
    return str(value).strip().lower() in {"true", "1", "yes", "y"}


def youtube_short_aspect_ratio(v: dict) -> Optional[bool]:
    width = youtube_safe_int(v.get("width"))
    height = youtube_safe_int(v.get("height"))
    if width is None or height is None or width <= 0 or height <= 0:
        return None
    return height >= width


def youtube_short_upload_cutoff_ok(v: dict) -> Optional[bool]:
    upload_date = str(v.get("upload_date") or "").strip()
    if upload_date and len(upload_date) >= 8 and upload_date[:8].isdigit():
        return upload_date[:8] >= "20241015"
    ts = youtube_safe_int(v.get("timestamp"))
    if ts is not None:
        try:
            return ts >= int(datetime(2024, 10, 15, tzinfo=timezone.utc).timestamp())
        except Exception:
            pass
    return None


def youtube_is_short_candidate(v: dict) -> bool:
    if youtube_boolish(v.get("is_short")):
        return True
    if youtube_boolish(v.get("_shorts_surface")):
        return True
    url = str(v.get("webpage_url") or "").lower()
    if "/shorts/" in url:
        return True
    duration = v.get("duration_seconds")
    try:
        duration = float(duration) if duration is not None else None
    except Exception:
        duration = None
    if duration is None or duration <= 0 or duration > 180:
        return False
    aspect = youtube_short_aspect_ratio(v)
    cutoff_ok = youtube_short_upload_cutoff_ok(v)
    if aspect is True and cutoff_ok is True:
        return True
    # When upload date/aspect is not available yet (common in flat discovery),
    # keep the legacy <=60s heuristic until the full player response fills the fields.
    if cutoff_ok is None or aspect is None:
        return duration <= 60
    return False


def youtube_classify_video(v: dict) -> str:
    if youtube_boolish(v.get("is_live")) or str(v.get("live_status") or "") in {"is_live", "is_upcoming", "post_live"}:
        return "Livestream"
    if youtube_boolish(v.get("is_premiere")):
        return "Premiere"
    if youtube_is_short_candidate(v):
        return "Short"
    return "Longform"


def youtube_enrich_from_player(v: dict, data: dict) -> None:
    details = data.get("videoDetails", {}) or {}
    micro = data.get("microformat", {}).get("playerMicroformatRenderer", {}) or {}

    for dest, source in (
        ("title", "title"),
        ("description", "shortDescription"),
        ("view_count", "viewCount"),
        ("channel_name", "author"),
        ("duration_seconds", "lengthSeconds"),
    ):
        val = details.get(source)
        if val not in (None, ""):
            if dest in {"view_count", "duration_seconds"}:
                val = youtube_safe_int(val)
            v[dest] = val

    v["upload_date"] = micro.get("uploadDate", v.get("upload_date", ""))
    v["category"] = micro.get("category", v.get("category", ""))
    v["is_live"] = details.get("isLiveContent", v.get("is_live", ""))
    v["is_short"] = details.get("isShort", v.get("is_short", ""))
    v["is_premiere"] = micro.get("isPremiere", v.get("is_premiere", ""))
    v["is_family_safe"] = micro.get("isFamilySafe", v.get("is_family_safe", ""))
    v["is_premium_content"] = micro.get("isPremiumContent", v.get("is_premium_content", ""))
    v["has_paid_promotion"] = micro.get("hasPaidPromotion", v.get("has_paid_promotion", ""))
    v["is_monetized"] = details.get("isMonetized", v.get("is_monetized", ""))

    v["ads_enabled"] = bool(data.get("playerAds") or data.get("adPlacements"))

    thumbs = micro.get("thumbnail", {}).get("thumbnails", [])
    if thumbs:
        v["thumbnail_url"] = thumbs[-1].get("url", v.get("thumbnail_url", ""))

    v["age_limit"] = max(
        youtube_safe_int(v.get("age_limit")) or 0,
        youtube_safe_int(micro.get("ageLimit")) or 0,
    ) or v.get("age_limit")

    formats = youtube_extract_inner_formats(data) if isinstance(data, dict) else []
    dims = [(youtube_safe_int(f.get("width")), youtube_safe_int(f.get("height"))) for f in formats if isinstance(f, dict)]
    dims = [(w, h) for w, h in dims if w and h]
    if dims and not v.get("width") and not v.get("height"):
        # Use the largest available vertical/square format when one exists.
        vertical = [(w, h) for w, h in dims if h >= w]
        w, h = max(vertical or dims, key=lambda pair: pair[0] * pair[1])
        v["width"], v["height"] = w, h

    v["classification"] = youtube_classify_video(v)


def youtube_extract_inner_formats(data: dict) -> list:
    streaming = data.get("streamingData", {}) or {}
    out = []
    for key in ("formats", "adaptiveFormats"):
        values = streaming.get(key) or []
        if isinstance(values, list):
            out.extend(values)
    return out


def youtube_fetch_ytdlp_caption_content(run_id: int, db: youtube_Database, v: dict, info: dict) -> int:
    """Download caption tracks directly from yt-dlp metadata, avoiding a second player request."""
    collections = [
        ("subtitles", info.get("subtitles") or {}, ""),
        ("automatic_captions", info.get("automatic_captions") or {}, "asr"),
    ]
    count = 0
    for track_type, collection, default_kind in collections:
        for lang, tracks in collection.items():
            if not isinstance(tracks, list):
                continue
            for track in tracks:
                if youtube_stop_requested() or not isinstance(track, dict):
                    continue
                base = track.get("url")
                if not base:
                    continue
                try:
                    headers = {"User-Agent": youtube_UA, "Referer": v.get("webpage_url", "")}
                    extra_headers = track.get("http_headers")
                    if isinstance(extra_headers, dict):
                        headers.update({str(k): str(val) for k, val in extra_headers.items() if val is not None})
                    r = youtube_SESSION.get(base, timeout=youtube_REQUEST_TIMEOUT, headers=headers)
                    if r.status_code != 200:
                        continue
                    payload = r.content
                    text = youtube_parse_caption_text(payload)
                    name = track.get("name", "")
                    if isinstance(name, dict):
                        name = youtube_text_from_runs(name)
                    db.insert_caption(run_id, {
                        "video_id": v["video_id"],
                        "language_code": lang,
                        "language_name": name or "",
                        "kind": track.get("kind", default_kind) or default_kind,
                        "track_type": "yt_dlp_content",
                        "ext": track.get("ext", ""),
                        "url": base,
                        "track_bytes": len(payload),
                        "sha256": youtube_sha256_bytes(payload),
                        "transcript_text": text,
                    })
                    count += 1
                except Exception as exc:
                    db.error(
                        run_id, video_id=v.get("video_id"), stage="caption_download",
                        endpoint="yt-dlp caption track", status=None,
                        exc_type=type(exc).__name__, message=str(exc), detail=str(base)[:1000],
                    )
    return count

def youtube_fetch_inner_player(run_id: int, db: youtube_Database, v: dict) -> Optional[dict]:
    if youtube_stop_requested():
        v["player_status"] = "STOPPED"
        return None
    if not youtube_INNERTUBE_API_KEY:
        return None

    video_id = v["video_id"]
    data, status, body = youtube_innertube_post(
        "player",
        {
            "videoId": video_id,
            "contentCheckOk": True,
            "racyCheckOk": True,
            "playbackContext": {
                "contentPlaybackContext": {
                    "html5Preference": "HTML5_PREF_WANTS"
                }
            },
        },
    )

    if not data:
        v["player_status"] = "FAILED"
        db.error(
            run_id,
            channel_id=v.get("channel_id"),
            video_id=video_id,
            stage="inner_player",
            endpoint="player",
            status=status,
            exc_type="InnerTubePlayerError",
            message="player returned no JSON",
            detail=body[:2000],
        )
        return None

    raw_id = db.raw(
        run_id,
        channel_id=v.get("channel_id"),
        video_id=video_id,
        source="innertube",
        endpoint="player",
        status=status,
        payload=data,
        content_type="application/json",
    )
    youtube_log(f"      [db] raw_data INSERT | source=innertube | endpoint=player | id={raw_id}")
    v["raw_player_id"] = raw_id
    v["player_status"] = "SUCCESS"

    youtube_enrich_from_player(v, data)

    formats = youtube_extract_inner_formats(data)
    if formats:
        db.insert_formats(run_id, video_id, formats, "innertube")

    return data


# ============================================================================
# CAPTIONS
# ============================================================================

def youtube_parse_caption_text(payload: bytes) -> str:
    text = payload.decode("utf-8", errors="replace")
    if text.lstrip().startswith("{"):
        try:
            data = json.loads(text)
            parts = []
            for event in data.get("events", []):
                for seg in event.get("segs", []):
                    if isinstance(seg, dict) and isinstance(seg.get("utf8"), str):
                        parts.append(seg["utf8"])
            if parts:
                return re.sub(r"\s+", " ", " ".join(parts)).strip()
        except Exception:
            pass
    text = re.sub(r"<[^>]+>", " ", text)
    text = re.sub(r"WEBVTT", " ", text, flags=re.I)
    text = re.sub(r"\d{2}:\d{2}:\d{2}[.,]\d{3}\s+-->.*", " ", text)
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def youtube_fetch_caption_content(run_id: int, db: youtube_Database, v: dict, player_data: dict) -> int:
    captions = player_data.get("captions", {}).get("playerCaptionsTracklistRenderer", {}) or {}
    tracks = captions.get("captionTracks") or []
    count = 0

    for track in tracks:
        if youtube_stop_requested():
            break
        base = track.get("baseUrl")
        if not base:
            continue
        try:
            r = youtube_SESSION.get(
                base,
                timeout=youtube_REQUEST_TIMEOUT,
                headers={"User-Agent": youtube_UA, "Referer": v["webpage_url"]},
            )
            if r.status_code != 200:
                continue
            payload = r.content
            text = youtube_parse_caption_text(payload)
            name = track.get("name", {})
            if isinstance(name, dict):
                name = youtube_text_from_runs(name)
            db.insert_caption(run_id, {
                "video_id": v["video_id"],
                "language_code": track.get("languageCode", ""),
                "language_name": name or "",
                "kind": track.get("kind", ""),
                "track_type": "inner_player",
                "ext": "xml",
                "url": base,
                "track_bytes": len(payload),
                "sha256": youtube_sha256_bytes(payload),
                "transcript_text": text,
            })
            count += 1
        except Exception as exc:
            db.error(
                run_id,
                video_id=v["video_id"],
                stage="caption_download",
                endpoint="captionTracks",
                status=None,
                exc_type=type(exc).__name__,
                message=str(exc),
                detail=base[:1000],
            )
        time.sleep(0.15)

    return count


