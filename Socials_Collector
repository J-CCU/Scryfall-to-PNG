# ============================================================================
# V19 INSTAGRAM ACCESS-BLOCKED HANDOFF / SCHEDULER YIELD
# ============================================================================
# The v18 log can enter a pathological state where every Instagram username
# gets the same HTTP 401 + "Please wait a few minutes" response. That is not
# enough evidence to call it a true rate limit, but it IS enough evidence that
# the current anonymous resolver path is unavailable for this session.
#
# V19 treats that condition as a short-lived PLATFORM_ACCESS_BACKOFF:
#   1. stop probing additional Instagram accounts immediately;
#   2. persist a retry time in instagram.db;
#   3. return control to the unified scheduler;
#   4. let TikTok/YouTube do useful work;
#   5. retry Instagram after the backoff expires.
#
# This deliberately does not call the older web_profile_info endpoint for an
# anonymous session. The v18 log showed that endpoint and the username feed
# endpoint returning the same 401 for every account, so continuing to alternate
# between them only spent time without increasing coverage.

V19_BUILD = "ALL_FIXES_V19_INSTAGRAM_ACCESS_BACKOFF"
INSTAGRAM_COLLECTOR_BUILD = V19_BUILD

V19_IG_ACCESS_BACKOFF_INITIAL = 600.0
V19_IG_ACCESS_BACKOFF_MAX = 3600.0

class V19InstagramAccessBackoff(BaseException):
    """Internal control-flow signal: anonymous Instagram access is unavailable."""


def v19__ig_access_blocked_text(text: str) -> bool:
    lowered = str(text or "").lower()
    if not lowered:
        return False
    # Treat the exact recurring anonymous-session failure as an access problem,
    # not as a generic rate limit.
    return (
        "401 unauthorized" in lowered
        and "please wait a few minutes" in lowered
    )


def v19__ig_set_access_backoff(db: instagram_Database, reason: str, username: str = "") -> float:
    try:
        prior = int(float(db.get_runtime_state("instagram_access_backoff_events") or 0))
    except Exception:
        prior = 0
    cooldown = min(
        V19_IG_ACCESS_BACKOFF_MAX,
        V19_IG_ACCESS_BACKOFF_INITIAL * (1.5 ** min(prior, 6)),
    )
    until = time.time() + cooldown
    db.set_runtime_state("instagram_access_backoff_until", str(until))
    db.set_runtime_state("instagram_access_backoff_reason", str(reason)[:1200])
    db.set_runtime_state("instagram_access_backoff_username", username)
    db.set_runtime_state("instagram_access_backoff_events", str(prior + 1))
    db.set_runtime_state("instagram_graph_success_streak", "0")
    instagram_log(
        f"[orchestrator] Instagram access-blocked; yielding to scheduler | "
        f"backoff={int(cooldown)//60}m {int(cooldown)%60}s | "
        f"account=@{username or 'unknown'} | reason={str(reason)[:220]}"
    )
    return until


def v19__ig_clear_access_backoff(db: Optional[instagram_Database] = None) -> None:
    if db is not None:
        for key in (
            "instagram_access_backoff_until",
            "instagram_access_backoff_reason",
            "instagram_access_backoff_username",
        ):
            try:
                db.set_runtime_state(key, "")
            except Exception:
                pass


def v19__ig_access_backoff_until(db: Optional[instagram_Database]) -> float:
    if db is None:
        return 0.0
    try:
        value = float(db.get_runtime_state("instagram_access_backoff_until") or 0)
        if value <= time.time():
            v19__ig_clear_access_backoff(db)
            return 0.0
        return value
    except Exception:
        return 0.0


# Keep the scheduler aware of this separate access-backoff state.
UNIFIED_COOLDOWN_KEYS["instagram"] = tuple(
    list(UNIFIED_COOLDOWN_KEYS.get("instagram", ())) + ["instagram_access_backoff_until"]
)

# Add a scheduler-recognizable marker to the immutable Instagram platform spec.
UNIFIED_PLATFORMS = tuple(
    UnifiedPlatform(
        key=p.key,
        label=p.label,
        db_path=p.db_path,
        worker_name=p.worker_name,
        cooldown_key=p.cooldown_key,
        throttle_patterns=(p.throttle_patterns + (re.compile(r"access[- ]blocked", re.I),)) if p.key == "instagram" else p.throttle_patterns,
    )
    for p in UNIFIED_PLATFORMS
)


# Anonymous resolver: one real attempt, then immediately yield if Instagram
# responds with the recurring 401/"Please wait" access block.
def v19__ig_resolve_anonymous(loader: Any, username: str) -> Optional[dict]:
    username = str(username or "").strip().lstrip("@").split("/")[0]
    if not username:
        return None

    # Do not disturb authenticated sessions; retain the existing resolver there.
    if instagram_INSTAGRAM_LOGIN_USERNAME:
        return v14__ig_resolve(loader, username)

    db = v19__ACTIVE_IG_DB
    if db is not None:
        until = v19__ig_access_backoff_until(db)
        if until > time.time():
            remaining = int(until - time.time())
            raise V19InstagramAccessBackoff(
                f"Instagram anonymous access backoff active; remaining={remaining}s"
            )

    cached = v13__instagram_find_cached_account(db, username) if db is not None else None

    target = str(cached.get("account_id")) if cached and cached.get("account_id") else username
    path = f"api/v1/feed/user/{target}/" + ("" if cached and cached.get("account_id") else "username/")

    if not instagram_wait_for_request_slot("Full", f"anonymous mobile-feed @{username}"):
        return None

    try:
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM}/{path}",
            params={"count": 12},
            timeout=instagram_REQUEST_TIMEOUT,
            headers={
                "User-Agent": instagram_UA,
                "x-ig-app-id": "936619743392459",
                "X-ASBD-ID": "198387",
                "X-Requested-With": "XMLHttpRequest",
                "Referer": instagram_INSTAGRAM + "/",
                "Origin": instagram_INSTAGRAM,
                "Accept": "application/json,text/plain,*/*",
                "Connection": "keep-alive",
            },
        )
        body = r.text or ""
        if r.status_code == 429:
            raise instagram_TooManyRequestsException(body[:1200])
        if r.status_code == 401 and "please wait a few minutes" in body.lower():
            until = v19__ig_set_access_backoff(db, f"HTTP 401 access block from {path}", username) if db is not None else 0.0
            raise V19InstagramAccessBackoff(
                f"Instagram anonymous access blocked for @{username}; retry_at={until}"
            )
        if r.status_code >= 400:
            instagram_log(
                f"[resolve/v19] Instagram endpoint unavailable | @{username} | "
                f"HTTP {r.status_code} | body={body[:180]}"
            )
            return None
        try:
            feed = r.json()
        except Exception:
            instagram_log(f"[resolve/v19] non-JSON feed response | @{username} | HTTP {r.status_code}")
            return None

        return v13__instagram_profile_from_feed_page(
            loader, feed, username,
            "Instagram direct mobile feed cached-ID" if cached else "Instagram direct mobile feed"
        )
    except instagram_TooManyRequestsException:
        raise
    except V19InstagramAccessBackoff:
        raise
    except Exception as exc:
        text_value = str(exc)
        if v19__ig_access_blocked_text(text_value):
            until = v19__ig_set_access_backoff(db, text_value, username) if db is not None else 0.0
            raise V19InstagramAccessBackoff(
                f"Instagram anonymous access blocked for @{username}; retry_at={until}"
            )
        instagram_log(
            f"[resolve/v19] one-shot endpoint failed without platform backoff | "
            f"@{username} | {type(exc).__name__}: {text_value[:220]}"
        )
        return None


v19__ACTIVE_IG_DB = None
v18__old_instagram_resolve_profile = instagram_resolve_profile
instagram_resolve_profile = v19__ig_resolve_anonymous


# The normal Instagram run catches Exception internally. The access-backoff
# signal intentionally derives from BaseException so it crosses that handler;
# this wrapper closes out the current run cleanly before returning to the worker.
v19__instagram_run_previous = instagram_Collector.run

def v19__instagram_run(self: instagram_Collector, inputs: list, limit: int, mode: str, force_refresh: bool = False) -> int:
    global v19__ACTIVE_IG_DB
    v19__ACTIVE_IG_DB = self.db
    try:
        return v19__instagram_run_previous(self, inputs, limit, mode, force_refresh)
    except V19InstagramAccessBackoff as exc:
        run_id = getattr(self, "last_run_id", None)
        if run_id:
            try:
                self.db.finish_run(run_id, "ACCESS_BACKOFF", str(exc)[:1000])
            except Exception:
                pass
        self.emit(f"[run] ACCESS_BACKOFF | {str(exc)}")
        return int(run_id or -1)
    finally:
        v19__ACTIVE_IG_DB = None

instagram_Collector.run = v19__instagram_run


