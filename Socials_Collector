# ============================================================================
# V21 OPTIONAL CLOUD POSTGRESQL BACKEND
# ============================================================================
# Default behavior remains SQLite. To use PostgreSQL, set:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# One PostgreSQL database is shared safely by placing each collector in its own
# schema: youtube, instagram, and tiktok. Existing collector SQL continues to
# use unqualified table names; each connection sets its own search_path.
#
# Dependency for PostgreSQL mode:
#   pip install psycopg2-binary
#
# Beekeeper Studio connects to the same DATABASE_URL/host credentials. It is a
# database client, not a database server.

V21_BUILD = "ALL_FIXES_V21_POSTGRES_OPTIONAL"

def _v21_database_url() -> str:
    return os.getenv("DATABASE_URL", "").strip()

def _v21_postgres_enabled() -> bool:
    url = _v21_database_url().lower()
    return url.startswith("postgresql://") or url.startswith("postgres://")

def _v21_pg_import():
    try:
        import psycopg2
        import psycopg2.extras
        return psycopg2, psycopg2.extras
    except ImportError as exc:
        raise RuntimeError(
            "DATABASE_URL selects PostgreSQL, but psycopg2 is not installed. "
            "Run: pip install psycopg2-binary"
        ) from exc

def _v21_translate_sql(sql: str) -> str:
    """Translate the small SQLite SQL subset used by this collector to PostgreSQL."""
    s = str(sql or "").strip()
    if not s:
        return s

    # SQLite PRAGMAs are either handled specially by execute() or ignored.
    if re.match(r"(?is)^\s*PRAGMA\s+", s):
        return s

    s = re.sub(
        r"(?i)\bINTEGER\s+PRIMARY\s+KEY\s+AUTOINCREMENT\b",
        "BIGSERIAL PRIMARY KEY",
        s,
    )
    s = re.sub(r"(?i)\bBLOB\b", "BYTEA", s)

    # SQLite's INSERT OR IGNORE maps directly to PostgreSQL ON CONFLICT DO NOTHING.
    if re.match(r"(?is)^\s*INSERT\s+OR\s+IGNORE\s+INTO\b", s):
        s = re.sub(r"(?is)^\s*INSERT\s+OR\s+IGNORE\s+INTO\b", "INSERT INTO", s, count=1)
        semi = ";" if s.rstrip().endswith(";") else ""
        core = s.rstrip().rstrip(";").rstrip()
        if not re.search(r"(?is)\bON\s+CONFLICT\b", core):
            s = core + " ON CONFLICT DO NOTHING" + semi

    # TikTok captions is the only INSERT OR REPLACE statement in the source.
    if re.match(r"(?is)^\s*INSERT\s+OR\s+REPLACE\s+INTO\s+captions\b", s):
        s = re.sub(
            r"(?is)^\s*INSERT\s+OR\s+REPLACE\s+INTO\b",
            "INSERT INTO",
            s,
            count=1,
        )
        semi = ";" if s.rstrip().endswith(";") else ""
        core = s.rstrip().rstrip(";").rstrip()
        s = (
            core
            + " ON CONFLICT (video_id, language_code, track_type, name, ext, url) "
              "DO UPDATE SET "
              "scrape_run_id=EXCLUDED.scrape_run_id, "
              "content=EXCLUDED.content, "
              "captured_at=EXCLUDED.captured_at"
            + semi
        )

    # SQLite accepts numeric 0/1 directly as CASE conditions; PostgreSQL
    # requires a boolean expression.
    s = re.sub(r"(?i)\bCASE\s+WHEN\s+\?", "CASE WHEN (? <> 0)", s)

    # Python's sqlite3 uses ?, psycopg2 uses %s.
    s = s.replace("?", "%s")
    return s

class _V21PostgresCursor:
    def __init__(self, conn, cursor):
        self._conn = conn
        self._cursor = cursor

    def execute(self, sql, params=None):
        self._conn._execute_on_cursor(self._cursor, sql, params)
        return self

    def executemany(self, sql, seq):
        translated = _v21_translate_sql(sql)
        savepoint = "v21_many"
        self._cursor.execute(f"SAVEPOINT {savepoint}")
        try:
            self._cursor.executemany(translated, seq)
        except Exception:
            self._cursor.execute(f"ROLLBACK TO SAVEPOINT {savepoint}")
            self._cursor.execute(f"RELEASE SAVEPOINT {savepoint}")
            raise
        else:
            self._cursor.execute(f"RELEASE SAVEPOINT {savepoint}")
        return self

    def fetchone(self):
        return self._cursor.fetchone()

    def fetchall(self):
        return self._cursor.fetchall()

    def __iter__(self):
        return iter(self._cursor)

    @property
    def rowcount(self):
        return self._cursor.rowcount

    @property
    def description(self):
        return self._cursor.description

    @property
    def lastrowid(self):
        # PostgreSQL sequences are session-scoped. All collector calls that read
        # lastrowid immediately follow an INSERT into a BIGSERIAL id table.
        c = self._conn._raw.cursor()
        try:
            c.execute("SELECT LASTVAL()")
            row = c.fetchone()
            return int(row[0]) if row else None
        finally:
            c.close()

    def close(self):
        return self._cursor.close()

class _V21PostgresConnection:
    def __init__(self, database_url: str, schema: str):
        psycopg2, extras = _v21_pg_import()
        self._psycopg2 = psycopg2
        self._extras = extras
        self.schema = re.sub(r"[^a-zA-Z0-9_]", "_", schema)
        self._raw = psycopg2.connect(database_url, connect_timeout=20)
        self._raw.autocommit = False
        c = self._raw.cursor()
        try:
            c.execute(f'CREATE SCHEMA IF NOT EXISTS "{self.schema}"')
            c.execute(f'SET search_path TO "{self.schema}", public')
            self._raw.commit()
        finally:
            c.close()

    def cursor(self):
        cur = self._raw.cursor(cursor_factory=self._extras.DictCursor)
        return _V21PostgresCursor(self, cur)

    def _execute_on_cursor(self, cur, sql, params=None):
        raw = str(sql or "").strip()

        # SQLite lets a transaction continue after many statement-level errors.
        # PostgreSQL instead marks the entire transaction failed until ROLLBACK.
        # A SAVEPOINT around each collector statement preserves the collector's
        # existing error/retry behavior without discarding earlier successful work.
        savepoint = "v21_stmt"
        cur.execute(f"SAVEPOINT {savepoint}")
        try:
            m = re.match(r"(?is)^\s*PRAGMA\s+table_info\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s*;?\s*$", raw)
            if m:
                table = m.group(1)
                cur.execute(
                    """
                    SELECT
                        ordinal_position - 1 AS cid,
                        column_name AS name,
                        data_type AS type,
                        CASE WHEN is_nullable='NO' THEN 1 ELSE 0 END AS notnull,
                        column_default AS dflt_value,
                        0 AS pk
                    FROM information_schema.columns
                    WHERE table_schema=%s AND table_name=%s
                    ORDER BY ordinal_position
                    """,
                    (self.schema, table),
                )
            elif re.match(r"(?is)^\s*PRAGMA\s+", raw):
                cur.execute("SELECT 1 WHERE FALSE")
            elif re.search(r"(?is)\bFROM\s+sqlite_master\b", raw):
                cur.execute(
                    """
                    SELECT table_name AS name
                    FROM information_schema.tables
                    WHERE table_schema=%s AND table_type='BASE TABLE'
                    ORDER BY table_name
                    """,
                    (self.schema,),
                )
            else:
                cur.execute(_v21_translate_sql(raw), params)
        except Exception:
            # Restore a usable transaction before propagating the ORIGINAL error.
            cur.execute(f"ROLLBACK TO SAVEPOINT {savepoint}")
            cur.execute(f"RELEASE SAVEPOINT {savepoint}")
            raise
        else:
            # psycopg2 keeps result rows on the cursor only until the next
            # command. RELEASE SAVEPOINT is itself a command, so executing it
            # here destroys SELECT/PRAGMA-emulation results before callers can
            # fetch them. Leave successful statement savepoints in place; the
            # surrounding COMMIT/ROLLBACK clears them automatically.
            pass

    def execute(self, sql, params=None):
        cur = self._raw.cursor(cursor_factory=self._extras.DictCursor)
        wrapped = _V21PostgresCursor(self, cur)
        wrapped.execute(sql, params)
        return wrapped

    def executemany(self, sql, seq):
        cur = self._raw.cursor(cursor_factory=self._extras.DictCursor)
        wrapped = _V21PostgresCursor(self, cur)
        wrapped.executemany(sql, seq)
        return wrapped

    def executescript(self, script):
        # Collector initialization scripts contain semicolon-separated DDL.
        cur = self._raw.cursor()
        try:
            for statement in str(script or "").split(";"):
                statement = statement.strip()
                if not statement or re.match(r"(?is)^PRAGMA\s+", statement):
                    continue
                translated = _v21_translate_sql(statement)
                sp = "v21_script_stmt"
                cur.execute(f"SAVEPOINT {sp}")
                try:
                    cur.execute(translated)
                except Exception as exc:
                    cur.execute(f"ROLLBACK TO SAVEPOINT {sp}")
                    cur.execute(f"RELEASE SAVEPOINT {sp}")
                    # Repair only the known legacy YouTube schema mismatch.
                    missing_channel_id = (
                        getattr(exc, "pgcode", None) == "42703"
                        and re.match(
                            r"(?is)^CREATE\s+(?:UNIQUE\s+)?INDEX\s+"
                            r"(?:IF\s+NOT\s+EXISTS\s+)?"
                            r"idx_channel_inputs_channel\s+ON\s+channel_inputs\s*"
                            r"\(\s*channel_id\s*\)$",
                            translated,
                        )
                    )
                    if missing_channel_id:
                        cur.execute(
                            "ALTER TABLE channel_inputs "
                            "ADD COLUMN IF NOT EXISTS channel_id TEXT"
                        )
                        cur.execute(translated)
                        continue
                    raise
                else:
                    cur.execute(f"RELEASE SAVEPOINT {sp}")
        finally:
            cur.close()
        return self

    def commit(self):
        return self._raw.commit()

    def rollback(self):
        return self._raw.rollback()

    def close(self):
        return self._raw.close()

def _v21_open_connection(path: Path, schema: str):
    if _v21_postgres_enabled():
        return _V21PostgresConnection(_v21_database_url(), schema)
    conn = sqlite3.connect(str(path), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn

# Override only the constructors. All existing database methods, migrations,
# checkpoints, exports, and scheduler code continue using self.conn.
