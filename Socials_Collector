def _v39_migrate_youtube_schema(db: youtube_Database) -> None:
    _v38_migrate_youtube_schema(db)
    with db.lock:
        channel_cols = {r[1] for r in db.conn.execute("PRAGMA table_info(channels)").fetchall()}
        channel_additions = {
            "catalog_verification_version": "TEXT",
            "catalog_verified_at": "TEXT",
            "catalog_verified_count": "INTEGER DEFAULT 0",
            "catalog_verified_hash": "TEXT",
            "catalog_oldest_timestamp": "INTEGER",
            "catalog_newest_timestamp": "INTEGER",
            "channel_api_refreshed_at": "TEXT",
        }
        for name, definition in channel_additions.items():
            if name not in channel_cols:
                db.conn.execute(f"ALTER TABLE channels ADD COLUMN {name} {definition}")

        ingestion_cols = {r[1] for r in db.conn.execute("PRAGMA table_info(video_ingestion)").fetchall()}
        ingestion_additions = {
            "completeness_audit_status": "TEXT",
            "last_completeness_audit_at": "TEXT",
        }
        for name, definition in ingestion_additions.items():
            if name not in ingestion_cols:
                db.conn.execute(f"ALTER TABLE video_ingestion ADD COLUMN {name} {definition}")

        db.conn.execute("CREATE INDEX IF NOT EXISTS idx_v39_formats_video ON formats(video_id)")
        db.conn.execute("CREATE INDEX IF NOT EXISTS idx_v39_captions_video ON caption_tracks(video_id)")
        db.conn.execute("CREATE INDEX IF NOT EXISTS idx_v39_ingestion_audit ON video_ingestion(completeness_audit_status, channel_id)")
        db.conn.commit()


