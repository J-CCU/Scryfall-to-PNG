def _v44_youtube_enqueue(db: youtube_Database, video_id: str, stage: str, action: str,
                         run_id: int, priority: int = 0, *, force: bool = False) -> bool:
    vid = str(video_id or "")
    stage = str(stage or "")
    if not vid or stage not in {"heavy", "comments"}:
        return False
    state = db.get_video_sync(vid) or {}
    audit = str(state.get("completeness_audit_status") or "")
    if not force:
        stage_done = (
            stage == "heavy" and audit in {"COMPLETE", "MISSING_COMMENTS"}
        ) or (
            stage == "comments" and audit in {"COMPLETE", "MISSING_PAYLOAD"}
        )
        if stage_done:
            _v46_mark_queue_done_if_present(db, vid, stage)
            return False
    boost = 0
    if stage == "heavy" and audit == "MISSING_PAYLOAD":
        boost = V45_FINISH_PRIORITY_BOOST
    elif stage == "comments" and audit == "MISSING_COMMENTS":
        boost = V45_FINISH_PRIORITY_BOOST
    # Blank audit means a newly discovered/incompletely classified row.  It is
    # genuinely unfinished, so enqueue directly instead of running expensive
    # evidence subqueries in the discovery lane.
    return _v46_enqueue_base(db, vid, stage, action, run_id, int(priority or 0) + boost, force=force)


# ---------------------------------------------------------------------------
# YouTube JS runtime: Deno remains preferred; Node >=22 is an automatic local
# fallback when already installed.  No runtime is downloaded by this program.
# ---------------------------------------------------------------------------
def _v46_find_node_runtime() -> Optional[Path]:
    candidates: List[Path] = []
    found = shutil.which("node")
    if found:
        candidates.append(Path(found))
    if os.name == "nt":
        for root in (os.getenv("ProgramFiles", ""), os.getenv("ProgramFiles(x86)", "")):
            if root:
                candidates.append(Path(root) / "nodejs" / "node.exe")
    seen = set()
    for candidate in candidates:
        key = str(candidate).lower()
        if key in seen:
            continue
        seen.add(key)
        try:
            if not candidate.is_file():
                continue
            cp = subprocess.run([str(candidate), "--version"], capture_output=True, text=True, timeout=4, check=False)
            m = re.search(r"v?(\d+)", (cp.stdout or "").strip())
            if cp.returncode == 0 and m and int(m.group(1)) >= 22:
                return candidate
        except Exception:
            continue
    return None


