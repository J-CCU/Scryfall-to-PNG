def instagram_enrich_post_parity(self: instagram_Collector, run_id: int, p: dict, mode: str, action: str) -> None:
    username = p.get("username", "")
    pid = p.get("post_id", "")
    # Lightweight Graph API performance refresh when this source is available.
    if action == "PERFORMANCE_REFRESH" and instagram_instagram_graph_enabled(username=username, account_id=p.get("account_id", "")):
        payload = instagram_graph_post_refresh(pid, self.db)
        if payload:
            refreshed = instagram_instagram_graph_normalize(p, payload)
            insights = instagram_graph_post_insights(pid, self.db)
            if insights is not None:
                refreshed["insights"] = insights
            self.db.upsert_post(refreshed)
            self.db.instagram_db_update_instagram_extra(refreshed)
            self.db.insert_raw(run_id, p.get("account_id", ""), pid, "Meta Graph API", "media_performance_refresh", payload)
            self.db.upsert_snapshot(run_id, refreshed)
            with self.db.lock:
                self.db.conn.execute("UPDATE post_ingestion SET last_performance_refresh_at=?,last_enriched_at=?,last_run_id=?,last_error=NULL,graph_status='SUCCESS' WHERE post_id=?", (instagram_now_utc(), instagram_now_utc(), run_id, pid))
                self.db.conn.commit()
            self.emit(f"      [graph] performance refresh committed | post={pid}")
            return
    instagram__INSTAGRAM_OLD_ENRICH_POST(self, run_id, p, mode, action)

    # Extract technical formats/caption tracks from the yt-dlp raw payload without media download.
    try:
        info = instagram__load_latest_instagram_ytdlp_raw(self.db, pid)
        if info:
            formats, captions = instagram_instagram_extract_ytdlp_tracks(info)
            if formats:
                n = self.db.instagram_db_insert_instagram_formats(run_id, pid, formats)
                self.db.update_post_stage(pid, "formats_status", "SUCCESS")
                self.emit(f"      [maximum/yt-dlp] formats={n} | post={pid}")
            else:
                self.db.update_post_stage(pid, "formats_status", "SUCCESS_EMPTY")
            if captions:
                n2 = self.db.instagram_db_insert_instagram_captions(run_id, pid, captions)
                self.db.update_post_stage(pid, "captions_status", "SUCCESS")
                if mode == "Maximum":
                    n3 = instagram_instagram_fetch_caption_content(self.db, run_id, pid)
                    self.emit(f"      [maximum/yt-dlp] caption_tracks={n2} content_updated={n3} | post={pid}")
            else:
                self.db.update_post_stage(pid, "captions_status", "SUCCESS_EMPTY")
        else:
            self.db.update_post_stage(pid, "formats_status", "NO_DATA")
            self.db.update_post_stage(pid, "captions_status", "NO_DATA")
    except Exception as exc:
        self.db.record_error(run_id, account_id=p.get("account_id", ""), post_id=pid, stage="technical_metadata", exc=exc)

    # Optional Graph comment/insight supplement for eligible owned media.
    if mode == "Maximum" and instagram_instagram_graph_enabled(username=username, account_id=p.get("account_id", "")):
        try:
            comments = instagram_graph_post_comments(pid, self.db)
            for c in comments:
                raw_id = self.db.insert_raw(run_id, p.get("account_id", ""), pid, "Meta Graph API", "comment", c)
                self.db.insert_comment(run_id, pid, c, raw_id)
            insights = instagram_graph_post_insights(pid, self.db)
            if insights is not None:
                p["insights"] = insights
                self.db.instagram_db_update_instagram_extra(p)
            with self.db.lock:
                self.db.conn.execute("UPDATE post_ingestion SET graph_status=? WHERE post_id=?", ("SUCCESS" if comments or insights is not None else "SUCCESS_EMPTY", pid))
                self.db.conn.commit()
            self.emit(f"      [graph] supplement complete | comments={len(comments)} | insights={'YES' if insights is not None else 'NO'} | post={pid}")
        except Exception as exc:
            self.db.record_error(run_id, account_id=p.get("account_id", ""), post_id=pid, stage="graph_supplement", exc=exc)

