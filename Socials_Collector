class youtube_Scraper:
    def __init__(self, db: youtube_Database, log_callback=None, progress_callback=None):
        self.db = db
        self.log_callback = log_callback
        self.progress_callback = progress_callback
        self.channels: Dict[str, dict] = {}
        self.videos: List[dict] = []
        self.last_run_id: Optional[int] = None
        # V36: persistent YouTube list-position context. The dashboard's progress
        # counter changes to video-level work while a channel is being processed,
        # so keep the outer channel position separately and include it in every
        # progress update.
        self.current_channel_index: int = 0
        self.current_channel_total: int = 0
        self.current_channel_label: str = ""

    def emit(self, message: str) -> None:
        youtube_log(message)
        if self.log_callback:
            self.log_callback(message + "\n")

    def progress(self, current: int, total: int, phase: str) -> None:
        if self.progress_callback:
            phase_text = str(phase or "")
            if self.current_channel_index and self.current_channel_total:
                label = str(self.current_channel_label or "").strip()
                context = f"YouTube channel {self.current_channel_index}/{self.current_channel_total}"
                if label:
                    context += f" | {label}"
                # The outer channel position remains visible even when the numeric
                # progress bar is temporarily showing video-level progress.
                phase_text = f"{context} | {phase_text}"
            self.progress_callback(current, total, phase_text)

    def run(self, inputs: list, limit: int, mode: str, force_refresh: bool = False) -> int:
        # Do NOT clear the stop event here. App.start() clears it before the
        # worker is launched; clearing it here creates a race where a very
        # fast Stop click can be lost.
        self.channels = {}
        self.videos = []
        _surface_ensure_schema(self.db)
        run_id = self.db.begin_run(mode, limit, inputs)
        self.last_run_id = run_id
        stats = {
            "resolved_inputs": 0, "duplicate_inputs": 0, "failed_inputs": 0,
            "videos_discovered": 0, "new": 0, "resume": 0,
            "performance_refresh": 0, "heavy_refresh": 0, "force": 0, "skipped": 0,
        }

        try:
            if youtube_stop_requested():
                self.db.finish_run(run_id, "STOPPED", "Stop requested before startup.")
                self.emit("[run] STOPPED before startup")
                return run_id
            self.emit(
                f"[run] {run_id} | mode={mode} | "
                f"limit={'ALL' if limit <= 0 else limit} | "
                f"incremental=yes | force_refresh={'yes' if force_refresh else 'no'} | "
                f"yt-dlp={'available' if youtube_yt_dlp else 'MISSING'}"
            )
            if youtube_yt_dlp:
                self.emit(
                    f"[config] YouTube JS: Deno={'ON' if youtube_YTDLP_DENO_PATH else 'OFF'} | "
                    f"yt-dlp-ejs={'ON' if youtube_YTDLP_EJS_AVAILABLE else 'OFF'} | "
                    f"npm_EJS_fallback={'ON' if (youtube_YTDLP_DENO_PATH and not youtube_YTDLP_EJS_AVAILABLE) else 'OFF'}"
                )
            self.emit(
                f"[config] YouTube Data API accelerator: {'ON' if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR else 'OFF'} | "
                f"playlistItems={youtube_YOUTUBE_API_PLAYLIST_PAGE_SIZE}/request | videos.list={youtube_YOUTUBE_API_VIDEO_BATCH_SIZE}/request | "
                f"commentThreads={youtube_YOUTUBE_API_COMMENT_PAGE_SIZE}/request | daily_budget={youtube_YOUTUBE_API_DAILY_BUDGET} | "
                f"purpose=reduce_yt-dlp_request_pressure"
            )
            if mode == "Maximum":
                self.emit(
                    "[config] Maximum extras: video_comments=ON(V38 parallel lane), captions=ON, formats=ON, raw=ON, "
                    f"channel_yt-dlp={'ON' if youtube_COLLECT_CHANNEL_YTDLP_METADATA else 'OFF'}"
                )
                self.emit(
                    f"[config] video comments handled by V38 independent API lane | "
                    f"comment_count metadata=retained | yt-dlp internal request sleep={youtube_YT_DLP_MAXIMUM_REQUEST_SLEEP:.2f}s | "
                    f"fast_player_bypass={'ON' if (youtube_THROUGHPUT_PROFILE == 'high' and youtube_SKIP_INNERTUBE_PLAYER_IN_HIGH_THROUGHPUT) else 'OFF'}"
                )
            self.emit(
                f"[config] video discovery: InnerTube={'ON' if youtube_USE_INNERTUBE_VIDEO_DISCOVERY else 'OFF'}, yt-dlp=ON"
            )
            self.emit(f"[config] extended surfaces: {'ON' if youtube_COLLECT_EXTENDED_SURFACES and mode == 'Maximum' else 'OFF'} | community_posts=ON")
            self.emit(f"[config] yt-dlp rate policy: {youtube_ytdlp_policy_text(mode)}")
            self.emit(
                "[config] rate-limit behavior: one YouTube rate-limit event pauses further yt-dlp video enrichment "
                "for up to 60 minutes; committed DB progress is preserved."
            )
            youtube_load_ytdlp_rate_limit(self.db)
            pending_retry = youtube_get_pending_ytdlp_retry(self.db)
            if youtube_ytdlp_rate_limited():
                remaining = youtube_ytdlp_rate_limit_remaining()
                self.emit(
                    f"[run] persisted yt-dlp cooldown detected | remaining={remaining // 60}m {remaining % 60}s | "
                    f"pending_video={pending_retry.get('video_id') or 'unknown'} | waiting before retry"
                )
                if not youtube_wait_for_ytdlp_rate_limit_clear(
                    self.db,
                    pending_video_id=pending_retry.get("video_id", ""),
                ):
                    self.db.finish_run(run_id, "STOPPED", "Stop requested during persisted yt-dlp cooldown.")
                    self.emit("[run] STOPPED during persisted yt-dlp cooldown")
                    return run_id
            youtube_refresh_innertube_config()
            if youtube_stop_requested():
                self.db.finish_run(run_id, "STOPPED", "Stop requested during startup/configuration.")
                self.emit("[run] STOPPED during startup/configuration")
                return run_id

            # If a previous run was interrupted by a rate limit, retry that exact
            # video before starting any new channel work. This makes the retry
            # order deterministic across program restarts as well as within one run.
            priority_retried_video_id = ""
            pending_video_id = pending_retry.get("video_id", "")
            if pending_video_id:
                pending_video = self.db.get_video_catalog(pending_video_id)
                if pending_video:
                    pending_video.setdefault("channel_id", pending_retry.get("channel_id", ""))
                    pending_action = pending_retry.get("action", "RESUME")
                    if force_refresh:
                        pending_action = "FORCE"
                    elif pending_action not in {"NEW", "RESUME", "FORCE", "HEAVY_REFRESH", "PERFORMANCE_REFRESH"}:
                        pending_action = "RESUME"
                    self.emit(
                        f"[throttle] PRIORITY RETRY | video={pending_video_id} | "
                        f"channel={pending_video.get('channel_id','')} | action={pending_action} | "
                        f"retrying before channel queue"
                    )
                    try:
                        youtube_enrich_video_with_rate_limit_retry(
                            run_id, self.db, pending_video, mode, pending_action
                        )
                        if pending_video.get("yt_dlp_status") == "SUCCESS":
                            priority_retried_video_id = pending_video_id
                            self.videos.append(pending_video)
                            self.emit(
                                f"[throttle] PRIORITY RETRY COMPLETE | video={pending_video_id} | "
                                f"normal channel queue can resume"
                            )
                            self.db.log_run_db_counts(run_id, prefix="[db] after priority retry")
                    except Exception as exc:
                        self.emit(
                            f"[throttle] PRIORITY RETRY ERROR | video={pending_video_id} | "
                            f"{type(exc).__name__}: {exc}"
                        )
                else:
                    self.emit(
                        f"[throttle] pending video {pending_video_id} was not found in videos table; "
                        f"continuing with normal queue without deleting any state"
                    )
                # The priority video has either been retried or will remain in the
                # normal backlog; the runtime pending pointer is cleared only when
                # the retry cooldown expires successfully.

            concurrency = youtube_HIGH_THROUGHPUT_CONCURRENCY if youtube_THROUGHPUT_PROFILE == "high" else 1
            self.emit(
                f"[config] yt-dlp concurrency={concurrency} | global video-start pacing enforced | "
                "no proxy/IP rotation"
            )
            # Resolve and process each input immediately. This keeps the scraper
            # productive throughout a large input list and makes stopped runs export
            # whatever has already been committed.
            seen_channel_ids = set()
            total_inputs = len(inputs)
            processed_channels = 0
            rate_limited_run = False

            for input_i, raw in enumerate(inputs, 1):
                if youtube_stop_requested():
                    self.emit("[run] STOP requested during channel resolution; ending run.")
                    break

                self.current_channel_index = input_i
                self.current_channel_total = total_inputs
                self.current_channel_label = str(raw or "").strip()
                self.progress(input_i, total_inputs, "resolve")
                self.emit(
                    f"\n[YOUTUBE POSITION] channel {input_i}/{total_inputs} | {raw}"
                )
                self.emit(f"[resolve {input_i}/{total_inputs}] Checking: {raw}")
                started = time.monotonic()
                cid = youtube_get_channel_id(raw, db=self.db, force_refresh=force_refresh)
                elapsed = time.monotonic() - started
                resolution = dict(youtube_LAST_RESOLUTION)
                normalized = raw.strip().rstrip("/")

                if not cid:
                    stats["failed_inputs"] += 1
                    self.emit(f"  Resolution FAILED after {elapsed:.1f}s")
                    self.db.record_channel_input(
                        run_id, raw, normalized, None, False,
                        resolution.get("method", ""), resolution.get("verified", False),
                    )
                    self.emit(f"  UNRESOLVED INPUT: {raw}")
                    continue

                stats["resolved_inputs"] += 1
                duplicate = cid in seen_channel_ids
                self.emit(
                    f"  Resolution OK after {elapsed:.1f}s -> {cid}"
                    + (f" | {resolution.get('method')}" if resolution.get("method") else "")
                    + (" | duplicate" if duplicate else "")
                )
                self.db.record_channel_input(
                    run_id, raw, normalized, cid, duplicate,
                    resolution.get("method", ""), resolution.get("verified", False),
                )
                if duplicate:
                    stats["duplicate_inputs"] += 1
                    self.emit(f"  DUPLICATE CHANNEL INPUT: {raw} -> {cid} | skipping duplicate scrape")
                    continue

                seen_channel_ids.add(cid)
                processed_channels += 1
                # Use the actual input-list position as the primary visible
                # channel index. processed_channels is retained as the unique
                # successfully-resolved count, but it must not hide where we are
                # in the user's 1..N YouTube list.
                self.progress(input_i, max(1, total_inputs), "channel metadata")
                self.emit(
                    f"\n[channel {input_i}/{total_inputs}] Processing: {raw} "
                    f"| unique_processed={processed_channels}"
                )
                self.emit(f"  Channel ID: {cid}")

                if youtube_stop_requested():
                    self.emit("  STOP requested before channel processing; ending run.")
                    break

                try:
                    channel = youtube_scrape_channel_metadata(run_id, self.db, cid, emit_fn=self.emit)
                    channel["requested_handle"] = resolution.get("requested_handle", "")
                    channel["resolution_method"] = resolution.get("method", "")
                    channel["resolution_verified"] = resolution.get("verified", False)
                    if resolution.get("resolved_handle"):
                        channel["handle"] = youtube_clean_handle(resolution.get("resolved_handle"))
                    if resolution.get("resolved_title"):
                        channel["title"] = resolution.get("resolved_title")
                    self.emit(f"  [db] upsert channel | {cid}")
                    self.db.upsert_channel(channel)
                    self.db.update_channel_resolution(run_id, cid, channel)
                    self.channels[cid] = channel
                    self.db.log_run_db_counts(run_id, prefix="  [db] after channel commit")
                    self.emit(
                        f"  Resolved handle: @{youtube_clean_handle(channel.get('handle')) or '(unknown)'} | "
                        f"verification={'PASS' if channel.get('resolution_verified') else 'UNKNOWN/FAIL'}"
                    )
                    self.emit(f"  Channel: {channel.get('title') or '(unknown)'}")
                    self.emit(
                        f"  [ACTIVE/YOUTUBE] {channel.get('title') or '(unknown)'}"
                        f" | @{youtube_clean_handle(channel.get('handle')) or '(unknown)'}"
                        f" | {cid}"
                    )
                    self.emit(
                        f"  Subscribers: {channel.get('subscribers_text') or 'N/A'}"
                        + (f" (exact={channel.get('subscribers_exact')})" if channel.get('subscribers_exact') else "")
                    )
                    self.emit(f"  Total views: {channel.get('total_views_text') or 'N/A'}")
                    if youtube_COLLECT_EXTENDED_SURFACES and mode == "Maximum":
                        youtube_collect_community_posts(run_id, self.db, channel, limit, mode)
                except Exception as exc:
                    self.emit(f"  Channel metadata error: {type(exc).__name__}: {exc}")
                    self.db.error(
                        run_id, channel_id=cid, stage="channel_metadata", endpoint="about/browse",
                        status=None, exc_type=type(exc).__name__, message=str(exc),
                        detail=traceback.format_exc(),
                    )

                already_indexed = self.db.channel_is_fully_indexed(cid)
                force_full_catalog = bool(force_refresh and limit <= 0 and youtube_FORCE_FULL_DISCOVERY_WITH_ALL)
                discovery_limit = (
                    limit if limit > 0
                    else (0 if (force_full_catalog or not already_indexed) else youtube_INCREMENTAL_DISCOVERY_WINDOW)
                )
                if force_full_catalog:
                    discovery_mode = "forced-full-index"
                else:
                    discovery_mode = "incremental-window" if (limit <= 0 and already_indexed) else "full-index"
                self.emit(
                    f"  Indexing: {discovery_mode} | "
                    f"discovery_window={'ALL' if discovery_limit <= 0 else discovery_limit}"
                )

                if youtube_stop_requested():
                    self.emit("  STOP requested before video discovery; ending run.")
                    break

                if youtube_USE_INNERTUBE_VIDEO_DISCOVERY:
                    self.emit("  [discovery] InnerTube video listing START...")
                    discovery_started = time.monotonic()
                    try:
                        inner_videos = youtube_scrape_videos_innertube(run_id, self.db, cid, discovery_limit)
                        self.emit(f"  [discovery] InnerTube video listing COMPLETE | {len(inner_videos)} videos | {time.monotonic() - discovery_started:.1f}s")
                    except Exception as exc:
                        inner_videos = []
                        self.emit(f"  InnerTube listing error: {type(exc).__name__}: {exc}")
                        self.db.error(
                            run_id, channel_id=cid, stage="inner_listing", endpoint="browse",
                            status=None, exc_type=type(exc).__name__, message=str(exc),
                            detail=traceback.format_exc(),
                        )
                else:
                    inner_videos = []
                    self.emit("  [discovery] InnerTube video listing SKIPPED | disabled because the current WEB browse request returns HTTP 400")

                self.emit("  [discovery] yt-dlp video listing START...")
                discovery_started = time.monotonic()
                try:
                    ytdlp_videos, _, ytdlp_complete = youtube_ytdlp_discover_with_rate_limit_retry(
                        run_id, self.db, cid, discovery_limit
                    )
                    if youtube_ytdlp_rate_limited():
                        youtube_persist_ytdlp_rate_limit(self.db)
                        rate_limited_run = True
                        remaining = youtube_ytdlp_rate_limit_remaining()
                        self.emit(
                            f"  [throttle] RATE_LIMITED during video discovery | waiting/retry did not complete | "
                            f"cooldown_remaining={remaining // 60}m {remaining % 60}s"
                        )
                    self.emit(f"  [discovery] yt-dlp video listing COMPLETE | {len(ytdlp_videos)} videos | complete={'yes' if ytdlp_complete else 'no/unknown'} | {time.monotonic() - discovery_started:.1f}s")
                except Exception as exc:
                    ytdlp_videos, ytdlp_complete = [], False
                    self.emit(f"  yt-dlp listing error: {type(exc).__name__}: {exc}")

                videos = youtube_merge_video_sources(inner_videos, ytdlp_videos, discovery_limit)
                if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR and videos and youtube_youtube_api_budget_available(self.db):
                    self.emit(f"  [youtube-api] standard metadata/statistics batch START | videos={len(videos)} | batch_size={youtube_YOUTUBE_API_VIDEO_BATCH_SIZE}")
                    youtube_youtube_api_enrich_videos_batch(run_id, self.db, videos)
                if rate_limited_run:
                    self.emit("  [run] stopping before further video enrichment because the yt-dlp session is rate-limited.")
                    break
                stats["videos_discovered"] += len(videos)
                self.emit(
                    f"  Video discovery: InnerTube={len(inner_videos)}, "
                    f"yt-dlp={len(ytdlp_videos)}, merged={len(videos)}"
                )

                full_index_complete = bool(limit <= 0 and not already_indexed and ytdlp_complete)
                if already_indexed:
                    full_index_complete = True

                if not videos:
                    self.emit(
                        "  WARNING: 0 videos extracted; recorded as extraction failure/unknown, "
                        "not a confirmed zero-video channel."
                    )
                    self.db.error(
                        run_id, channel_id=cid, stage="listing", endpoint="browse/channel/videos",
                        status=None, exc_type="NoVideosExtracted",
                        message="No video records extracted",
                        detail="Both InnerTube and yt-dlp discovery returned no accessible video records.",
                    )
                    continue

                plan = []
                self.emit(f"  [videos] {len(videos)} video records discovered; listing them before enrichment...")
                for discovery_i, video in enumerate(videos, 1):
                    if youtube_stop_requested():
                        break
                    video["channel_id"] = cid
                    action = youtube_choose_video_action(self.db, video, mode, force_refresh)
                    db_action = self.db.register_video_discovery(run_id, video)
                    if video.get("video_id") == priority_retried_video_id:
                        action = "SKIP"
                    plan.append((video, action))
                    title = (video.get("title") or "(untitled)").replace("\n", " ").strip()
                    if len(title) > 110:
                        title = title[:107] + "..."
                    published = video.get("published_text") or video.get("upload_date") or "?"
                    duration = youtube_format_duration(video.get("duration_seconds"))
                    self.emit(
                        f"    [discover {discovery_i}/{len(videos)}] {video.get('video_id','')} | "
                        f"{published} | {duration} | {title}"
                    )
                    self.emit(
                        f"      [db] video_ingestion {db_action} | action={action} | "
                        f"last_discovered_at={youtube_now_utc()}"
                    )

                if not plan:
                    self.emit("  STOP requested before video indexing completed.")
                    break

                self.db.log_run_db_counts(run_id, prefix="  [db] after discovery")

                # After a channel has been fully cataloged, also resume a bounded
                # backlog of older incomplete videos so a throttled/stopped baseline
                # does not get trapped behind the newest-250 discovery window.
                if limit <= 0 and already_indexed and not force_refresh and youtube_BACKLOG_ENRICHMENT_BATCH > 0:
                    existing_ids = {v.get("video_id") for v, _ in plan}
                    backlog_videos = self.db.list_video_backlog(cid, mode, youtube_BACKLOG_ENRICHMENT_BATCH)
                    added_backlog = 0
                    for backlog_video in backlog_videos:
                        if backlog_video.get("video_id") in existing_ids:
                            continue
                        action = youtube_choose_video_action(self.db, backlog_video, mode, False)
                        if action == "SKIP":
                            continue
                        plan.append((backlog_video, action))
                        existing_ids.add(backlog_video.get("video_id"))
                        added_backlog += 1
                    if added_backlog:
                        self.emit(f"  [backlog] queued {added_backlog} older incomplete videos for resume")

                if youtube_COLLECT_COMMENTS:
                    # Comments are most useful for near-real-time sentiment work,
                    # so when enabled process the newest videos first while keeping
                    # incomplete backlog entries eligible for later repair.
                    plan.sort(key=lambda pair: int((pair[0] or {}).get("timestamp") or 0), reverse=True)
                    self.emit("  [comments] YouTube comment toggle=ON | newest videos prioritized")

                self.db.update_channel_index(
                    cid, complete=full_index_complete, discovered_count=len(plan)
                )

                api_refreshed_ids = set()
                if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
                    api_refresh_videos = [video for video, action in plan if action == "PERFORMANCE_REFRESH"]
                    if api_refresh_videos and youtube_youtube_api_budget_available(self.db):
                        youtube_refresh_performance_batch_via_youtube_api(run_id, self.db, api_refresh_videos)
                        api_refreshed_ids = {v.get("video_id") for v in api_refresh_videos}

                concurrency = youtube_HIGH_THROUGHPUT_CONCURRENCY if youtube_THROUGHPUT_PROFILE == "high" else 1
                batches = [plan[i:i + concurrency] for i in range(0, len(plan), concurrency)]
                completed_since_count = 0
                global_progress = 0

                def _process_video_item(item):
                    video, action = item
                    if action == "SKIP":
                        return video, action, None, False
                    if action == "PERFORMANCE_REFRESH" and video.get("video_id") in api_refreshed_ids:
                        return video, "API_REFRESHED", None, False
                    try:
                        result = youtube_enrich_video_with_rate_limit_retry(
                            run_id, self.db, video, mode, action
                        )
                        return video, action, result, False
                    except Exception as exc:
                        return video, action, exc, True

                for batch_no, batch in enumerate(batches, 1):
                    if youtube_stop_requested():
                        break
                    if youtube_ORCHESTRATED_RUN and youtube_ytdlp_rate_limited():
                        self.emit("      [orchestrator] YouTube throttle state active; yielding to next platform.")
                        break

                    futures = {}
                    with ThreadPoolExecutor(max_workers=concurrency, thread_name_prefix="yt-video") as executor:
                        for local_i, (video, action) in enumerate(batch):
                            j = (batch_no - 1) * concurrency + local_i + 1
                            title = (video.get("title") or "")[:95]
                            if action == "SKIP":
                                futures[executor.submit(_process_video_item, (video, action))] = j
                                continue
                            stats_key = {
                                "NEW": "new", "RESUME": "resume", "PERFORMANCE_REFRESH": "performance_refresh",
                                "HEAVY_REFRESH": "heavy_refresh", "FORCE": "force",
                            }.get(action)
                            if stats_key and not (action == "PERFORMANCE_REFRESH" and video.get("video_id") in api_refreshed_ids):
                                stats[stats_key] += 1
                            self.emit(f"    [{j}/{len(plan)}] {video['video_id']} | {title} | {action} | worker_pool={concurrency}")
                            futures[executor.submit(_process_video_item, (video, action))] = j

                        for future in as_completed(futures):
                            j = futures[future]
                            video, action, result, failed = future.result()
                            global_progress += 1
                            self.progress(global_progress, len(plan), "video")

                            if action == "API_REFRESHED":
                                stats["performance_refresh"] += 1
                                self.emit(f"    [{j}/{len(plan)}] {video['video_id']} | {video.get('title','')[:95]} | PERFORMANCE_REFRESH via YouTube Data API")
                                continue

                            if action == "SKIP":
                                stats["skipped"] += 1
                                state = self.db.get_video_sync(video["video_id"]) or {}
                                last = state.get("last_enriched_at") or state.get("last_performance_refresh_at") or "unknown"
                                self.emit(f"    [{j}/{len(plan)}] {video['video_id']} | {video.get('title','')[:95]} | SKIP already indexed (last={last})")
                                continue

                            if failed:
                                exc = result
                                self.emit(f"      ERROR: {type(exc).__name__}: {exc}")
                                self.db.error(
                                    run_id, channel_id=cid, video_id=video.get("video_id"),
                                    stage="video_enrichment", endpoint="player/yt-dlp/captions",
                                    status=None, exc_type=type(exc).__name__, message=str(exc),
                                    detail=traceback.format_exc(),
                                )
                                video["player_status"] = "ENRICHMENT_FAILED"
                                try:
                                    self.db.mark_video_enrichment(run_id, video, full=False, heavy=False, error=f"{type(exc).__name__}: {exc}")
                                    self.db.upsert_video(video)
                                    self.db.video_snapshot(run_id, video)
                                except Exception:
                                    pass
                            else:
                                self.videos.append(video)
                                self.emit(
                                    f"      [stage] complete | yt-dlp={video.get('yt_dlp_status','?')} "
                                    f"player={video.get('player_status','?')}"
                                )

                            completed_since_count += 1
                            if (
                                completed_since_count >= youtube_RUN_DB_COUNTS_EVERY
                                or global_progress == len(plan)
                            ):
                                self.db.log_run_db_counts(run_id, prefix=f"      [db] progress {global_progress}/{len(plan)}")
                                completed_since_count = 0

                    if youtube_ytdlp_rate_limited():
                        self.emit("      [throttle] rate-limit circuit breaker active; no additional video batch will be submitted.")
                        break

                rate_limited_run = youtube_ytdlp_rate_limited()
                if rate_limited_run:
                    self.emit("  [run] yt-dlp rate-limit circuit breaker active; preserving progress and ending run.")

                shorts = sum(1 for v in videos if v.get("classification") == "Short")
                lives = sum(1 for v in videos if v.get("classification") == "Livestream")
                longform = sum(1 for v in videos if v.get("classification") == "Longform")
                self.emit(
                    f"  Completed channel {input_i}/{total_inputs} | {raw} | discovered={len(plan)} | "
                    f"Short={shorts} Longform={longform} Live={lives}"
                )
                self.emit(
                    f"[YOUTUBE POSITION] completed {input_i}/{total_inputs} | remaining={max(0, total_inputs-input_i)}"
                )
                if rate_limited_run:
                    break

            status = "RATE_LIMITED" if rate_limited_run or youtube_ytdlp_rate_limited() else ("STOPPED" if youtube_stop_requested() else "COMPLETED")
            note = (
                f"channels={len(self.channels)} resolved_inputs={stats['resolved_inputs']} "
                f"duplicate_inputs={stats['duplicate_inputs']} failed_inputs={stats['failed_inputs']} "
                f"discovered={stats['videos_discovered']} new={stats['new']} resume={stats['resume']} "
                f"performance_refresh={stats['performance_refresh']} heavy_refresh={stats['heavy_refresh']} "
                f"force={stats['force']} skipped={stats['skipped']} enriched={len(self.videos)} "
                f"ytdlp_request_starts={youtube_YTDLP_VIDEO_REQUEST_STARTS} rate_limit_events={youtube_YTDLP_RATE_LIMIT_EVENTS}"
            )
            self.db.finish_run(run_id, status, note)
            self.db.log_run_db_counts(run_id, prefix="[db] final")
            self.emit(f"\n[run] {status} | {note}")
            self.emit(f"[run] database: {youtube_DB_PATH}")
            return run_id

        except Exception as exc:
            self.db.finish_run(run_id, "FAILED", f"{type(exc).__name__}: {exc}")
            self.emit(f"[run] FATAL: {type(exc).__name__}: {exc}")
            self.emit(traceback.format_exc())
            raise


