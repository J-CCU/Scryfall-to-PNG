def _v52_public_backoff_until(db: Optional[instagram_Database]) -> float:
    if db is None:
        return 0.0
    try:
        value = float(db.get_runtime_state("instagram_access_backoff_until") or 0)
        who = str(db.get_runtime_state("instagram_access_backoff_username") or "")
        reason = str(db.get_runtime_state("instagram_access_backoff_reason") or "")
        if who in {"graph-api", "graph-auth"} or "meta graph" in reason.lower():
            return 0.0
        return value if value > time.time() else 0.0
    except Exception:
        return 0.0


def _v52_clamp_legacy_public_backoff(db: Optional[instagram_Database]) -> None:
    if db is None:
        return
    try:
        who = str(db.get_runtime_state("instagram_access_backoff_username") or "")
        reason = str(db.get_runtime_state("instagram_access_backoff_reason") or "")
        until = float(db.get_runtime_state("instagram_access_backoff_until") or 0)
        if who in {"graph-api", "graph-auth"} or "meta graph" in reason.lower():
            return
        now = time.time()
        # Old shared Graph/public escalation can leave a public 401 parked for
        # 120-240 minutes.  A migrated public failure starts from the public
        # circuit's own first step instead.
        if until > now + V52_IG_PUBLIC_BACKOFF_SCHEDULE[0]:
            new_until = now + V52_IG_PUBLIC_BACKOFF_SCHEDULE[0]
            db.set_runtime_state("instagram_access_backoff_until", str(new_until))
            db.set_runtime_state("instagram_public_backoff_events", "1")
            instagram_log(
                f"[instagram/v52] legacy public cooldown clamped | old_remaining={int(until-now)//60}m | "
                f"new_remaining={int(V52_IG_PUBLIC_BACKOFF_SCHEDULE[0])//60}m"
            )
        # The legacy shared event count is no longer authoritative for public access.
        db.set_runtime_state("instagram_access_backoff_events", "0")
    except Exception as exc:
        instagram_log(f"[instagram/v52] public cooldown migration skipped | {type(exc).__name__}: {exc}")


def v19__ig_set_access_backoff_v52(db: instagram_Database, reason: str, username: str = "") -> float:
    # Graph has its own V50 circuit.  Keep this compatibility branch so an older
    # call site can never contaminate the public circuit again.
    if username in {"graph-api", "graph-auth"} or "meta graph" in str(reason).lower():
        return _v50_set_graph_cooldown(db, reason, auth=(username == "graph-auth"))
    try:
        prior = int(float(db.get_runtime_state("instagram_public_backoff_events") or 0))
    except Exception:
        prior = 0
    idx = min(max(0, prior), len(V52_IG_PUBLIC_BACKOFF_SCHEDULE) - 1)
    cooldown = float(V52_IG_PUBLIC_BACKOFF_SCHEDULE[idx])
    until = time.time() + cooldown
    db.set_runtime_state("instagram_access_backoff_until", str(until))
    db.set_runtime_state("instagram_access_backoff_reason", str(reason)[:1200])
    db.set_runtime_state("instagram_access_backoff_username", str(username or ""))
    db.set_runtime_state("instagram_public_backoff_events", str(prior + 1))
    instagram_log(
        f"[instagram/v52] PUBLIC SOURCE COOLDOWN | retry_in={int(cooldown)//60}m | "
        f"Graph/offline DB lanes remain enabled | account=@{username or 'unknown'} | reason={str(reason)[:220]}"
    )
    return until

