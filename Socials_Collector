# Comment-only repair avoids repeating expensive payload extraction when the
# payload is already proven complete.
def instagram_choose_post_action_v42(db: instagram_Database, p: dict, mode: str, force_refresh: bool = False) -> str:
    if force_refresh:
        return "FORCE"
    row = db.get_post_state(str(p.get("post_id") or ""))
    if not row:
        return "NEW"
    state = dict(row)
    if not _v42_instagram_payload_complete(db, state, mode == "Maximum", require_comments=False):
        return "RESUME"
    if instagram_COLLECT_COMMENTS and not _v42_ig_comments_terminal(db, state):
        return "COMMENT_REPAIR"
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE":
        _v42_refresh_ig_audit(db, str(p.get("post_id") or ""))
        with db.lock:
            db.conn.execute("UPDATE post_ingestion SET enrichment_state='COMPLETE',current_stage='COMPLETE',last_error=NULL WHERE post_id=?", (p.get("post_id"),))
            db.conn.commit()
    age = instagram_post_age_days(p)
    refresh_hours = instagram_ACTIVE_POST_REFRESH_HOURS if age is None or age <= 30 else instagram_MATURE_POST_REFRESH_HOURS
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = _v29_hours(last)
    return "PERFORMANCE_REFRESH" if elapsed is None or elapsed >= refresh_hours else "SKIP"

