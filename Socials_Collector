# ============================================================================

def youtube_scrape_videos_innertube(run_id: int, db: youtube_Database, channel_id: str, limit: int) -> List[dict]:
    videos: List[dict] = []
    seen = set()
    visited = set()

    def add_data(data: dict, request_kind: str, status: int, body: str) -> List[str]:
        raw_id = db.raw(
            run_id,
            channel_id=channel_id,
            video_id=None,
            source="innertube",
            endpoint="browse",
            status=status,
            payload=body if body else data,
            content_type="application/json",
            note=request_kind,
        )
        new_tokens = youtube_extract_continuations(data)
        for renderer in youtube_extract_renderers(data):
            v = youtube_renderer_to_video(renderer, channel_id)
            if v and v["video_id"] not in seen:
                v["raw_listing_id"] = raw_id
                seen.add(v["video_id"])
                videos.append(v)
                if limit > 0 and len(videos) >= limit:
                    break
        return new_tokens

    # Channel Videos tab. The current WEB client frequently rejects this
    # undocumented browse form with HTTP 400. When that happens, do not make a
    # second uploads-playlist browse request; yt-dlp is the primary discovery
    # path and is much more reliable for current YouTube channel listings.
    inner_browse_failed = False
    if youtube_INNERTUBE_API_KEY:
        data, status, body = youtube_innertube_post(
            "browse",
            {"browseId": channel_id, "params": "EgZ2aWRlb3M%3D"},
        )
        if data:
            queue = add_data(data, "videos_tab", status, body)
            youtube_debug(f"[inner] videos tab: {len(videos)} video(s), {len(queue)} continuation(s)")
        else:
            queue = []
            inner_browse_failed = True
            if status == 400:
                youtube_debug("[inner] videos-tab browse HTTP 400; skipping InnerTube listing fallback and continuing with yt-dlp")
            else:
                youtube_debug(f"[inner] videos-tab browse failed | HTTP {status}")
    else:
        queue = []

    while queue and (limit <= 0 or len(videos) < limit):
        if youtube_stop_requested():
            break
        token = queue.pop(0)
        if token in visited:
            continue
        visited.add(token)

        data, status, body = youtube_innertube_post("browse", {"continuation": token})
        if not data:
            db.error(
                run_id,
                channel_id=channel_id,
                stage="inner_continuation",
                endpoint="browse",
                status=status,
                exc_type="InnerTubeError",
                message="Continuation request failed",
                detail=body[:1500],
            )
            continue

        new_tokens = add_data(data, "videos_tab_continuation", status, body)
        for nt in new_tokens:
            if nt not in visited:
                queue.append(nt)
        youtube_debug(f"[inner] continuation -> {len(videos)} video(s); queue={len(queue)}")
        time.sleep(youtube_PAGE_DELAY)

    # Upload playlist fallback only when the Videos tab was not itself a hard
    # HTTP-400 failure. Avoid a duplicate known-invalid browse call.
    if (limit <= 0 or len(videos) < limit) and not inner_browse_failed:
        playlist_id = youtube_uploads_playlist(channel_id)
        if playlist_id and youtube_INNERTUBE_API_KEY:
            data, status, body = youtube_innertube_post("browse", {"browseId": playlist_id})
            if data:
                queue = add_data(data, "uploads_playlist", status, body)
                while queue and (limit <= 0 or len(videos) < limit):
                    token = queue.pop(0)
                    if token in visited:
                        continue
                    visited.add(token)
                    data, status, body = youtube_innertube_post("browse", {"continuation": token})
                    if not data:
                        continue
                    new_tokens = add_data(data, "uploads_continuation", status, body)
                    for nt in new_tokens:
                        if nt not in visited:
                            queue.append(nt)
                    time.sleep(youtube_PAGE_DELAY)

    return videos[:limit] if limit > 0 else videos


