def _v43_pre_main_policy(argv=None) -> tuple:
    args = list(sys.argv if argv is None else argv)
    is_worker = len(args) >= 4 and args[1] == "--platform-worker"
    key = str(args[2]).lower() if is_worker else ""
    # Parent must never perform the deep audit before Tk exists. Each worker
    # must audit exactly its own DB before network work begins.
    return is_worker, key


