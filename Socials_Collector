            f"      [captions/v37] selected one track | video={video_id} | "
            f"lang={lang} type={track_type} ext={track.get('ext','')} | elapsed={elapsed:.1f}s"
        )
        return 1
    except Exception as exc:
        db.error(
            run_id, video_id=video_id, stage="caption_download",
            endpoint="yt-dlp selected caption track", status=None,
            exc_type=type(exc).__name__, message=str(exc), detail=base[:1000],
        )
        youtube_log(
            f"      [captions/v37] bounded caption attempt failed | video={video_id} | "
            f"{type(exc).__name__}: {str(exc)[:180]}"
        )
        return 0


