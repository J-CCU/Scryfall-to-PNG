# Make official-API quota accounting atomic now that comments and discovery can
# call the API concurrently.
def youtube_youtube_api_note_request_v38(db: Optional[youtube_Database] = None) -> int:
    global youtube_YOUTUBE_API_REQUEST_COUNT
    with youtube_YOUTUBE_API_REQUEST_LOCK:
        youtube_YOUTUBE_API_REQUEST_COUNT += 1
        n = youtube_YOUTUBE_API_REQUEST_COUNT
    if db is not None:
        try:
            today = youtube_youtube_api_today_key()
            now = youtube_now_utc()
            with db.lock:
                day_row = db.conn.execute(
                    "SELECT value FROM runtime_state WHERE key='youtube_api_quota_day'"
                ).fetchone()
                used_row = db.conn.execute(
                    "SELECT value FROM runtime_state WHERE key='youtube_api_quota_used'"
                ).fetchone()
                stored_day = str(day_row[0]) if day_row else ""
                used = youtube_safe_int(used_row[0]) if used_row else 0
                if stored_day != today:
                    used = 0
                    db.conn.execute(
                        "INSERT INTO runtime_state(key,value,updated_at) VALUES('youtube_api_quota_day',?,?) "
                        "ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at",
                        (today, now),
                    )
                db.conn.execute(
                    "INSERT INTO runtime_state(key,value,updated_at) VALUES('youtube_api_quota_used',?,?) "
                    "ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at",
                    (str(int(used or 0) + 1), now),
                )
                db.conn.commit()
        except Exception:
            pass
    return n


youtube_youtube_api_note_request = youtube_youtube_api_note_request_v38


def _v38_comment_budget_available(db: youtube_Database) -> bool:
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_YOUTUBE_API_KEY:
        return False
    try:
        today = youtube_youtube_api_today_key()
        with db.lock:
            day_row = db.conn.execute(
                "SELECT value FROM runtime_state WHERE key='youtube_api_quota_day'"
            ).fetchone()
            used_row = db.conn.execute(
                "SELECT value FROM runtime_state WHERE key='youtube_api_quota_used'"
            ).fetchone()
        stored_day = str(day_row[0]) if day_row else ""
        used = int(float(used_row[0])) if used_row and used_row[0] else 0
        if stored_day != today:
            used = 0
        comment_ceiling = max(0, youtube_YOUTUBE_API_DAILY_BUDGET - V38_COMMENT_API_RESERVE)
        return used < comment_ceiling
    except Exception:
        return True


def _v38_comment_api_get(
    db: youtube_Database, endpoint: str, params: dict
) -> Tuple[Optional[dict], int, str]:
    if not _v38_comment_budget_available(db):
        return None, 0, "V38_COMMENT_QUOTA_RESERVE"
    q = dict(params)
    q["key"] = youtube_YOUTUBE_API_KEY
    try:
        # Per-call request avoids sharing requests.Session mutation/state across
        # comment workers and the discovery lane.
        r = requests.get(
            f"https://www.googleapis.com/youtube/v3/{endpoint}",
            params=q,
            timeout=youtube_REQUEST_TIMEOUT,
            headers={"User-Agent": youtube_UA},
        )
        req_no = youtube_youtube_api_note_request(db)
        youtube_debug(
            f"[youtube-api/v38-comments] {endpoint} request #{req_no} | status={r.status_code}"
        )
        body = r.text[:4000]
        if r.status_code != 200:
            return None, r.status_code, body
        return r.json(), r.status_code, body
    except Exception as exc:
        return None, 0, f"{type(exc).__name__}: {exc}"


def _v38_api_error_reason(body: str) -> str:
    try:
        payload = json.loads(body or "{}")
        errors = ((payload.get("error") or {}).get("errors") or [])
        if errors and isinstance(errors[0], dict):
            return str(errors[0].get("reason") or "")
    except Exception:
        pass
    return ""


def _v38_mark_comment_attempt(db: youtube_Database, video_id: str) -> None:
    with db.lock:
        db.conn.execute(
            "UPDATE video_ingestion SET last_comments_attempt_at=?, current_stage='comments', "
            "enrichment_state=CASE WHEN enrichment_state='COMPLETE' THEN 'IN_PROGRESS' ELSE enrichment_state END "
            "WHERE video_id=?",
            (youtube_now_utc(), video_id),
        )
        db.conn.commit()


def _v38_mark_comment_success(db: youtube_Database, video_id: str, status: str) -> None:
    db.mark_video_stage(video_id, "comments", status)
    with db.lock:
        db.conn.execute(
            "UPDATE video_ingestion SET last_comments_refresh_at=?, last_comments_attempt_at=?, last_error=NULL "
            "WHERE video_id=?",
            (youtube_now_utc(), youtube_now_utc(), video_id),
        )
        db.conn.commit()
    _v38_finalize_video(db, video_id)


def _v38_mark_comment_deferred(db: youtube_Database, video_id: str, status: str) -> None:
    db.mark_video_stage(video_id, "comments", status)
    with db.lock:
        v13__set_checkpoint(
            db.conn, "video_ingestion", "video_id", video_id,
            state="IN_PROGRESS", stage="comments", error_marker=None,
        )
        db.conn.commit()


def _v38_finalize_video(db: youtube_Database, video_id: str) -> bool:
    state = db.get_video_sync(video_id) or {}
    payload_ok = _v35_youtube_payload_complete(db, state, "Maximum")
    comments_ok = _v38_comments_complete(db, state)
    complete = bool(payload_ok and comments_ok)
    with db.lock:
        v13__set_checkpoint(
            db.conn, "video_ingestion", "video_id", video_id,
            state=("COMPLETE" if complete else "IN_PROGRESS"),
            stage=("COMPLETE" if complete else ("comments" if payload_ok else "FINALIZE")),
            error_marker=None,
        )
        if complete:
            db.conn.execute("UPDATE video_ingestion SET last_error=NULL WHERE video_id=?", (video_id,))
        db.conn.commit()
    return complete


def _v38_fetch_comments_api(
    run_id: int, db: youtube_Database, video: dict
) -> Tuple[str, int]:
    vid = str(video.get("video_id") or "")
    if not vid:
        return "FAILED", 0
    _v38_mark_comment_attempt(db, vid)
    rows_written = 0
    page_token = ""
    pages = 0
    try:
        while not youtube_stop_requested():
            params = {
                "part": "snippet,replies",
                "videoId": vid,
                "maxResults": youtube_YOUTUBE_API_COMMENT_PAGE_SIZE,
                "order": "time",
                "textFormat": "plainText",
            }
            if page_token:
                params["pageToken"] = page_token
            data, status, body = _v38_comment_api_get(db, "commentThreads", params)
            if data is None:
                reason = _v38_api_error_reason(body)
                if status == 403 and (reason == "commentsDisabled" or "commentsDisabled" in body):
                    _v38_mark_comment_success(db, vid, "SUCCESS_EMPTY")
                    return "SUCCESS_EMPTY", rows_written
                if body == "V38_COMMENT_QUOTA_RESERVE" or reason in {
                    "quotaExceeded", "dailyLimitExceeded", "dailyLimitExceededUnreg"
                }:
                    _v38_mark_comment_deferred(db, vid, "DEFERRED_QUOTA")
                    return "DEFERRED_QUOTA", rows_written
                db.error(
                    run_id, channel_id=video.get("channel_id"), video_id=vid,
                    stage="youtube_comments", endpoint="commentThreads", status=status or None,
                    exc_type="YouTubeAPIError", message=f"commentThreads failed: {reason or body[:300]}",
                    detail=body[:2000],
                )
                db.mark_video_stage(vid, "comments", "FAILED")
                return "FAILED", rows_written

            pages += 1
            raw_id = db.raw(
                run_id, channel_id=video.get("channel_id"), video_id=vid,
                source="youtube_api", endpoint="commentThreads", status=status,
                payload=data, content_type="application/json", note="video_comments_page_v38",
            )
            batch_rows: List[dict] = []
            for thread in data.get("items") or []:
                sn = thread.get("snippet") or {}
                top = sn.get("topLevelComment") or {}
                top_id = str(top.get("id") or "")
                c = v18__youtube_comment_from_api_item(top, vid, "root")
                if c and c.get("id"):
                    batch_rows.append(c)

                included = ((thread.get("replies") or {}).get("comments") or [])
                total_replies = int(sn.get("totalReplyCount") or 0)
                # If all replies are already embedded, use them directly. If the
                # thread says more exist, comments.list becomes authoritative for
                # that parent so every accessible reply is paginated.
                if total_replies <= len(included):
                    for reply in included:
                        rc = v18__youtube_comment_from_api_item(reply, vid, top_id or "root")
                        if rc and rc.get("id"):
                            batch_rows.append(rc)
                elif top_id:
                    reply_token = ""
                    while not youtube_stop_requested():
                        rp = {
                            "part": "snippet", "parentId": top_id,
                            "maxResults": youtube_YOUTUBE_API_COMMENT_PAGE_SIZE,
                            "textFormat": "plainText",
                        }
                        if reply_token:
                            rp["pageToken"] = reply_token
                        rdata, rstatus, rbody = _v38_comment_api_get(db, "comments", rp)
                        if rdata is None:
                            reason = _v38_api_error_reason(rbody)
                            if rbody == "V38_COMMENT_QUOTA_RESERVE" or reason in {
                                "quotaExceeded", "dailyLimitExceeded", "dailyLimitExceededUnreg"
                            }:
                                if batch_rows:
                                    rows_written += db.insert_comments_batch(run_id, batch_rows, raw_id)
                                _v38_mark_comment_deferred(db, vid, "DEFERRED_QUOTA")
                                return "DEFERRED_QUOTA", rows_written
                            # Preserve already-collected top-level data, but leave
                            # the stage partial so the missing reply page is retried.
                            if batch_rows:
                                rows_written += db.insert_comments_batch(run_id, batch_rows, raw_id)
                            _v38_mark_comment_deferred(db, vid, "PARTIAL")
                            return "PARTIAL", rows_written
                        reply_raw_id = db.raw(
                            run_id, channel_id=video.get("channel_id"), video_id=vid,
                            source="youtube_api", endpoint="comments", status=rstatus,
                            payload=rdata, content_type="application/json",
                            note="video_comment_replies_page_v38",
                        )
                        reply_rows = []
                        for reply in rdata.get("items") or []:
                            rc = v18__youtube_comment_from_api_item(reply, vid, top_id)
                            if rc and rc.get("id"):
                                reply_rows.append(rc)
                        if reply_rows:
                            rows_written += db.insert_comments_batch(run_id, reply_rows, reply_raw_id)
                        reply_token = str(rdata.get("nextPageToken") or "")
                        if not reply_token:
                            break

            if batch_rows:
                rows_written += db.insert_comments_batch(run_id, batch_rows, raw_id)
            page_token = str(data.get("nextPageToken") or "")
            if not page_token:
                break

        if youtube_stop_requested():
            _v38_mark_comment_deferred(db, vid, "PARTIAL")
            return "PARTIAL", rows_written

        expected = youtube_safe_int(video.get("comment_count"))
        with db.lock:
            actual_row = db.conn.execute(
                "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)
            ).fetchone()
        actual = int(actual_row[0] or 0) if actual_row else 0
        # Full API pagination is the completeness proof. Published scalar counts
        # can differ from retrievable public rows because comments can disappear
        # or be inaccessible between the statistics and comments requests.
        status = "SUCCESS" if actual > 0 else "SUCCESS_EMPTY"
        _v38_mark_comment_success(db, vid, status)
        if expected is not None and expected != actual:
            youtube_log(
                f"      [comments/v38] count note | video={vid} | statistics={expected} | "
                f"persisted_accessible={actual} | API pagination complete"
            )
        youtube_log(
            f"      [comments/v38] {status} | video={vid} | pages={pages} | "
            f"rows_written_or_updated={rows_written} | persisted={actual}"
        )
        return status, rows_written
    except Exception as exc:
        db.error(
            run_id, channel_id=video.get("channel_id"), video_id=vid,
            stage="youtube_comments", endpoint="commentThreads/comments", status=None,
            exc_type=type(exc).__name__, message=str(exc), detail=traceback.format_exc(),
        )
        try:
            db.mark_video_stage(vid, "comments", "FAILED")
        except Exception:
            pass
        return "FAILED", rows_written


def _v38_collect_comments(run_id: int, db: youtube_Database, video: dict) -> Tuple[str, int]:
    if youtube_USE_YOUTUBE_DATA_API_ACCELERATOR and youtube_YOUTUBE_API_KEY:
        return _v38_fetch_comments_api(run_id, db, video)
    # Credential-free fallback keeps comments mandatory, but it is intentionally
    # isolated from the primary yt-dlp lane. An API key is strongly preferred.
    _v38_mark_comment_attempt(db, str(video.get("video_id") or ""))
    status, count, _ = v18__youtube_fetch_comments_ytdlp(run_id, db, video)
    vid = str(video.get("video_id") or "")
    if status in {"SUCCESS", "SUCCESS_EMPTY"}:
        _v38_mark_comment_success(db, vid, status)
    elif status in {"RATE_LIMITED", "STOPPED", "PARTIAL"}:
        _v38_mark_comment_deferred(db, vid, status)
    else:
        db.mark_video_stage(vid, "comments", status)
    return status, count


# Capture the fully patched V37/V13 heavy retry function before replacing the
# public name with queue submission.
_v38_heavy_enrich_orig = youtube_enrich_video_with_rate_limit_retry
_v38_rate_limited_orig = youtube_ytdlp_rate_limited


class V38YouTubePipeline:
    def __init__(self, run_id: int, db: youtube_Database, mode: str, emit: Callable[[str], None]):
        self.run_id = int(run_id)
        self.db = db
        self.mode = str(mode)
        self.emit = emit
        self.heavy_q: "queue.Queue" = queue.Queue()
        self.comment_q: "queue.Queue" = queue.Queue()
        self.lock = threading.RLock()
        self.heavy_pending = set()
        self.comment_pending = set()
        self.heavy_submitted = 0
        self.heavy_completed = 0
        self.heavy_failed = 0
        self.comment_submitted = 0
        self.comment_completed = 0
        self.comment_failed = 0
        self.comment_deferred = 0
        self.closed = False
        self.heavy_threads = [
            threading.Thread(target=self._heavy_worker, name=f"v38-ytdlp-{i+1}", daemon=True)
            for i in range(V38_YTDLP_WORKERS)
        ]
        self.comment_threads = [
            threading.Thread(target=self._comment_worker, name=f"v38-comments-{i+1}", daemon=True)
            for i in range(V38_COMMENT_WORKERS)
        ]
        for t in self.heavy_threads + self.comment_threads:
            t.start()

    def submit_heavy(self, video: dict, action: str) -> bool:
        vid = str((video or {}).get("video_id") or "")
        if not vid:
            return False
        with self.lock:
            if vid in self.heavy_pending:
                return False
            self.heavy_pending.add(vid)
            self.heavy_submitted += 1
        self.heavy_q.put((dict(video), str(action)))
        if self.heavy_submitted % 100 == 0:
            self.emit(
                f"[youtube/v38 queue] discovery still running | yt-dlp submitted={self.heavy_submitted} "
                f"pending={self.heavy_q.qsize()} | comments submitted={self.comment_submitted} "
                f"pending={self.comment_q.qsize()}"
            )
        return True

    def submit_comments(self, video: dict, *, force: bool = False) -> bool:
        vid = str((video or {}).get("video_id") or "")
        if not vid:
            return False
        state = self.db.get_video_sync(vid) or {}
        if not force and not _v38_comment_refresh_due(self.db, video, state):
            return False
        with self.lock:
            if vid in self.comment_pending:
                return False
            self.comment_pending.add(vid)
            self.comment_submitted += 1
        self.comment_q.put(dict(video))
        return True

    def _heavy_worker(self) -> None:
        while True:
            item = self.heavy_q.get()
            if item is None:
                self.heavy_q.task_done()
                return
            video, action = item
            vid = str(video.get("video_id") or "")
            try:
                _v38_heavy_enrich_orig(self.run_id, self.db, video, self.mode, action)
                with self.lock:
                    self.heavy_completed += 1
            except Exception as exc:
                with self.lock:
                    self.heavy_failed += 1
                youtube_log(
                    f"[youtube/v38 yt-dlp] ERROR | video={vid} | {type(exc).__name__}: {exc}"
                )
            finally:
                # Keep the video id in the run-wide seen set so another code path
                # cannot enqueue the same heavy job again after it finishes.
                self.heavy_q.task_done()

    def _comment_worker(self) -> None:
        while True:
            video = self.comment_q.get()
            if video is None:
                self.comment_q.task_done()
                return
            vid = str(video.get("video_id") or "")
            try:
                status, _count = _v38_collect_comments(self.run_id, self.db, video)
                with self.lock:
                    self.comment_completed += 1
                    if status in {"DEFERRED_QUOTA", "PARTIAL", "RATE_LIMITED", "STOPPED"}:
                        self.comment_deferred += 1
                    elif status not in {"SUCCESS", "SUCCESS_EMPTY"}:
                        self.comment_failed += 1
            except Exception as exc:
                with self.lock:
                    self.comment_completed += 1
                    self.comment_failed += 1
                youtube_log(
                    f"[youtube/v38 comments] ERROR | video={vid} | {type(exc).__name__}: {exc}"
                )
            finally:
                # Keep the video id in the run-wide seen set. Performance refresh
                # and discovery can race; one comment crawl per video per run is enough.
                self.comment_q.task_done()

    def snapshot(self) -> dict:
        with self.lock:
            return {
                "heavy_submitted": self.heavy_submitted,
                "heavy_completed": self.heavy_completed,
                "heavy_failed": self.heavy_failed,
                "heavy_pending": self.heavy_q.qsize(),
                "comment_submitted": self.comment_submitted,
                "comment_completed": self.comment_completed,
                "comment_failed": self.comment_failed,
                "comment_deferred": self.comment_deferred,
                "comment_pending": self.comment_q.qsize(),
            }

    def drain(self) -> dict:
        self.emit(
            f"[youtube/v38] discovery/API phase complete | draining independent lanes | "
            f"yt-dlp_workers={V38_YTDLP_WORKERS} comment_workers={V38_COMMENT_WORKERS}"
        )
        last_log = 0.0
        while self.heavy_q.unfinished_tasks or self.comment_q.unfinished_tasks:
            now = time.monotonic()
            if now - last_log >= V38_DRAIN_LOG_SECONDS:
                s = self.snapshot()
                self.emit(
                    f"[youtube/v38 progress] yt-dlp={s['heavy_completed']}/{s['heavy_submitted']} "
                    f"queued={s['heavy_pending']} failed={s['heavy_failed']} | "
                    f"comments={s['comment_completed']}/{s['comment_submitted']} "
                    f"queued={s['comment_pending']} deferred={s['comment_deferred']} "
                    f"failed={s['comment_failed']}"
                )
                last_log = now
            time.sleep(0.25)
        return self.snapshot()

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        for _ in self.heavy_threads:
            self.heavy_q.put(None)
        for _ in self.comment_threads:
            self.comment_q.put(None)
        self.heavy_q.join()
        self.comment_q.join()
        for t in self.heavy_threads + self.comment_threads:
            t.join(timeout=5.0)


def _v38_current_pipeline() -> Optional[V38YouTubePipeline]:
    with _V38_PIPELINE_LOCK:
        return _V38_PIPELINE


def youtube_enrich_video_with_rate_limit_retry_v38(
    run_id: int, db: youtube_Database, video: dict, mode: str, action: str
) -> dict:
    pipeline = _v38_current_pipeline()
    if pipeline is None:
        return _v38_heavy_enrich_orig(run_id, db, video, mode, action)

    # Comment-only actions never touch yt-dlp. For all heavy actions, enqueue
    # comments separately first so API work can overlap the slower extractor.
    force_comments = action == "FORCE"
    pipeline.submit_comments(video, force=force_comments)
    if action in {"COMMENT_REPAIR", "COMMENT_REFRESH"}:
        video["yt_dlp_status"] = (db.get_video_sync(str(video.get("video_id") or "")) or {}).get("yt_dlp_status") or "UNCHANGED"
        video["player_status"] = (db.get_video_sync(str(video.get("video_id") or "")) or {}).get("player_status") or "UNCHANGED"
        return video

    pipeline.submit_heavy(video, action)
    # These are display-only values in the base runner; the background worker
    # writes the authoritative statuses to video_ingestion.
    video["yt_dlp_status"] = "QUEUED_V38"
    video["player_status"] = "QUEUED_V38"
    return video


