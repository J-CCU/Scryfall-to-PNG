    def raw(
        self,
        run_id: int,
        *,
        channel_id: Optional[str],
        video_id: Optional[str],
        source: str,
        endpoint: str,
        status: Optional[int],
        payload: Any,
        content_type: str,
        note: str = "",
    ) -> int:
        if isinstance(payload, bytes):
            raw = payload
        elif isinstance(payload, str):
            raw = payload.encode("utf-8", errors="replace")
        else:
            raw = youtube_compact_json(payload).encode("utf-8", errors="replace")

        with self.lock:
            cur = self.conn.execute(
                """
                INSERT INTO raw_data
                (scrape_run_id, captured_at, channel_id, video_id, source,
                 endpoint, http_status, content_type, compression, sha256,
                 raw_bytes, payload_gzip, note)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'gzip', ?, ?, ?, ?)
                """,
                (
                    run_id,
                    youtube_now_utc(),
                    channel_id,
                    video_id,
                    source,
                    endpoint,
                    status,
                    content_type,
                    youtube_sha256_bytes(raw),
                    len(raw),
                    youtube_gzip_bytes(raw),
                    note,
                ),
            )
            self.conn.commit()
            return int(cur.lastrowid)

