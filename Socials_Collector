# being permanently finalized from a metadata-only fallback. Unavailable/private
# records can still become terminal-complete when their public metadata was saved.
_v49_enrich_from_player_prev = youtube_enrich_from_player

def youtube_enrich_from_player(v: dict, data: dict) -> None:
    _v49_enrich_from_player_prev(v, data)
    play = (data or {}).get("playabilityStatus") or {}
    status = str(play.get("status") or "").upper()
    reason_parts = [str(play.get("reason") or "")]
    msgs = play.get("messages") or []
    if isinstance(msgs, list):
        reason_parts.extend(str(x) for x in msgs if x)
    reason = " ".join(reason_parts).strip()
    reason_l = reason.lower()
    micro = ((data or {}).get("microformat") or {}).get("playerMicroformatRenderer") or {}
    live = micro.get("liveBroadcastDetails") or {}
    start = live.get("startTimestamp")
    if start:
        try:
            dt = datetime.fromisoformat(str(start).replace("Z", "+00:00"))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            v["timestamp"] = int(dt.timestamp())
        except Exception:
            pass
    upcoming = (
        status == "LIVE_STREAM_OFFLINE"
        or "will begin" in reason_l
        or "upcoming" in reason_l
        or (bool(start) and not live.get("endTimestamp") and not youtube_boolish(v.get("is_live")))
    )
    if upcoming:
        v["live_status"] = "is_upcoming"
        v["availability"] = "upcoming"
        v["is_premiere"] = True if youtube_boolish(v.get("is_premiere")) else v.get("is_premiere", "")
    elif status in {"ERROR", "UNPLAYABLE", "LOGIN_REQUIRED"}:
        if any(token in reason_l for token in ("unavailable", "private", "deleted", "removed")):
            v["availability"] = "unavailable"
        elif any(token in reason_l for token in ("sign in", "login", "age-restricted", "age restricted")):
            v["availability"] = "auth_required"


# ---------------------------------------------------------------------------
# YouTube payload proof: raw_data.source is written as lowercase `innertube` by
# the live player path.  V45 compared it to `InnerTube`, leaving valid fallback
# payloads permanently MISSING_PAYLOAD.  Use case-insensitive source evidence.
# ---------------------------------------------------------------------------
def _v45_youtube_payload_expr(vi: str = "vi") -> str:
    return f"""
        {vi}.last_enriched_at IS NOT NULL
        AND NOT EXISTS(
            SELECT 1 FROM videos vv WHERE vv.video_id={vi}.video_id
              AND (COALESCE(vv.live_status,'')='is_upcoming' OR COALESCE(vv.availability,'')='upcoming')
        )
        AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id={vi}.video_id)
        AND (
            EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id
                   AND LOWER(COALESCE(r.source,''))='yt-dlp' AND r.note='video_full_info')
            OR (
                COALESCE({vi}.player_status,'')='SUCCESS'
                AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id
                           AND LOWER(COALESCE(r.source,''))='innertube')
            )
        )
        AND (
            EXISTS(SELECT 1 FROM formats f WHERE f.video_id={vi}.video_id)
            OR COALESCE({vi}.formats_status,'') IN
               ('SUCCESS_EMPTY','SUCCESS_FAST_PATH','SKIPPED_NO_API_KEY','SKIPPED_PERFORMANCE_REFRESH')
        )
        AND (
            EXISTS(SELECT 1 FROM caption_tracks c WHERE c.video_id={vi}.video_id)
            OR COALESCE({vi}.captions_status,'') IN
               ('SUCCESS_EMPTY','SKIPPED_NO_API_KEY','SKIPPED_PERFORMANCE_REFRESH')
        )
    """


_v44_youtube_payload_expr = _v45_youtube_payload_expr

_v49_normalize_youtube_prev = _v45_normalize_youtube_persisted_stages

def _v45_normalize_youtube_persisted_stages(db: youtube_Database) -> None:
    _v49_normalize_youtube_prev(db)
    # Repair timestamps/checkpoints for lowercase InnerTube evidence produced by
    # the actual writer.  This is local SQLite work only; no network calls.
    with db.lock:
        db.conn.execute("""
            UPDATE video_ingestion
            SET last_enriched_at=(SELECT MAX(s.captured_at) FROM video_snapshots s
                                  WHERE s.video_id=video_ingestion.video_id)
            WHERE last_enriched_at IS NULL
              AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id=video_ingestion.video_id)
              AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=video_ingestion.video_id
                         AND LOWER(COALESCE(r.source,'')) IN ('yt-dlp','innertube'))
        """)
        db.conn.commit()


