def _v42_scalar(conn: sqlite3.Connection, sql: str, params: tuple = ()):
    try:
        row = conn.execute(sql, params).fetchone()
        return row[0] if row else None
    except Exception:
        return None


def _v42_set_comment_evidence(db, table: str, id_col: str, item_id: str, evidence: str, source: str) -> None:
    try:
        with db.lock:
            db.conn.execute(
                f"UPDATE {table} SET comments_evidence=?,comments_last_source=? WHERE {id_col}=?",
                (str(evidence or ""), str(source or ""), str(item_id or "")),
            )
            db.conn.commit()
    except Exception:
        pass


def _v42_youtube_comment_terminal(db: youtube_Database, state: Optional[dict]) -> bool:
    if not state:
        return False
    d = dict(state)
    vid = str(d.get("video_id") or "")
    if not vid:
        return False
    status = str(d.get("comments_status") or "").upper()
    evidence = str(d.get("comments_evidence") or "").upper()
    with db.lock:
        actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)) or 0)
        expected = _v42_scalar(db.conn, "SELECT comment_count FROM videos WHERE video_id=?", (vid,))
    if status == "SUCCESS":
        return actual > 0
    if status in {"COMMENTS_DISABLED", "DISABLED"}:
        return True
    if status == "SUCCESS_EMPTY":
        if evidence in {
            "API_PAGINATION_COMPLETE", "API_COMMENTS_DISABLED", "YTDLP_METADATA_ZERO",
            "YTDLP_TRAVERSAL_COMPLETE_EMPTY", "LEGACY_METADATA_ZERO", "LEGACY_API_EMPTY"
        }:
            return True
        return expected is not None and int(expected or 0) == 0
    return False


# Replace the permissive V38 predicate.  All YouTube completion/finalization
# paths resolve this global at runtime, so they immediately inherit V42 proof.
def _v38_comments_complete_v42(db: youtube_Database, state: Optional[dict]) -> bool:
    # V48: comment evidence is mandatory only when the shared toggle is ON.
    # Existing comment rows/statuses remain untouched while OFF.
    if not youtube_COLLECT_COMMENTS:
        return True
    return _v42_youtube_comment_terminal(db, state)

_v38_comments_complete = _v38_comments_complete_v42


# Classify the source actually used by V41's API->fallback collector and reject
# an unproven zero from the slower fallback instead of silently finishing it.
_v42_yt_collect_prev = _v38_collect_comments

def _v38_collect_comments_v42(run_id: int, db: youtube_Database, video: dict) -> Tuple[str, int]:
    _v42_migrate_youtube(db)
    vid = str((video or {}).get("video_id") or "")
    api_was_eligible = bool(
        (not _v39_api_circuit_open(db))
        and (not _v41_transient_api_cooldown_open(db))
        and youtube_USE_YOUTUBE_DATA_API_ACCELERATOR
        and youtube_YOUTUBE_API_KEY
    )
    status, count = _v42_yt_collect_prev(run_id, db, video)
    with db.lock:
        actual = int(_v42_scalar(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,)) or 0)
        expected = _v42_scalar(db.conn, "SELECT comment_count FROM videos WHERE video_id=?", (vid,))
        latest = db.conn.execute(
            "SELECT source,note FROM raw_data WHERE video_id=? AND (note LIKE 'video_comments%' OR note LIKE 'video_comment_replies%') ORDER BY id DESC LIMIT 1",
            (vid,),
        ).fetchone()
    latest_source = str(latest[0] or "") if latest else ""
    latest_note = str(latest[1] or "") if latest else ""
    used_fallback = latest_source.lower() == "yt-dlp" and latest_note == "video_comments"

    if status == "SUCCESS" and actual > 0:
        source = "yt-dlp" if used_fallback else ("youtube_api" if api_was_eligible else latest_source or "unknown")
        evidence = "YTDLP_TRAVERSAL_COMPLETE" if used_fallback else "API_PAGINATION_COMPLETE"
        _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, evidence, source)
        return "SUCCESS", count

    if status == "SUCCESS_EMPTY":
        if used_fallback:
            if expected is not None and int(expected or 0) == 0:
                _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "YTDLP_METADATA_ZERO", "yt-dlp")
                return status, count
            # yt-dlp can legitimately return an empty comments list when the
            # comment surface was unavailable.  Without zero-count metadata or
            # API proof, do not turn that ambiguity into permanent completion.
            db.mark_video_stage(vid, "comments", "PENDING_UNVERIFIED_EMPTY")
            _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "YTDLP_EMPTY_UNVERIFIED", "yt-dlp")
            return "PENDING_UNVERIFIED_EMPTY", count
        # Official API success means pagination ended normally or the API
        # explicitly reported commentsDisabled; either is terminal evidence.
        evidence = "API_PAGINATION_COMPLETE" if latest_source.lower() == "youtube_api" else "API_COMMENTS_DISABLED"
        _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, evidence, "youtube_api")
        return status, count

    if status not in {"DEFERRED_QUOTA", "RATE_LIMITED", "STOPPED", "PARTIAL"}:
        _v42_set_comment_evidence(db, "video_ingestion", "video_id", vid, "INCOMPLETE", latest_source or "unknown")
    return status, count

_v38_collect_comments = _v38_collect_comments_v42


# ---------------------------------------------------------------------------
# Instagram comment collection: detect stop/partial traversal and fully page
# Graph comments/replies.  Evidence is consumed by update_post_stage below.
# ---------------------------------------------------------------------------
def _v42_ig_fetch_record(post_id: str, status: str, source: str, fetched: int) -> None:
    with _V42_IG_COMMENT_FETCH_LOCK:
        _V42_IG_COMMENT_FETCH[str(post_id)] = {
            "status": str(status), "source": str(source), "fetched": int(fetched or 0)
        }


def _v42_ig_collect_comments(self: instagram_Collector, run_id: int, p_obj: Any, post_id: str) -> int:
    if not instagram_COLLECT_COMMENTS:
        return 0
    pending = []
    raw_pending = []
    total = 0
    completed = True

    def flush() -> None:
        nonlocal pending, raw_pending, total
        if not pending:
            raw_pending = []
            return
        raw_ids = self.db.insert_raw_batch_v14(run_id, "", post_id, raw_pending)
        pairs = [(c, raw_id) for (c, _), raw_id in zip(pending, raw_ids)]
        total += self.db.insert_comments_batch_v14(run_id, post_id, pairs)
        pending = []
        raw_pending = []

    try:
        for comment in p_obj.get_comments():
            if instagram_stop_requested():
                completed = False
                break
            c = instagram_comment_to_dict(comment)
            if c.get("comment_id"):
                pending.append((c, None))
                raw_pending.append(("Instaloader", "comment_node", c.get("_raw_node") or {}))
            answers = getattr(comment, "answers", None)
            if answers is not None:
                for answer in answers:
                    if instagram_stop_requested():
                        completed = False
                        break
                    rc = instagram_comment_to_dict(answer, c.get("comment_id") or "")
                    if rc.get("comment_id"):
                        pending.append((rc, None))
                        raw_pending.append(("Instaloader", "comment_reply_node", rc.get("_raw_node") or {}))
                    if len(pending) >= 100:
                        flush()
                    if instagram_MAX_COMMENTS_PER_POST is not None and total >= instagram_MAX_COMMENTS_PER_POST:
                        completed = False
                        flush()
                        _v42_ig_fetch_record(post_id, "PARTIAL_LIMIT", "Instaloader", total)
                        return total
                if not completed:
                    break
            if len(pending) >= 100:
                flush()
            if instagram_MAX_COMMENTS_PER_POST is not None and total + len(pending) >= instagram_MAX_COMMENTS_PER_POST:
                completed = False
                flush()
                break
        flush()
        _v42_ig_fetch_record(post_id, "COMPLETE" if completed else "PARTIAL_STOP", "Instaloader", total)
        return total
    except Exception:
        flush()
        _v42_ig_fetch_record(post_id, "FAILED", "Instaloader", total)
        raise

instagram_Collector.collect_comments = _v42_ig_collect_comments


def _v42_graph_comment_row(c: dict, parent_id: Optional[str] = None) -> dict:
