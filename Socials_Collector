def v16__count(conn, sql: str, params: tuple = ()) -> int:
    try:
        row = conn.execute(sql, params).fetchone()
        return int(row[0] or 0) if row else 0
    except Exception:
        return 0


def v16__youtube_evidence_complete(db, state: Optional[dict], mode: str) -> bool:
    if not state or not state.get("last_enriched_at"):
        return False
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE":
        return False
    if state.get("yt_dlp_status") != "SUCCESS":
        return False
    vid = str(state.get("video_id") or "")
    if not vid:
        return False
    with db.lock:
        # Canonical snapshot is evidence that the final normalized record was persisted.
        if v16__count(db.conn, "SELECT COUNT(*) FROM video_snapshots WHERE video_id=?", (vid,)) < 1:
            return False
        # Successful yt-dlp status must have the actual raw payload behind it.
        if v16__count(db.conn, "SELECT COUNT(*) FROM raw_data WHERE video_id=? AND source='yt-dlp' AND note='video_full_info'", (vid,)) < 1:
            return False
        player_status = str(state.get("player_status") or "")
        if player_status not in {"SUCCESS", "SKIPPED_NO_API_KEY", "SKIPPED_FAST_PATH", "SKIPPED_PERFORMANCE_REFRESH"}:
            return False
        if player_status == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM raw_data WHERE video_id=? AND source='InnerTube'", (vid,)) < 1:
            # Player may have been successful without a raw record in a legacy run;
            # treat it as incomplete so it can be repaired rather than silently skipped.
            return False
        if mode == "Maximum":
            fs = str(state.get("formats_status") or "")
            if fs not in {"SUCCESS", "SUCCESS_EMPTY", "SUCCESS_FAST_PATH", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}:
                return False
            if fs == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM formats WHERE video_id=?", (vid,)) < 1:
                return False
            cs = str(state.get("captions_status") or "")
            if cs not in {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}:
                return False
            if cs == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM caption_tracks WHERE video_id=?", (vid,)) < 1:
                return False
    return True


def v16__instagram_evidence_complete(db, state, maximum: bool) -> bool:
    if not state or not state["last_enriched_at"]:
        return False
    d = dict(state)
    if str(d.get("enrichment_state") or "").upper() != "COMPLETE":
        return False
    pid = str(d.get("post_id") or "")
    if not pid:
        return False
    with db.lock:
        if v16__count(db.conn, "SELECT COUNT(*) FROM post_snapshots WHERE post_id=?", (pid,)) < 1:
            return False
        if v16__count(db.conn, "SELECT COUNT(*) FROM raw_data WHERE post_id=?", (pid,)) < 1:
            return False
        if instagram_COLLECT_YTDLP_ENRICHMENT and d.get("ytdlp_status") not in {"SUCCESS", "NO_DATA", "SKIPPED"}:
            return False
        if d.get("ytdlp_status") == "SUCCESS":
            if v16__count(db.conn, "SELECT COUNT(*) FROM formats WHERE post_id=?", (pid,)) < 1 and str(d.get("formats_status") or "") == "SUCCESS":
                return False
        sidecar = str(d.get("sidecar_status") or "")
        if instagram_COLLECT_SIDECARS and sidecar not in {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED", "NO_DATA", ""}:
            return False
        if sidecar == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM sidecar_items WHERE post_id=?", (pid,)) < 1:
            return False
        # Comment completeness is tied to the toggle, not to whether this was an old run.
        if instagram_COLLECT_COMMENTS:
            cs = str(d.get("comments_status") or "")
            if cs not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA"}:
                return False
            actual = v16__count(db.conn, "SELECT COUNT(*) FROM comments WHERE post_id=?", (pid,))
            expected = v16__count(db.conn, "SELECT COALESCE(comments_count,0) FROM posts WHERE post_id=?", (pid,))
            if cs == "SUCCESS" and actual < 1:
                return False
            if expected > 0 and actual < expected:
                # A known platform comment count is higher than our persisted rows,
                # so this item is not proven complete yet.
                return False
            if cs == "SUCCESS_EMPTY" and expected > 0:
                return False
    return True


def v16__tiktok_evidence_complete(db, state, maximum: bool) -> bool:
    if not state or not state.get("last_enriched_at"):
        return False
    if str(state.get("enrichment_state") or "").upper() != "COMPLETE":
        return False
    vid = str(state.get("video_id") or "")
    if not vid or state.get("ytdlp_status") != "SUCCESS":
        return False
    with db.lock:
        if v16__count(db.conn, "SELECT COUNT(*) FROM video_snapshots WHERE video_id=?", (vid,)) < 1:
            return False
        if v16__count(db.conn, "SELECT COUNT(*) FROM raw_data WHERE video_id=?", (vid,)) < 1:
            return False
        if maximum and tiktok_COLLECT_FORMATS:
            fs = str(state.get("formats_status") or "")
            if fs not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED"}:
                return False
            if fs == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM formats WHERE video_id=?", (vid,)) < 1:
                return False
        if maximum and tiktok_COLLECT_CAPTIONS:
            cs = str(state.get("captions_status") or "")
            if cs not in {"SUCCESS", "SUCCESS_EMPTY", "NO_DATA", "SKIPPED"}:
                return False
            if cs == "SUCCESS" and v16__count(db.conn, "SELECT COUNT(*) FROM captions WHERE video_id=?", (vid,)) < 1:
                return False
        if tiktok_COLLECT_RESEARCH_COMMENTS:
            token = bool(tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN)
            cst = str(state.get("comments_status") or "")
            actual = v16__count(db.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (vid,))
            expected = v16__count(db.conn, "SELECT COALESCE(comment_count,0) FROM videos WHERE video_id=?", (vid,))
            if token:
                if cst not in {"SUCCESS", "SUCCESS_EMPTY"}:
                    return False
                if cst == "SUCCESS" and actual < 1:
                    return False
                if expected > 0 and actual < expected:
                    return False
                if cst == "SUCCESS_EMPTY" and expected > 0:
                    return False
            else:
                # Without Research API access the collector cannot fulfill the comment
                # stage; this remains a terminal state until credentials are supplied.
                if cst not in {"UNAVAILABLE_NO_RESEARCH_ACCESS", "SKIPPED_COMMENTS_DISABLED", "SUCCESS", "SUCCESS_EMPTY", "NO_DATA"}:
                    return False
    return True


def v16__youtube_choose(db, video, mode, force_refresh=False):
