        if status == "SUCCESS_EMPTY":
            return True, 0
        if status == "SUCCESS":
            with db.lock:
                row = db.conn.execute(
                    "SELECT COUNT(*) FROM caption_tracks WHERE video_id=?", (str(video_id or ""),)
                ).fetchone()
            n = int(row[0] or 0) if row else 0
            if n > 0:
                return True, n
    except Exception:
        pass
    return False, 0


def _v37_lang_order(mapping: dict, preferred: str = "") -> list[str]:
    keys = [str(k) for k in mapping.keys()]
    if not keys:
        return []
    preferred = str(preferred or "").strip().lower()
    ordered = []
    def add(k):
        if k in mapping and k not in ordered:
            ordered.append(k)
    if preferred:
        for k in keys:
            if k.lower() == preferred:
                add(k)
        pfx = preferred.split("-", 1)[0]
        for k in keys:
            if k.lower().split("-", 1)[0] == pfx:
                add(k)
    for want in ("en", "en-US", "en-GB"):
        for k in keys:
            if k.lower() == want.lower():
                add(k)
    for k in keys:
        if k.lower().startswith("en-"):
            add(k)
    for k in keys:
        add(k)
    return ordered


def _v37_pick_ytdlp_caption(info: dict) -> Optional[tuple[str, str, dict, str]]:
    """Pick one useful caption track: manual first, then one original ASR track."""
    preferred = str((info or {}).get("language") or "")
    ext_rank = {"json3": 0, "vtt": 1, "srv3": 2, "srv2": 3, "srv1": 4, "ttml": 5, "srt": 6}
    for track_type, mapping, default_kind in (
        ("subtitles", (info or {}).get("subtitles") or {}, ""),
        ("automatic_captions", (info or {}).get("automatic_captions") or {}, "asr"),
    ):
        if not isinstance(mapping, dict):
            continue
        for lang in _v37_lang_order(mapping, preferred):
            tracks = mapping.get(lang) or []
            if not isinstance(tracks, list):
                continue
            usable = [t for t in tracks if isinstance(t, dict) and t.get("url")]
            if not usable:
                continue
            usable.sort(key=lambda t: ext_rank.get(str(t.get("ext") or "").lower(), 99))
            return track_type, lang, usable[0], default_kind
    return None


def youtube_fetch_ytdlp_caption_content_v37(run_id: int, db: youtube_Database, v: dict, info: dict) -> int:
    video_id = str((v or {}).get("video_id") or "")
    done, existing = _v37_yt_caption_existing(db, video_id)
    if done:
        youtube_log(
            f"      [captions/v37] persisted caption stage reused | video={video_id} | "
            f"stored_tracks={existing} | network=0"
        )
        return existing

    picked = _v37_pick_ytdlp_caption(info or {})
    if not picked or youtube_stop_requested():
        return 0
    track_type, lang, track, default_kind = picked
    base = str(track.get("url") or "")
    if not base:
        return 0
    try:
        headers = {"User-Agent": youtube_UA, "Referer": v.get("webpage_url", "")}
        extra_headers = track.get("http_headers")
        if isinstance(extra_headers, dict):
            headers.update({str(k): str(val) for k, val in extra_headers.items() if val is not None})
        started = time.monotonic()
        r = youtube_SESSION.get(
            base,
            timeout=(V37_YOUTUBE_CAPTION_CONNECT_TIMEOUT, V37_YOUTUBE_CAPTION_READ_TIMEOUT),
            headers=headers,
        )
        elapsed = time.monotonic() - started
        if r.status_code != 200:
            youtube_log(
                f"      [captions/v37] selected track unavailable | video={video_id} | "
                f"lang={lang} type={track_type} HTTP={r.status_code} | elapsed={elapsed:.1f}s"
            )
            return 0
        payload = r.content
        name = track.get("name", "")
        if isinstance(name, dict):
            name = youtube_text_from_runs(name)
        db.insert_caption(run_id, {
            "video_id": video_id,
            "language_code": lang,
            "language_name": name or "",
            "kind": track.get("kind", default_kind) or default_kind,
            "track_type": "yt_dlp_content_v37",
