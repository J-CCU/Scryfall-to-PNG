class UnifiedSchedulerV34(UnifiedSchedulerV28):
    def __init__(self, app: "UnifiedApp") -> None:
        super().__init__(app)
        self._v34_force_stop_ui_authorized = False

    def start(self, inputs, limit, mode, force_refresh, continuous,
              high_throughput, extended_surfaces, collect_comments=False) -> None:
        self.ui_log(
            "[server/v34] ALWAYS-ON hard isolation | platform COMPLETE => platform-only next pass; "
            "global shutdown => explicit user control only\n"
        )
        # Dedicated server invariant: a platform pass completing is never the end
        # of the service. Ignore an accidentally unchecked legacy GUI checkbox.
        return super().start(
            inputs, limit, mode, force_refresh, True,
            high_throughput, extended_surfaces, collect_comments,
        )

    def request_force_stop_from_ui(self) -> None:
        self._v34_force_stop_ui_authorized = True
        try:
            super().force_stop()
        finally:
            self._v34_force_stop_ui_authorized = False

    def force_stop(self) -> None:
        # Compatibility guard: no legacy/worker path is allowed to turn an item,
        # account, or platform completion into a global shutdown.
        if not self._v34_force_stop_ui_authorized:
            self.ui_log(
                "[control/v34] IGNORED non-UI global force-stop request | "
                "master and sibling platforms remain alive\n"
            )
            return
        return super().force_stop()


