V30_BUILD = V33_BUILD


def instagram_instagram_graph_get_v33(path: str, params: Optional[dict] = None, db: Optional[instagram_Database] = None) -> Optional[dict]:
    if not instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN or not instagram_instagram_graph_budget_available(db):
        return None

    # Honor an already-persisted Graph/Instagram cooldown before making a request.
    if db is not None:
        until = v19__ig_access_backoff_until(db)
        if until > time.time():
            remaining = max(1, int(until - time.time()))
            raise V19InstagramAccessBackoff(
                f"Instagram/Meta cooldown active; remaining={remaining}s"
            )

    instagram_instagram_graph_note_request(db)
    try:
        r = instagram_SESSION.get(
            f"{instagram_INSTAGRAM_GRAPH_BASE_URL}/{str(path).lstrip('/')}",
            params={**(params or {}), "access_token": instagram_INSTAGRAM_GRAPH_ACCESS_TOKEN},
            timeout=instagram_REQUEST_TIMEOUT,
        )
        try:
            data = r.json()
        except Exception:
            data = None

        err = data.get("error") if isinstance(data, dict) else None
        err = err if isinstance(err, dict) else {}
        code = instagram_safe_int(err.get("code"))
        subcode = instagram_safe_int(err.get("error_subcode"))
        message = str(err.get("message") or "")

        # Meta app/request throttle. One detection is enough: persist cooldown and
        # yield the entire Instagram worker immediately. The scheduler will leave
        # YouTube/TikTok alone and retry Instagram only after cooldown expires.
        if r.status_code == 429 or code in {4, 17, 32, 613}:
            reason = f"Meta Graph throttle HTTP {r.status_code} code={code or ''}: {message or r.text[:220]}"
            until = v19__ig_set_access_backoff(db, reason, "graph-api") if db is not None else (time.time() + V19_IG_ACCESS_BACKOFF_INITIAL)
            remaining = max(1, int(until - time.time()))
            instagram_log(
                f"[graph/v33] THROTTLED | Instagram entering cooldown | remaining={remaining}s | "
                f"HTTP={r.status_code} code={code or ''}"
            )
            raise V19InstagramAccessBackoff(
                f"Meta Graph request limit reached; retry_at={until}"
            )

        # Business Discovery cannot see this username (commonly not a professional
        # account, renamed/deleted, or otherwise unavailable to Business Discovery).
        # This is account-specific and must never trigger a platform cooldown.
        if code == 110 and subcode == 2207013:
            instagram_log(
                f"[graph/v33] ACCOUNT SKIP | Business Discovery cannot resolve username | "
                f"HTTP={r.status_code} code=110 subcode=2207013 | continuing to next account"
            )
            return None

        if r.status_code != 200:
            instagram_log(f"[graph] HTTP {r.status_code} {path}: {r.text[:500]}")
            return None
        if err:
            instagram_log(f"[graph] API error {path}: {str(err)[:500]}")
            return None
        return data if isinstance(data, dict) else None
    except V19InstagramAccessBackoff:
        raise
    except Exception as exc:
        instagram_log(f"[graph] {path} {type(exc).__name__}: {exc}")
        return None


