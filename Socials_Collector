# TikTok Research comments: paginate every top-level and reply page.  None from
# the Research API is failure/defer, never a proven empty comment section.
# ---------------------------------------------------------------------------
def _v42_tt_fetch_record(video_id: str, status: str, source: str, fetched: int) -> None:
    with _V42_TT_COMMENT_FETCH_LOCK:
        _V42_TT_COMMENT_FETCH[str(video_id)] = {
            "status": str(status), "source": str(source), "fetched": int(fetched or 0)
        }


def tiktok_research_comments_v42(video_id: str, db: Optional[tiktok_Database] = None) -> List[dict]:
    vid = str(video_id or "")
    if not tiktok_COLLECT_RESEARCH_COMMENTS:
        _v42_tt_fetch_record(vid, "DISABLED", "TikTok Research API", 0)
        return []
    if not tiktok_ensure_research_access_token(db):
        _v42_tt_fetch_record(vid, "DEFERRED_NO_RESEARCH_ACCESS", "TikTok Research API", 0)
        return []
    out: List[dict] = []
    seen = set()
    cursor = 0
    complete = True
    while not tiktok_stop_requested():
        data = tiktok_research_post(
            "/video/comment/list/",
            {"fields": "id,video_id,text,like_count,reply_count,parent_comment_id,create_time"},
            {"video_id": int(vid), "max_count": tiktok_MAX_RESEARCH_COMMENTS_PER_PAGE, "cursor": cursor},
            db,
        )
        if data is None:
            complete = False
            break
        payload = data.get("data") or {}
        page_rows = payload.get("comments") or []
        for row in page_rows:
            cid = str((row or {}).get("id") or "")
            if cid and cid not in seen:
                seen.add(cid)
                out.append(row)
        has_more = bool(payload.get("has_more"))
        nxt = payload.get("cursor")
        if not has_more or nxt is None or int(nxt) == int(cursor):
            break
        cursor = int(nxt)

    # Fetch all reply pages for every top-level comment that reports replies.
    if complete and not tiktok_stop_requested():
        parents = [r for r in list(out) if not r.get("parent_comment_id") and int(tiktok_safe_int(r.get("reply_count")) or 0) > 0]
        for parent in parents:
            rcursor = 0
            while not tiktok_stop_requested():
                data = tiktok_research_post(
                    "/video/comment/list/",
                    {"fields": "id,video_id,text,like_count,reply_count,parent_comment_id,create_time"},
                    {"comment_id": int(parent.get("id")), "max_count": tiktok_MAX_RESEARCH_COMMENTS_PER_PAGE, "cursor": rcursor},
                    db,
                )
                if data is None:
                    complete = False
                    break
                payload = data.get("data") or {}
                for row in payload.get("comments") or []:
                    cid = str((row or {}).get("id") or "")
                    if cid and cid not in seen:
                        seen.add(cid)
                        out.append(row)
                has_more = bool(payload.get("has_more"))
                nxt = payload.get("cursor")
                if not has_more or nxt is None or int(nxt) == int(rcursor):
                    break
                rcursor = int(nxt)
            if not complete:
                break
    if tiktok_stop_requested():
        complete = False
    _v42_tt_fetch_record(vid, "COMPLETE" if complete else "PARTIAL", "TikTok Research API", len(out))
    return out

