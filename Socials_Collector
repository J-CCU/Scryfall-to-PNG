def _v51_tt_recent_discovery_due(db: tiktok_Database, account_id: str) -> bool:
    key = _v51_tt_discovery_next_key(account_id)
    try:
        nxt = float(db.get_runtime_state(key) or 0)
    except Exception:
        nxt = 0.0
    now = time.time()
    if nxt <= 0:
        with db.lock:
            row = db.conn.execute("SELECT last_indexed_at FROM accounts WHERE account_id=?", (str(account_id),)).fetchone()
        last = _v51_iso_epoch(row[0] if row else None)
        if last > 0:
