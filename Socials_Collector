    global youtube_YOUTUBE_API_KEY, youtube_YOUTUBE_API_KEY_SOURCE, youtube_USE_YOUTUBE_DATA_API_ACCELERATOR
    if _V39_CONFIGURED_YOUTUBE_API_KEY:
        youtube_YOUTUBE_API_KEY = _V39_CONFIGURED_YOUTUBE_API_KEY
        youtube_YOUTUBE_API_KEY_SOURCE = _V39_CONFIGURED_YOUTUBE_API_SOURCE
        youtube_USE_YOUTUBE_DATA_API_ACCELERATOR = True


def _v39_disable_api_globals() -> None:
    global youtube_YOUTUBE_API_KEY, youtube_USE_YOUTUBE_DATA_API_ACCELERATOR
    youtube_YOUTUBE_API_KEY = ""
    youtube_USE_YOUTUBE_DATA_API_ACCELERATOR = False


def _v39_load_api_circuit(db: youtube_Database) -> bool:
    """Load persisted daily quota state. A new Pacific quota day auto-resets it."""
    global _V39_API_CIRCUIT_OPEN, _V39_API_CIRCUIT_REASON, _V39_API_CIRCUIT_DAY
    today = youtube_youtube_api_today_key()
    with _V39_API_CIRCUIT_LOCK:
        with db.lock:
            day_row = db.conn.execute(
                "SELECT value FROM runtime_state WHERE key='youtube_api_circuit_day'"
            ).fetchone()
            reason_row = db.conn.execute(
                "SELECT value FROM runtime_state WHERE key='youtube_api_circuit_reason'"
            ).fetchone()
            day = str(day_row[0]) if day_row and day_row[0] else ""
            reason = str(reason_row[0]) if reason_row and reason_row[0] else ""
            if day and day != today:
                _v39_runtime_delete_locked(
                    db,
                    "youtube_api_circuit_day",
                    "youtube_api_circuit_reason",
                    "youtube_api_circuit_opened_at",
                )
                # The collector's own conservative request budget is daily too.
                _v39_runtime_set_locked(db, "youtube_api_quota_day", today)
                _v39_runtime_set_locked(db, "youtube_api_quota_used", "0")
                db.conn.commit()
                day = ""
                reason = ""
        _V39_API_CIRCUIT_OPEN = bool(day == today and reason)
        _V39_API_CIRCUIT_REASON = reason if _V39_API_CIRCUIT_OPEN else ""
        _V39_API_CIRCUIT_DAY = day if _V39_API_CIRCUIT_OPEN else today
        if _V39_API_CIRCUIT_OPEN:
            _v39_disable_api_globals()
        else:
            _v39_restore_api_globals()
        return _V39_API_CIRCUIT_OPEN


def _v39_api_circuit_open(db: Optional[youtube_Database] = None) -> bool:
    today = youtube_youtube_api_today_key()
    with _V39_API_CIRCUIT_LOCK:
        if _V39_API_CIRCUIT_OPEN and _V39_API_CIRCUIT_DAY == today:
            return True
        needs_reload = (_V39_API_CIRCUIT_DAY != today)
    if db is not None and needs_reload:
        try:
            return _v39_load_api_circuit(db)
        except Exception:
            pass
    with _V39_API_CIRCUIT_LOCK:
        return bool(_V39_API_CIRCUIT_OPEN and _V39_API_CIRCUIT_DAY == today)


def _v39_trip_api_circuit(db: Optional[youtube_Database], reason: str, detail: str = "") -> None:
    """Persist one quota failure and disable all official Data API work this quota day."""
    global _V39_API_CIRCUIT_OPEN, _V39_API_CIRCUIT_REASON, _V39_API_CIRCUIT_DAY
    reason = str(reason or "quotaExceeded")
    with _V39_API_CIRCUIT_LOCK:
        already = _V39_API_CIRCUIT_OPEN
        _V39_API_CIRCUIT_OPEN = True
        _V39_API_CIRCUIT_REASON = reason
        _V39_API_CIRCUIT_DAY = youtube_youtube_api_today_key()
        _v39_disable_api_globals()
        if db is not None:
            try:
                with db.lock:
                    _v39_runtime_set_locked(db, "youtube_api_circuit_day", youtube_youtube_api_today_key())
                    _v39_runtime_set_locked(db, "youtube_api_circuit_reason", reason)
                    _v39_runtime_set_locked(db, "youtube_api_circuit_opened_at", youtube_now_utc())
                    db.conn.commit()
            except Exception:
                pass
    if not already:
        youtube_log(
            f"[youtube-api/v39] QUOTA CIRCUIT OPEN | reason={reason} | "
            "all official Data API calls deferred for this quota day; yt-dlp/InnerTube/DB lanes continue"
        )


def _v39_catalog_hash(video_ids: List[str]) -> str:
    joined = "\n".join(sorted({str(v) for v in video_ids if v}))
    return hashlib.sha256(joined.encode("utf-8")).hexdigest()


def _v39_catalog_proof_row(db: youtube_Database, channel_id: str) -> Optional[dict]:
    with db.lock:
        cur = db.conn.execute(
            "SELECT index_complete,catalog_verification_version,catalog_verified_at,catalog_verified_count," 
            "catalog_verified_hash,catalog_oldest_timestamp,catalog_newest_timestamp "
            "FROM channels WHERE channel_id=?",
            (channel_id,),
        )
        row = cur.fetchone()
    if not row:
        return None
    cols = ["index_complete", "catalog_verification_version", "catalog_verified_at", "catalog_verified_count",
            "catalog_verified_hash", "catalog_oldest_timestamp", "catalog_newest_timestamp"]
    return dict(zip(cols, row))


def _v39_catalog_proof_is_current(db: youtube_Database, channel_id: str) -> bool:
    row = _v39_catalog_proof_row(db, channel_id)
    if not row:
        return False
    if str(row.get("index_complete") or "") != "1":
        return False
    if str(row.get("catalog_verification_version") or "") != V39_CATALOG_PROOF_VERSION:
        return False
    verified_at = row.get("catalog_verified_at")
    age = _v38_hours_since(verified_at)
    if age is None or age >= V39_CATALOG_REVERIFY_HOURS:
        return False
    proof_count = int(row.get("catalog_verified_count") or 0)
    with db.lock:
        current_count = int(db.conn.execute(
            "SELECT COUNT(*) FROM videos WHERE channel_id=?", (channel_id,)
        ).fetchone()[0] or 0)
    # New incremental rows make current_count larger than the old proof and are
    # fine. Losing rows below the proof count invalidates historical coverage.
    return current_count >= proof_count


def _v39_repair_catalog_shape(db: youtube_Database) -> dict:
    """Repair local relational holes without network calls or deleting history."""
    now = youtube_now_utc()
    with db.lock:
        before_missing_ingestion = int(db.conn.execute(
            "SELECT COUNT(*) FROM videos v LEFT JOIN video_ingestion vi ON vi.video_id=v.video_id WHERE vi.video_id IS NULL"
        ).fetchone()[0] or 0)
        before_missing_video = int(db.conn.execute(
            "SELECT COUNT(*) FROM video_ingestion vi LEFT JOIN videos v ON v.video_id=vi.video_id WHERE v.video_id IS NULL"
        ).fetchone()[0] or 0)

        # Every catalog row must have a durable ingestion/checkpoint row.
        db.conn.execute(
            """
            INSERT OR IGNORE INTO video_ingestion(
                video_id,channel_id,first_seen_at,last_discovered_at,discovery_count,enrichment_state,current_stage
            )
            SELECT v.video_id,COALESCE(v.channel_id,''),COALESCE(v.updated_at,?),COALESCE(v.updated_at,?),0,
                   'DISCOVERED','DISCOVERED'
            FROM videos v
            LEFT JOIN video_ingestion vi ON vi.video_id=v.video_id
            WHERE vi.video_id IS NULL
            """,
            (now, now),
        )

        # Recover missing canonical video rows from the newest snapshot when an
        # older interrupted build left only video_ingestion + snapshots.
        orphan_ids = [str(r[0]) for r in db.conn.execute(
            "SELECT vi.video_id FROM video_ingestion vi LEFT JOIN videos v ON v.video_id=vi.video_id WHERE v.video_id IS NULL"
        ).fetchall() if r and r[0]]
        recovered = 0
        placeholders = 0
        for vid in orphan_ids:
            cur = db.conn.execute(
                """
                SELECT channel_id,title,description,published_text,upload_date,timestamp,duration_seconds,
                       view_count,like_count,comment_count,channel_name,uploader_id,category,language,
                       availability,age_limit,live_status,is_live,is_short,is_premiere,is_family_safe,
                       is_monetized,has_paid_promotion,is_premium_content,thumbnail_url,webpage_url
                FROM video_snapshots WHERE video_id=? ORDER BY captured_at DESC,id DESC LIMIT 1
                """,
                (vid,),
            )
            snap = cur.fetchone()
            if snap:
                db.conn.execute(
                    """
                    INSERT OR IGNORE INTO videos(
                        video_id,channel_id,title,description,published_text,upload_date,timestamp,duration_seconds,
                        view_count,like_count,comment_count,channel_name,uploader_id,category,language,availability,
                        age_limit,live_status,is_live,is_short,is_premiere,is_family_safe,is_monetized,
                        has_paid_promotion,is_premium_content,thumbnail_url,webpage_url,updated_at
                    ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                    """,
                    (vid, *snap, now),
                )
                recovered += 1
            else:
                row = db.conn.execute(
                    "SELECT COALESCE(channel_id,'') FROM video_ingestion WHERE video_id=?", (vid,)
                ).fetchone()
                cid = str(row[0] or "") if row else ""
                db.conn.execute(
                    "INSERT OR IGNORE INTO videos(video_id,channel_id,webpage_url,updated_at) VALUES(?,?,?,?)",
                    (vid, cid, f"https://www.youtube.com/watch?v={vid}", now),
                )
                placeholders += 1

        # Keep channel IDs synchronized in both directions where one side knows it.
        db.conn.execute(
            "UPDATE video_ingestion SET channel_id=(SELECT v.channel_id FROM videos v WHERE v.video_id=video_ingestion.video_id) "
            "WHERE COALESCE(channel_id,'')='' AND EXISTS(SELECT 1 FROM videos v WHERE v.video_id=video_ingestion.video_id AND COALESCE(v.channel_id,'')<>'')"
        )
        db.conn.execute(
            "UPDATE videos SET channel_id=(SELECT vi.channel_id FROM video_ingestion vi WHERE vi.video_id=videos.video_id) "
            "WHERE COALESCE(channel_id,'')='' AND EXISTS(SELECT 1 FROM video_ingestion vi WHERE vi.video_id=videos.video_id AND COALESCE(vi.channel_id,'')<>'')"
        )

        # A video must not disappear from coverage merely because the channel row
        # was absent in a legacy/interrupted DB. Placeholder channel metadata is
        # filled by the normal channel pass later.
        db.conn.execute(
            """
            INSERT OR IGNORE INTO channels(channel_id,channel_url,index_complete,indexed_video_count,updated_at)
            SELECT DISTINCT v.channel_id,
                   'https://www.youtube.com/channel/' || v.channel_id,
                   '0',0,?
            FROM videos v
            WHERE COALESCE(v.channel_id,'')<>''
            """,
            (now,),
        )
        db.conn.commit()

    return {
        "missing_ingestion_repaired": before_missing_ingestion,
        "missing_video_repaired": before_missing_video,
        "snapshot_recovered": recovered,
        "placeholder_recovered": placeholders,
    }


def _v39_invalidate_unproven_or_stale_catalogs(db: youtube_Database) -> dict:
    """Legacy index_complete is not proof; stale V39 proof is periodically rechecked."""
    now = youtube_now_utc()
    invalid_legacy = 0
    invalid_stale = 0
    invalid_count = 0
    with db.lock:
        rows = db.conn.execute(
            "SELECT channel_id,index_complete,catalog_verification_version,catalog_verified_at,catalog_verified_count "
            "FROM channels"
        ).fetchall()
        for channel_id, index_complete, version, verified_at, proof_count in rows:
            cid = str(channel_id or "")
            if not cid:
                continue
            current_count = int(db.conn.execute(
                "SELECT COUNT(*) FROM videos WHERE channel_id=?", (cid,)
            ).fetchone()[0] or 0)
            reason = ""
            if str(version or "") != V39_CATALOG_PROOF_VERSION:
                reason = "legacy_unproven"
                invalid_legacy += 1
            else:
                age = _v38_hours_since(verified_at)
                if age is None or age >= V39_CATALOG_REVERIFY_HOURS:
                    reason = "proof_stale"
                    invalid_stale += 1
                elif current_count < int(proof_count or 0):
                    reason = "db_count_below_proof"
                    invalid_count += 1
            if reason:
                db.conn.execute(
                    "UPDATE channels SET index_complete='0' WHERE channel_id=?",
                    (cid,),
                )
        _v39_runtime_set_locked(db, "v39_catalog_guard_last_at", now)
        db.conn.commit()
    return {
        "legacy_unproven": invalid_legacy,
        "stale_proof": invalid_stale,
        "count_below_proof": invalid_count,
    }


def _v39_audit_video_evidence(db: youtube_Database, mode: str = "Maximum") -> dict:
    """Audit every known video. Nothing incomplete is silently promoted to COMPLETE."""
    now = youtube_now_utc()
    with db.lock:
        video_ids = [str(r[0]) for r in db.conn.execute(
            "SELECT video_id FROM video_ingestion ORDER BY video_id"
        ).fetchall() if r and r[0]]

    counts = {
        "videos": len(video_ids),
        "complete": 0,
        "missing_payload": 0,
        "missing_comments": 0,
        "missing_payload_comments": 0,
        "checkpoint_repaired": 0,
    }
    updates = []
    for vid in video_ids:
        state = db.get_video_sync(vid) or {}
        payload_ok = _v35_youtube_payload_complete(db, state, mode)
        comments_ok = _v38_comments_complete(db, state)
        if payload_ok and comments_ok:
            if str(state.get("enrichment_state") or "").upper() != "COMPLETE" or state.get("last_error"):
                if _v38_finalize_video(db, vid):
                    counts["checkpoint_repaired"] += 1
            status = "COMPLETE"
            counts["complete"] += 1
        elif not payload_ok and not comments_ok:
            status = "MISSING_PAYLOAD_COMMENTS"
            counts["missing_payload_comments"] += 1
        elif not payload_ok:
            status = "MISSING_PAYLOAD"
            counts["missing_payload"] += 1
        else:
            status = "MISSING_COMMENTS"
            counts["missing_comments"] += 1
        updates.append((status, now, vid))

    with db.lock:
        if updates:
            db.conn.executemany(
                "UPDATE video_ingestion SET completeness_audit_status=?, last_completeness_audit_at=? WHERE video_id=?",
                updates,
            )
        _v39_runtime_set_locked(db, "v39_last_completeness_audit_at", now)
        _v39_runtime_set_locked(db, "v39_last_completeness_audit_total", counts["videos"])
        _v39_runtime_set_locked(db, "v39_last_completeness_audit_complete", counts["complete"])
        db.conn.commit()
    counts["pending"] = counts["videos"] - counts["complete"]
    return counts


def _v39_database_completeness_audit(db: youtube_Database, mode: str = "Maximum") -> dict:
    _v39_migrate_youtube_schema(db)
    shape = _v39_repair_catalog_shape(db)
    catalog = _v39_invalidate_unproven_or_stale_catalogs(db)
    evidence = _v39_audit_video_evidence(db, mode)
    circuit = _v39_load_api_circuit(db)
    with db.lock:
        unverified = int(db.conn.execute(
            "SELECT COUNT(*) FROM channels WHERE COALESCE(index_complete,'0')<>'1' OR COALESCE(catalog_verification_version,'')<>?",
            (V39_CATALOG_PROOF_VERSION,),
        ).fetchone()[0] or 0)
        deferred_quota = int(db.conn.execute(
            "SELECT COUNT(*) FROM video_ingestion WHERE comments_status='DEFERRED_QUOTA'"
        ).fetchone()[0] or 0)
    return {
        **shape,
        **catalog,
        **evidence,
        "catalog_unverified": unverified,
        "deferred_quota": deferred_quota,
        "api_circuit_open": bool(circuit),
    }


def _v39_pre_main_database_guard() -> dict:
    """Run before unified_main for the parent/YouTube worker; local DB only."""
    db = youtube_Database(youtube_DB_PATH)
    try:
        summary = _v39_database_completeness_audit(db, "Maximum")
        print(
            "[pre-main/v39] DATABASE COMPLETENESS GUARD | "
            f"videos={summary['videos']} complete={summary['complete']} pending={summary['pending']} | "
            f"missing_payload={summary['missing_payload']} missing_comments={summary['missing_comments']} "
            f"missing_both={summary['missing_payload_comments']} | "
            f"catalog_unverified={summary['catalog_unverified']} | "
            f"quota_deferred={summary['deferred_quota']} | "
            f"api_circuit={'OPEN' if summary['api_circuit_open'] else 'CLOSED'}",
            flush=True,
        )
        if summary["catalog_unverified"]:
            print(
                "[pre-main/v39] unverified/stale channel catalogs will receive FULL historical reconciliation "
                "before they are allowed to use the recent-window shortcut",
                flush=True,
            )
        if summary["pending"]:
            print(
                "[pre-main/v39] incomplete video evidence remains retryable; DB-first repair queues will continue "
                "until payload + mandatory comment evidence are complete",
                flush=True,
            )
        return summary
    finally:
        db.close()



# ---------------------------------------------------------------------------
# Channel metadata API quota hygiene. The legacy channel metadata function's
# embedded channels.list request is suppressed above. This wrapper restores the
# useful exact official metrics at most once per channel/day through the shared
# V39 quota circuit, instead of once per channel every five-minute rotation.
# ---------------------------------------------------------------------------
_v39_channel_metadata_orig = youtube_scrape_channel_metadata


def youtube_scrape_channel_metadata_v39(
    run_id: int, db: youtube_Database, channel_id: str,
    emit_fn: Optional[Callable[[str], None]] = None,
) -> dict:
    channel = _v39_channel_metadata_orig(run_id, db, channel_id, emit_fn=emit_fn)
    if _v39_api_circuit_open(db) or not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_YOUTUBE_API_KEY:
        return channel
    try:
        with db.lock:
            row = db.conn.execute(
                "SELECT channel_api_refreshed_at FROM channels WHERE channel_id=?", (channel_id,)
            ).fetchone()
        last = row[0] if row else None
        age = _v38_hours_since(last)
        if age is not None and age < V39_CHANNEL_API_REFRESH_HOURS:
            return channel

        data, status, body = youtube_youtube_api_get(
            "channels",
            {"part": "snippet,statistics,contentDetails", "id": channel_id},
            db=db, run_id=run_id, note="channel_metrics_v39_daily",
        )
        if not data:
            return channel
        items = data.get("items") or []
        if not items:
            return channel
        item = items[0]
        raw_id = db.raw(
            run_id, channel_id=channel_id, video_id=None, source="youtube_api",
            endpoint="channels", status=status, payload=data,
            content_type="application/json", note="channel_metadata_v39_daily",
        )
        api_channel = youtube_parse_channel_data(
            channel_id, None, None, page_html="", ytdlp_info=None, api_item=item
        )
        # Merge only useful non-empty API values so HTML/InnerTube-only fields
        # remain intact.
        for key, value in api_channel.items():
            if value not in (None, "", [], {}):
                channel[key] = value
        db.upsert_channel(channel)
        with db.lock:
            db.conn.execute(
                "UPDATE channels SET channel_api_refreshed_at=? WHERE channel_id=?",
                (youtube_now_utc(), channel_id),
            )
            db.conn.commit()
        youtube_log(
            f"  [youtube-api/v39] channel metrics refreshed | channel={channel_id} | raw_id={raw_id} | next_due~{V39_CHANNEL_API_REFRESH_HOURS:g}h"
        )
    except Exception as exc:
        youtube_log(
            f"  [youtube-api/v39] channel metrics refresh deferred | channel={channel_id} | {type(exc).__name__}: {exc}"
        )
    return channel


youtube_scrape_channel_metadata = youtube_scrape_channel_metadata_v39


# Quota-aware exact handle resolver. Cached verified channel IDs still avoid
# this path; new/changed handles use the shared circuit instead of an untracked
# direct request.
def youtube_youtube_api_resolve_handle_v39(handle: str) -> Optional[dict]:
    if youtube_stop_requested() or not youtube_YOUTUBE_API_KEY or not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR:
        return None
    db = None
    try:
        db = youtube_Database(youtube_DB_PATH)
        _v39_migrate_youtube_schema(db)
        if _v39_api_circuit_open(db) or not youtube_youtube_api_budget_available(db):
            return None
        data, status, body = youtube_youtube_api_get(
            "channels",
            {"part": "snippet,statistics,contentDetails", "forHandle": f"@{handle}"},
            db=db, run_id=None, note="resolve_handle_v39",
        )
        if not data:
            return None
        items = data.get("items") or []
        return items[0] if items else None
    except Exception as exc:
        youtube_debug(f"[api/forHandle/v39] {type(exc).__name__}: {exc}")
        return None
    finally:
        if db is not None:
            try:
                db.close()
            except Exception:
                pass


