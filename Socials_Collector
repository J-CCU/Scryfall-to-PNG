def v13__youtube_fetch(self_run_id: int, db: youtube_Database, video: dict, mode: str, maximum: bool):
    vid = str(video.get("video_id") or "")
    try:
        state = db.get_video_sync(vid)
        if vid and state and state.get("yt_dlp_status") == "SUCCESS" and str(state.get("enrichment_state") or "").upper() in {"IN_PROGRESS", "FAILED"}:
            with db.lock:
                row = db.conn.execute(
                    "SELECT payload_gzip FROM raw_data WHERE video_id=? AND source='yt-dlp' AND note='video_full_info' ORDER BY id DESC LIMIT 1",
                    (vid,),
                ).fetchone()
            if row and row[0]:
                info = json.loads(gzip.decompress(bytes(row[0])).decode("utf-8", errors="replace"))
                video.update({
                    "title": info.get("title") or video.get("title"),
                    "description": info.get("description") or video.get("description"),
                    "timestamp": info.get("timestamp") or video.get("timestamp"),
                    "duration_seconds": info.get("duration") if info.get("duration") is not None else video.get("duration_seconds"),
                    "view_count": info.get("view_count") if info.get("view_count") is not None else video.get("view_count"),
                    "like_count": info.get("like_count") if info.get("like_count") is not None else video.get("like_count"),
                    "comment_count": info.get("comment_count") if info.get("comment_count") is not None else video.get("comment_count"),
                    "webpage_url": info.get("webpage_url") or video.get("webpage_url"),
                    "_v13_resumed_ytdlp": True,
                })
                video["yt_dlp_status"] = "SUCCESS"
                youtube_log(f"      [resume/cache] reused persisted yt-dlp payload | video={vid} | no network extraction")
                return info
    except Exception as exc:
        youtube_debug(f"      [resume/cache] persisted yt-dlp reuse unavailable | video={vid} | {type(exc).__name__}: {exc}")
    return v13__youtube_fetch_orig(self_run_id, db, video, mode, maximum)

