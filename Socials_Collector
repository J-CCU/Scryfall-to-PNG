            top = self.output.index("@0,0").split(".")[0]
            bottom = self.output.index(f"@0,{max(self.output.winfo_height()-4,1)}").split(".")[0]
            self.log_position_var.set(f"Log: lines {top}–{bottom}")
        except Exception:
            pass

    def log_ui(self, message: str) -> None:
        try:
            if threading.current_thread() is threading.main_thread():
                self.output.insert(tk.END, message)
                if self.auto_follow_var.get():
                    self.output.see(tk.END)
            else:
                self.ui_queue.put(("log", message))
        except Exception as exc:
            print(f"[ui] log error: {type(exc).__name__}: {exc}", flush=True)

    def pump_ui_queue(self) -> None:
        try:
            while True:
                item = self.ui_queue.get_nowait()
                kind = item[0]
                if kind == "log":
                    msg = item[1]
                    self.output.insert(tk.END, msg)
                    if self.auto_follow_var.get():
                        self.output.see(tk.END)
                    stripped = msg.strip()
                    if "[db]" in stripped and "run=" in stripped:
                        self.db_status_var.set("DB: " + stripped.replace("  ", " "))
                    elif stripped.startswith("[control]") or stripped.startswith("[run]"):
                        self.status_var.set(stripped)
                elif kind == "progress":
                    _, current, total, phase = item
                    self.progress["maximum"] = max(total, 1)
                    self.progress["value"] = min(current, total)
                    self.status_var.set(f"{phase}: {current}/{total}")
                elif kind == "run_id":
                    self.last_run_id = item[1]
                elif kind == "process_done":
                    self._process_finished(item[1])
        except queue.Empty:
            pass
        finally:
            try:
                self.root.after(50, self.pump_ui_queue)
            except Exception:
                pass

    def selected_limit(self) -> int:
        return {"Latest 30": 30, "Latest 100": 100, "Latest 300": 300, "Latest 1000": 1000, "All available": 0}.get(self.limit_var.get(), tiktok_DEFAULT_LIMIT)

    def start(self) -> None:
        if self.process and self.process.poll() is None:
            self.log_ui("[control] scrape is already running\n")
            return
        inputs = [x.strip() for x in self.input_box.get("1.0", tk.END).splitlines() if x.strip()]
        if not inputs:
            messagebox.showwarning("Input", "Paste at least one TikTok @handle or URL.")
            return
        if tiktok_yt_dlp is None:
            python_cmd = sys.executable
            message = f"yt-dlp is not installed in {python_cmd}.\n\nInstall with:\n{python_cmd} -m pip install -U \"yt-dlp[default]\" requests"
            self.log_ui("[control] START BLOCKED: yt-dlp is missing.\n")
            messagebox.showerror("Missing yt-dlp", message)
            return

        tiktok_clear_stop_request()
        self.stop_clicked = False
        self.output.delete("1.0", tk.END)
        self.progress["value"] = 0
        self.status_var.set("Starting...")
        self.start_btn.config(state="disabled")
        self.stop_btn.config(state="normal")
        limit = self.selected_limit()
        mode = self.mode_var.get()
        force_refresh = self.force_refresh_var.get()
        self.log_ui(
            f"[control] Start Scrape clicked | inputs={len(inputs)} | mode={mode} | "
            f"limit={'ALL' if limit <= 0 else limit} | force_refresh={'yes' if force_refresh else 'no'}\n"
        )
        self.log_ui("[control] launching isolated TikTok collector process...\n")
        try:
            self.db.close()
        except Exception:
            pass
        try:
            job = {
                "inputs": inputs,
                "limit": limit,
                "mode": mode,
                "force_refresh": force_refresh,
            }
            self.job_path = tiktok_BASE_DIR / f".tiktok_job_{os.getpid()}_{int(time.time()*1000)}.json"
            self.job_path.write_text(json.dumps(job, ensure_ascii=False), encoding="utf-8")
            cmd = [sys.executable, str(Path(__file__).resolve()), "--worker", str(self.job_path)]
            env = os.environ.copy()
            env["PYTHONUNBUFFERED"] = "1"
            env["PYTHONIOENCODING"] = "utf-8"
            self.process = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, encoding="utf-8", errors="replace", bufsize=1, cwd=str(tiktok_BASE_DIR), env=env, start_new_session=True
            )
            self.worker = threading.Thread(target=self._read_worker_output, daemon=True, name="tiktok-output-reader")
            self.worker.start()
            self.log_ui(f"[control] worker process started | pid={self.process.pid}\n")
            self.log_ui(f"[control] python={sys.executable}\n")
            self.log_ui(f"[control] script={Path(__file__).resolve()}\n")
            self.root.after(750, self._startup_check)
        except Exception as exc:
            self.log_ui(f"[control] START ERROR: {type(exc).__name__}: {exc}\n")
            self.status_var.set("Ready")
            self.start_btn.config(state="normal")
            self.stop_btn.config(state="disabled")
            try:
                self.db = tiktok_Database(tiktok_DB_PATH)
            except Exception:
                pass
            messagebox.showerror("Start Error", str(exc))

    def _startup_check(self) -> None:
        if self.process is None:
            return
        rc = self.process.poll()
        if rc is None:
            self.log_ui("[control] worker is alive; waiting for first TikTok collector message...\n")
        else:
            self.log_ui(f"[control] worker exited before startup check | exit_code={rc}\n")

    def _read_worker_output(self) -> None:
        process = self.process
        if process is None or process.stdout is None:
            self.ui_queue.put(("process_done", -1))
            return
        try:
            for raw in process.stdout:
                line = raw.rstrip("\n")
                if line.startswith("[PROGRESS]|"):
                    parts = line.split("|", 3)
                    if len(parts) == 4:
                        try:
                            self.ui_queue.put(("progress", int(parts[1]), int(parts[2]), parts[3]))
                            continue
                        except ValueError:
                            pass
                m = re.match(r"^\[run\] (\d+) \|", line)
                if m:
                    try:
                        self.ui_queue.put(("run_id", int(m.group(1))))
                    except ValueError:
                        pass
                self.ui_queue.put(("log", raw))
        except Exception as exc:
            self.ui_queue.put(("log", f"[control] output-reader error: {type(exc).__name__}: {exc}\n"))
        finally:
            try:
                rc = process.wait()
            except Exception:
                rc = -1
            self.ui_queue.put(("process_done", rc))

    def _force_kill_if_needed(self) -> None:
        if self.process is not None and self.process.poll() is None and self.stop_clicked:
            try:
                self.process.kill()
            except Exception:
                pass

    def _process_finished(self, rc: int) -> None:
        try:
            self.db = tiktok_Database(tiktok_DB_PATH)
        except Exception as exc:
            self.log_ui(f"[control] database reopen error: {type(exc).__name__}: {exc}\n")
        if self.job_path:
            try:
                self.job_path.unlink(missing_ok=True)
            except Exception:
                pass
            self.job_path = None
        was_stopped = self.stop_clicked
        self.process = None
        self.worker = None
        self.start_btn.config(state="normal")
        self.stop_btn.config(state="disabled")
        if was_stopped:
            self.status_var.set("Stopped")
            self.log_ui(f"[control] TikTok collector stopped | exit_code={rc}\n")
        elif rc == 0:
            self.status_var.set("Ready")
            self.log_ui("[control] TikTok collector completed successfully\n")
        else:
            self.status_var.set("Failed")
            self.log_ui(f"[control] TikTok collector exited with code {rc}\n")

    def stop(self) -> None:
        process = self.process
        if process is None or process.poll() is not None:
            self.log_ui("[control] no active TikTok collector process to stop\n")
            return
        self.stop_clicked = True
        self.stop_btn.config(state="disabled")
        self.status_var.set("Stopping collector...")
        self.log_ui("\n[control] STOP clicked — terminating the isolated TikTok collector now.\n")
        try:
            process.terminate()
        except Exception:
            try:
                process.kill()
            except Exception:
                pass
        self.root.after(1500, self._force_kill_if_needed)

    def export_last(self) -> None:
        if not self.last_run_id:
            messagebox.showwarning("Export", "No scrape run is available yet.")
            return
        folder = filedialog.askdirectory(title="Choose export folder")
        if not folder:
            return
        try:
            outputs = tiktok_export_run_csvs(self.db, self.last_run_id, Path(folder))
            self.log_ui("\n[export] completed:\n")
            for name, path in outputs.items():
                self.log_ui(f"  {name}: {path}\n")
            messagebox.showinfo("Export", f"Exported {len(outputs)} CSV files.")
        except Exception as exc:
            messagebox.showerror("Export Error", str(exc))

    def open_db_folder(self) -> None:
        folder = str(tiktok_DB_PATH.parent)
        try:
            if sys.platform == "darwin":
                subprocess.run(["open", folder], check=False)
            elif os.name == "nt":
                os.startfile(folder)  # type: ignore[attr-defined]
            else:
                subprocess.run(["xdg-open", folder], check=False)
        except Exception as exc:
            messagebox.showerror("Open Folder", str(exc))


