def _v54_tiktok_universe_coverage(path: Path = tiktok_DB_PATH) -> dict:
    out = {"universe_total": 0, "universe_resolved": 0, "universe_unresolved": 0, "unresolved_locators": []}
    try:
        configured = list(production_load_universe(PRODUCTION_UNIVERSE_FILE).get("tiktok", []) or [])
    except Exception:
        configured = []
    expected = []
    for raw in configured:
        username = tiktok_normalized_username(raw)
        if username and username not in expected:
            expected.append(username)
    out["universe_total"] = len(expected)
    if not expected:
        return out
    conn = _v46_open_readonly(Path(path))
    if conn is None:
        out["universe_unresolved"] = len(expected)
        out["unresolved_locators"] = [f"@{x}" for x in expected]
        return out
    try:
        resolved = {
            str(r[0] or "").strip().lower()
            for r in conn.execute(
                "SELECT username FROM accounts WHERE COALESCE(account_id,'')<>'' AND UPPER(COALESCE(resolution_verified,''))='YES'"
            ).fetchall()
            if str(r[0] or "").strip()
        }
        # Historical successful input mappings cover renamed/alternate locator
        # forms without allowing an unresolved row to erase a prior good map.
        try:
            for r in conn.execute(
                "SELECT resolved_username FROM account_inputs WHERE COALESCE(account_id,'')<>'' AND UPPER(COALESCE(resolution_verified,''))='YES'"
            ).fetchall():
                u = tiktok_normalized_username(r[0])
                if u:
                    resolved.add(u)
        except Exception:
            pass
        missing = [u for u in expected if u not in resolved]
        out["universe_resolved"] = len(expected) - len(missing)
        out["universe_unresolved"] = len(missing)
        out["unresolved_locators"] = [f"@{u}" for u in missing]
        return out
    finally:
        conn.close()


