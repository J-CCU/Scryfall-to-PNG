        self.output.pack(fill="both", expand=True)

        self._selftest_summary("Ready. The three platform databases remain separate.")

    def _progress_text_var(self, key: str) -> tk.StringVar:
        if not hasattr(self, "progress_text_vars"):
            self.progress_text_vars = {p.key: tk.StringVar(value="0 / 0") for p in UNIFIED_PLATFORMS}
        return self.progress_text_vars[key]

    def _selftest_summary(self, msg: str) -> None:
        self.output.insert(tk.END, f"[startup] {msg}\n")

    def enqueue_ui(self, item: tuple) -> None:
        self.ui_queue.put(item)

    def _pump_ui(self) -> None:
        try:
            while True:
                item = self.ui_queue.get_nowait()
                kind = item[0]
                if kind == "log":
                    self.output.insert(tk.END, item[1])
                    if self.auto_follow_var.get():
                        self.output.see(tk.END)
                elif kind == "platform":
                    self.platform_status_vars[item[1]].set(item[2])
                elif kind == "cooldown":
                    until = float(item[2])
                    if until > time.time():
                        remaining = int(until - time.time())
                        mins, secs = divmod(max(0, remaining), 60)
                        self.platform_cooldown_vars[item[1]].set(f"{mins}m {secs}s")
                    else:
                        self.platform_cooldown_vars[item[1]].set("Ready")
                elif kind == "progress":
                    _, key, cur, total, phase = item
                    self.progress_text_vars[key].set(f"{cur} / {total} — {phase}")
                elif kind == "scheduler_done":
                    self.start_btn.config(state="normal")
                    self.stop_btn.config(state="disabled")
                    if self.status_var:
                        self.status_var.set("Ready")
            self.root.after(100, self._pump_ui)
        except queue.Empty:
            self.root.after(100, self._pump_ui)

        # Refresh cooldown text without requiring a new scheduler message.
        for p in UNIFIED_PLATFORMS:
            until = self.scheduler.platform_cooldown_until.get(p.key, 0.0)
            if until > time.time():
                remaining = int(until - time.time())
                mins, secs = divmod(max(0, remaining), 60)
                self.platform_cooldown_vars[p.key].set(f"{mins}m {secs}s")

    def _collect_inputs(self) -> Dict[str, List[str]]:
        result: Dict[str, List[str]] = {}
        for p in UNIFIED_PLATFORMS:
            raw = self.text_boxes[p.key].get("1.0", tk.END)
            result[p.key] = [line.strip() for line in raw.splitlines() if line.strip()]
        return result

    def start(self) -> None:
        if self.scheduler.running:
            return
        inputs = self._collect_inputs()
        limit = UNIFIED_LIMIT_OPTIONS[self.limit_var.get()]
        mode = self.mode_var.get()
        self.status_var.set("Running")
        self.start_btn.config(state="disabled")
        self.stop_btn.config(state="normal")
        self.scheduler.start(
            inputs,
            limit,
            mode,
            bool(self.force_refresh_var.get()),
            bool(self.continuous_var.get()),
            bool(self.high_throughput_var.get()),
            bool(self.extended_surfaces_var.get()),
            bool(self.collect_comments_var.get()),
        )

    def stop(self) -> None:
        if not self.scheduler.running:
            self.output.insert(tk.END, "[control] No active scheduler.\n")
            return
        self.status_var.set("Stopping")
        self.scheduler.stop()

    def open_folder(self) -> None:
        folder = str(BASE_DIR)
        try:
            if sys.platform == "darwin":
                subprocess.run(["open", folder], check=False)
            elif os.name == "nt":
                os.startfile(folder)  # type: ignore[attr-defined]
            else:
                subprocess.run(["xdg-open", folder], check=False)
        except Exception as exc:
            messagebox.showerror("Open Data Folder", str(exc))

    def run_self_test(self) -> None:
        self.output.insert(tk.END, "\n[self-test] Starting local collector/database tests...\n")
        self.output.see(tk.END)
        thread = threading.Thread(target=self._self_test_worker, daemon=True)
        thread.start()

    def _self_test_worker(self) -> None:
        results: List[str] = []
        try:
            # YouTube has no dedicated current self_test() entrypoint, so instantiate
            # the real database class and verify its schema can initialize.
            with tempfile.TemporaryDirectory(prefix="unified_youtube_test_") as td:
                db = youtube_Database(Path(td) / "youtube_test.db")
                try:
                    tables = {r[0] for r in db.conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
                    assert "channels" in tables and "videos" in tables and "runtime_state" in tables and "surface_items" in tables and "surface_snapshots" in tables
                finally:
                    db.close()
            results.append("YouTube database: PASS")

            if instagram_self_test() == 0:
                results.append("Instagram collector: PASS")
            else:
                results.append("Instagram collector: FAIL")
            if tiktok_self_test() == 0:
                results.append("TikTok collector: PASS")
            else:
                results.append("TikTok collector: FAIL")
        except Exception as exc:
            results.append(f"Self-test ERROR: {type(exc).__name__}: {exc}")
        self.enqueue_ui(("log", "[self-test] " + " | ".join(results) + "\n"))


def unified_self_test() -> int:
    print("All-in-One Social Collector self-test")
    print(f"Source file: {Path(__file__).resolve()}")
    print("Databases: youtube_maximum.db | instagram.db | tiktok.db")
    with tempfile.TemporaryDirectory(prefix="unified_youtube_test_") as td:
        db = youtube_Database(Path(td) / "youtube_test.db")
        try:
            tables = {r[0] for r in db.conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
            required = {"channels", "videos", "runtime_state"}
            missing = required - tables
            if missing:
                raise RuntimeError(f"YouTube schema missing: {sorted(missing)}")
            print("YouTube database: PASS")
        finally:
            db.close()
    if instagram_self_test() != 0:
        return 1
    if tiktok_self_test() != 0:
        return 1
    print("Unified self-test: PASS")
    return 0


def unified_dispatch_worker(platform_key: str, job_file: str) -> int:
    mapping = {
        "youtube": youtube_worker_main,
        "instagram": instagram_worker_main,
        "tiktok": tiktok_worker_main,
    }
    fn = mapping.get(platform_key)
    if fn is None:
        print(f"[worker] unknown platform: {platform_key}", flush=True)
        return 2
    return int(fn(job_file))


def unified_main() -> None:
    if len(sys.argv) >= 4 and sys.argv[1] == "--platform-worker":
        raise SystemExit(unified_dispatch_worker(sys.argv[2], sys.argv[3]))
    if len(sys.argv) >= 2 and sys.argv[1] == "--self-test":
        raise SystemExit(unified_self_test())

    root = tk.Tk()
    app = UnifiedApp(root)

    def close() -> None:
        try:
            app.scheduler.stop()
        finally:
            root.destroy()

    root.protocol("WM_DELETE_WINDOW", close)
    root.mainloop()


# ============================================================================
# V13 DURABILITY / THROTTLE / PERFORMANCE HARDENING
# ============================================================================
# This layer is intentionally appended after all existing platform/parity
# definitions so it can override the final active implementations without
# rewriting the original collectors. It provides:
#   * explicit DISCOVERED -> IN_PROGRESS -> COMPLETE/FAILED checkpoint state
#   * stop-safe resume decisions based on stage state, never on record existence
#   * one-shot Instagram profile endpoint attempts to avoid hidden 10-55 minute waits
#   * Instagram cached-ID feed resolution when a username endpoint is refused
#   * connection pooling on the collector-owned requests sessions
#   * stronger TikTok throttle detection (no generic "please wait" false positives)
#   * stale pending-retry cleanup when an item is already complete
#   * reduced full-table COUNT scans during hot loops
#   * extra database indexes for ingestion/backlog queries
#   * cached raw-enrichment reuse on resume where the complete yt-dlp payload is already stored
#
# Async I/O is deliberately not used for the stateful Instaloader/yt-dlp session
# paths. The collector instead uses bounded concurrency where that architecture is
# already supported (YouTube) and avoids multiplying anonymous Instagram/TikTok
# request pressure.

v13__REAL_YOUTUBE_INITIALIZE = youtube_Database.initialize
v13__REAL_INSTAGRAM_INITIALIZE = instagram_Database.initialize
v13__REAL_TIKTOK_INITIALIZE = tiktok_Database.initialize


def v13__ensure_columns(db, table: str, additions: dict) -> None:
    cols = {r[1] for r in db.conn.execute(f"PRAGMA table_info({table})").fetchall()}
    for name, definition in additions.items():
        if name not in cols:
            db.conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {definition}")


def v13__youtube_migrate(db: youtube_Database) -> None:
    with db.lock:
        v13__ensure_columns(db, "video_ingestion", {
            "enrichment_state": "TEXT DEFAULT 'DISCOVERED'",
            "current_stage": "TEXT",
            "checkpoint_at": "TEXT",
        })
        db.conn.executescript("""
            CREATE INDEX IF NOT EXISTS idx_v13_youtube_ingestion_state
              ON video_ingestion(channel_id, enrichment_state, last_discovered_at);
            CREATE INDEX IF NOT EXISTS idx_v13_youtube_stage_status
              ON video_ingestion(video_id, yt_dlp_status, player_status, captions_status, formats_status);
        """)
        rows = db.conn.execute(
            "SELECT video_id,enrichment_state,last_enriched_at,last_error,yt_dlp_status,player_status,captions_status,formats_status FROM video_ingestion"
        ).fetchall()
        for r in rows:
            state = str(r[1] or "").upper()
            if state in {"COMPLETE", "IN_PROGRESS", "FAILED", "DISCOVERED"}:
                continue
            complete = (
                bool(r[2])
                and str(r[4] or "") == "SUCCESS"
                and str(r[5] or "") in {"SUCCESS", "SKIPPED_NO_API_KEY", "SKIPPED_FAST_PATH", "SKIPPED_PERFORMANCE_REFRESH"}
                and str(r[6] or "") in {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}
                and str(r[7] or "") in {"SUCCESS", "SUCCESS_EMPTY", "SUCCESS_FAST_PATH", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"}
            )
            inferred = "COMPLETE" if complete else ("FAILED" if r[3] else "DISCOVERED")
            db.conn.execute("UPDATE video_ingestion SET enrichment_state=?, checkpoint_at=COALESCE(checkpoint_at,last_enriched_at) WHERE video_id=?", (inferred, r[0]))
        db.conn.commit()


def v13__instagram_migrate(db: instagram_Database) -> None:
    with db.lock:
        v13__ensure_columns(db, "post_ingestion", {
            "enrichment_state": "TEXT DEFAULT 'DISCOVERED'",
            "current_stage": "TEXT",
            "checkpoint_at": "TEXT",
        })
        db.conn.executescript("""
            CREATE INDEX IF NOT EXISTS idx_v13_instagram_ingestion_state
              ON post_ingestion(account_id, enrichment_state, last_discovered_at);
            CREATE INDEX IF NOT EXISTS idx_v13_instagram_stage_status
              ON post_ingestion(post_id, instaloader_status, ytdlp_status, comments_status, sidecar_status);
        """)
        rows = db.conn.execute(
            "SELECT post_id,enrichment_state,last_enriched_at,last_error,instaloader_status,ytdlp_status,comments_status,sidecar_status FROM post_ingestion"
        ).fetchall()
        for r in rows:
            state = str(r[1] or "").upper()
            if state in {"COMPLETE", "IN_PROGRESS", "FAILED", "DISCOVERED"}:
                continue
            # Legacy rows are only inferred COMPLETE when the statuses are explicitly terminal.
            terminal = {"SUCCESS", "SUCCESS_EMPTY", "SKIPPED", "NO_DATA", "NO_POST_OBJECT"}
            required_ok = str(r[4] or "") in {"SUCCESS", "SUCCESS_EMPTY"}
            ytdlp_ok = str(r[5] or "") in terminal or not r[5]
            comments_ok = str(r[6] or "") in terminal or not r[6]
            sidecar_ok = str(r[7] or "") in terminal or not r[7]
            complete = bool(r[2]) and required_ok and ytdlp_ok and comments_ok and sidecar_ok
            inferred = "COMPLETE" if complete else ("FAILED" if r[3] else "DISCOVERED")
            db.conn.execute("UPDATE post_ingestion SET enrichment_state=?, checkpoint_at=COALESCE(checkpoint_at,last_enriched_at) WHERE post_id=?", (inferred, r[0]))
        db.conn.commit()


def v13__tiktok_migrate(db: tiktok_Database) -> None:
    with db.lock:
