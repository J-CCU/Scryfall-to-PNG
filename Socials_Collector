def youtube_clear_ytdlp_rate_limit(db: Optional["Database"] = None) -> None:
    """Clear the persisted cooldown only after the waiting period has expired."""
    global youtube_YTDLP_RATE_LIMITED_UNTIL
    with youtube_YTDLP_RATE_LIMIT_LOCK:
        youtube_YTDLP_RATE_LIMITED_UNTIL = 0.0
    if db is None or not hasattr(db, "set_runtime_state"):
        return
    for key in (
        "yt_dlp_rate_limited_until",
        "yt_dlp_rate_limit_pending_video_id",
        "yt_dlp_rate_limit_pending_channel_id",
        "yt_dlp_rate_limit_pending_run_id",
        "yt_dlp_rate_limit_pending_action",
        "yt_dlp_rate_limit_reason",
    ):
        try:
            db.set_runtime_state(key, "")
        except Exception:
            pass


def youtube_wait_for_ytdlp_rate_limit_clear(db: Optional["Database"] = None, *, pending_video_id: str = "") -> bool:
    if youtube_ORCHESTRATED_RUN and youtube_ytdlp_rate_limited():
        youtube_log(
            f"[orchestrator] YouTube throttle detected; returning control to multi-platform scheduler "
            f"| pending_video={pending_video_id or 'none'}"
        )
        return False
    """Wait through the persisted cooldown, respecting Stop, then allow one retry."""
    while youtube_ytdlp_rate_limited():
        if youtube_stop_requested():
            return False
        remaining = youtube_ytdlp_rate_limit_remaining()
        mins, secs = divmod(remaining, 60)
        target = f" | retry_video={pending_video_id}" if pending_video_id else ""
        youtube_log(f"[throttle] cooldown active | remaining={mins}m {secs}s{target} | preserving committed DB data")
        wait_for = min(float(remaining), youtube_YTDLP_RATE_LIMIT_WAIT_LOG_INTERVAL)
        if youtube_STOP_EVENT.wait(wait_for):
            return False
    youtube_clear_ytdlp_rate_limit(db)
    youtube_log("[throttle] cooldown expired | yt-dlp requests can resume")
    return True


