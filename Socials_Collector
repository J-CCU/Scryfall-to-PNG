# ---------------------------------------------------------------------------
# Performance refresh correctness: never stamp last_performance_refresh_at when
# the official API returned nothing. Discovery/API data already fetched in this
# same pass still counts as a valid refresh and is committed once.
# ---------------------------------------------------------------------------
def youtube_refresh_performance_batch_via_youtube_api_v39(
    run_id: int, db: youtube_Database, videos: List[dict]
) -> int:
    pipeline = _v38_current_pipeline()
    if pipeline is not None:
        for video in videos:
            pipeline.submit_comments(video, force=False)

    if not videos or _v39_api_circuit_open(db):
        youtube_log("  [youtube-api/v39] performance refresh DEFERRED | quota circuit/API unavailable | timestamps unchanged")
        return 0
    if not youtube_USE_YOUTUBE_DATA_API_ACCELERATOR or not youtube_youtube_api_budget_available(db):
        youtube_log("  [youtube-api/v39] performance refresh DEFERRED | API budget unavailable | timestamps unchanged")
        return 0

    # Rows already enriched by API-primary discovery are fresh and need no
    # duplicate request. The V34 wrapper marks those rows.
    fresh_ids = {
        str(v.get("video_id") or "")
        for v in videos
        if bool((v or {}).get("_v34_youtube_api_batch_enriched"))
    }
    todo = [v for v in videos if str(v.get("video_id") or "") not in fresh_ids]
    if todo:
        youtube_youtube_api_enrich_videos_batch(run_id, db, todo)
        for v in todo:
            if bool((v or {}).get("_v34_youtube_api_batch_enriched")) or (v or {}).get("_youtube_api_item"):
                fresh_ids.add(str(v.get("video_id") or ""))

    committed = 0
    for v in videos:
        vid = str(v.get("video_id") or "")
        if not vid or vid not in fresh_ids:
            continue
        state = db.get_video_sync(vid) or {}
        v["yt_dlp_status"] = state.get("yt_dlp_status") or "SUCCESS"
        v["player_status"] = state.get("player_status") or "SUCCESS"
        v["comments_status"] = state.get("comments_status") or "DEFERRED_QUOTA"
        v["captions_status"] = state.get("captions_status") or "SUCCESS_EMPTY"
        v["formats_status"] = state.get("formats_status") or "SUCCESS_EMPTY"
        db.upsert_video(v)
        db.video_snapshot(run_id, v)
        db.mark_video_enrichment(run_id, v, full=False, heavy=False)
        committed += 1
    youtube_log(
        f"  [youtube-api/v39] performance refresh COMPLETE | requested={len(videos)} | "
        f"fresh_api_rows={len(fresh_ids)} | db_committed={committed}"
    )
    return committed


