youtube_RENDERER_KEYS = (
    "videoRenderer",
    "playlistVideoRenderer",
    "gridVideoRenderer",
    "compactVideoRenderer",
    "reelItemRenderer",
)


def youtube_extract_renderers(obj: Any) -> List[dict]:
    found = []
    def walk(node: Any) -> None:
        if isinstance(node, dict):
            for key in youtube_RENDERER_KEYS:
                value = node.get(key)
                if isinstance(value, dict):
                    found.append(value)
            for child in node.values():
                walk(child)
        elif isinstance(node, list):
            for child in node:
                walk(child)
    walk(obj)
    out = []
    seen = set()
    for r in found:
        vid = r.get("videoId")
        if vid and vid not in seen:
            seen.add(vid)
            out.append(r)
    return out


def youtube_extract_continuations(obj: Any) -> List[str]:
    out: List[str] = []
    def add(value: Any) -> None:
        if isinstance(value, str) and value and value not in out:
            out.append(value)
    def walk(node: Any) -> None:
        if isinstance(node, dict):
            cc = node.get("continuationCommand")
            if isinstance(cc, dict):
                add(cc.get("token"))
            nc = node.get("nextContinuationData")
            if isinstance(nc, dict):
                add(nc.get("continuation"))
            endpoint = node.get("continuationEndpoint")
            if isinstance(endpoint, dict):
                command = endpoint.get("command", {})
                if isinstance(command, dict):
                    cc2 = command.get("continuationCommand")
                    if isinstance(cc2, dict):
                        add(cc2.get("token"))
            for child in node.values():
                walk(child)
        elif isinstance(node, list):
            for child in node:
                walk(child)
    walk(obj)
    return out


def youtube_renderer_to_video(r: dict, channel_id: str) -> Optional[dict]:
    vid = r.get("videoId")
    if not isinstance(vid, str) or not vid:
        return None

    title = youtube_text_from_runs(r.get("title", {})) or youtube_text_from_runs(r.get("headline", {}))
    published = youtube_text_from_runs(r.get("publishedTimeText", {}))
    length_text = youtube_text_from_runs(r.get("lengthText", {}))
    views_text = youtube_text_from_runs(r.get("viewCountText", {}))

    duration = youtube_parse_duration(length_text)
    badges = []
    for b in r.get("badges", []):
        if isinstance(b, dict):
            label = b.get("metadataBadgeRenderer", {}).get("label")
            if label:
                badges.append(label)

    if any("LIVE" in b.upper() for b in badges):
        classification = "Livestream"
    elif any("PREMIERE" in b.upper() for b in badges):
        classification = "Premiere"
    elif duration is not None and duration < 60:
        classification = "Short"
    else:
        classification = "Longform"

    thumbs = r.get("thumbnail", {}).get("thumbnails", [])
    thumb = thumbs[-1].get("url", "") if thumbs else f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg"

    return {
        "video_id": vid,
        "channel_id": channel_id,
        "title": title,
        "description": "",
        "published_text": published,
        "upload_date": "",
        "timestamp": None,
        "duration_seconds": duration,
        "width": youtube_safe_int(r.get("width")),
        "height": youtube_safe_int(r.get("height")),
        "view_count": youtube_safe_int(r.get("viewCountText", {}).get("simpleText", "")) or youtube_safe_int(youtube_digits_only(views_text)),
        "like_count": None,
        "comment_count": None,
        "channel_name": youtube_text_from_runs(r.get("ownerText", {})),
        "uploader_id": "",
        "category": "",
        "language": "",
        "availability": "",
        "age_limit": None,
        "live_status": "",
        "classification": classification,
        "is_live": "" if classification != "Livestream" else True,
        "is_short": classification == "Short",
        "is_premiere": classification == "Premiere",
        "is_family_safe": "",
        "is_monetized": "",
        "ads_enabled": "",
        "has_paid_promotion": "",
        "is_premium_content": "",
        "thumbnail_url": thumb,
        "webpage_url": f"https://www.youtube.com/watch?v={vid}",
        "listing_status": "SUCCESS",
        "player_status": "NOT_FETCHED",
        "yt_dlp_status": "NOT_FETCHED",
        "raw_listing_id": None,
        "raw_player_id": None,
        "raw_ytdlp_id": None,
        "source_raw_listing": r,
    }


