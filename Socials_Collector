        now = tiktok_now_utc()
        with self.lock:
            exists = self.conn.execute("SELECT video_id FROM video_ingestion WHERE video_id=?", (vid,)).fetchone()
            if exists:
                self.conn.execute(
                    "UPDATE video_ingestion SET last_discovered_at=?,discovery_count=discovery_count+1,last_run_id=? WHERE video_id=?",
                    (now, run_id, vid),
                )
            else:
                self.conn.execute(
                    """INSERT INTO video_ingestion(video_id,account_id,first_seen_at,last_discovered_at,discovery_count,last_run_id)
                    VALUES(?,?,?,?,?,?)""",
