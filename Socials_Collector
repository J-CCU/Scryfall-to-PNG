# V49 corrected the parser but cached rows created before the fix can still say
# e.g. subscribers_text='62.5K subscribers', subscribers_exact='625'.  Detect
# that impossible scale mismatch and invalidate only the channel API freshness
# marker so the next pass repairs it from channels.list.
def _v50_channel_metrics_suspicious(row: Optional[dict]) -> bool:
    if not row:
        return False
    pairs = (
        (row.get("subscribers_text"), row.get("subscribers_exact")),
        (row.get("total_views_text"), row.get("total_views_exact")),
    )
    for text_value, exact_value in pairs:
        text_s = str(text_value or "")
        if not re.search(r"\d(?:[\d,.]*)\s*[KMBT]\b", text_s, re.I):
            continue
        parsed = _v49_human_count(text_s)
        try:
            exact = int(str(exact_value or "").replace(",", ""))
        except Exception:
            exact = 0
        if parsed and (exact <= 0 or exact < parsed / 10 or exact > parsed * 10):
            return True
    return False


