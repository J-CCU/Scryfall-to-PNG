# ===========================================================================
# V41 — DURABLE FINISHED COUNTER + API->FALLBACK->API COMMENT RECOVERY
# ===========================================================================
# V41 makes the visible meaning of "finished" match durable database evidence:
#   * catalog/channel progress remains visible as the fast discovery counter;
#   * a separate GUI counter reads SQLite and shows videos whose mandatory
#     payload + comment evidence is actually COMPLETE;
#   * completeness_audit_status is refreshed at each heavy/comment completion,
#     not only at startup/end-of-run audits;
#   * every incomplete historical row remains eligible for repair after restart;
#     video_ingestion is the durable work ledger, so an in-memory queue loss can
#     never erase the obligation to finish that video;
#   * official YouTube comments are preferred whenever the API is healthy;
#   * daily quota exhaustion uses the slower yt-dlp comment fallback until the
#     next Pacific quota day, then the API is automatically retried;
#   * transient API/rate failures use the same fallback during a shorter
#     persisted cooldown and automatically probe the API again afterward.

V41_BUILD = "ALL_FIXES_V41_DURABLE_FINISHED_COUNTER_API_FALLBACK"
V41_TRANSIENT_API_COOLDOWN_SECONDS = max(
    60.0, float(os.getenv("SOCIAL_YOUTUBE_API_TRANSIENT_COOLDOWN_SECONDS", "900"))
)
V41_REPAIR_ALL_LIMIT = max(10000, int(os.getenv("SOCIAL_YOUTUBE_REPAIR_ALL_LIMIT", "100000")))
V41_TRANSIENT_API_REASONS = {"rateLimitExceeded", "userRateLimitExceeded", "backendError"}

# A restart must reconstruct the entire unfinished obligation from SQLite, not
# only 50 heavy / 1000 comment rows per channel.  list_video_backlog reads these
# globals at runtime and the V38 pipeline de-duplicates jobs within a run.
V39_HEAVY_REPAIR_PER_CHANNEL = V41_REPAIR_ALL_LIMIT
V39_COMMENT_BACKLOG_PER_CHANNEL = V41_REPAIR_ALL_LIMIT
V38_HEAVY_REPAIR_PER_CHANNEL = V41_REPAIR_ALL_LIMIT
V38_COMMENT_BACKLOG_PER_CHANNEL = V41_REPAIR_ALL_LIMIT


def _v41_runtime_delete(db: youtube_Database, *keys: str) -> None:
    if not keys:
        return
    try:
        with db.lock:
            db.conn.executemany("DELETE FROM runtime_state WHERE key=?", [(k,) for k in keys])
            db.conn.commit()
    except Exception:
        pass


def _v41_transient_api_cooldown_until(db: youtube_Database) -> float:
    try:
        raw = db.get_runtime_state("youtube_api_transient_cooldown_until") or "0"
        until = float(raw)
    except Exception:
        until = 0.0
    if until and until <= time.time():
        _v41_runtime_delete(
            db,
            "youtube_api_transient_cooldown_until",
            "youtube_api_transient_cooldown_reason",
        )
        return 0.0
    return until


def _v41_transient_api_cooldown_open(db: youtube_Database) -> bool:
    return _v41_transient_api_cooldown_until(db) > time.time()


def _v41_set_transient_api_cooldown(db: youtube_Database, reason: str) -> float:
    now = time.time()
    current = _v41_transient_api_cooldown_until(db)
    until = max(current, now + V41_TRANSIENT_API_COOLDOWN_SECONDS)
    try:
        with db.lock:
            _v39_runtime_set_locked(db, "youtube_api_transient_cooldown_until", f"{until:.3f}")
            _v39_runtime_set_locked(db, "youtube_api_transient_cooldown_reason", str(reason or "rateLimitExceeded"))
            db.conn.commit()
    except Exception:
        pass
    if current <= now:
        youtube_log(
            f"[youtube-api/v41] TRANSIENT COOLDOWN | reason={reason or 'rate-limit'} | "
            f"seconds={int(V41_TRANSIENT_API_COOLDOWN_SECONDS)} | yt-dlp fallback remains active"
        )
    return until


