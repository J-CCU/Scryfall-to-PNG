def _v45_youtube_payload_complete(db: youtube_Database, state: Optional[dict], mode: str = "Maximum") -> bool:
    if not state:
        return False
    vid = str((state or {}).get("video_id") or "")
    if not vid:
        return False
    # Non-Maximum modes still benefit from the same durable proof; V45 is used
    # by the server's Maximum mode and keeping one predicate avoids split-brain
    # queue/action/finalizer decisions.
    expr = _v45_youtube_payload_expr("vi")
    try:
        with db.lock:
            row = db.conn.execute(
                f"SELECT 1 FROM video_ingestion vi WHERE vi.video_id=? AND ({expr}) LIMIT 1",
                (vid,),
            ).fetchone()
        return bool(row)
    except Exception:
        return False


