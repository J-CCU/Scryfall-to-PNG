# ============================================================================
# V15 WORK-CONSERVING PLATFORM SCHEDULER
# ============================================================================
# Scheduling policy:
#   1. Instagram has priority when ready.
#   2. TikTok is next when Instagram is cooling/complete.
#   3. YouTube is the filler workload while Instagram/TikTok are cooling.
#   4. If a higher-priority platform's persisted cooldown expires while YouTube
#      is running, let the current YouTube video reach a durable completion
#      boundary, then preempt the YouTube worker and resume the ready platform.
#   5. When both Instagram and TikTok become ready simultaneously, Instagram wins.
#   6. FAILED is terminal for the current scheduler cycle; continuous mode can
#      retry it on the next cycle.
#   7. A 401/"Please wait" Instagram endpoint refusal is not promoted to a
#      platform-wide cooldown; only explicit rate/challenge evidence is.
#
# This is scheduling only. It does not bypass rate limits or rotate identities.

v15__PLATFORM_PRIORITY = ("instagram", "tiktok", "youtube")
v15__SAFE_YOUTUBE_BOUNDARY = re.compile(r"\[stage\]\s+complete\b", re.I)


def v15__higher_priority_ready(self: UnifiedScheduler, inputs: Dict[str, List[str]]) -> bool:
    now = time.time()
    for key in ("instagram", "tiktok"):
        if not inputs.get(key):
            continue
        state = self.platform_states.get(key, "READY")
        if state in {"COMPLETE", "EMPTY", "FAILED"}:
            continue
        until = self.platform_cooldown_until.get(key, 0.0)
        if until <= now:
            # Refresh from the DB in case the cooldown expired while YouTube was running.
            p = next((x for x in UNIFIED_PLATFORMS if x.key == key), None)
            if p is not None:
                db_until = self._cooldown_until(p)
                self.platform_cooldown_until[key] = db_until
                until = db_until
            if until <= now:
                return True
    return False


def v15__ready_platforms(self: UnifiedScheduler, inputs: Dict[str, List[str]]) -> List[UnifiedPlatform]:
    now = time.time()
    ready: List[UnifiedPlatform] = []
    for p in UNIFIED_PLATFORMS:
        if not inputs.get(p.key):
            continue
        if self.platform_states.get(p.key) in {"COMPLETE", "EMPTY", "FAILED"}:
            continue
        until = self.platform_cooldown_until.get(p.key, 0.0)
        if until and until > now:
            continue
        # Re-read persisted cooldown for correctness after another worker updated DB.
        persisted = self._cooldown_until(p)
        if persisted > now:
            self.platform_cooldown_until[p.key] = persisted
            continue
        ready.append(p)
    return ready

UnifiedScheduler._ready_platforms = v15__ready_platforms


def v15__all_terminal(self: UnifiedScheduler, inputs: Dict[str, List[str]]) -> bool:
    for p in UNIFIED_PLATFORMS:
        if not inputs.get(p.key):
            continue
        if self.platform_states.get(p.key) not in {"COMPLETE", "EMPTY", "FAILED"}:
            return False
    return True

UnifiedScheduler._all_terminal = v15__all_terminal


def v15__next_priority(self: UnifiedScheduler, candidates: List[UnifiedPlatform]) -> Optional[UnifiedPlatform]:
    if not candidates:
        return None
    by_key = {p.key: p for p in candidates}
    # Fixed priority inside the work-conserving scheduler, independent of the
    # legacy round-robin cursor.
    for key in v15__PLATFORM_PRIORITY:
        if key in by_key:
            return by_key[key]
    return candidates[0]


# Keep legacy method name but make its effective order priority-based.
UnifiedScheduler._next_in_order = v15__next_priority


# Reimplement the worker runner with safe YouTube preemption at a completed
# video boundary. Non-YouTube workers retain the original lifecycle behavior.
def v15__run_platform(
    self: UnifiedScheduler,
    platform: UnifiedPlatform,
    inputs: List[str],
    limit: int,
    mode: str,
    force_refresh: bool,
    high_throughput: bool,
    extended_surfaces: bool,
) -> str:
    if not inputs:
        self.ui_platform(platform.key, "EMPTY")
        return "EMPTY"

    env = os.environ.copy()
    env["SOCIAL_COLLECTOR_ORCHESTRATED"] = "1"
    env["SOCIAL_COLLECTOR_THROUGHPUT_PROFILE"] = "high" if high_throughput else "normal"
    env["SOCIAL_COLLECTOR_EXTENDED_SURFACES"] = "1" if extended_surfaces else "0"
    env["PYTHONUNBUFFERED"] = "1"

    job_path = self._write_job(platform, inputs, limit, mode, force_refresh)
    output_tail: List[str] = []
    self.current = platform
    self.current_rate_limited = False
    preempted = False
    preempt_requested = False
    self.ui_platform(platform.key, "RUNNING")
    self.ui_log(
        f"\n[multiplatform] >>> {platform.label} | cycle={self.cycle} | "
        f"inputs={len(inputs)} | limit={'ALL' if limit <= 0 else limit}\n"
    )

    try:
        cmd = [sys.executable, str(Path(__file__).resolve()), "--platform-worker", platform.key, str(job_path)]
        self.ui_log(
            f"[multiplatform] launch: {platform.label} worker | "
            f"high_throughput={'YES' if high_throughput else 'NO'}\n"
        )
        with self.worker_lock:
            self.process = subprocess.Popen(
                cmd,
                cwd=str(BASE_DIR),
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                bufsize=1,
            )

        if self.process.stdout is not None:
            for raw in self.process.stdout:
                if self.stop_event.is_set():
                    break
                line = raw.rstrip("\n")
                output_tail.append(line)
                if len(output_tail) > 240:
                    output_tail.pop(0)
                self.ui_log(line + "\n")

                if line.startswith("[PROGRESS]|"):
                    parts = line.split("|", 3)
                    if len(parts) == 4:
                        try:
                            self.app.enqueue_ui(("progress", platform.key, int(parts[1]), int(parts[2]), parts[3]))
                        except Exception:
                            pass

                lowered_line = line.lower()
                explicit_throttle_event = (
                    ("[throttle]" in lowered_line or "[orchestrator]" in lowered_line)
                    and any(p.search(line) for p in platform.throttle_patterns)
                )
                if explicit_throttle_event:
                    self.current_rate_limited = True
                    proc = self.process
                    if proc is not None and proc.poll() is None:
                        try:
                            proc.terminate()
                        except Exception:
                            pass
                    break

                # Only YouTube is preemptible filler work. If Instagram/TikTok
                # becomes ready during this YouTube run, finish the current
                # durable video boundary, then give control back.
                if platform.key == "youtube" and not preempt_requested:
                    if v15__higher_priority_ready(self, getattr(self, "v15_all_inputs", {})):
                        preempt_requested = True
                        self.ui_log(
                            "[multiplatform] higher-priority platform cooldown expired while YouTube was running; "
                            "will hand off after the current YouTube video reaches a durable completion boundary.\n"
                        )

                if (
                    platform.key == "youtube"
                    and preempt_requested
                    and v15__SAFE_YOUTUBE_BOUNDARY.search(line)
                ):
                    preempted = True
                    self.ui_log(
                        "[multiplatform] YouTube safe boundary reached; preempting filler workload to resume "
                        "the ready higher-priority platform.\n"
                    )
                    proc = self.process
                    if proc is not None and proc.poll() is None:
                        try:
                            proc.terminate()
                        except Exception:
                            pass
                    break

        rc = self.process.wait() if self.process is not None else -1
    except Exception as exc:
        self.ui_log(f"[multiplatform] {platform.label} worker error: {type(exc).__name__}: {exc}\n")
        rc = -1
    finally:
        with self.worker_lock:
            self.process = None
        try:
            job_path.unlink(missing_ok=True)
        except Exception:
            pass
        self.current = None

    if preempted:
        # Do not mark the platform failed. Its durable per-video checkpoints
        # allow the next worker invocation to resume exactly where it left off.
        self.ui_platform(platform.key, "READY")
        return "PREEMPTED"

    throttled, until = self._platform_is_throttled(platform, output_tail)
    if self.current_rate_limited or throttled:
        self.ui_platform(platform.key, "COOLDOWN")
        self.ui_cooldown(platform.key, until)
        self.ui_log(
            f"[multiplatform] {platform.label} parked due to throttle/cooldown | "
            f"until={datetime.fromtimestamp(until, timezone.utc).isoformat() if until else 'unknown'}\n"
        )
        return "RATE_LIMITED"

    if self.stop_event.is_set():
        self.ui_platform(platform.key, "STOPPED")
        return "STOPPED"

    if rc == 0:
        self.ui_platform(platform.key, "COMPLETE")
        self.ui_log(f"[multiplatform] <<< {platform.label} completed successfully\n")
        return "COMPLETE"

    self.ui_platform(platform.key, "FAILED")
    self.ui_log(f"[multiplatform] <<< {platform.label} worker exited with code {rc}\n")
    return "FAILED"

UnifiedScheduler._run_platform = v15__run_platform


def v15__main(
    self: UnifiedScheduler,
    inputs: Dict[str, List[str]],
    limit: int,
    mode: str,
    force_refresh: bool,
    continuous: bool,
    high_throughput: bool,
    extended_surfaces: bool,
) -> None:
    self.ui_log("\n[multiplatform] MASTER SCHEDULER STARTED\n")
    self.ui_log("[multiplatform] Work-conserving priority: Instagram -> TikTok -> YouTube\n")
    self.ui_log(
        f"[multiplatform] mode={mode} | limit={'ALL' if limit <= 0 else limit} | comments={'ON' if self.collect_comments_enabled else 'OFF'} | "
        f"continuous={'YES' if continuous else 'NO'} | high_throughput={'YES' if high_throughput else 'NO'} | "
        f"extended_surfaces={'YES' if extended_surfaces else 'NO'}\n"
    )
    self.v15_all_inputs = inputs
    try:
        while not self.stop_event.is_set():
            # Mirror persisted cooldowns before every scheduling decision.
            for p in UNIFIED_PLATFORMS:
                if inputs.get(p.key):
                    until = self._cooldown_until(p)
                    self.platform_cooldown_until[p.key] = until
                    if until > time.time():
                        self.ui_cooldown(p.key, until)
                        if self.platform_states.get(p.key) not in {"COMPLETE", "EMPTY", "FAILED"}:
                            self.platform_states[p.key] = "COOLDOWN"
                    elif self.platform_states.get(p.key) == "COOLDOWN":
                        self.platform_states[p.key] = "READY"

            ready = self._ready_platforms(inputs)
            if ready:
                platform = self._next_in_order(ready)
                if platform is None:
                    continue

                status = self._run_platform(
                    platform,
                    inputs.get(platform.key, []),
                    limit,
                    mode,
                    force_refresh,
                    high_throughput,
                    extended_surfaces,
                )

                if status == "STOPPED":
                    break
                # PREEMPTED, RATE_LIMITED and FAILED all return control to the
                # priority selector immediately. Complete also re-enters it so
                # the next ready platform is chosen by priority.
                continue

            if self._all_terminal(inputs):
                if continuous:
                    self._reset_cycle(inputs)
                    if self.stop_event.wait(1.0):
                        break
                    continue
                self.ui_log("\n[multiplatform] All supplied platform queues are complete/terminal for this cycle.\n")
                break

            cooldown_platform, until = self._next_cooldown(inputs)
            if cooldown_platform is not None:
                remaining = max(0.0, until - time.time())
                mins, secs = divmod(int(remaining), 60)
                self.ui_log(
                    f"[multiplatform] waiting for earliest platform cooldown | "
                    f"platform={cooldown_platform.label} | remaining={mins}m {secs}s\n"
                )
                wait_for = min(max(0.25, remaining), 5.0)
                if self.stop_event.wait(wait_for):
                    break
                continue

            self.ui_log("[multiplatform] No ready platform and no persisted cooldown. Ending cycle.\n")
            break
    except Exception as exc:
        self.ui_log(f"[multiplatform] scheduler fatal error: {type(exc).__name__}: {exc}\n")
        self.ui_log(traceback.format_exc())
    finally:
        self.current = None
        self.process = None
        self.v15_all_inputs = {}
        self.ui_log("[multiplatform] MASTER SCHEDULER STOPPED\n")
        self.app.enqueue_ui(("scheduler_done",))

UnifiedScheduler._main = v15__main


