}


# The scheduler reads the platform-specific runtime_state table because the
# platform collectors persist their cooldowns there. These alternate spellings
# are included to keep the scheduler resilient to the exact key names used by
# different collector revisions.
UNIFIED_COOLDOWN_KEYS = {
    "youtube": ("youtube_ytdlp_rate_limited_until", "youtube_yt_dlp_rate_limited_until", "yt_dlp_rate_limited_until"),
    "instagram": ("instagram_rate_limited_until", "instagram_RATE_LIMITED_UNTIL", "rate_limited_until"),
    "tiktok": ("tiktok_rate_limited_until", "tiktok_tiktok_rate_limited_until"),
}


class UnifiedScheduler:
    def __init__(self, app: "UnifiedApp") -> None:
        self.app = app
        self.stop_event = threading.Event()
        self.wake_event = threading.Event()
        self.thread: Optional[threading.Thread] = None
        self.process: Optional[subprocess.Popen] = None
        self.current: Optional[UnifiedPlatform] = None
        self.current_rate_limited = False
        self.platform_states: Dict[str, str] = {p.key: "READY" for p in UNIFIED_PLATFORMS}
        self.platform_cooldown_until: Dict[str, float] = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.platform_runs: Dict[str, int] = {}
        self.cycle = 1
        self.cursor = 0
        self.worker_lock = threading.Lock()
        self.collect_comments_enabled = False

    @property
    def running(self) -> bool:
        return self.thread is not None and self.thread.is_alive()

    def ui_log(self, msg: str) -> None:
        self.app.enqueue_ui(("log", msg))

    def ui_platform(self, key: str, state: str) -> None:
        self.platform_states[key] = state
        self.app.enqueue_ui(("platform", key, state))

    def ui_cooldown(self, key: str, until: float) -> None:
        self.platform_cooldown_until[key] = max(0.0, until)
        self.app.enqueue_ui(("cooldown", key, max(0.0, until)))

    def start(
        self,
        inputs: Dict[str, List[str]],
        limit: int,
        mode: str,
        force_refresh: bool,
        continuous: bool,
        high_throughput: bool,
        extended_surfaces: bool,
        collect_comments: bool = False,
    ) -> None:
        if self.running:
            return
        if not any(inputs.get(p.key) for p in UNIFIED_PLATFORMS):
            self.ui_log("[multiplatform] No inputs supplied. Add at least one YouTube, Instagram, or TikTok input.\n")
            return

        self.stop_event.clear()
        self.wake_event.clear()
        self.current = None
        self.process = None
        self.current_rate_limited = False
        self.collect_comments_enabled = bool(collect_comments)
        self.platform_states = {p.key: ("READY" if inputs.get(p.key) else "EMPTY") for p in UNIFIED_PLATFORMS}
        self.platform_cooldown_until = {p.key: 0.0 for p in UNIFIED_PLATFORMS}
        self.platform_runs = {}
        self.cycle = 1
        self.cursor = 0

        args = (inputs, limit, mode, force_refresh, continuous, high_throughput, extended_surfaces)
        self.thread = threading.Thread(target=self._main, args=args, daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()
        self.wake_event.set()
        proc = self.process
        if proc is not None and proc.poll() is None:
            self.ui_log("[multiplatform] STOP requested; terminating the active platform worker.\n")
            try:
                proc.terminate()
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        self.app.root.after(1200, self._force_kill)

    def _force_kill(self) -> None:
        proc = self.process
        if proc is not None and proc.poll() is None:
            try:
                proc.kill()
            except Exception:
                pass

    def _db_runtime_state(self, db_path: Path) -> Dict[str, str]:
        result: Dict[str, str] = {}
        if not db_path.exists():
            return result
        try:
            conn = sqlite3.connect(str(db_path), timeout=2.0)
            try:
                conn.execute("PRAGMA busy_timeout=2000")
                rows = conn.execute("SELECT key, value FROM runtime_state").fetchall()
                result = {str(k): str(v) for k, v in rows}
            finally:
                conn.close()
        except Exception:
            return result
        return result

    def _cooldown_until(self, platform: UnifiedPlatform) -> float:
        state = self._db_runtime_state(platform.db_path)
        for key in UNIFIED_COOLDOWN_KEYS.get(platform.key, ()):
            raw = state.get(key)
            if raw:
                try:
                    return max(0.0, float(raw))
                except Exception:
                    continue
        # Some collector revisions store the cooldown in epoch milliseconds.
        for key, raw in state.items():
            if "rate_limited_until" not in key.lower():
                continue
            try:
                value = float(raw)
                if value > 2_000_000_000_000:
                    value /= 1000.0
                if value > time.time():
                    return value
            except Exception:
                continue
        return 0.0

    def _platform_is_throttled(self, platform: UnifiedPlatform, output_tail: List[str]) -> Tuple[bool, float]:
        until = self._cooldown_until(platform)
        if until > time.time():
            return True, until
        text = "\n".join(output_tail[-120:])
        if any(p.search(text) for p in platform.throttle_patterns):
            # If the platform emitted a throttle event but didn't persist a cooldown
            # key (for example during a hard worker exit), park briefly so the next
            # platform can proceed; the next pass re-reads the DB state.
            return True, time.time() + 60.0
        return False, 0.0

    def _write_job(self, platform: UnifiedPlatform, inputs: List[str], limit: int, mode: str, force_refresh: bool) -> Path:
        payload = {
            "inputs": list(inputs),
            "limit": int(limit),
            "mode": str(mode),
            "force_refresh": bool(force_refresh),
            "collect_comments": bool(self.collect_comments_enabled),
        }
        fd, raw_path = tempfile.mkstemp(prefix=f"social_collector_{platform.key}_", suffix=".json", dir=str(BASE_DIR))
        os.close(fd)
        path = Path(raw_path)
        path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        return path

    def _run_platform(
        self,
        platform: UnifiedPlatform,
        inputs: List[str],
        limit: int,
        mode: str,
        force_refresh: bool,
        high_throughput: bool,
        extended_surfaces: bool,
    ) -> str:
        if not inputs:
            self.ui_platform(platform.key, "EMPTY")
            return "EMPTY"

        env = os.environ.copy()
        env["SOCIAL_COLLECTOR_ORCHESTRATED"] = "1"
        env["SOCIAL_COLLECTOR_THROUGHPUT_PROFILE"] = "high" if high_throughput else "normal"
        env["SOCIAL_COLLECTOR_EXTENDED_SURFACES"] = "1" if extended_surfaces else "0"
        env["SOCIAL_COLLECT_COMMENTS"] = "1" if self.collect_comments_enabled else "0"
        env["PYTHONUNBUFFERED"] = "1"

        job_path = self._write_job(platform, inputs, limit, mode, force_refresh)
        output_tail: List[str] = []
        self.current = platform
        self.current_rate_limited = False
        self.ui_platform(platform.key, "RUNNING")
        self.ui_log(f"\n[multiplatform] >>> {platform.label} | cycle={self.cycle} | inputs={len(inputs)} | limit={'ALL' if limit <= 0 else limit}\n")

        try:
            cmd = [sys.executable, str(Path(__file__).resolve()), "--platform-worker", platform.key, str(job_path)]
            self.ui_log(f"[multiplatform] launch: {platform.label} worker | high_throughput={'YES' if high_throughput else 'NO'}\n")
            with self.worker_lock:
                self.process = subprocess.Popen(
                    cmd,
                    cwd=str(BASE_DIR),
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                )

            if self.process.stdout is not None:
                for raw in self.process.stdout:
                    if self.stop_event.is_set():
                        break
                    line = raw.rstrip("\n")
                    output_tail.append(line)
                    if len(output_tail) > 200:
                        output_tail.pop(0)
                    if line.startswith("[PROGRESS]|"):
                        parts = line.split("|", 3)
                        if len(parts) == 4:
                            try:
                                self.app.enqueue_ui(("progress", platform.key, int(parts[1]), int(parts[2]), parts[3]))
                            except Exception:
                                pass
                        # V22 graceful END boundary: progress is emitted only after
                        # the current item has returned from its enrichment/write
                        # path. Stop this platform here, before another item begins.
                        if getattr(self, "graceful_end_requested", False):
                            self.ui_log(f"[control] {platform.label} current item checkpointed; ending worker at item boundary.\n")
                            try:
                                if proc.poll() is None:
                                    proc.terminate()
                            except Exception:
                                pass
                            break
                    self.ui_log(line + "\n")
                    lowered_line = line.lower()
                    explicit_throttle_event = (
                        ("[throttle]" in lowered_line or "[orchestrator]" in lowered_line)
                        and any(p.search(line) for p in platform.throttle_patterns)
                    )
                    if explicit_throttle_event:
                        self.current_rate_limited = True
                        # The collector has already emitted the persisted throttle event.
                        # Release this process now so the scheduler can advance to the
                        # next platform. Pending item/account ids remain in runtime_state.
                        proc = self.process
                        if proc is not None and proc.poll() is None:
                            try:
                                proc.terminate()
                            except Exception:
                                pass
                        break

            rc = self.process.wait() if self.process is not None else -1
        except Exception as exc:
            self.ui_log(f"[multiplatform] {platform.label} worker error: {type(exc).__name__}: {exc}\n")
            rc = -1
        finally:
            with self.worker_lock:
                self.process = None
            try:
                job_path.unlink(missing_ok=True)
            except Exception:
                pass
            self.current = None

        throttled, until = self._platform_is_throttled(platform, output_tail)
        if self.current_rate_limited or throttled:
            self.ui_platform(platform.key, "COOLDOWN")
            self.ui_cooldown(platform.key, until)
            self.ui_log(
                f"[multiplatform] {platform.label} parked due to throttle/cooldown | "
                f"until={datetime.fromtimestamp(until, timezone.utc).isoformat() if until else 'unknown'}\n"
            )
            return "RATE_LIMITED"

        if self.stop_event.is_set():
            self.ui_platform(platform.key, "STOPPED")
            return "STOPPED"

        if rc == 0:
            self.ui_platform(platform.key, "COMPLETE")
            self.ui_log(f"[multiplatform] <<< {platform.label} completed successfully\n")
            return "COMPLETE"

        self.ui_platform(platform.key, "FAILED")
        self.ui_log(f"[multiplatform] <<< {platform.label} worker exited with code {rc}\n")
        return "FAILED"

    def _ready_platforms(self, inputs: Dict[str, List[str]]) -> List[UnifiedPlatform]:
        now = time.time()
        ready: List[UnifiedPlatform] = []
        for p in UNIFIED_PLATFORMS:
            if not inputs.get(p.key):
                continue
            if self.platform_states.get(p.key) in {"COMPLETE", "EMPTY"}:
                continue
            until = self.platform_cooldown_until.get(p.key, 0.0)
            if until and until > now:
                continue
            ready.append(p)
        return ready

    def _next_in_order(self, candidates: List[UnifiedPlatform]) -> Optional[UnifiedPlatform]:
        if not candidates:
            return None
        indexed = {p.key: p for p in candidates}
        for offset in range(len(UNIFIED_PLATFORMS)):
            idx = (self.cursor + offset) % len(UNIFIED_PLATFORMS)
            p = UNIFIED_PLATFORMS[idx]
            if p.key in indexed:
                self.cursor = (idx + 1) % len(UNIFIED_PLATFORMS)
                return p
        return candidates[0]

    def _next_cooldown(self, inputs: Dict[str, List[str]]) -> Tuple[Optional[UnifiedPlatform], float]:
        now = time.time()
        candidates: List[Tuple[float, UnifiedPlatform]] = []
        for p in UNIFIED_PLATFORMS:
            if not inputs.get(p.key):
                continue
            if self.platform_states.get(p.key) in {"COMPLETE", "EMPTY"}:
                continue
            until = self.platform_cooldown_until.get(p.key, 0.0)
            if until > now:
                candidates.append((until, p))
        if not candidates:
            return None, 0.0
        until, p = min(candidates, key=lambda x: x[0])
        return p, until

    def _all_terminal(self, inputs: Dict[str, List[str]]) -> bool:
        for p in UNIFIED_PLATFORMS:
            if not inputs.get(p.key):
                continue
            if self.platform_states.get(p.key) not in {"COMPLETE", "EMPTY"}:
                return False
        return True

    def _reset_cycle(self, inputs: Dict[str, List[str]]) -> None:
        self.cycle += 1
        self.cursor = 0
        for p in UNIFIED_PLATFORMS:
            if inputs.get(p.key):
                self.platform_states[p.key] = "READY"
            else:
                self.platform_states[p.key] = "EMPTY"
            self.platform_cooldown_until[p.key] = 0.0
        self.ui_log(f"\n[multiplatform] ===== starting cycle {self.cycle} =====\n")

    def _main(
        self,
        inputs: Dict[str, List[str]],
        limit: int,
        mode: str,
        force_refresh: bool,
        continuous: bool,
        high_throughput: bool,
        extended_surfaces: bool,
    ) -> None:
        self.ui_log("\n[multiplatform] MASTER SCHEDULER STARTED\n")
        self.ui_log("[multiplatform] Fixed order: YouTube -> Instagram -> TikTok\n")
        self.ui_log(
            f"[multiplatform] mode={mode} | limit={'ALL' if limit <= 0 else limit} | "
            f"continuous={'YES' if continuous else 'NO'} | high_throughput={'YES' if high_throughput else 'NO'} | extended_surfaces={'YES' if extended_surfaces else 'NO'}\n"
        )
        try:
            while not self.stop_event.is_set():
                # Mirror persisted cooldown state before selecting the next platform.
                for p in UNIFIED_PLATFORMS:
                    if inputs.get(p.key):
                        until = self._cooldown_until(p)
                        if until > time.time():
                            self.ui_cooldown(p.key, until)
                            if self.platform_states.get(p.key) not in {"COMPLETE", "EMPTY"}:
                                self.platform_states[p.key] = "COOLDOWN"

                ready = self._ready_platforms(inputs)
                if ready:
                    platform = self._next_in_order(ready)
                    if platform is None:
                        continue
                    status = self._run_platform(platform, inputs.get(platform.key, []), limit, mode, force_refresh, high_throughput, extended_surfaces)
                    if status == "COMPLETE":
                        continue
                    if status == "STOPPED":
                        break
                    # RATE_LIMITED / FAILED: move immediately to the next platform.
                    if status in {"RATE_LIMITED", "FAILED"}:
                        continue

                if self._all_terminal(inputs):
                    if continuous:
                        self._reset_cycle(inputs)
                        # Small scheduler pause; collectors still control actual request pacing.
                        if self.stop_event.wait(1.0):
                            break
                        continue
                    self.ui_log("\n[multiplatform] All supplied platform queues are complete.\n")
                    break

                cooldown_platform, until = self._next_cooldown(inputs)
                if cooldown_platform is not None:
                    remaining = max(0.0, until - time.time())
                    mins, secs = divmod(int(remaining), 60)
                    # When no other platform is ready, do not park the GUI/process
                    # for minutes. The platform has already been safely parked and
                    # the persisted cooldown/pending item remains available for a
                    # later run. With multiple platforms, the scheduler will normally
                    # have advanced to another ready platform before reaching here.
                    self.ui_log(
                        f"[multiplatform] No other ready platform; ending cycle with {cooldown_platform.label} cooldown preserved | "
                        f"remaining={mins}m {secs}s\n"
                    )
                    break

                # Avoid a tight loop if a collector failed without a persisted cooldown.
                self.ui_log("[multiplatform] No ready platform and no explicit cooldown. Ending cycle.\n")
                break
        except Exception as exc:
            self.ui_log(f"[multiplatform] scheduler fatal error: {type(exc).__name__}: {exc}\n")
            self.ui_log(traceback.format_exc())
        finally:
            self.current = None
            self.process = None
            self.ui_log("[multiplatform] MASTER SCHEDULER STOPPED\n")
            self.app.enqueue_ui(("scheduler_done",))


class UnifiedApp:
