    def run_db_counts(self, run_id: int) -> dict:
        """Return current row counts attributable to this scrape run."""
        tables = {
            "inputs": ("channel_inputs", "scrape_run_id=?"),
            "channels": ("channel_snapshots", "scrape_run_id=?"),
            "videos": ("video_snapshots", "scrape_run_id=?"),
            "raw": ("raw_data", "scrape_run_id=?"),
            "comments": ("comments", "scrape_run_id=?"),
            "formats": ("formats", "scrape_run_id=?"),
            "captions": ("caption_tracks", "scrape_run_id=?"),
            "errors": ("errors", "scrape_run_id=?"),
            "ingestion": ("video_ingestion", "last_run_id=?"),
        }
        out = {}
        with self.lock:
            for key, (table, where) in tables.items():
                row = self.conn.execute(
                    f"SELECT COUNT(*) FROM {table} WHERE {where}", (run_id,)
                ).fetchone()
                out[key] = int(row[0] or 0)
        return out

