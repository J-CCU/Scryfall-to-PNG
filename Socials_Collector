#
# These collectors store metadata/raw nodes only; media is never downloaded.
# Each platform keeps its own surface_items and surface_snapshots tables in its
# own SQLite database, so the three databases remain independent.


def _surface_ensure_schema(db) -> None:
    with db.lock:
        db.conn.executescript("""
        CREATE TABLE IF NOT EXISTS surface_items (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            owner_id TEXT NOT NULL,
            surface TEXT NOT NULL,
            item_id TEXT NOT NULL,
            item_type TEXT,
            title TEXT,
            text TEXT,
            published_at TEXT,
            expires_at TEXT,
            url TEXT,
            source TEXT,
            raw_data_id INTEGER,
            metadata_json TEXT,
            first_seen_at TEXT NOT NULL,
            last_seen_at TEXT NOT NULL,
            last_run_id INTEGER,
            UNIQUE(owner_id, surface, item_id)
        );
        CREATE TABLE IF NOT EXISTS surface_snapshots (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            scrape_run_id INTEGER,
            surface_item_id INTEGER,
            owner_id TEXT NOT NULL,
            surface TEXT NOT NULL,
            item_id TEXT NOT NULL,
            captured_at TEXT NOT NULL,
            metadata_json TEXT,
            raw_data_id INTEGER
        );
        CREATE INDEX IF NOT EXISTS idx_surface_owner ON surface_items(owner_id, surface);
        CREATE INDEX IF NOT EXISTS idx_surface_snapshots_run ON surface_snapshots(scrape_run_id);
        """)
        db.conn.commit()


def _surface_record(
    db, run_id: int, *, owner_id: str, surface: str, item_id: str,
    item_type: str = "", title: str = "", text: str = "",
    published_at: str = "", expires_at: str = "", url: str = "",
    source: str = "", metadata=None, raw_data_id: Optional[int] = None,
) -> Tuple[int, str]:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    metadata_json = json.dumps(metadata if metadata is not None else {}, ensure_ascii=False, default=str, separators=(",", ":"))
    owner_id, surface, item_id = str(owner_id or ""), str(surface or ""), str(item_id or "")
    if not owner_id or not surface or not item_id:
        return 0, "INVALID"
    with db.lock:
        row = db.conn.execute(
            "SELECT id FROM surface_items WHERE owner_id=? AND surface=? AND item_id=?",
            (owner_id, surface, item_id),
        ).fetchone()
        if row:
            sid = int(row[0])
            db.conn.execute(
                """UPDATE surface_items SET item_type=COALESCE(NULLIF(?,''),item_type),
                   title=COALESCE(NULLIF(?,''),title), text=COALESCE(NULLIF(?,''),text),
                   published_at=COALESCE(NULLIF(?,''),published_at), expires_at=COALESCE(NULLIF(?,''),expires_at),
                   url=COALESCE(NULLIF(?,''),url), source=COALESCE(NULLIF(?,''),source),
                   raw_data_id=COALESCE(?,raw_data_id), metadata_json=COALESCE(NULLIF(?,''),metadata_json),
                   last_seen_at=?, last_run_id=? WHERE id=?""",
                (item_type,title,text,published_at,expires_at,url,source,raw_data_id,metadata_json,now,run_id,sid),
            )
            state="EXISTING"
        else:
            cur=db.conn.execute(
                """INSERT INTO surface_items(owner_id,surface,item_id,item_type,title,text,published_at,expires_at,url,source,raw_data_id,metadata_json,first_seen_at,last_seen_at,last_run_id)
                   VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                (owner_id,surface,item_id,item_type,title,text,published_at,expires_at,url,source,raw_data_id,metadata_json,now,now,run_id),
            )
            sid=int(cur.lastrowid)
            state="NEW"
        db.conn.execute(
            "INSERT INTO surface_snapshots(scrape_run_id,surface_item_id,owner_id,surface,item_id,captured_at,metadata_json,raw_data_id) VALUES(?,?,?,?,?,?,?,?)",
            (run_id,sid,owner_id,surface,item_id,now,metadata_json,raw_data_id),
        )
        db.conn.commit()
    return sid,state


def youtube_collect_community_posts(run_id: int, db: youtube_Database, channel: dict, limit: int, mode: str) -> int:
    if not youtube_COLLECT_EXTENDED_SURFACES or mode != "Maximum" or youtube_yt_dlp is None:
        return 0
    cid=str(channel.get("channel_id") or "")
    handle=youtube_clean_handle(channel.get("handle") or channel.get("custom_url") or "")
    target=f"{youtube_YOUTUBE}/@{handle}/posts" if handle else f"{youtube_YOUTUBE}/channel/{cid}/posts"
    opts=youtube_ytdlp_base_opts(False, use_cookies=True)
    opts["extract_flat"]=True
    if limit>0:
        opts["playlistend"]=limit
    youtube_log(f"  [surface:community] START | target={target} | limit={'ALL' if limit<=0 else limit}")
    count=0; start=time.monotonic()
    try:
        if not youtube_wait_for_ytdlp_surface_slot("community-post surface"):
            return 0
        with youtube_yt_dlp.YoutubeDL(opts) as ydl:
            info=ydl.extract_info(target,download=False)
            if not isinstance(info,dict):
                return 0
            entries=info.get("entries") or []
            raw_listing_id=db.raw(run_id,channel_id=cid,video_id=None,source="yt-dlp",endpoint="posts",status=200,payload=ydl.sanitize_info(info),content_type="application/json",note="community/posts surface")
            for entry in entries:
                if youtube_stop_requested() or (limit>0 and count>=limit) or not isinstance(entry,dict):
                    break
                item_id=str(entry.get("id") or entry.get("webpage_url") or entry.get("url") or "")
                if not item_id:
                    continue
                published_at=""
                if entry.get("timestamp"):
                    try:
                        published_at=datetime.fromtimestamp(int(entry["timestamp"]),timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                    except Exception: published_at=str(entry.get("timestamp"))
                url=str(entry.get("webpage_url") or entry.get("url") or "")
                if url.startswith("/"): url=youtube_YOUTUBE+url
                _surface_record(db,run_id,owner_id=cid,surface="community_posts",item_id=item_id,item_type="youtube_community_post",title=str(entry.get("title") or ""),text=str(entry.get("description") or entry.get("text") or ""),published_at=published_at,url=url,source="yt-dlp",raw_data_id=raw_listing_id,metadata=entry)
                count+=1
                youtube_log(f"    [surface:community {count}] {item_id}")
    except Exception as exc:
        db.error(run_id,channel_id=cid,stage="community_posts",endpoint="posts",status=None,exc_type=type(exc).__name__,message=str(exc),detail=traceback.format_exc())
        youtube_log(f"  [surface:community] ERROR | {type(exc).__name__}: {exc}")
    youtube_log(f"  [surface:community] COMPLETE | rows={count} | elapsed={time.monotonic()-start:.1f}s")
    return count


def instagram_collect_extended_surfaces(self: instagram_Collector, run_id: int, account: dict, limit: int, mode: str) -> int:
    if not instagram_COLLECT_EXTENDED_SURFACES or mode != "Maximum" or instagram_instaloader is None:
        return 0
    profile=account.get("_profile")
    if profile is None:
        return 0
    owner_id=str(account.get("account_id") or getattr(profile,"userid","") or "")
    username=str(account.get("username") or getattr(profile,"username","") or "")
    total=0
    self.emit(f"  [surface] Instagram extended coverage START | @{username}")

    def post_surface(surface: str, iterator_factory) -> None:
        nonlocal total
        try:
            if not instagram_wait_for_request_slot("Maximum",f"{surface} surface"): return
            n=0
            for post in iterator_factory():
                if instagram_stop_requested() or (limit>0 and n>=limit): break
                p=instagram_post_to_dict(post,owner_id,username); pid=str(p.get("post_id") or p.get("shortcode") or "")
                if not pid: continue
                self.live_posts[pid]=post; self.db.upsert_post(p)
                raw_id=self.db.insert_raw(run_id,owner_id,pid,"Instaloader",f"surface:{surface}",p.get("_raw_node") or {})
                _surface_record(self.db,run_id,owner_id=owner_id,surface=surface,item_id=pid,item_type=str(p.get("typename") or "instagram_post"),text=str(p.get("caption") or ""),published_at=str(p.get("taken_at") or ""),url=str(p.get("post_url") or ""),source="Instaloader",raw_data_id=raw_id,metadata=p.get("_raw_node") or p)
                n+=1; total+=1
            self.emit(f"  [surface:{surface}] COMPLETE | rows={n}")
        except Exception as exc:
            if "login required" in str(exc).lower() or exc.__class__.__name__.lower().startswith("loginrequired"):
                self.emit(f"  [surface:{surface}] unavailable without authenticated session")
            elif instagram_is_rate_limit_exception(exc):
                instagram_set_rate_limit(self.db,str(exc),pending_account_id=owner_id)
                self.emit(f"  [surface:{surface}] RATE LIMITED")
            else:
                self.db.record_error(run_id,account_id=owner_id,stage=f"surface:{surface}",exc=exc)
                self.emit(f"  [surface:{surface}] ERROR | {type(exc).__name__}: {exc}")

    # Instaloader documents these distinct profile surfaces. Reels/IGTV/Tagged are
    # post iterators; the main post table remains canonical and surface_items keeps
    # the originating surface so duplicates are not lost or confused.
    post_surface("reels",profile.get_reels)
    post_surface("igtv",profile.get_igtv_posts)
    post_surface("tagged",profile.get_tagged_posts)

    try:
        if instagram_wait_for_request_slot("Maximum",f"stories @{username}"):
            n=0
            for story in self.loader.get_stories(userids=[profile.userid]):
                for item in story.get_items():
                    if instagram_stop_requested() or (limit>0 and n>=limit): break
                    iid=str(getattr(item,"mediaid","") or getattr(item,"shortcode","") or "")
                    if not iid: continue
                    d=getattr(item,"date_utc",None); ex=getattr(item,"expiring_utc",None)
                    raw_node=instagram_object_node(item)
                    raw_id=self.db.insert_raw(run_id,owner_id,iid,"Instaloader","surface:stories",raw_node)
                    _surface_record(self.db,run_id,owner_id=owner_id,surface="stories",item_id=iid,item_type=str(getattr(item,"typename","instagram_story_item")),text=str(getattr(item,"caption","") or ""),published_at=d.strftime("%Y-%m-%dT%H:%M:%SZ") if d else "",expires_at=ex.strftime("%Y-%m-%dT%H:%M:%SZ") if ex else "",url=str(getattr(item,"url","") or ""),source="Instaloader",raw_data_id=raw_id,metadata=raw_node)
                    n+=1; total+=1
            self.emit(f"  [surface:stories] COMPLETE | rows={n}")
    except Exception as exc:
        if "login required" in str(exc).lower() or exc.__class__.__name__.lower().startswith("loginrequired"):
            self.emit("  [surface:stories] unavailable without authenticated session")
        elif instagram_is_rate_limit_exception(exc):
            instagram_set_rate_limit(self.db,str(exc),pending_account_id=owner_id); self.emit("  [surface:stories] RATE LIMITED")
        else: self.db.record_error(run_id,account_id=owner_id,stage="surface:stories",exc=exc)

    try:
        if instagram_wait_for_request_slot("Maximum",f"highlights @{username}"):
            n=0
            for highlight in self.loader.get_highlights(profile):
                if instagram_stop_requested(): break
                hid=str(getattr(highlight,"unique_id","") or "")
                if hid:
                    raw_node=instagram_object_node(highlight); raw_id=self.db.insert_raw(run_id,owner_id,hid,"Instaloader","surface:highlights",raw_node)
                    _surface_record(self.db,run_id,owner_id=owner_id,surface="highlights",item_id=hid,item_type="instagram_highlight",title=str(getattr(highlight,"title","") or ""),url=str(getattr(highlight,"cover_url","") or ""),source="Instaloader",raw_data_id=raw_id,metadata=raw_node); total+=1
                for item in highlight.get_items():
                    if instagram_stop_requested() or (limit>0 and n>=limit): break
                    iid=str(getattr(item,"mediaid","") or getattr(item,"shortcode","") or "")
                    if not iid: continue
                    raw_node=instagram_object_node(item); raw_id=self.db.insert_raw(run_id,owner_id,iid,"Instaloader","surface:highlight_item",raw_node)
                    d=getattr(item,"date_utc",None)
                    _surface_record(self.db,run_id,owner_id=owner_id,surface="highlight_items",item_id=iid,item_type=str(getattr(item,"typename","instagram_highlight_item")),text=str(getattr(item,"caption","") or ""),published_at=d.strftime("%Y-%m-%dT%H:%M:%SZ") if d else "",source="Instaloader",raw_data_id=raw_id,metadata={"highlight_id":hid,"node":raw_node})
                    n+=1; total+=1
            self.emit(f"  [surface:highlights] COMPLETE | highlight_items={n}")
    except Exception as exc:
        if "login required" in str(exc).lower() or exc.__class__.__name__.lower().startswith("loginrequired"):
            self.emit("  [surface:highlights] unavailable without authenticated session")
        elif instagram_is_rate_limit_exception(exc):
            instagram_set_rate_limit(self.db,str(exc),pending_account_id=owner_id); self.emit("  [surface:highlights] RATE LIMITED")
        else: self.db.record_error(run_id,account_id=owner_id,stage="surface:highlights",exc=exc)

    self.emit(f"  [surface] Instagram extended coverage COMPLETE | total={total}")
    return total


def tiktok_research_collect_user_surface(username: str, db: tiktok_Database, run_id: int, surface: str, endpoint: str, response_keys: Tuple[str, ...], limit: int = 0) -> int:
    if not tiktok_COLLECT_EXTENDED_SURFACES or not tiktok_COLLECT_RESEARCH_API or not tiktok_ensure_research_access_token(db):
        return 0
    count=0; cursor=0; page_size=min(100,max(1,tiktok_RESEARCH_SURFACE_PAGE_SIZE))
    while not tiktok_stop_requested() and (limit<=0 or count<limit):
        data=tiktok_research_post(endpoint, {"fields":"id,create_time,username,region_code,video_description,music_id,like_count,comment_count,share_count,view_count,hashtag_names,is_stem_verified,favorites_count,video_duration,hashtag_info_list,sticker_info_list,effect_info_list,video_mention_list,video_label,video_tag"}, {"username":username.lstrip("@"),"max_count":min(page_size,limit-count) if limit>0 else page_size,"cursor":cursor}, db)
        if not data: break
        payload=data.get("data") or {}; rows=[]
        for key in response_keys:
            if isinstance(payload.get(key),list): rows=payload[key]; break
        if not rows: break
        for row in rows:
            if tiktok_stop_requested() or (limit>0 and count>=limit): break
            iid=str(row.get("id") or "")
            if not iid: continue
            raw_id=db.insert_raw(run_id,"",iid,"TikTok Research API",f"surface:{surface}",row)
            _surface_record(db,run_id,owner_id=username.lstrip("@"),surface=surface,item_id=iid,item_type="tiktok_video_surface",text=str(row.get("video_description") or ""),published_at=tiktok_iso_from_timestamp(row.get("create_time")) if row.get("create_time") else "",url=f"https://www.tiktok.com/@{row.get('username') or username.lstrip('@')}/video/{iid}",source=f"TikTok Research API:{surface}",raw_data_id=raw_id,metadata=row)
            count+=1
        if not payload.get("has_more") or payload.get("cursor") is None or int(payload.get("cursor"))==int(cursor): break
        cursor=int(payload.get("cursor"))
    return count


