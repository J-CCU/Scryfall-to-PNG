def _v51_tt_reconcile_limited(db: tiktok_Database) -> dict:
    """Repair only the tiny failed tail; never downgrade full SUCCESS payloads."""
    _v51_migrate_tiktok(db)
    with db.lock:
        rows = db.conn.execute(
            """SELECT video_id,enrichment_attempts,last_run_id,last_error,access_state,access_reason
               FROM video_ingestion
               WHERE COALESCE(completeness_audit_status,'')<>'COMPLETE'
                  OR COALESCE(enrichment_state,'')<>'COMPLETE'
                  OR COALESCE(access_state,'') IN ('COMPLETE_LIMITED','RETRY_PENDING')"""
        ).fetchall()
    finalized = 0
    deferred = 0
    for row in rows:
        d = dict(row)
        vid = str(d.get("video_id") or "")
        if str(d.get("access_state") or "") == "COMPLETE_LIMITED":
            if _v51_tt_finalize_limited(db, vid, str(d.get("access_reason") or "LIMITED"), int(d.get("last_run_id") or 0)):
                finalized += 1
            continue
        category = _v51_tt_error_category(d.get("last_error"))
        if not category or not _v51_tt_listing_evidence_sufficient(db, vid):
            continue
        attempts = int(d.get("enrichment_attempts") or 0)
        if attempts >= V51_TIKTOK_LIMITED_AFTER_ATTEMPTS:
            if _v51_tt_finalize_limited(db, vid, category, int(d.get("last_run_id") or 0)):
                finalized += 1
        else:
            _v51_tt_schedule_retry(db, vid, category)
            deferred += 1
    return {"limited_finalized": finalized, "limited_deferred": deferred}


