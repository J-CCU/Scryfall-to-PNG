        if isinstance(exc, instagram_TooManyRequestsException) or ("429" in str(exc) and "too many requests" in str(exc).lower()):
            raise
        instagram_log(f"[resolve/feed] one-shot endpoint failed | @{username} | {type(exc).__name__}: {exc}")
