            sidecars = 0
        total = int(_v46_scalar(conn, f"SELECT COUNT(*) FROM {ing}") or 0)
        complete = int(_v46_scalar(conn, f"SELECT COUNT(*) FROM {ing} WHERE completeness_audit_status='COMPLETE' AND enrichment_state='COMPLETE'") or 0)
        collected = int(_v46_scalar(conn, f"SELECT COUNT(*) FROM {ing} WHERE comments_status='SUCCESS'") or 0)
