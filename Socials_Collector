            "SELECT v.* FROM videos v JOIN video_ingestion vi ON vi.video_id=v.video_id WHERE v.channel_id=? AND (COALESCE(vi.enrichment_state,'') <> 'COMPLETE' OR vi.last_error IS NOT NULL) ORDER BY COALESCE(v.timestamp,0) ASC, v.video_id LIMIT ?",
            (channel_id, limit),
        )
        cols = [d[0] for d in cur.description]
