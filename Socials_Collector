def _v38_collect_comments_v41(
    run_id: int, db: youtube_Database, video: dict
) -> Tuple[str, int]:
    # Calling this function also re-evaluates the Pacific quota day. When the day
    # changes, V39 clears its persisted circuit and restores the configured key.
    daily_open = _v39_api_circuit_open(db)
    transient_open = _v41_transient_api_cooldown_open(db)
    api_eligible = bool(
        (not daily_open)
        and (not transient_open)
        and youtube_USE_YOUTUBE_DATA_API_ACCELERATOR
        and youtube_YOUTUBE_API_KEY
    )

    if api_eligible:
        status, count = _v41_collect_comments_api_preferred(run_id, db, video)
        if status in {"SUCCESS", "SUCCESS_EMPTY"}:
            return status, count
        # A quota failure can trip the daily circuit during this very request.
        # Preserve any API rows already written, then UPSERT the fallback result.
        if status in {"DEFERRED_QUOTA", "FAILED", "PARTIAL", "RATE_LIMITED"}:
            return _v41_collect_comments_ytdlp_fallback(
                run_id, db, video, f"api_{status.lower()}"
            )
        return status, count

    if daily_open:
        reason = f"daily_quota_until_next_Pacific_day:{_V39_API_CIRCUIT_REASON or 'quotaExceeded'}"
    elif transient_open:
        reason = "transient_api_cooldown"
    else:
        reason = "api_unavailable"
    return _v41_collect_comments_ytdlp_fallback(run_id, db, video, reason)


