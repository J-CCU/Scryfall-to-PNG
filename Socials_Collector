        return "NEW"
    if force_refresh:
        return "FORCE"
    if not youtube_state_is_complete(state, mode) or state.get("last_error"):
        return "RESUME"
    # Complete means complete: never schedule an automatic heavy re-scrape.
    # Only refresh changing counters when their age-based interval is due.
    last = state.get("last_performance_refresh_at") or state.get("last_enriched_at")
    elapsed = _v29_hours(last)
    if elapsed is None or elapsed >= youtube_video_refresh_interval_hours(video):
        return "PERFORMANCE_REFRESH"
    return "SKIP"

