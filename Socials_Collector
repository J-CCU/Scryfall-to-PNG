def _v44_work_priority(video: Optional[dict]) -> int:
    try:
        return int((video or {}).get("timestamp") or 0)
    except Exception:
        return 0


def _v44_youtube_enqueue(db: youtube_Database, video_id: str, stage: str, action: str, run_id: int, priority: int = 0, *, force: bool = False) -> bool:
    vid = str(video_id or "")
    stage = str(stage or "")
    if not vid or stage not in {"heavy", "comments"}:
        return False
    _v44_migrate_youtube(db)
    now_epoch = time.time()
    now_iso = youtube_now_utc()
    with db.lock:
        row = db.conn.execute("SELECT state,lease_expires_at FROM youtube_work_queue WHERE video_id=? AND stage=?", (vid, stage)).fetchone()
        if row and str(row[0] or "") == "RUNNING" and float(row[1] or 0) > now_epoch:
            return False
        if row:
            db.conn.execute(
                """UPDATE youtube_work_queue SET action=?,state='PENDING',priority=MAX(priority,?),run_id=?,next_attempt_at=0,
                   lease_owner=NULL,lease_expires_at=0,last_error=NULL,updated_at=? WHERE video_id=? AND stage=?""",
                (str(action or "RESUME"), int(priority or 0), int(run_id or 0), now_iso, vid, stage),
            )
        else:
            db.conn.execute(
                """INSERT INTO youtube_work_queue(video_id,stage,action,state,priority,run_id,attempts,next_attempt_at,
                   lease_owner,lease_expires_at,last_error,created_at,updated_at)
                   VALUES(?,?,?,'PENDING',?,?,0,0,NULL,0,NULL,?,?)""",
                (vid, stage, str(action or "RESUME"), int(priority or 0), int(run_id or 0), now_iso, now_iso),
            )
        db.conn.commit()
    return True


