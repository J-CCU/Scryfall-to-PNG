def _v21_platform_schema_from_path(db_path: Path) -> str:
    name = Path(db_path).name.lower()
    if "youtube" in name:
        return "youtube"
    if "instagram" in name:
        return "instagram"
    if "tiktok" in name:
        return "tiktok"
    return "public"

def _v21_scheduler_runtime_state(self, db_path: Path) -> Dict[str, str]:
    result: Dict[str, str] = {}
    try:
        if _v21_postgres_enabled():
            schema = _v21_platform_schema_from_path(db_path)
            conn = _V21PostgresConnection(_v21_database_url(), schema)
            try:
                rows = conn.execute("SELECT key,value FROM runtime_state").fetchall()
                return {str(r[0]): str(r[1]) for r in rows}
            finally:
                conn.close()

        if not db_path.exists():
