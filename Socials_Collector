def tiktok_now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def tiktok_log(msg: str) -> None:
    with tiktok_LOG_LOCK:
        print(msg, flush=True)


def tiktok_safe_int(v: Any) -> Optional[int]:
    if v is None or v == "":
        return None
    try:
        return int(str(v).replace(",", "").strip())
    except Exception:
        return None


def tiktok_safe_float(v: Any) -> Optional[float]:
    if v is None or v == "":
        return None
    try:
        return float(v)
    except Exception:
        return None


def tiktok_compact_json(obj: Any) -> str:
    try:
        return json.dumps(obj, ensure_ascii=False, separators=(",", ":"))
    except Exception:
        return ""


def tiktok_gzip_bytes(data: bytes) -> bytes:
    return gzip.compress(data, compresslevel=6)


def tiktok_sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def tiktok_normalized_username(value: str) -> str:
    s = str(value or "").strip()
    if not s:
        return ""
    if "tiktok.com/@" in s.lower():
        s = s.split("@", 1)[1]
    elif s.startswith("@"):
        s = s[1:]
    s = s.split("/", 1)[0].split("?", 1)[0].split("#", 1)[0].strip()
    return s.lower() if re.fullmatch(r"[A-Za-z0-9._-]{2,40}", s) else ""


def tiktok_normalize_input(value: str) -> Tuple[str, str]:
    """Return kind ('username'|'profile_url'|'video_url'|'') and normalized value."""
    raw = str(value or "").strip()
    if not raw:
        return "", ""
    if re.fullmatch(r"@[A-Za-z0-9._-]{2,40}", raw):
        return "username", tiktok_normalized_username(raw)
    if re.fullmatch(r"[A-Za-z0-9._-]{2,40}", raw):
        return "username", raw.lower()
    if re.search(r"tiktok\.com/.*/video/\d+", raw, re.I):
        m = re.search(r"https?://(?:www\.)?tiktok\.com/@([^/]+)/video/(\d+)", raw, re.I)
        if m:
            return "video_url", f"https://www.tiktok.com/@{m.group(1)}/video/{m.group(2)}"
        m = re.search(r"/video/(\d+)", raw)
        if m:
            return "video_url", f"https://www.tiktok.com/video/{m.group(1)}"
    if re.search(r"tiktok\.com/@", raw, re.I):
        username = tiktok_normalized_username(raw)
        if username:
            return "profile_url", f"https://www.tiktok.com/@{username}"
    return "", ""


def tiktok_username_from_url(url: str) -> str:
    m = re.search(r"tiktok\.com/@([^/]+)", str(url or ""), re.I)
    return m.group(1).lower() if m else ""


def tiktok_video_url(video_id: str, username: str = "") -> str:
    if username:
        return f"https://www.tiktok.com/@{username}/video/{video_id}"
    return f"https://www.tiktok.com/video/{video_id}"


def tiktok_published_timestamp(info: dict) -> Optional[int]:
    ts = tiktok_safe_int(info.get("timestamp") or info.get("create_time"))
    return ts


def tiktok_iso_from_timestamp(ts: Any) -> Optional[str]:
    ts = tiktok_safe_int(ts)
    if ts is None:
        return None
    try:
        return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        return None


def tiktok_video_age_days(video: dict) -> Optional[float]:
    ts = tiktok_safe_int(video.get("timestamp"))
    if ts is None:
        return None
    return max(0.0, (datetime.now(timezone.utc) - datetime.fromtimestamp(ts, tz=timezone.utc)).total_seconds() / 86400.0)


def tiktok_stop_requested() -> bool:
    return tiktok_STOP_EVENT.is_set() or bool(tiktok_RUN_STATE.get("stop_requested"))


def tiktok_clear_stop_request() -> None:
    tiktok_RUN_STATE["stop_requested"] = False
    tiktok_STOP_EVENT.clear()


def tiktok_request_stop() -> None:
    tiktok_RUN_STATE["stop_requested"] = True
    tiktok_STOP_EVENT.set()


def tiktok_unique_by_id(rows: Iterable[dict], key: str) -> List[dict]:
    seen = set()
    out = []
    for row in rows:
        value = row.get(key)
        if not value or value in seen:
            continue
        seen.add(value)
        out.append(row)
    return out


