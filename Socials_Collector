def instagram_instagram_extract_ytdlp_tracks(info: dict) -> tuple[list, list]:
    formats = [f for f in (info.get("formats") or []) if isinstance(f, dict)]
    tracks = []
    for track_type, mapping in (("manual", info.get("subtitles") or {}), ("automatic", info.get("automatic_captions") or {})):
        if not isinstance(mapping, dict):
            continue
        for lang, entries in mapping.items():
            if not isinstance(entries, list):
                continue
            for idx, e in enumerate(entries):
                if not isinstance(e, dict):
                    continue
                tracks.append({"language_code": lang, "track_type": track_type, "name": e.get("name") or str(idx), "ext": e.get("ext") or "", "url": e.get("url") or "", "content": None})
    return formats, tracks


def instagram_instagram_fetch_caption_content(db: instagram_Database, run_id: int, post_id: str) -> int:
    with db.lock:
        rows = db.conn.execute("SELECT id,url FROM captions WHERE post_id=? AND COALESCE(content,'')='' AND COALESCE(url,'')<>'' ORDER BY id", (post_id,)).fetchall()
    updated = 0
    for row in rows:
        if instagram_stop_requested() or instagram_rate_limited():
            break
        try:
            r = instagram_SESSION.get(str(row["url"]), timeout=instagram_REQUEST_TIMEOUT, headers={"User-Agent": instagram_UA, "Referer": instagram_INSTAGRAM + "/"})
            if r.status_code != 200 or not r.text:
                continue
            with db.lock:
                db.conn.execute("UPDATE captions SET content=?,captured_at=?,scrape_run_id=? WHERE id=?", (r.text, instagram_now_utc(), run_id, int(row["id"])))
                db.conn.commit()
            updated += 1
        except Exception as exc:
            db.record_error(run_id, post_id=post_id, stage="caption_content", exc=exc)
    return updated


