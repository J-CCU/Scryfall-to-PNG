# V44 — DB-FIRST COMPLETION ENGINE / DURABLE YOUTUBE WORK QUEUE
# ============================================================================
# V44 makes SQLite the authoritative work ledger, not an in-memory queue.
# Discovery still runs ahead for throughput, but every heavy/comment obligation
# is persisted before workers touch it.  Crash/restart recovery is lease-based.
# It also fixes completion-finalization ordering, fast bulk startup auditing,
# stale Instagram/TikTok catalog-proof refresh, and exposes physical DB row
# counts separately from strict "Finished" counts.

V44_BUILD = "ALL_FIXES_V44_DB_FIRST_COMPLETION_ENGINE"
V44_YT_LEASE_SECONDS = max(300, int(os.getenv("SOCIAL_YOUTUBE_WORK_LEASE_SECONDS", "1800")))
V44_YT_RETRY_BASE_SECONDS = max(10, int(os.getenv("SOCIAL_YOUTUBE_WORK_RETRY_SECONDS", "60")))
V44_YT_EMPTY_COMMENT_RETRY_SECONDS = max(300, int(os.getenv("SOCIAL_YOUTUBE_EMPTY_COMMENT_RETRY_SECONDS", "3600")))
V44_TIKTOK_COMMENT_RETRY_SECONDS = max(300, int(os.getenv("SOCIAL_TIKTOK_COMMENT_RETRY_SECONDS", "3600")))
V44_WAL_CHECKPOINT_SECONDS = max(30, int(os.getenv("SOCIAL_DB_WAL_CHECKPOINT_SECONDS", "120")))

_V44_IG_FULL_PROOFS: set[str] = set()
_V44_IG_FULL_PROOFS_LOCK = threading.RLock()
_V44_TT_FULL_PROOFS: set[str] = set()
_V44_TT_FULL_PROOFS_LOCK = threading.RLock()


def _v44_sql_status_list(values) -> str:
    return ",".join("'" + str(v).replace("'", "''") + "'" for v in values)


_V44_YT_PLAYER_TERMINAL = (
    "SUCCESS", "SKIPPED_NO_API_KEY", "SKIPPED_FAST_PATH", "SKIPPED_PERFORMANCE_REFRESH"
)
_V44_YT_FORMAT_TERMINAL = (
    "SUCCESS", "SUCCESS_EMPTY", "SUCCESS_FAST_PATH", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"
)
_V44_YT_CAPTION_TERMINAL = (
    "SUCCESS", "SUCCESS_EMPTY", "SKIPPED_NO_API_KEY", "SKIPPED_PERFORMANCE_REFRESH"
)
_V44_YT_EMPTY_COMMENT_EVIDENCE = (
    "API_PAGINATION_COMPLETE", "API_COMMENTS_DISABLED", "YTDLP_METADATA_ZERO",
    "YTDLP_TRAVERSAL_COMPLETE_EMPTY", "LEGACY_METADATA_ZERO", "LEGACY_API_EMPTY"
)


def _v44_youtube_payload_expr(vi: str = "vi") -> str:
    return f"""
        {vi}.last_enriched_at IS NOT NULL
        AND COALESCE({vi}.last_error,'')=''
        AND COALESCE({vi}.player_status,'') IN ({_v44_sql_status_list(_V44_YT_PLAYER_TERMINAL)})
        AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id={vi}.video_id)
        AND (
            (COALESCE({vi}.yt_dlp_status,'')='SUCCESS' AND EXISTS(
                SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id
                  AND r.source='yt-dlp' AND r.note='video_full_info'
            ))
            OR
            (COALESCE({vi}.yt_dlp_status,'')='FAILED_EMPTY' AND COALESCE({vi}.player_status,'')='SUCCESS' AND EXISTS(
                SELECT 1 FROM raw_data r WHERE r.video_id={vi}.video_id AND r.source='InnerTube'
            ))
        )
        AND COALESCE({vi}.formats_status,'') IN ({_v44_sql_status_list(_V44_YT_FORMAT_TERMINAL)})
        AND (COALESCE({vi}.formats_status,'')<>'SUCCESS' OR EXISTS(SELECT 1 FROM formats f WHERE f.video_id={vi}.video_id))
        AND COALESCE({vi}.captions_status,'') IN ({_v44_sql_status_list(_V44_YT_CAPTION_TERMINAL)})
        AND (COALESCE({vi}.captions_status,'')<>'SUCCESS' OR EXISTS(SELECT 1 FROM caption_tracks c WHERE c.video_id={vi}.video_id))
    """


def _v44_youtube_comments_expr(vi: str = "vi", v: str = "v") -> str:
    # V48: comments OFF => no comment requirement for collector completion.
    # Durable comments and statuses are preserved, and the queue is reopened
    # automatically on a later comments-ON run.
    if not youtube_COLLECT_COMMENTS:
        return "1"
    return f"""
        (
            (COALESCE({vi}.comments_status,'')='SUCCESS' AND EXISTS(SELECT 1 FROM comments c WHERE c.video_id={vi}.video_id))
            OR
            (COALESCE({vi}.comments_status,'')='SUCCESS_EMPTY' AND (
                COALESCE({vi}.comments_evidence,'') IN ({_v44_sql_status_list(_V44_YT_EMPTY_COMMENT_EVIDENCE)})
                OR {v}.comment_count=0
            ))
            OR
            (COALESCE({vi}.comments_status,'') IN ('COMMENTS_DISABLED','DISABLED') AND COALESCE({vi}.comments_evidence,'')='API_COMMENTS_DISABLED')
        )
    """


