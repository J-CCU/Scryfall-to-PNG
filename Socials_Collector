    return float(instagram_MIN_INTERVAL_BY_MODE.get(mode, 6.0))


def instagram_policy_text(mode: str) -> str:
    return f"collector_policy_min_interval={instagram_mode_min_interval(mode):.1f}s | request_sleep={instagram_REQUEST_SLEEP_BY_MODE.get(mode, 1.0):.1f}s"


def instagram_wait_for_request_slot(mode: str, label: str) -> bool:
    global instagram_LAST_REQUEST_START, instagram_REQUEST_COUNTER
    if instagram_stop_requested() or instagram_rate_limited():
        return False
    with instagram_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = None if not instagram_LAST_REQUEST_START else now - instagram_LAST_REQUEST_START
        wait_for = 0.0 if elapsed is None else max(0.0, instagram_mode_min_interval(mode) - elapsed)
        if elapsed is not None:
            wait_for += random.uniform(0.0, min(1.5, max(0.25, instagram_mode_min_interval(mode) * 0.12)))
        if wait_for > 0:
            instagram_log(f"      [throttle] waiting {wait_for:.1f}s before Instagram {label}")
            if instagram_STOP_EVENT.wait(wait_for):
                return False
        instagram_LAST_REQUEST_START = time.monotonic()
        instagram_REQUEST_COUNTER += 1
        n = instagram_REQUEST_COUNTER
    instagram_log(f"      [throttle] Instagram {label} request START | #{n} | min_interval={instagram_mode_min_interval(mode):.1f}s")
    return True


def instagram_parse_duration_text(value: str) -> Optional[float]:
    if not value:
        return None
    m = re.search(r"(?:in|for|after)?\s*(\d+)\s*(seconds?|secs?|minutes?|mins?|hours?|hrs?)", value, re.I)
    if not m:
        return None
    n = int(m.group(1))
    unit = m.group(2).lower()
    if unit.startswith("hour") or unit.startswith("hr"):
        return n * 3600.0
    if unit.startswith("minute") or unit.startswith("min"):
        return n * 60.0
    return float(n)


def instagram_is_rate_limit_exception(exc: Exception) -> bool:
    if instagram_instaloader is not None and isinstance(exc, instagram_TooManyRequestsException):
        return True
    text = str(exc).lower()
    # Instagram commonly returns misleading 401/"Please wait a few minutes"
    # responses from web_profile_info even on the first request. Treat that
    # endpoint-specific response as an endpoint failure, not as a platform
    # cooldown, so the collector can use the mobile-feed fallback.
    if "401 unauthorized" in text and "please wait" in text:
        return False
    return any(token in text for token in (
        "too many requests", "429", "rate limit", "feedback_required", "checkpoint_required", "challenge_required"
    ))


def instagram_is_login_or_challenge(exc: Exception) -> bool:
    if isinstance(exc, (instagram_LoginRequiredException, instagram_BadCredentialsException, instagram_PrivateProfileNotFollowedException)):
        return True
    text = str(exc).lower()
    return any(token in text for token in ("login", "checkpoint", "challenge", "verification", "feedback_required"))


# ============================================================================
# PERSISTED RATE LIMIT STATE
# ============================================================================


def instagram_set_rate_limit(db: "Database", reason: str = "", pending_post_id: str = "", pending_account_id: str = "") -> None:
    global instagram_RATE_LIMITED_UNTIL, instagram_RATE_LIMIT_COOLDOWN, instagram_RATE_LIMIT_EVENTS, instagram_INSTAGRAM_ADAPTIVE_INTERVAL_MULTIPLIER, instagram_INSTAGRAM_SUCCESSFUL_REQUESTS_SINCE_BACKOFF
    with instagram_RATE_LIMIT_LOCK:
        instagram_RATE_LIMIT_EVENTS += 1
        cooldown = min(instagram_RATE_LIMIT_MAX_COOLDOWN, max(instagram_RATE_LIMIT_INITIAL_COOLDOWN, instagram_RATE_LIMIT_COOLDOWN))
        instagram_RATE_LIMITED_UNTIL = time.time() + cooldown
        instagram_RATE_LIMIT_COOLDOWN = min(instagram_RATE_LIMIT_MAX_COOLDOWN, max(instagram_RATE_LIMIT_INITIAL_COOLDOWN, cooldown * 1.5))
        remaining = int(cooldown)
    db.set_runtime_state("instagram_rate_limited_until", str(instagram_RATE_LIMITED_UNTIL))
    db.set_runtime_state("instagram_rate_limit_reason", reason[:1000])
    db.set_runtime_state("instagram_rate_limit_pending_post_id", pending_post_id)
    db.set_runtime_state("instagram_rate_limit_pending_account_id", pending_account_id)
    instagram_log(f"[throttle] Instagram rate limit/challenge detected | cooldown={remaining//60}m {remaining%60}s | pending_post={pending_post_id or 'none'} | reason={reason[:240]}")


def instagram_load_rate_limit_state(db: "Database") -> None:
    global instagram_RATE_LIMITED_UNTIL
    try:
        until = float(db.get_runtime_state("instagram_rate_limited_until") or 0)
    except Exception:
        until = 0
    with instagram_RATE_LIMIT_LOCK:
        instagram_RATE_LIMITED_UNTIL = max(instagram_RATE_LIMITED_UNTIL, until)


def instagram_rate_limited() -> bool:
    with instagram_RATE_LIMIT_LOCK:
        return time.time() < instagram_RATE_LIMITED_UNTIL


def instagram_rate_limit_remaining() -> int:
    with instagram_RATE_LIMIT_LOCK:
        return max(0, int(instagram_RATE_LIMITED_UNTIL - time.time()))


def instagram_clear_rate_limit(db: Optional["Database"] = None) -> None:
    global instagram_RATE_LIMITED_UNTIL
    with instagram_RATE_LIMIT_LOCK:
        instagram_RATE_LIMITED_UNTIL = 0.0
    if db:
        for k in (
            "instagram_rate_limited_until", "instagram_rate_limit_reason",
            "instagram_rate_limit_pending_post_id", "instagram_rate_limit_pending_account_id",
        ):
            db.set_runtime_state(k, "")


def instagram_wait_for_rate_limit_clear(db: Optional["Database"] = None, pending_post_id: str = "") -> bool:
    if instagram_ORCHESTRATED_RUN and instagram_rate_limited():
        instagram_log(
            f"[orchestrator] Instagram throttle detected; returning control to multi-platform scheduler "
            f"| pending_post={pending_post_id or 'none'}"
        )
        return False
    while instagram_rate_limited():
        if instagram_stop_requested():
            return False
        remain = instagram_rate_limit_remaining()
        m, s = divmod(remain, 60)
        instagram_log(f"[throttle] cooldown active | remaining={m}m {s}s | retry_post={pending_post_id or 'none'} | committed DB data preserved")
        if instagram_STOP_EVENT.wait(min(float(remain), instagram_RATE_LIMIT_LOG_INTERVAL)):
            return False
    instagram_clear_rate_limit(db)
    instagram_log("[throttle] Instagram cooldown expired | requests can resume")
    return True


