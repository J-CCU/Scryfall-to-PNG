def _v46_database_url() -> str:
    """Local SQLite is authoritative unless localhost PostgreSQL is explicitly enabled."""
    allow_pg = social_env_bool("SOCIAL_COLLECTOR_ALLOW_LOCAL_POSTGRES", False)
    if not allow_pg:
        return ""
    raw = os.getenv("DATABASE_URL", "").strip()
    if not raw:
        return ""
    try:
        from urllib.parse import urlparse
        host = (urlparse(raw).hostname or "").lower()
        if host in {"localhost", "127.0.0.1", "::1"}:
            return raw
    except Exception:
        pass
    return ""


