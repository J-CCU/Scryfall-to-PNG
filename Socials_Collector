def _v34_ig_reset_backoff_after_success(db: Optional[instagram_Database]) -> None:
    if db is None:
        return
    try:
        prior = int(float(db.get_runtime_state("instagram_access_backoff_events") or 0))
    except Exception:
        prior = 0
    try:
        streak = int(float(db.get_runtime_state("instagram_graph_success_streak") or 0)) + 1
    except Exception:
        streak = 1
    try:
        db.set_runtime_state("instagram_graph_success_streak", str(streak))
    except Exception:
        pass
    if prior <= 0:
        return
    # A single successful Graph request is not enough evidence that an app-level
    # request limit has cleared. Keep the escalation history until a sustained
    # run of successful requests proves recovery.
    if streak < V34_IG_GRAPH_SUCCESS_RESET_STREAK:
        instagram_log(
            f"[graph/v34] successful Graph response | recovery_streak={streak}/{V34_IG_GRAPH_SUCCESS_RESET_STREAK} | "
            "throttle escalation retained"
        )
        return
    try:
        db.set_runtime_state("instagram_access_backoff_events", "0")
        db.set_runtime_state("instagram_access_backoff_until", "")
        db.set_runtime_state("instagram_access_backoff_reason", "")
        db.set_runtime_state("instagram_access_backoff_username", "")
        db.set_runtime_state("instagram_graph_success_streak", "0")
        instagram_log(
            f"[graph/v34] sustained Graph recovery confirmed | "
            f"successes={V34_IG_GRAPH_SUCCESS_RESET_STREAK} | throttle escalation reset"
        )
    except Exception:
        pass


