            c = out["youtube"]
            print(
                f"[pre-main/v42] YouTube | finished={c.get('complete',0)}/{c.get('items',0)} | "
                f"payload={c.get('payload',0)} | comments collected={c.get('comments_collected',0)} "
                f"empty={c.get('comments_empty',0)} pending={c.get('comments_pending',0)} | "
                f"catalogs={c.get('catalogs_verified',0)}/{c.get('catalogs_total',0)} | reclassified={c.get('reclassified',0)}",
                flush=True,
            )
        finally:
            db.close()
    if key in {"", "instagram"}:
        db = instagram_Database(instagram_DB_PATH)
        try:
            out["instagram"] = _v42_audit_instagram(db)
            c = out["instagram"]
            print(
                f"[pre-main/v42] Instagram | finished={c.get('complete',0)}/{c.get('items',0)} | "
                f"payload={c.get('payload',0)} | comments collected={c.get('comments_collected',0)} "
