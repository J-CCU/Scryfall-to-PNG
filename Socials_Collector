def _v55_historical_unresolved_count(db: tiktok_Database, username: str) -> int:
    uname = tiktok_normalized_username(username).lower()
    if not uname:
        return 0
    with db.lock:
        rows = db.conn.execute(
            """SELECT normalized_input,input_text FROM account_inputs
               WHERE UPPER(COALESCE(resolution_verified,''))='NO'"""
        ).fetchall()
    n = 0
