def _v42_tt_mark_stage(self: tiktok_Database, video_id: str, stage: str, status: str) -> None:
    requested = str(status or "")
    final = requested
    evidence = ""
    source = ""
    if stage == "formats":
        with self.lock:
            persisted = int(_v42_scalar(self.conn, "SELECT COUNT(*) FROM formats WHERE video_id=?", (video_id,)) or 0)
        if requested == "SUCCESS" and persisted == 0:
            # Base code had the empty-list branch inverted.
            final = "SUCCESS_EMPTY"
        elif requested == "SUCCESS_EMPTY" and persisted == 0:
            # Base code only reaches this branch when it saw format entries but
            # none could be persisted.  That is not a proven empty surface.
            final = "PENDING_FORMAT_PERSIST"
    if stage == "comments" and requested in {"SUCCESS", "SUCCESS_EMPTY"}:
        with _V42_TT_COMMENT_FETCH_LOCK:
            fetch = _V42_TT_COMMENT_FETCH.pop(str(video_id), None)
        with self.lock:
            actual = int(_v42_scalar(self.conn, "SELECT COUNT(*) FROM comments WHERE video_id=?", (video_id,)) or 0)
            expected = _v42_scalar(self.conn, "SELECT comment_count FROM videos WHERE video_id=?", (video_id,))
        if fetch and fetch.get("status") != "COMPLETE":
            final = str(fetch.get("status") or "PARTIAL")
            evidence = final
            source = str(fetch.get("source") or "")
        elif fetch:
            final = "SUCCESS" if actual > 0 else "SUCCESS_EMPTY"
            evidence = "RESEARCH_API_PAGINATION_COMPLETE"
            source = str(fetch.get("source") or "TikTok Research API")
        elif actual > 0:
            final = "SUCCESS"
            evidence = "PERSISTED_ROWS"
        elif expected is not None and int(expected or 0) == 0:
            final = "SUCCESS_EMPTY"
            evidence = "METADATA_ZERO"
        else:
            final = "PENDING_UNVERIFIED_EMPTY"
            evidence = "EMPTY_WITHOUT_TRAVERSAL_PROOF"
    _v42_tt_mark_stage_prev(self, video_id, stage, final)
    if stage == "comments":
        _v42_set_comment_evidence(self, "video_ingestion", "video_id", video_id, evidence or final, source)

