# One-time recovery when browser impersonation becomes newly available. This
# does not loop on every restart: the installed yt-dlp/curl_cffi signature is
# recorded in runtime_state. It simply makes previously access-limited evidence
# immediately eligible for one fresh attempt with the new capability.
def _v54_impersonation_signature() -> str:
    if not _v53_tiktok_impersonation_available():
        return ""
    try:
        import yt_dlp as _v54_ydl
        yv = str(getattr(_v54_ydl.version, "__version__", "unknown"))
    except Exception:
        yv = "unknown"
    try:
        import curl_cffi as _v54_curl
        cv = str(getattr(_v54_curl, "__version__", "unknown"))
    except Exception:
        cv = "unknown"
    return f"yt-dlp={yv}|curl_cffi={cv}"


def _v54_reopen_tiktok_after_new_impersonation(db: tiktok_Database) -> dict:
    sig = _v54_impersonation_signature()
    if not sig:
        return {"reopened_videos": 0, "reopened_catalogs": 0, "cleared_resolve_cooldowns": 0}
    marker = "v54_impersonation_recovery_signature"
    if str(db.get_runtime_state(marker) or "") == sig:
        return {"reopened_videos": 0, "reopened_catalogs": 0, "cleared_resolve_cooldowns": 0}
    _v51_migrate_tiktok(db)
    with db.lock:
        vcur = db.conn.execute(
            "UPDATE video_ingestion SET access_retry_after=0 WHERE access_state='COMPLETE_LIMITED' AND access_reason IN ('IP_BLOCKED','NO_FORMATS')"
        )
        acur = db.conn.execute(
            "UPDATE accounts SET catalog_retry_after=0 WHERE catalog_access_status='LIMITED'"
        )
        rows = db.conn.execute(
            "SELECT key FROM runtime_state WHERE key LIKE 'v51_tiktok_resolve_retry_after:%' AND COALESCE(value,'')<>''"
        ).fetchall()
        for row in rows:
            db.conn.execute("UPDATE runtime_state SET value='',updated_at=? WHERE key=?", (tiktok_now_utc(), str(row[0])))
        db.conn.commit()
        reopened_videos = max(0, int(vcur.rowcount or 0))
        reopened_catalogs = max(0, int(acur.rowcount or 0))
        cleared = len(rows)
    db.set_runtime_state(marker, sig)
    tiktok_log(
        f"[tiktok/v54] NEW impersonation capability detected | reopened limited videos={reopened_videos} | "
        f"catalogs={reopened_catalogs} | resolve cooldowns cleared={cleared}"
    )
    return {"reopened_videos": reopened_videos, "reopened_catalogs": reopened_catalogs, "cleared_resolve_cooldowns": cleared}


