def _v42_ig_account_is_indexed(self: instagram_Database, account_id: str) -> bool:
    _v42_migrate_instagram(self)
    with self.lock:
        row = self.conn.execute(
            "SELECT index_complete,catalog_verification_version,catalog_verified_at FROM accounts WHERE account_id=?",
