def instagram_now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def instagram_iso_from_dt(value: Any) -> str:
    if value is None:
        return ""
    try:
        if isinstance(value, datetime):
            dt = value if value.tzinfo else value.replace(tzinfo=timezone.utc)
        elif isinstance(value, (int, float)):
            dt = datetime.fromtimestamp(float(value), tz=timezone.utc)
        else:
            return str(value)
        return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        return str(value)


def instagram_safe_int(value: Any) -> Optional[int]:
    try:
        if value in (None, ""):
            return None
        return int(value)
    except Exception:
        return None


def instagram_safe_float(value: Any) -> Optional[float]:
    try:
        if value in (None, ""):
            return None
        return float(value)
    except Exception:
        return None


def instagram_json_text(value: Any) -> str:
    try:
        return json.dumps(value, ensure_ascii=False, default=str, separators=(",", ":"))
    except Exception:
        return json.dumps(str(value), ensure_ascii=False)


def instagram_gzip_text(value: Any) -> bytes:
    raw = value if isinstance(value, (bytes, bytearray)) else instagram_json_text(value).encode("utf-8", errors="replace")
    return gzip.compress(bytes(raw), compresslevel=6)


def instagram_sha256_blob(blob: bytes) -> str:
    return hashlib.sha256(blob).hexdigest()


def instagram_unique_by_id(rows: Iterable[dict], key: str) -> List[dict]:
    seen = set()
    out = []
    for row in rows:
        value = str(row.get(key) or "")
        if not value or value in seen:
            continue
        seen.add(value)
        out.append(row)
    return out


def instagram_log(message: str) -> None:
    with instagram_LOG_LOCK:
        print(str(message), flush=True)


def instagram_stop_requested() -> bool:
