def _v44_tt_backlog(self: tiktok_Database, account_id: str, limit: int = V42_REPAIR_ALL_LIMIT) -> List[dict]:
    _v42_migrate_tiktok(self)
    has_credentials = bool(tiktok_TIKTOK_RESEARCH_ACCESS_TOKEN or (tiktok_TIKTOK_RESEARCH_CLIENT_KEY and tiktok_TIKTOK_RESEARCH_CLIENT_SECRET))
    try:
        retry_after = float(self.get_runtime_state("v44_tiktok_comments_retry_after") or 0)
    except Exception:
        retry_after = 0.0
    comments_runnable = bool(has_credentials and retry_after <= time.time())
    with self.lock:
        if comments_runnable:
            rows = self.conn.execute(
                """SELECT v.*,i.* FROM videos v JOIN video_ingestion i ON i.video_id=v.video_id
                   WHERE v.account_id=? AND (COALESCE(i.completeness_audit_status,'')<>'COMPLETE' OR COALESCE(i.enrichment_state,'')<>'COMPLETE' OR COALESCE(i.last_error,'')<>'')
                   ORDER BY COALESCE(v.timestamp,0) DESC LIMIT ?""",
                (account_id, max(0, int(limit))),
            ).fetchall()
        else:
            # Do not spend an entire pass walking payload-complete rows whose
            # only missing stage cannot currently run. They remain durable and
            # reappear automatically when Research access/cooldown allows it.
            rows = self.conn.execute(
                """SELECT v.*,i.* FROM videos v JOIN video_ingestion i ON i.video_id=v.video_id
                   WHERE v.account_id=? AND (
                       COALESCE(i.completeness_audit_status,'') IN ('MISSING_PAYLOAD','MISSING_PAYLOAD_COMMENTS','')
                       OR COALESCE(i.last_error,'')<>''
                   ) ORDER BY COALESCE(v.timestamp,0) DESC LIMIT ?""",
                (account_id, max(0, int(limit))),
            ).fetchall()
    return [dict(r) for r in rows]

