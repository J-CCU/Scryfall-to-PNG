# ===========================================================================
# V25 — permanent independent platform lifecycle
# ===========================================================================
V25_BUILD = "ALL_FIXES_V25_IMMORTAL_PLATFORM_LIFECYCLE"

class UnifiedSchedulerV25(UnifiedSchedulerV23):
    def __init__(self, app: "UnifiedApp") -> None:
        super().__init__(app)
        self.graceful_end_requested = False
        self._slot_restart_after: Dict[str, float] = {}

    def start(self, inputs, limit, mode, force_refresh, continuous,
              high_throughput, extended_surfaces, collect_comments=False) -> None:
        self.graceful_end_requested = False
        self._slot_restart_after = {}
        self.ui_log("[server/v25] PERMANENT SERVICE mode | platform completion cannot stop sibling platforms\n")
        # Force permanent service operation regardless of the old GUI checkbox.
        return UnifiedSchedulerV20.start(
            self, inputs, limit, mode, force_refresh, True,
            high_throughput, extended_surfaces, collect_comments,
        )

    def _wait_until(self, until: float) -> bool:
        while (not self.stop_event.is_set()
               and not self.graceful_end_requested
               and until > time.time()):
            remaining = max(0.0, until - time.time())
            self.wake_event.wait(min(1.0, remaining))
            self.wake_event.clear()
        return not self.stop_event.is_set() and not self.graceful_end_requested

    def _platform_loop(self, platform: UnifiedPlatform) -> None:
        try:
            pre_state, pre_reason = v20_preflight(platform, self.inputs.get(platform.key, []))
            self.platform_reasons[platform.key] = pre_reason
            self.ui_log(f"[preflight/{platform.key}] {pre_state} | {pre_reason}\n")
            if pre_state == "FAILED":
                self.ui_platform(platform.key, "FAILED")
                return

            while not self.stop_event.is_set() and not self.graceful_end_requested:
                until = self._cooldown_until(platform)
                if until > time.time():
                    kind = self._cooldown_kind(platform)
                    self.ui_platform(platform.key, kind)
                    self.ui_cooldown(platform.key, until)
                    remaining = max(0.0, until - time.time())
                    mins, secs = divmod(int(remaining), 60)
                    self.ui_log(
                        f"[multiplatform/v25] {platform.label} paused | {mins}m {secs}s remaining | "
                        "siblings continue independently\n"
                    )
                    if not self._wait_until(until):
                        break

                if self.graceful_end_requested or self.stop_event.is_set():
                    break

                status = self._run_platform_process(platform)

                if status == "STOPPED":
                    break

                if status == "COMPLETE":
                    if self.graceful_end_requested or self.stop_event.is_set():
                        break
                    self.ui_log(
                        f"[multiplatform/v25] {platform.label} pass COMPLETE; "
                        f"restarting {platform.label} only; siblings unaffected.\n"
                    )
                    self.ui_platform(platform.key, "READY")
                    # Small interruptible guard prevents an empty account from
                    # becoming a CPU-burning restart loop.
                    end = time.time() + 1.0
                    while time.time() < end:
                        if self.stop_event.is_set() or self.graceful_end_requested:
                            break
                        self.wake_event.wait(min(0.2, max(0.0, end-time.time())))
                        self.wake_event.clear()
                    continue

                if status in {"COOLDOWN", "ACCESS_BLOCKED"}:
                    continue

                if status == "FAILED":
                    n = self.platform_failures.get(platform.key, 1)
                    delay = min(
                        V20_RETRY_FAILURE_MAX,
                        V20_RETRY_FAILURE_INITIAL * (2 ** min(n - 1, 4)),
                    )
                    until = time.time() + delay
                    self.ui_platform(platform.key, "RETRYING")
                    self.ui_cooldown(platform.key, until)
                    self.ui_log(
                        f"[multiplatform/v25] {platform.label} failed; "
                        f"retrying this platform only in {int(delay)}s\n"
                    )
                    if not self._wait_until(until):
                        break

        except BaseException as exc:
            # Never let a platform-thread exception propagate into the master.
            self.platform_reasons[platform.key] = f"{type(exc).__name__}: {exc}"[:500]
            self.ui_platform(platform.key, "RETRYING")
            self.ui_log(
                f"[multiplatform/v25] {platform.label} SLOT EXCEPTION | "
                f"{type(exc).__name__}: {exc} | watchdog will recreate slot\n"
            )
        finally:
            if self.stop_event.is_set() or self.graceful_end_requested:
                self.ui_platform(platform.key, "STOPPED")

    def _spawn_slot(self, platform: UnifiedPlatform, reason="initial") -> None:
        t = threading.Thread(
            target=self._platform_loop,
            args=(platform,),
            name=f"Platform-{platform.key}-V25",
            daemon=True,
        )
        self.slot_threads[platform.key] = t
        t.start()
        self.ui_log(
            f"[multiplatform/v25] STARTED service slot: {platform.label} | reason={reason}\n"
        )

    def _main(self) -> None:
        self.ui_log("\n[multiplatform/v25] MASTER SERVICE STARTED\n")
        self.ui_log("[multiplatform/v25] Platform slots are permanent and independent.\n")
        self.ui_log(
            f"[multiplatform/v25] mode={self.mode} | "
            f"limit={'ALL' if self.limit <= 0 else self.limit} | continuous=FORCED-YES | "
            f"high_throughput={'YES' if self.high_throughput else 'NO'} | "
            f"extended_surfaces={'YES' if self.extended_surfaces else 'NO'} | "
            f"comments={'ON' if self.collect_comments_enabled else 'OFF'}\n"
        )

        for p in UNIFIED_PLATFORMS:
            if self.inputs.get(p.key):
                self._spawn_slot(p)

        try:
            # IMMORTAL MASTER: never exit because a child/slot completed.
            while not self.stop_event.is_set() and not self.graceful_end_requested:
                now = time.time()
                for p in UNIFIED_PLATFORMS:
                    if not self.inputs.get(p.key):
                        continue
                    t = self.slot_threads.get(p.key)
                    if t is not None and t.is_alive():
                        continue
                    if now < self._slot_restart_after.get(p.key, 0.0):
                        continue
                    self._slot_restart_after[p.key] = now + 2.0
                    self.ui_log(
                        f"[multiplatform/v25] WATCHDOG: {p.label} slot died/returned; "
                        "recreating it without touching siblings.\n"
                    )
                    self._spawn_slot(p, "watchdog-restart")

                self.wake_event.wait(0.5)
                self.wake_event.clear()

            # Graceful End: no new passes; wait for each active child to hit the
            # next PROGRESS checkpoint. _run_platform_process already terminates
            # the child at that committed-item boundary when this flag is set.
            if self.graceful_end_requested and not self.stop_event.is_set():
                self.ui_log(
                    "[control] Graceful End active | no new passes; "
                    "waiting for active item checkpoints.\n"
                )
                while (not self.stop_event.is_set()
                       and any(t.is_alive() for t in self.slot_threads.values())):
                    self.wake_event.wait(0.5)
                    self.wake_event.clear()

        except BaseException as exc:
            self.ui_log(f"[multiplatform/v25] MASTER ERROR: {type(exc).__name__}: {exc}\n")
        finally:
            self.current = None
            self.ui_log("[multiplatform/v25] MASTER SERVICE STOPPED\n")
            self.app.enqueue_ui(("scheduler_done",))

    def stop(self) -> None:
        # Normal End is graceful: it does NOT kill all active subprocesses.
        if self.graceful_end_requested:
            return
        self.graceful_end_requested = True
        self.wake_event.set()
        self.ui_log(
            "[control] END requested | no new passes will start; "
            "active workers stop after their next committed item checkpoint.\n"
        )
        with self.process_lock:
            active = list(self.processes.keys())
        if not active:
            self.stop_event.set()
            self.wake_event.set()

    def force_stop(self) -> None:
        self.ui_log("[control] FORCE STOP requested | terminating all active workers now.\n")
        self.graceful_end_requested = True
        self.stop_event.set()
        self.wake_event.set()
        with self.process_lock:
            procs = list(self.processes.items())
        for _, proc in procs:
            if proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    try:
                        proc.kill()
                    except Exception:
                        pass
        try:
            self.app.root.after(1200, self._force_kill_all)
        except Exception:
            pass


UnifiedScheduler = UnifiedSchedulerV25

_v25_app_init_prev = UnifiedApp.__init__
