def v13__instagram_profile_from_feed(loader: Any, username: str) -> Optional[dict]:
    if not username or instagram_instaloader is None:
        return None
    if not instagram_wait_for_request_slot("Full", f"mobile-feed profile @{username}"):
        return None
    try:
        feed = v13__instagram_feed_get_json(loader, f"api/v1/feed/user/{username.lower()}/username/", {"count": 12})
