def youtube_innertube_context() -> dict:
    client = {
        "clientName": youtube_WEB_CLIENT["clientName"],
        "clientVersion": youtube_WEB_CLIENT["clientVersion"] or "2.20260916.01.00",
        "hl": "en",
        "gl": "US",
        "userAgent": youtube_UA,
    }
    if youtube_VISITOR_DATA:
        client["visitorData"] = youtube_VISITOR_DATA
    return {"client": client}


def youtube_innertube_post(endpoint: str, payload: dict) -> Tuple[Optional[dict], int, str]:
    if youtube_stop_requested():
        return None, 0, "stop requested"
    if not youtube_INNERTUBE_API_KEY:
        youtube_refresh_innertube_config()
    if not youtube_INNERTUBE_API_KEY:
        return None, 0, "missing API key"

    headers = {
        "Content-Type": "application/json",
        "X-YouTube-Client-Name": "1",
        "X-YouTube-Client-Version": youtube_WEB_CLIENT["clientVersion"] or youtube_WEB_CLIENT_VERSION,
        "Origin": youtube_YOUTUBE,
        "Referer": youtube_HOME,
        "User-Agent": youtube_UA,
    }

    auth = youtube_sapisid_hash()
    if auth:
        headers["Authorization"] = auth
        headers["X-Goog-AuthUser"] = "0"

    body = {
        "context": youtube_innertube_context(),
        **payload,
    }

    try:
        r = youtube_SESSION.post(
            f"{youtube_INNERTUBE_BASE}/{endpoint}",
            params={"key": youtube_INNERTUBE_API_KEY, "prettyPrint": "false"},
            json=body,
            headers=headers,
            timeout=youtube_REQUEST_TIMEOUT,
        )
        if r.status_code != 200:
            youtube_debug(f"[{endpoint}] HTTP {r.status_code}: {r.text[:600]}")
            return None, r.status_code, r.text
        return r.json(), r.status_code, r.text
    except Exception as exc:
        youtube_debug(f"[{endpoint}] {type(exc).__name__}: {exc}")
        return None, 0, str(exc)


