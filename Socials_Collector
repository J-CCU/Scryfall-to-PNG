def youtube_export_run_csvs(db: youtube_Database, run_id: int, folder: Path) -> Dict[str, Path]:
    folder.mkdir(parents=True, exist_ok=True)
    outputs = {}
    queries = {
        "channels": "SELECT * FROM channel_snapshots WHERE scrape_run_id=? ORDER BY id",
        "videos": "SELECT * FROM video_snapshots WHERE scrape_run_id=? ORDER BY id",
        "comments": "SELECT * FROM comments WHERE scrape_run_id=? ORDER BY id",
        "formats": "SELECT * FROM formats WHERE scrape_run_id=? ORDER BY id",
        "captions": "SELECT * FROM caption_tracks WHERE scrape_run_id=? ORDER BY id",
        "errors": "SELECT * FROM errors WHERE scrape_run_id=? ORDER BY id",
        "channel_inputs": "SELECT * FROM channel_inputs WHERE scrape_run_id=? ORDER BY id",
        "video_ingestion": "SELECT vi.* FROM video_ingestion vi JOIN videos v ON v.video_id=vi.video_id JOIN video_snapshots vs ON vs.video_id=vi.video_id AND vs.scrape_run_id=? ORDER BY vi.video_id",
        "surface_items": "SELECT * FROM surface_items ORDER BY last_seen_at DESC",
        "surface_snapshots": "SELECT * FROM surface_snapshots WHERE scrape_run_id=? ORDER BY id",
    }
    with db.lock:
        for name, sql in queries.items():
            path = folder / f"{name}_run_{run_id}.csv"
            cur = db.conn.execute(sql, (run_id,))
            rows = cur.fetchall()
            cols = [d[0] for d in cur.description]
            with path.open("w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(cols)
                writer.writerows(rows)
            outputs[name] = path
    return outputs


