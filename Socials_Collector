def _v44_fast_audit_youtube(db: youtube_Database) -> dict:
    """Bulk evidence reconciliation. No network and no per-row commits."""
    _v44_migrate_youtube(db)
    now = youtube_now_utc()
    payload = _v44_youtube_payload_expr("vi")
    comments = _v44_youtube_comments_expr("vi", "v")
    with db.lock:
        # Recover evidence for legacy rows in set-based updates.
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_evidence='PERSISTED_ROWS', comments_last_source=COALESCE(NULLIF(comments_last_source,''),'legacy')
            WHERE comments_status='SUCCESS' AND COALESCE(comments_evidence,'')=''
              AND EXISTS(SELECT 1 FROM comments c WHERE c.video_id=video_ingestion.video_id)
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_evidence='LEGACY_API_EMPTY', comments_last_source='youtube_api'
            WHERE comments_status='SUCCESS_EMPTY' AND COALESCE(comments_evidence,'')=''
              AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=video_ingestion.video_id
                         AND r.source='youtube_api' AND r.note LIKE 'video_comments_page%')
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_evidence='LEGACY_METADATA_ZERO', comments_last_source=COALESCE(NULLIF(comments_last_source,''),'legacy')
            WHERE comments_status='SUCCESS_EMPTY' AND COALESCE(comments_evidence,'')=''
              AND EXISTS(SELECT 1 FROM videos v WHERE v.video_id=video_ingestion.video_id AND v.comment_count=0)
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET comments_status='PENDING_UNVERIFIED_EMPTY', comments_evidence='LEGACY_UNVERIFIED_EMPTY'
            WHERE comments_status IN ('SUCCESS','SUCCESS_EMPTY') AND COALESCE(comments_evidence,'')=''
              AND NOT EXISTS(SELECT 1 FROM comments c WHERE c.video_id=video_ingestion.video_id)
              AND NOT EXISTS(SELECT 1 FROM videos v WHERE v.video_id=video_ingestion.video_id AND v.comment_count=0)
        """)
        db.conn.execute(f"""
            UPDATE video_ingestion AS vi
            SET completeness_audit_status = CASE
                WHEN ({payload}) AND EXISTS(SELECT 1 FROM videos v WHERE v.video_id=vi.video_id AND ({comments})) THEN 'COMPLETE'
                WHEN NOT ({payload}) AND NOT EXISTS(SELECT 1 FROM videos v WHERE v.video_id=vi.video_id AND ({comments})) THEN 'MISSING_PAYLOAD_COMMENTS'
                WHEN NOT ({payload}) THEN 'MISSING_PAYLOAD'
                ELSE 'MISSING_COMMENTS'
            END,
            last_completeness_audit_at=?
        """, (now,))
        # Completion state must agree with evidence. V42 previously updated the
        # audit column without always flipping the checkpoint to COMPLETE.
        db.conn.execute("""
            UPDATE video_ingestion
            SET enrichment_state='COMPLETE', current_stage='COMPLETE', last_error=NULL
            WHERE completeness_audit_status='COMPLETE'
        """)
        db.conn.execute("""
            UPDATE video_ingestion
            SET enrichment_state='IN_PROGRESS',
                current_stage=CASE WHEN completeness_audit_status='MISSING_COMMENTS' THEN 'comments' ELSE 'FINALIZE' END
            WHERE completeness_audit_status<>'COMPLETE' AND enrichment_state='COMPLETE'
        """)
        db.conn.commit()
    c = _v42_live_youtube_counts(youtube_DB_PATH if Path(db.path) == Path(youtube_DB_PATH) else Path(db.path))
    return c


def _v44_ig_payload_expr(i: str = "i") -> str:
