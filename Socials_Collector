def instagram_merge_ytdlp_into_post(p: dict, info: dict) -> dict:
    if not isinstance(info, dict):
        return p
    mapping = {
        "title": "title",
        "description": "caption",
        "view_count": "video_view_count",
        "like_count": "likes",
        "comment_count": "comments_count",
        "duration": "video_duration",
        "width": "width",
        "height": "height",
        "thumbnail": "thumbnail_url",
        "webpage_url": "post_url",
    }
    for src, dst in mapping.items():
        val = info.get(src)
        if val not in (None, "") and p.get(dst) in (None, ""):
            p[dst] = val
    p["_ytdlp_raw"] = info
    return p


