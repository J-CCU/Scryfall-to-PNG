def _v42_live_youtube_counts(db_path: Path = youtube_DB_PATH) -> dict:
    if not Path(db_path).exists():
        return {"items":0,"complete":0,"payload":0,"pending":0,"comments_collected":0,"comments_empty":0,"comments_disabled":0,"comments_deferred":0,"comments_failed":0,"comments_pending":0,"comment_rows":0,"catalogs_verified":0,"catalogs_total":0}
    conn = sqlite3.connect(str(db_path), timeout=2.0)
    try:
        total = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion") or 0)
        cols = _v42_table_columns(conn, "video_ingestion")
        complete = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE completeness_audit_status='COMPLETE' AND enrichment_state='COMPLETE'") or 0) if "completeness_audit_status" in cols else 0
        payload = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion vi WHERE vi.yt_dlp_status='SUCCESS' AND EXISTS(SELECT 1 FROM video_snapshots s WHERE s.video_id=vi.video_id) AND EXISTS(SELECT 1 FROM raw_data r WHERE r.video_id=vi.video_id AND r.source='yt-dlp' AND r.note='video_full_info')") or 0)
        collected = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion vi WHERE vi.comments_status='SUCCESS' AND EXISTS(SELECT 1 FROM comments c WHERE c.video_id=vi.video_id)") or 0)
        empty = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion vi LEFT JOIN videos v ON v.video_id=vi.video_id WHERE vi.comments_status='SUCCESS_EMPTY' AND (COALESCE(vi.comments_evidence,'') IN ('API_PAGINATION_COMPLETE','API_COMMENTS_DISABLED','YTDLP_METADATA_ZERO','YTDLP_TRAVERSAL_COMPLETE_EMPTY','LEGACY_METADATA_ZERO','LEGACY_API_EMPTY') OR v.comment_count=0)") or 0) if "comments_evidence" in cols else 0
        disabled = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status IN ('COMMENTS_DISABLED','DISABLED')") or 0)
        deferred = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status LIKE 'DEFERRED%' OR comments_status IN ('RATE_LIMITED','STOPPED','PARTIAL','PENDING_UNVERIFIED_EMPTY')") or 0)
        failed = int(_v42_scalar(conn, "SELECT COUNT(*) FROM video_ingestion WHERE comments_status IN ('FAILED','ERROR')") or 0)
        terminal = min(total, collected + empty + disabled)
        comment_rows = int(_v42_scalar(conn, "SELECT COUNT(*) FROM comments") or 0)
        ccols = _v42_table_columns(conn, "channels")
        catalogs_total = int(_v42_scalar(conn, "SELECT COUNT(*) FROM channels") or 0)
        catalogs_verified = int(_v42_scalar(conn, "SELECT COUNT(*) FROM channels WHERE index_complete='1' AND catalog_verification_version=?", (V39_CATALOG_PROOF_VERSION,)) or 0) if "catalog_verification_version" in ccols else 0
        return {"items":total,"complete":complete,"payload":payload,"pending":max(0,total-complete),"comments_collected":collected,"comments_empty":empty,"comments_disabled":disabled,"comments_deferred":deferred,"comments_failed":failed,"comments_pending":max(0,total-terminal),"comment_rows":comment_rows,"catalogs_verified":catalogs_verified,"catalogs_total":catalogs_total}
    finally:
        conn.close()


def _v42_live_instagram_counts(db_path: Path = instagram_DB_PATH, comments_required: bool = False) -> dict:
    if not Path(db_path).exists():
        return {"items":0,"complete":0,"payload":0,"pending":0,"comments_collected":0,"comments_empty":0,"comments_deferred":0,"comments_failed":0,"comments_pending":0,"comment_rows":0,"catalogs_verified":0,"catalogs_total":0}
    conn = sqlite3.connect(str(db_path), timeout=2.0)
    try:
        total = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion") or 0)
        cols = _v42_table_columns(conn, "post_ingestion")
        complete = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion WHERE completeness_audit_status='COMPLETE' AND enrichment_state='COMPLETE'") or 0) if "completeness_audit_status" in cols else 0
        payload = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion i WHERE i.last_enriched_at IS NOT NULL AND EXISTS(SELECT 1 FROM post_snapshots s WHERE s.post_id=i.post_id) AND EXISTS(SELECT 1 FROM raw_data r WHERE r.post_id=i.post_id)") or 0)
        collected = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion i WHERE i.comments_status='SUCCESS' AND EXISTS(SELECT 1 FROM comments c WHERE c.post_id=i.post_id)") or 0)
        empty = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion i LEFT JOIN posts p ON p.post_id=i.post_id WHERE i.comments_status='SUCCESS_EMPTY' AND (COALESCE(i.comments_evidence,'') IN ('GRAPH_PAGINATION_COMPLETE','INSTALOADER_TRAVERSAL_COMPLETE','METADATA_ZERO','LEGACY_METADATA_ZERO') OR p.comments_count=0)") or 0) if "comments_evidence" in cols else 0
        deferred = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion WHERE comments_status LIKE 'DEFERRED%' OR comments_status IN ('PARTIAL','PENDING_UNVERIFIED_EMPTY','RATE_LIMITED')") or 0)
        failed = int(_v42_scalar(conn, "SELECT COUNT(*) FROM post_ingestion WHERE comments_status IN ('FAILED','ERROR')") or 0)
        terminal = min(total, collected + empty) if comments_required else total
        comment_rows = int(_v42_scalar(conn, "SELECT COUNT(*) FROM comments") or 0)
        acols = _v42_table_columns(conn, "accounts")
        catalogs_total = int(_v42_scalar(conn, "SELECT COUNT(*) FROM accounts") or 0)
        catalogs_verified = int(_v42_scalar(conn, "SELECT COUNT(*) FROM accounts WHERE index_complete='YES' AND catalog_verification_version=?", (V42_CATALOG_PROOF_VERSION,)) or 0) if "catalog_verification_version" in acols else 0
        return {"items":total,"complete":complete,"payload":payload,"pending":max(0,total-complete),"comments_collected":collected,"comments_empty":empty,"comments_deferred":deferred,"comments_failed":failed,"comments_pending":max(0,total-terminal),"comment_rows":comment_rows,"catalogs_verified":catalogs_verified,"catalogs_total":catalogs_total}
    finally:
        conn.close()


