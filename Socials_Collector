# Apply the adaptive multiplier to every top-level Instagram request, matching the
# collector behavior used by the YouTube implementation. The multiplier increases
# after throttling and decays after sustained success; it never bypasses a platform
# restriction.
def instagram_instagram_adaptive_interval_for_mode(mode: str) -> float:
    base = instagram_mode_min_interval(mode)
    with instagram_RATE_LIMIT_LOCK:
        mult = max(1.0, float(instagram_INSTAGRAM_ADAPTIVE_INTERVAL_MULTIPLIER))
    return base * mult


def instagram_instagram_policy_text_parity(mode: str) -> str:
    with instagram_RATE_LIMIT_LOCK:
        mult = max(1.0, float(instagram_INSTAGRAM_ADAPTIVE_INTERVAL_MULTIPLIER))
    return (
        f"collector_policy_min_interval={instagram_instagram_adaptive_interval_for_mode(mode):.1f}s | "
        f"request_sleep={instagram_REQUEST_SLEEP_BY_MODE.get(mode, 1.0):.1f}s | adaptive_multiplier={mult:.2f}x"
    )


def instagram_wait_for_request_slot_parity(mode: str, label: str) -> bool:
    global instagram_LAST_REQUEST_START, instagram_REQUEST_COUNTER
    if instagram_stop_requested() or instagram_rate_limited():
        return False
    min_interval = instagram_instagram_adaptive_interval_for_mode(mode)
    with instagram_REQUEST_LOCK:
        now = time.monotonic()
        elapsed = None if not instagram_LAST_REQUEST_START else now - instagram_LAST_REQUEST_START
        wait_for = 0.0 if elapsed is None else max(0.0, min_interval - elapsed)
        if elapsed is not None:
            wait_for += random.uniform(0.0, min(1.5, max(0.25, min_interval * 0.12)))
        if wait_for > 0:
            instagram_log(f"      [throttle] waiting {wait_for:.1f}s before Instagram {label} | {instagram_instagram_policy_text_parity(mode)}")
            if instagram_STOP_EVENT.wait(wait_for):
                return False
            if instagram_rate_limited() or instagram_stop_requested():
                return False
        instagram_LAST_REQUEST_START = time.monotonic()
        instagram_REQUEST_COUNTER += 1
        n = instagram_REQUEST_COUNTER
    instagram_log(f"      [throttle] Instagram {label} request START | #{n} | min_interval={min_interval:.1f}s")
    return True


