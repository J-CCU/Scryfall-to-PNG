                ON channel_inputs(scrape_run_id);
            CREATE INDEX IF NOT EXISTS idx_channel_inputs_channel
                ON channel_inputs(channel_id);
            """)
            # Schema migrations for databases created by older versions.
            for table, column, definition in (
                ("channels", "requested_handle", "TEXT"),
                ("channels", "resolution_method", "TEXT"),
                ("channels", "resolution_verified", "TEXT"),
                ("channel_snapshots", "requested_handle", "TEXT"),
                ("channel_snapshots", "resolution_method", "TEXT"),
                ("channel_snapshots", "resolution_verified", "TEXT"),
                ("channels", "first_indexed_at", "TEXT"),
                ("channels", "last_indexed_at", "TEXT"),
                ("channels", "index_complete", "TEXT"),
                ("channels", "indexed_video_count", "INTEGER DEFAULT 0"),
                ("channels", "last_discovery_count", "INTEGER DEFAULT 0"),
            ):
                cols = {row[1] for row in self.conn.execute(f"PRAGMA table_info({table})").fetchall()}
                if column not in cols:
                    self.conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")

            self._backfill_video_ingestion()
            self.conn.commit()

    def _backfill_video_ingestion(self) -> None:
        """Seed incremental-sync state from existing videos/snapshots."""
        rows = self.conn.execute(
            """
            SELECT v.video_id, v.channel_id, v.updated_at,
                   s.captured_at, s.yt_dlp_status, s.player_status
            FROM videos v
            LEFT JOIN video_snapshots s
              ON s.id = (
                  SELECT MAX(s2.id) FROM video_snapshots s2
                  WHERE s2.video_id = v.video_id
              )
            """
        ).fetchall()
        for video_id, channel_id, updated_at, captured_at, ytdlp_status, player_status in rows:
            existing = self.conn.execute(
                "SELECT video_id FROM video_ingestion WHERE video_id=?", (video_id,)
            ).fetchone()
            if existing:
                continue
            last = captured_at or updated_at
            complete = (ytdlp_status == "SUCCESS" and player_status == "SUCCESS")
            self.conn.execute(
                """
                INSERT INTO video_ingestion
                (video_id, channel_id, first_seen_at, last_discovered_at,
                 last_enriched_at, last_performance_refresh_at, yt_dlp_status,
                 player_status, comments_status, captions_status, formats_status)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    video_id, channel_id, last, last,
                    last if complete else None,
                    last if complete else None,
                    ytdlp_status or "LEGACY_UNKNOWN",
                    player_status or "LEGACY_UNKNOWN",
                    "LEGACY_UNKNOWN", "LEGACY_UNKNOWN", "LEGACY_UNKNOWN",
                ),
            )

