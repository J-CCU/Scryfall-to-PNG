# ---------------------------------------------------------------------------
# Instagram/Meta throttle policy.
# A code-4 app throttle is not improved by cycling access tokens or usernames.
# Escalate 10m -> 30m -> 60m -> 120m -> 240m and reset the escalation only
# after an actual successful Graph response.
# ---------------------------------------------------------------------------
V34_IG_BACKOFF_SCHEDULE = (600.0, 1800.0, 3600.0, 7200.0, 14400.0)
# Do not declare an app-level throttle recovered after a single lucky response.
# Meta code-4 limits can briefly admit one request and reject the next one.
V34_IG_GRAPH_SUCCESS_RESET_STREAK = max(3, int(os.getenv("SOCIAL_COLLECTOR_IG_GRAPH_SUCCESS_RESET_STREAK", "10")))

def v19__ig_set_access_backoff_v34(db: instagram_Database, reason: str, username: str = "") -> float:
    try:
        prior = int(float(db.get_runtime_state("instagram_access_backoff_events") or 0))
    except Exception:
        prior = 0
    idx = min(max(0, prior), len(V34_IG_BACKOFF_SCHEDULE) - 1)
    cooldown = float(V34_IG_BACKOFF_SCHEDULE[idx])
    until = time.time() + cooldown
    db.set_runtime_state("instagram_access_backoff_until", str(until))
    db.set_runtime_state("instagram_access_backoff_reason", str(reason)[:1200])
    db.set_runtime_state("instagram_access_backoff_username", username)
    db.set_runtime_state("instagram_access_backoff_events", str(prior + 1))
    db.set_runtime_state("instagram_graph_success_streak", "0")
    instagram_log(
        f"[orchestrator] Instagram access-blocked; yielding to scheduler | "
        f"backoff={int(cooldown)//60}m {int(cooldown)%60}s | "
        f"account=@{username or 'unknown'} | reason={str(reason)[:220]}"
    )
    return until

