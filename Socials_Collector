    identity = bool(row.get("account_id") or row.get("username"))
    descriptive = bool(row.get("description") or row.get("timestamp") or row.get("published_at"))
    title = str(row.get("title") or "").strip()
    if title and title.lower() != f"tiktok video {video_id}".lower():
        descriptive = True
    return bool(identity and descriptive)


