class tiktok_TikTokYTDLPLogger:
    def __init__(self, db: Optional[tiktok_Database] = None, pending_video_id: str = "", pending_account_id: str = ""):
        self.db = db
        self.pending_video_id = pending_video_id
        self.pending_account_id = pending_account_id

    def _emit(self, level: str, msg: str) -> None:
        text = str(msg or "").strip()
        if not text:
            return
        tiktok_log(f"      [yt-dlp/{level.lower()}] {text}")
        if tiktok_is_tiktok_rate_limit_text(text):
            tiktok_set_tiktok_rate_limit(self.db, reason=text, pending_video_id=self.pending_video_id, pending_account_id=self.pending_account_id)

    def debug(self, msg: str) -> None:
        # TikTok can be chatty; keep comments/HTTP/errors/rate warnings visible.
        lowered = str(msg or "").lower()
        if any(k in lowered for k in ("comment", "warning", "error", "http", "request", "challenge")):
            self._emit("DEBUG", msg)

    def info(self, msg: str) -> None:
        self._emit("INFO", msg)

    def warning(self, msg: str) -> None:
        self._emit("WARNING", msg)

    def error(self, msg: str) -> None:
        self._emit("ERROR", msg)


def tiktok_ytdlp_opts(mode: str, *, flat: bool, db: Optional[tiktok_Database] = None, pending_video_id: str = "", pending_account_id: str = "") -> dict:
    opts = {
        "quiet": True,
        "no_warnings": False,
        "ignoreerrors": True if flat else False,
        "skip_download": True,
        "socket_timeout": tiktok_REQUEST_TIMEOUT,
        "sleep_interval_requests": tiktok_TIKTOK_REQUEST_SLEEP_BY_MODE.get(mode, 1.0),
        "extract_flat": flat,
        "cachedir": False,
        "retries": 2,
        "fragment_retries": 2,
        "extractor_retries": 1,
        "logger": tiktok_TikTokYTDLPLogger(db, pending_video_id, pending_account_id),
    }
    if tiktok_YTDLP_COOKIEFILE and tiktok_YTDLP_COOKIEFILE.exists():
        opts["cookiefile"] = str(tiktok_YTDLP_COOKIEFILE)
    return opts


def tiktok_ytdlp_extract(url: str, mode: str, *, flat: bool, db: Optional[tiktok_Database] = None, pending_video_id: str = "", pending_account_id: str = "") -> Optional[dict]:
    if tiktok_yt_dlp is None:
        return None
    with tiktok_yt_dlp.YoutubeDL(tiktok_ytdlp_opts(mode, flat=flat, db=db, pending_video_id=pending_video_id, pending_account_id=pending_account_id)) as ydl:
        return ydl.extract_info(url, download=False)


def tiktok_normalize_video_info(info: dict, account_id: str = "", username: str = "") -> dict:
    ts = tiktok_published_timestamp(info)
    thumbs = info.get("thumbnails") or []
    cover = ""
    if thumbs and isinstance(thumbs[-1], dict):
        cover = thumbs[-1].get("url") or ""
    return {
        "video_id": str(info.get("id") or ""),
        "account_id": account_id or info.get("channel_id") or "",
        "username": username or info.get("uploader") or info.get("channel") or "",
        "title": info.get("title") or "",
        "description": info.get("description") or "",
        "timestamp": ts,
        "published_at": tiktok_iso_from_timestamp(ts),
        "duration": tiktok_safe_int(info.get("duration")),
        "width": tiktok_safe_int(info.get("width")),
        "height": tiktok_safe_int(info.get("height")),
        "view_count": tiktok_safe_int(info.get("view_count")),
        "like_count": tiktok_safe_int(info.get("like_count")),
        "comment_count": tiktok_safe_int(info.get("comment_count")),
        "repost_count": tiktok_safe_int(info.get("repost_count")),
        "save_count": tiktok_safe_int(info.get("save_count")),
        "share_url": info.get("webpage_url") or info.get("url") or "",
        "video_url": info.get("webpage_url") or tiktok_video_url(str(info.get("id") or ""), username),
        "cover_url": cover or info.get("thumbnail") or "",
        "track": info.get("track") or "",
        "album": info.get("album") or "",
        "artists": info.get("artists"),
        "region_code": info.get("region_code") or "",
        "availability": info.get("availability") or "",
        "_raw_info": info,
    }


def tiktok_resolve_account(username: str, db: tiktok_Database, *, mode: str, force_refresh: bool = False) -> Optional[dict]:
    username = tiktok_normalized_username(username)
    if not username:
        return None
    if not force_refresh:
        cached = db.cached_account_resolution(username)
        if cached:
            tiktok_log(f"[resolve/cache] @{username} -> {cached['account_id']} [verified cache]")
            return {
                "account_id": cached["account_id"],
                "username": cached.get("username") or username,
                "display_name": cached.get("display_name") or "",
                "bio": "",
                "uid": "",
                "sec_uid": cached["account_id"],
                "verified": True,
                "followers": None,
                "following": None,
                "likes": None,
                "video_count": None,
                "avatar_url": "",
                "bio_url": "",
                "account_url": f"{tiktok_TIKTOK}/@{username}",
                "resolution_method": "cached_verified",
                "resolution_verified": True,
            }

    url = f"{tiktok_TIKTOK}/@{username}"
    page, status, final_url = tiktok_get_page_details(url)
    if tiktok_is_tiktok_page_throttle(page or "", status):
        reason = f"profile page HTTP {status}" if status else "profile page throttle/challenge"
        tiktok_set_tiktok_rate_limit(db, reason=reason, pending_account_id=username)
        return None
    candidate: dict = {}
    raw_json = None
    if page:
        raw_json = tiktok_parse_embedded_json(page, "SIGI_STATE") or tiktok_parse_embedded_json(page, "sigi-persisted-data") or tiktok_parse_embedded_json(page, "__UNIVERSAL_DATA_FOR_REHYDRATION__")
        candidate = tiktok_extract_tiktok_profile_candidate(raw_json, username) if raw_json else {}
        if not candidate:
            # Some pages expose initial JSON in generic application scripts.
            for key in ("SIGI_STATE", "sigi-persisted-data", "__UNIVERSAL_DATA_FOR_REHYDRATION__"):
                obj = tiktok_parse_embedded_json(page, key)
                if obj:
                    candidate = tiktok_extract_tiktok_profile_candidate(obj, username)
                    if candidate:
                        raw_json = obj
                        break
        if candidate and candidate.get("username", "").lower() == username.lower():
            cid = candidate.get("sec_uid") or candidate.get("uid") or candidate.get("username")
            candidate.update(
                {
                    "account_id": str(cid),
                    "account_url": f"{tiktok_TIKTOK}/@{candidate.get('username') or username}",
                    "resolution_method": "exact profile page JSON",
                    "resolution_verified": True,
                }
            )
            tiktok_log(f"[resolve/page] @{username} -> {cid} [exact profile page JSON]")
            return candidate

    # yt-dlp fallback: current TikTok extractor may need a secondary user ID on some profiles.
    if tiktok_yt_dlp is not None and tiktok_wait_for_request_slot(mode, f"profile @{username}"):
        try:
            info = tiktok_ytdlp_extract(url, mode, flat=True, db=db, pending_account_id=username)
            if info:
                entries = info.get("entries") if isinstance(info, dict) else None
                profile_username = info.get("uploader") or info.get("channel") or username
                sec_uid = info.get("channel_id") or info.get("uploader_id") or ""
                if sec_uid or profile_username:
                    account = {
                        "account_id": str(sec_uid or profile_username),
                        "username": str(profile_username),
                        "display_name": info.get("channel") or info.get("uploader") or "",
                        "bio": "",
                        "uid": info.get("uploader_id") or "",
                        "sec_uid": sec_uid,
                        "verified": bool(info.get("channel_is_verified") or info.get("uploader_is_verified")),
                        "followers": tiktok_safe_int(info.get("channel_follower_count") or info.get("uploader_follower_count")),
                        "following": tiktok_safe_int(info.get("channel_following_count") or info.get("uploader_following_count")),
                        "likes": None,
                        "video_count": len(entries) if isinstance(entries, list) else None,
                        "avatar_url": info.get("channel_thumbnail") or info.get("thumbnail") or "",
                        "bio_url": "",
                        "account_url": f"{tiktok_TIKTOK}/@{profile_username}",
                        "resolution_method": "yt-dlp profile fallback",
                        "resolution_verified": str(profile_username).lower() == username.lower(),
                    }
                    if account["resolution_verified"]:
                        tiktok_log(f"[resolve/yt-dlp] @{username} -> {account['account_id']} [verified fallback]")
                        return account
        except Exception as exc:
            tiktok_log(f"[resolve/yt-dlp] @{username} {type(exc).__name__}: {exc}")

    tiktok_log(f"[resolve] FAILED @{username} | no verified profile identity")
    return None


