def tiktok_pending_retry_context(db: tiktok_Database) -> tuple[str, str, str]:
    """Return persisted pending video/account/username before a scheduler resume."""
    video_id = str(db.get_runtime_state("tiktok_rate_limit_pending_video_id") or "").strip()
    account_id = str(db.get_runtime_state("tiktok_rate_limit_pending_account_id") or "").strip()
    username = ""
    if account_id:
        try:
            with db.lock:
                row = db.conn.execute("SELECT username FROM accounts WHERE account_id=?", (account_id,)).fetchone()
            if row:
                username = str(row[0] or "").strip()
        except Exception:
            username = ""
    return video_id, account_id, username


def tiktok_clear_pending_retry(db: tiktok_Database) -> None:
    for key in ("tiktok_rate_limit_pending_video_id", "tiktok_rate_limit_pending_account_id"):
        try:
            db.set_runtime_state(key, "")
        except Exception:
            pass


def tiktok_run_parity(self: tiktok_Collector, inputs: list, limit: int, mode: str, force_refresh: bool = False) -> int:
    self.emit(f"[config] adaptive rate policy: {tiktok_tiktok_policy_text_parity(mode)}")
    if tiktok_COLLECT_RESEARCH_API:
        tiktok_ensure_research_access_token(self.db)
        _, used = tiktok_tiktok_research_budget_state(self.db)
        self.emit(f"[config] Research API budget used_today={used}/{tiktok_TIKTOK_RESEARCH_DAILY_REQUEST_LIMIT} | per_run_cap={tiktok_TIKTOK_RESEARCH_MAX_REQUESTS_PER_RUN}")

    # A scheduler resume must try the exact item that triggered the previous
    # throttle before beginning ordinary account work. For account-level
    # throttles, move the matching account input to the front when it can be
    # identified from the persisted account id/username.
    pending_video_id, pending_account_id, pending_username = tiktok_pending_retry_context(self.db)
    run_inputs = list(inputs or [])
    if pending_username and len(run_inputs) > 1:
        def input_matches_pending(raw: str) -> bool:
            try:
                kind, normalized = tiktok_normalize_input(raw)
                candidate = normalized if kind == "username" else tiktok_username_from_url(normalized)
                return str(candidate or "").strip().lower() == pending_username.lower()
            except Exception:
                return False
        for idx, raw in enumerate(run_inputs):
            if input_matches_pending(str(raw)):
                if idx:
                    run_inputs.insert(0, run_inputs.pop(idx))
                self.emit(f"[throttle] PRIORITY ACCOUNT RETRY | @{pending_username} | moved to front of scheduler input queue")
                break

    # In orchestrated mode the previous run parks the platform before the
    # cooldown expires, so the pending pointer survives into this process.
    # Retry that exact video before invoking the normal collector queue.
    priority_run_id: Optional[int] = None
    if pending_video_id and not tiktok_tiktok_rate_limited():
        try:
            with self.db.lock:
                row = self.db.conn.execute("SELECT * FROM videos WHERE video_id=?", (pending_video_id,)).fetchone()
            pending_video = dict(row) if row else None
            if pending_video:
                priority_run_id = self.db.begin_run(mode, 1, [f"tiktok://priority/{pending_video_id}"])
                self.last_run_id = priority_run_id
                action = "FORCE" if force_refresh else "RESUME"
                self.emit(
                    f"[throttle] PRIORITY RETRY | video={pending_video_id} | "
                    f"account={pending_video.get('account_id','')} | action={action} | retrying before normal queue"
                )
                self.enrich_video(priority_run_id, pending_video, mode, action)
                if not tiktok_tiktok_rate_limited():
                    tiktok_clear_pending_retry(self.db)
                    self.db.finish_run(priority_run_id, "COMPLETE", f"Priority retry completed for {pending_video_id}")
                    self.db.log_counts(priority_run_id, prefix="[db] after TikTok priority retry")
                    self.emit(f"[throttle] PRIORITY RETRY COMPLETE | video={pending_video_id} | normal queue can resume")
                else:
                    self.db.finish_run(priority_run_id, "STOPPED", f"Priority retry re-throttled for {pending_video_id}")
                    self.emit(f"[throttle] PRIORITY RETRY RE-THROTTLED | video={pending_video_id} | yielding to scheduler")
                    return priority_run_id
            else:
                self.emit(f"[throttle] pending video {pending_video_id} was not found in videos table; continuing normal queue")
        except Exception as exc:
            if priority_run_id is not None:
                try:
                    self.db.finish_run(priority_run_id, "FAILED", str(exc)[:1000])
                except Exception:
                    pass
            self.emit(f"[throttle] PRIORITY RETRY ERROR | video={pending_video_id} | {type(exc).__name__}: {exc}")

    result = tiktok__TIKTOK_OLD_RUN(self, run_inputs, limit, mode, force_refresh)
    with tiktok_RATE_LIMIT_LOCK:
        global tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF, tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER
        if not tiktok_tiktok_rate_limited():
            tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF += 1
            if tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF >= 25 and tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER > 1.0:
                tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER = max(1.0, tiktok_TIKTOK_ADAPTIVE_INTERVAL_MULTIPLIER * 0.75)
                tiktok_TIKTOK_SUCCESSFUL_REQUESTS_SINCE_BACKOFF = 0
    return result

