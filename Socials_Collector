def tiktok_update_tiktok_caption_contents(db: tiktok_Database, run_id: int, video_id: str, mode: str) -> int:
    """Fetch subtitle text for already-discovered caption tracks; media is never downloaded."""
    with db.lock:
        rows = db.conn.execute("SELECT id,url FROM captions WHERE video_id=? AND COALESCE(content,'')='' AND COALESCE(url,'')<>'' ORDER BY id", (video_id,)).fetchall()
    updated = 0
    for row in rows:
        if tiktok_stop_requested() or tiktok_tiktok_rate_limited():
            break
        url = str(row["url"] or "")
        try:
            r = tiktok_SESSION.get(url, timeout=tiktok_REQUEST_TIMEOUT, headers={"User-Agent": tiktok_UA})
            if r.status_code != 200 or not r.text:
                continue
            text_content = r.text
            with db.lock:
                db.conn.execute("UPDATE captions SET content=?,captured_at=?,scrape_run_id=? WHERE id=?", (text_content, tiktok_now_utc(), run_id, int(row["id"])))
                db.conn.commit()
            updated += 1
        except Exception as exc:
            db.record_error(run_id, video_id=video_id, stage="caption_content", exc=exc, message=str(exc))
    return updated


def tiktok_choose_video_action_parity(db: tiktok_Database, video: dict, mode: str, force_refresh: bool = False) -> str:
    if force_refresh:
        return "FORCE"
    state = db.get_video_state(video.get("video_id", "")) or {}
    if not state or not state.get("last_enriched_at"):
        return "NEW"
    if state.get("last_error"):
        return "RESUME"
    last_full = state.get("last_full_refresh_at") or state.get("last_enriched_at")
    age_days = tiktok_video_age_days(video)
    refresh_hours = 24.0 if age_days is not None and age_days <= 30 else 168.0
    if tiktok_hours_since_iso(last_full) is None or tiktok_hours_since_iso(last_full) >= refresh_hours:
        return "PERFORMANCE_REFRESH"
    if mode == "Maximum":
        last_heavy = state.get("last_maximum_refresh_at") or state.get("last_full_refresh_at")
        if tiktok_hours_since_iso(last_heavy) is None or tiktok_hours_since_iso(last_heavy) >= 168.0:
            return "HEAVY_REFRESH"
    return "SKIP"

